config BR2_PACKAGE_GT_BE98_OS
	bool "gt-be98-os (mainline OS integration)"
	depends on BR2_INIT_OPENRC
	depends on BR2_LINUX_KERNEL
	select BR2_PACKAGE_HOST_UBOOT_TOOLS
	select BR2_PACKAGE_HOST_UBOOT_TOOLS_FIT_SUPPORT
	select BR2_PACKAGE_HOST_DTC
	help
	  GT-BE98 mainline development OS integration:
	   - OpenRC services: gt-be98-watchdog (health-gated petting),
	     dhcpcd (USB lifeline + rnr0), sshd (keys only), chronyd,
	     syslogd, gt-be98-persist (USB stick), gt-be98-drivers (Runner),
	     gt-be98-boot-done, gt-be98-netconsole (only with a target);
	     optional gt-be98-wifi, gt-be98-telnet,
	     dnsmasq;
	   - gt-be98-postcode / -health / -wdtd / -status, a guarded devmem;
	   - the rescue initramfs /init (installed to $(BINARIES_DIR)/rescue/),
	     used by board/gt-be98-mainline/post-image.sh;
	   - lab-specific values (SSH keys, host keys, static fallback
	     address, remote syslog) from the local configuration file.

if BR2_PACKAGE_GT_BE98_OS

config BR2_PACKAGE_GT_BE98_OS_LOCAL_CONF
	string "local configuration file (build host, not in git)"
	default ""
	help
	  Absolute path of a shell KEY=VALUE file with the lab-specific
	  settings (template: board/gt-be98-mainline/local.conf.example).
	  board/gt-be98-mainline/build.sh sets it. Empty: no SSH key (the
	  passwordless USB telnet lifeline is then enabled), no firmware,
	  and post-image.sh cannot build the FIT (it needs STOCK_BOOTFS).

config BR2_PACKAGE_GT_BE98_OS_RELEASE
	bool "release image (no lab secrets, no lab addresses)"
	help
	  Build a release image: board/gt-be98-mainline/build.sh sets it
	  with RELEASE=1 (environment or local configuration; template
	  board/gt-be98-mainline/release.conf.example). The build then
	  refuses every local-configuration value that would put a lab
	  secret or a lab address into the image (SSH_HOSTKEY_DIR,
	  WEBUI_PASSWORD[_HASH], ROOTFS_URL, SYSLOG_REMOTE, NETCONSOLE,
	  RNR0_FALLBACK, USB_FALLBACK), strips the comments of
	  SSH_AUTHORIZED_KEYS, and enables the web UI with its first-login
	  setup token instead of a baked password. SSH host keys are
	  generated on the box at first boot (gt-be98-hostkeys) and kept
	  in /jffs. Check the result with
	  board/gt-be98-mainline/release-check.sh.

config BR2_PACKAGE_GT_BE98_OS_HOSTAPD_FILS
	bool "hostapd: Fast Initial Link Setup discovery (FILS)"
	depends on BR2_PACKAGE_HOSTAPD
	help
	  Build Buildroot's hostapd with CONFIG_FILS, which Buildroot's
	  hostapd package has no option for. It lets a 6 GHz BSS send FILS
	  discovery frames (fils_discovery_max_interval=); nothing changes
	  unless a config sets a fils_* key. CONFIG_FILS_SK_PFS (FILS shared
	  key authentication with PFS) is left out.

config BR2_PACKAGE_GT_BE98_OS_HOSTAPD_MBO
	bool "hostapd: Multiband Operation (MBO)"
	depends on BR2_PACKAGE_HOSTAPD
	help
	  Build Buildroot's hostapd with CONFIG_MBO (src/ap/mbo_ap.c), which
	  Buildroot's hostapd package has no option for. The MBO element is
	  only sent by a BSS whose config sets mbo=1; with WPA2, hostapd
	  then requires PMF. WNM (BSS transition management) is not
	  enabled by this option.

config BR2_PACKAGE_GT_BE98_OS_HOSTAPD_WNM
	bool "hostapd: WNM (802.11v BSS transition management)"
	depends on BR2_PACKAGE_HOSTAPD
	help
	  Build Buildroot's hostapd with CONFIG_WNM (CONFIG_WNM_AP:
	  src/ap/wnm_ap.c and the bss_transition= / wnm_sleep_mode= keys),
	  which Buildroot's hostapd package has no option for. Needed by
	  gt-be98-wifi-gen's 802.11k/v (network kv=1, the generator's KV
	  switch): without it hostapd refuses a config with bss_transition=.
	  Off: 802.11k/v waits for the Wi-Fi driver to pass the RRM/WNM
	  action frames (open-wifi INV-T6); turn it on with KV=1.

config BR2_PACKAGE_GT_BE98_OS_HOSTAPD_AIRTIME_POLICY
	bool "hostapd: airtime policy (airtime_mode)"
	depends on BR2_PACKAGE_HOSTAPD
	help
	  Build Buildroot's hostapd with CONFIG_AIRTIME_POLICY, which
	  Buildroot's hostapd package has no option for. It adds the
	  airtime_mode, airtime_bss_weight, airtime_bss_limit and
	  airtime_sta_weight keys; hostapd then hands per-station airtime
	  weights to the driver (bca_pcie_ipc maps them onto the
	  firmware's airtime management). Nothing changes unless a config
	  sets airtime_mode (default 0).

endif
