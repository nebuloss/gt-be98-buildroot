# Example Wi-Fi network list for gt-be98-wifi (WIFI_NETWORKS). Copy to
# /etc/hostapd/networks.conf, set the passphrases, then in
# /etc/conf.d/gt-be98-wifi: WIFI_NETWORKS=/etc/hostapd/networks.conf
# Format and rules: /usr/sbin/gt-be98-wifi-gen (header). key=value, the
# value is the rest of the line (never quoted); a block starts at network=
# or radio=. Each network is one BSS on every radio of its bands, bridged
# (brwifi<id>) to its own 802.1Q VLAN on WIFI_TRUNK.
#
# Bands: 2g (bcawl3), 5gl (bcawl0, ch 36-64), 5gh (bcawl1, ch 100+), 6g (bcawl2).
# 6 GHz takes only WPA3-SAE (sae, psk2sae: rendered as SAE with H2E), OWE
# (owe, open-owe: open on 2.4/5 GHz, OWE on 6 GHz) or WPA3-Enterprise
# (wpa3-eap, wpa2-wpa3-eap: rendered as wpa3-eap); PMF is required there.
# Enterprise (wpa2-eap, wpa3-eap, wpa2-wpa3-eap) takes no passphrase: the box
# relays EAP (PEAP, TTLS, EAP-TLS, ...) to an external RADIUS server given by
# IP address (radius_server, radius_port 1812, radius_secret; optional
# accounting radius_acct_server, radius_acct_port 1813, radius_acct_secret).
# max_clients=N caps the clients of each of the network's BSSes (hostapd
# max_num_sta; one more is disassociated with reason 5, "AP busy").
# schedule= (network or radio): on only inside the windows, local time
# (WIFI_SCHED_TZ in /etc/conf.d/gt-be98-wifi, a POSIX TZ string; UTC if
# empty), e.g. weekdays@07:00-23:00 weekend@09:00-24:00 or daily@22:00-06:00;
# applied only while the clock is synchronised (NTP).
# Airtime: radio airtime=1 (static weights) with airtime_sta_weight=MAC W
# per station (mac80211 default 256: W=512 asks for twice the airtime of a
# default station) or airtime_weight=W for every station of a network;
# airtime=2|3 share the radio between networks by airtime_weight (3 caps the
# networks with airtime_limit=1). Off (airtime=0) by default.
# Radio options: ax=1 turns HE (802.11ax) on for 2g/5gl/5gh (6g is always
# HE); twt=0 turns hostapd's TWT responder off (on by default, HE radios
# only); zwdfs=1 (5gl/5gh, a DFS channel, country set) is zero-wait DFS: the
# radio starts at once on a non-DFS channel, the DFS channel's CAC runs in
# the background, then hostapd moves there; monitor=1 makes the radio a
# monitor (<dev>mon on its channel/width, no BSS); led=0 turns its LED off.
# Station (Wi-Fi uplink, at most one): station=<band> with ssid=,
# security=psk2|sae and passphrase= makes that radio a Wi-Fi client of
# another AP (its networks then run on virtual interfaces, on the uplink's
# channel). A network reaches the uplink only when routed: routed=A.B.C.1/P
# instead of vlan= (DHCP/DNS and NAT by the box); a 3-address station cannot
# be bridged. See the example at the end.
# This file holds secrets: keep it mode 0600.
# country= is written only once the regulatory database is loaded.
#country=XX

radio=2g
channel=6
width=20
radio=5gl
channel=36
width=80
#ax=1
#zwdfs=1
radio=5gh
channel=100
width=80
radio=6g
channel=37

network=10
ssid=home
security=psk2sae
passphrase=CHANGE-ME-NOW
bands=2g 5gl 5gh
vlan=10

network=20
ssid=iot
security=psk2
passphrase=CHANGE-ME-TOO
bands=2g
vlan=20

network=30
ssid=guest
security=open-owe
bands=2g 5gl 5gh 6g
vlan=30
isolate=1
max_clients=16
schedule=daily@08:00-23:00

# WPA2/WPA3-Enterprise (transition) on 2.4/5 GHz, WPA3-Enterprise on 6 GHz.
# The RADIUS server must list the box's address as a client with this secret.
network=40
ssid=corp
security=wpa2-wpa3-eap
radius_server=192.0.2.10
radius_secret=CHANGE-ME-RADIUS
#radius_port=1812
#radius_acct_server=192.0.2.10
#radius_acct_port=1813
bands=2g 5gl 5gh 6g
vlan=40

# Repeater: 5 GHz-low joins an upstream AP; network 50 is routed behind it.
#station=5gl
#ssid=upstream
#security=sae
#passphrase=CHANGE-ME-UPLINK
#network=50
#ssid=repeater
#security=psk2sae
#passphrase=CHANGE-ME-REP
#bands=2g 5gl
#routed=192.168.50.1/24
