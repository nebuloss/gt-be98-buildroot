#!/bin/sh
# SPDX-License-Identifier: GPL-2.0
# busybox udhcpc hook: address, default route, resolver
case "$1" in
deconfig)
	ip -4 addr flush dev "$interface"
	;;
bound|renew)
	ip -4 addr flush dev "$interface"
	ip addr add "$ip/${mask:-24}" dev "$interface"
	for r in $router; do
		ip route replace default via "$r" dev "$interface"
		break
	done
	printf 'DHCP_SERVER=%s\nDHCP_ROUTER=%s\n' "$serverid" "${router%% *}" > /tmp/dhcp.env
	: > /etc/resolv.conf
	for d in $dns; do echo "nameserver $d" >> /etc/resolv.conf; done
	;;
esac
exit 0
