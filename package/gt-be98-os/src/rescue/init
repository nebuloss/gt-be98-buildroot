#!/bin/sh
# SPDX-License-Identifier: GPL-2.0
# GT-BE98 mainline OS - initramfs /init (static BusyBox ash, PID 1).
#
# The kernel Image carries only this script and a static BusyBox. The OS
# (rootfs.squashfs) comes from, in this order:
#   0. /rootfs.squashfs already in the initramfs (IMAGE=initrd builds: a
#      second cpio named by the DT; not used by the default netroot image);
#   1. a USB storage partition labelled GTBE98-ROOT, holding either
#      /rootfs.squashfs (vfat or ext4) or a complete root (/sbin/init, ext4:
#      booted read-write as is, the persistent option);
#   2. slot 1's UBI volume "rootfs1" (vol 4) on the NAND "image" partition
#      (UBI_MTD, NAND images only): UBI attached with nothing writable
#      (brcmnand.allow_write=0, no UBI fence: the write gate refuses every
#      write), the first ROOTFS_SIZE bytes of the volume copied into RAM and
#      checked against ROOTFS_SHA256 (both built into this initramfs by
#      post-image.sh, so an itb boots only the rootfs it was built with),
#      then UBI detached again: nothing keeps the NAND open, and the OS's
#      gt-be98-jffs attaches it afresh with the write fence;
#   3. HTTP: ROOTFS_URL (build time, local configuration) and
#      ROOTFS_URL.sha256, fetched over the USB-Ethernet lifeline into RAM and
#      checked against the sha256. "@DHCP_SERVER@" / "@DHCP_ROUTER@" in the
#      URL are replaced by the addresses the lifeline's DHCP lease named
#      (to test a new rootfs without reflashing vol 4).
# A squashfs is loop-mounted read-only at /rom with a tmpfs overlay
# (/overlay) and the box switch_roots into OpenRC (/sbin/init).
# Any failure ends in the RESCUE lifeline of the stage-2 image: busybox
# telnetd (root shell, NO password) bound to the USB NIC address, and
# bounded watchdog petting (WDT_MAX s, echo 1 > /tmp/extend adds 600 s, at
# most 3600 s), then the hardware watchdog resets the box into stock.
#
# Watchdog: U-Boot arms it before the kernel. /init pets it in the
# background from the start, for at most NET_WDT_MAX s (finding, copying or
# fetching and mounting the rootfs; no network needed for 1 and 2); it stops
# petting right before switch_root (the OS gt-be98-watchdog service takes
# over within the watchdog timeout), or hands over to the rescue loop, which
# pets only with a lifeline address.
#
# Post-codes ("BE98PC xx" -> 0xff802628[31:24] via the be98pc earlycon):
#   c0 /init  c1 /proc  c2 /sys  c3 /dev,/tmp  c4 command line  c5 USB pins
#   c6 USB NIC found      c7 address (DHCP or ml.ip=)   c9 /init petting
#   d7 looking for a GTBE98-ROOT USB partition          d8 found and mounted
#   db reading UBI rootfs1 from the NAND                dc copied, sha256 ok
#   d9 fetching the rootfs over HTTP                    da fetched, sha256 ok
#   f1 squashfs mounted   f2 overlay mounted   f3 switch_root to OpenRC
#   rescue reasons (then c8 telnetd up, ca petting deadline reached):
#   e0 no rootfs source at all (no USB root, no ROOTFS_URL)
#   e1 squashfs mount failed   e2 overlay failed   e3 no /sbin/init
#   e4 RESCUE=1 / ml.rescue=1  e5 HTTP fetch failed e6 sha256 mismatch
#   e8 no address within NET_WAIT s (in rescue: nothing pets, U-Boot's
#      watchdog resets the box)                     ee no USB bus at all
#   e9 UBI rootfs1 unavailable (no NAND partition, attach failed, no volume,
#      no ROOTFS_SHA256)                            eb UBI rootfs1 sha256 mismatch
#
# Build-time settings: /etc/ml-defaults (post-image.sh, from the local
# configuration). The kernel command line is forced; ml.* options on it
# still override: ml.ip=A.B.C.D/NN, ml.usbmux=0|1, ml.wdt_max=N, ml.rescue=1.

PATH=/bin:/sbin:/usr/bin:/usr/sbin
export PATH

pc() { echo "BE98PC $1" > /dev/kmsg; }
log() { echo "INIT: $*" > /dev/kmsg; }

pc c0
/bin/busybox mkdir -p /usr/bin /usr/sbin /sbin
/bin/busybox --install -s
mount -t proc proc /proc && pc c1
mount -t sysfs sysfs /sys && pc c2
mount -t devtmpfs devtmpfs /dev 2>/dev/null
mkdir -p /dev/pts /tmp
mount -t devpts devpts /dev/pts
mount -t tmpfs tmpfs /tmp && pc c3

upi() { cut -d. -f1 /proc/uptime; }
T0=$(upi)

RESCUE=0
STATIC_IP=
USBMUX=1
WDT_MAX=600
NET_WAIT=45
NET_WDT_MAX=300
OVERLAY_SIZE=75%
ROOT_LABEL=GTBE98-ROOT
ROOTFS_URL=
USB_ROOT_WAIT=8
UBI_MTD=image
UBI_ROOT_VOL=rootfs1
UBI_VID_OFFSET=2048
ROOTFS_SHA256=
ROOTFS_SIZE=
[ -f /etc/ml-defaults ] && . /etc/ml-defaults

CMDLINE=$(cat /proc/cmdline 2>/dev/null)
log "cmdline: ${CMDLINE:-<unreadable>}"
for w in $CMDLINE; do
	case "$w" in
	ml.ip=*)	STATIC_IP=${w#*=} ;;
	ml.usbmux=*)	USBMUX=${w#*=} ;;
	ml.wdt_max=*)	WDT_MAX=${w#*=} ;;
	ml.rescue=*)	RESCUE=${w#*=} ;;
	esac
done
case "$WDT_MAX" in ''|*[!0-9]*) WDT_MAX=600 ;; esac
[ "$WDT_MAX" -gt 3600 ] && WDT_MAX=3600
log "$(uname -a)"
log "params: rescue=$RESCUE wdt_max=$WDT_MAX usbmux=$USBMUX root_label=$ROOT_LABEL url=${ROOTFS_URL:-<none>}"
pc c4

# USB port power / overcurrent pins (58,59 USB0; 60,61 USB1) to function 0
# through the TEST_PORT pinmux block (no mainline pinctrl driver yet).
if [ "$USBMUX" = 1 ]; then
	for pin in 58 59 60 61; do
		devmem 0xff800554 32 0
		devmem 0xff800558 32 $pin
		devmem 0xff80055c 32 0x21
	done
fi
pc c5

idle() { while :; do sleep 3600; done; }

# ---- background watchdog petting while the rootfs is fetched/mounted ---------
PETPID=
pet_start() {
	[ -c /dev/watchdog ] || { log "watchdog: no /dev/watchdog"; return 1; }
	(
		exec 3>/dev/watchdog || exit 1
		end=$(( $(upi) + NET_WDT_MAX ))
		# children must not inherit fd 3: /dev/watchdog is single-open and
		# the OS opens it right after switch_root
		while [ "$(upi 3>&-)" -lt "$end" ]; do echo -n . >&3; sleep 5 3>&-; done
		echo "BE98PC ca" > /dev/kmsg
		echo "INIT: watchdog: boot petting window over, reset follows" > /dev/kmsg
		while :; do sleep 3600 3>&-; done
	) &
	PETPID=$!
	pc c9
	log "watchdog: petting for at most ${NET_WDT_MAX}s while the rootfs is loaded"
}
pet_stop() {
	[ -n "$PETPID" ] || return 0
	kill "$PETPID" 2>/dev/null
	wait "$PETPID" 2>/dev/null
	PETPID=
}

# ---- USB-Ethernet lifeline ---------------------------------------------------
IF=
ADDR=
usb_nic() {
	ls -l /sys/class/net 2>/dev/null | grep /usb | sed 's/.* \([^ ]*\) -> .*/\1/' | head -n 1
}
net_up() {
	local deadline=$((T0 + NET_WAIT))
	[ -e /sys/bus/usb/devices/usb1 ] || sleep 2
	if [ ! -e /sys/bus/usb/devices/usb1 ]; then
		pc ee; log "usb: no USB bus (power-up or xhci probe failed)"
		dmesg | grep -iE 'xhci|usb|phy|pmb' | tail -n 20 | while read -r l; do log "dmesg: $l"; done
		return 1
	fi
	while [ "$(upi)" -lt "$deadline" ]; do
		if [ -z "$IF" ]; then
			IF=$(usb_nic)
			[ -n "$IF" ] || { sleep 1; continue; }
			pc c6; log "net: USB NIC $IF at $(upi)s"
			ip link set lo up
			ip link set "$IF" up
		fi
		udhcpc -i "$IF" -n -q -t 2 -T 2 -s /etc/udhcpc.script >>/tmp/udhcpc.log 2>&1
		ADDR=$(ip -4 -o addr show dev "$IF" 2>/dev/null | sed -n 's/.* inet \([0-9.]*\)\/.*/\1/p' | head -n 1)
		[ -n "$ADDR" ] && break
		if [ -n "$STATIC_IP" ]; then
			ip addr add "$STATIC_IP" dev "$IF" && ADDR=${STATIC_IP%/*}
			break
		fi
		[ -e "/sys/class/net/$IF" ] || IF=
	done
	[ -n "$ADDR" ] || { log "net: no address within ${NET_WAIT}s"; return 1; }
	pc c7; log "net: address $ADDR on $IF at $(upi)s"
	return 0
}

# ---- mounting ------------------------------------------------------------------
mkdir -p /mnt/rw /mnt/ro /mnt/usb /newroot
REASON=
rw_tmpfs() {
	mountpoint -q /mnt/rw && return 0
	mount -t tmpfs -o mode=0755,size=$OVERLAY_SIZE tmpfs /mnt/rw
}

# $1 = squashfs file. Mounts it at /mnt/ro and the overlay at /newroot.
mount_squashfs() {
	if ! mount -t squashfs -o ro,loop "$1" /mnt/ro; then
		REASON=e1; log "os: squashfs mount of $1 failed"; return 1
	fi
	pc f1
	rw_tmpfs || { REASON=e2; umount /mnt/ro; return 1; }
	if ! mkdir -p /mnt/rw/upper /mnt/rw/work ||
	   ! mount -t overlay -o lowerdir=/mnt/ro,upperdir=/mnt/rw/upper,workdir=/mnt/rw/work \
		overlay /newroot; then
		REASON=e2; log "os: overlay mount failed"; umount /mnt/ro; return 1
	fi
	pc f2
	if [ ! -x /newroot/sbin/init ]; then
		REASON=e3; log "os: /sbin/init missing in the rootfs"
		umount /newroot; umount /mnt/ro; return 1
	fi
	return 0
}

# switch_root into /newroot. $1: what to move into it (layers to keep visible)
switch_os() {
	local src=$1
	mkdir -p /newroot/rom /newroot/overlay 2>/dev/null
	mountpoint -q /mnt/ro && mount --move /mnt/ro /newroot/rom
	mountpoint -q /mnt/rw && mount --move /mnt/rw /newroot/overlay
	if mountpoint -q /mnt/usb; then
		mkdir -p /newroot/media/gtbe98-root 2>/dev/null
		mount --move /mnt/usb /newroot/media/gtbe98-root
	fi
	{
		echo "BOOT_T0=$T0"
		echo "BOOT_ROOT_SOURCE=$src"
		echo "BOOT_USB_IF=$IF"
		echo "BOOT_USB_ADDR=$ADDR"
	} > /run-boot-info 2>/dev/null
	cp /run-boot-info /newroot/etc/gt-be98-boot-info 2>/dev/null
	pet_stop
	umount /dev/pts 2>/dev/null
	umount /tmp 2>/dev/null
	umount /sys
	umount /dev 2>/dev/null
	pc f3
	log "os: root from $src, switch_root to OpenRC at $(cut -d' ' -f1 /proc/uptime)s"
	umount /proc
	exec switch_root /newroot /sbin/init
	echo "BE98PC e3" > /dev/kmsg
	reboot -f
	idle
}

# 0. rootfs already in the initramfs (IMAGE=initrd)
try_initramfs_root() {
	[ -f /rootfs.squashfs ] || return 1
	log "os: /rootfs.squashfs in the initramfs ($(wc -c < /rootfs.squashfs) bytes)"
	mount_squashfs /rootfs.squashfs && switch_os initramfs
	return 1
}

# 1. USB storage partition labelled $ROOT_LABEL
try_usb_root() {
	local dev n=0
	pc d7
	dev=$(findfs "LABEL=$ROOT_LABEL" 2>/dev/null)
	while [ -z "$dev" ] && [ $n -lt "$USB_ROOT_WAIT" ]; do
		sleep 1; n=$((n + 1)); dev=$(findfs "LABEL=$ROOT_LABEL" 2>/dev/null)
	done
	[ -n "$dev" ] || { log "usbroot: no partition labelled $ROOT_LABEL"; return 1; }
	log "usbroot: $dev ($ROOT_LABEL)"
	# a complete ext4 root: boot it read-write (persistent)
	if mount -t ext4 -o rw,noatime "$dev" /newroot 2>/dev/null; then
		if [ -x /newroot/sbin/init ]; then
			pc d8; log "usbroot: ext4 root on $dev (read-write, persistent)"
			switch_os "usb-ext4:$dev"
		fi
		umount /newroot
	fi
	# a partition holding rootfs.squashfs
	if mount -o ro "$dev" /mnt/usb 2>/dev/null; then
		if [ -f /mnt/usb/rootfs.squashfs ]; then
			pc d8; log "usbroot: $dev/rootfs.squashfs"
			mount_squashfs /mnt/usb/rootfs.squashfs && switch_os "usb-squashfs:$dev"
		else
			log "usbroot: $dev has neither /sbin/init nor /rootfs.squashfs"
		fi
		umount /mnt/usb 2>/dev/null
	fi
	return 1
}

# 2. slot 1's UBI volume rootfs1, copied into RAM and checked
try_ubi_root() {
	local m v got
	[ -n "$ROOTFS_SHA256" ] && [ -n "$ROOTFS_SIZE" ] || { REASON=e9; log "ubiroot: no ROOTFS_SHA256/SIZE in this image"; return 1; }
	m=$(sed -n "s/^mtd\([0-9]*\): [0-9a-f]* [0-9a-f]* \"$UBI_MTD\"\$/\1/p" /proc/mtd | head -n 1)
	[ -n "$m" ] || { REASON=e9; log "ubiroot: no NAND partition \"$UBI_MTD\""; return 1; }
	pc db
	# nothing may be written: no fence, allow_write off (the defaults)
	echo "" > /sys/module/ubi/parameters/fence 2>/dev/null
	echo 0 > /sys/module/brcmnand/parameters/allow_write 2>/dev/null
	if ! ubiattach -m "$m" -d 0 -O "$UBI_VID_OFFSET" /dev/ubi_ctrl >/dev/null 2>&1; then
		REASON=e9; log "ubiroot: UBI attach of mtd$m failed"; return 1
	fi
	v=
	for d in /sys/class/ubi/ubi0_*; do
		[ "$(cat "$d/name" 2>/dev/null)" = "$UBI_ROOT_VOL" ] && v=${d##*/}
	done
	if [ -z "$v" ] || [ ! -e "/dev/$v" ]; then
		REASON=e9; log "ubiroot: no UBI volume $UBI_ROOT_VOL"; ubidetach -d 0 /dev/ubi_ctrl; return 1
	fi
	rw_tmpfs || { REASON=e2; ubidetach -d 0 /dev/ubi_ctrl; return 1; }
	log "ubiroot: reading $ROOTFS_SIZE bytes of $UBI_ROOT_VOL (/dev/$v) at $(upi)s"
	rm -f /mnt/rw/rootfs.squashfs
	head -c "$ROOTFS_SIZE" "/dev/$v" > /mnt/rw/rootfs.squashfs
	ubidetach -d 0 /dev/ubi_ctrl || log "ubiroot: UBI detach failed"
	got=$(sha256sum /mnt/rw/rootfs.squashfs | cut -d' ' -f1)
	if [ "$got" != "$ROOTFS_SHA256" ]; then
		REASON=eb; log "ubiroot: sha256 mismatch (want $ROOTFS_SHA256, got $got): vol 4 does not hold this image's rootfs"
		rm -f /mnt/rw/rootfs.squashfs
		return 1
	fi
	pc dc; log "ubiroot: $ROOTFS_SIZE bytes, sha256 ok at $(upi)s"
	mount_squashfs /mnt/rw/rootfs.squashfs && switch_os "ubi:$UBI_ROOT_VOL"
	return 1
}

# 3. HTTP
try_http_root() {
	local want got
	[ -n "$ROOTFS_URL" ] || { log "http: no ROOTFS_URL configured"; return 1; }
	[ -n "$ADDR" ] || return 1
	DHCP_SERVER= DHCP_ROUTER=
	[ -f /tmp/dhcp.env ] && . /tmp/dhcp.env
	ROOTFS_URL=$(echo "$ROOTFS_URL" | sed -e "s/@DHCP_SERVER@/$DHCP_SERVER/g" -e "s/@DHCP_ROUTER@/$DHCP_ROUTER/g")
	rw_tmpfs || { REASON=e2; return 1; }
	pc d9; log "http: fetching $ROOTFS_URL at $(upi)s"
	rm -f /mnt/rw/rootfs.squashfs /tmp/rootfs.sha256
	if ! wget -q -T 30 -O /tmp/rootfs.sha256 "$ROOTFS_URL.sha256" ||
	   ! wget -q -T 30 -O /mnt/rw/rootfs.squashfs "$ROOTFS_URL"; then
		REASON=e5; log "http: fetch failed"; return 1
	fi
	want=$(cut -d' ' -f1 /tmp/rootfs.sha256)
	got=$(sha256sum /mnt/rw/rootfs.squashfs | cut -d' ' -f1)
	if [ -z "$want" ] || [ "$want" != "$got" ]; then
		REASON=e6; log "http: sha256 mismatch (want ${want:-?}, got $got)"
		rm -f /mnt/rw/rootfs.squashfs
		return 1
	fi
	pc da; log "http: $(wc -c < /mnt/rw/rootfs.squashfs) bytes, sha256 ok at $(upi)s"
	# the image stays in the overlay tmpfs (/overlay/rootfs.squashfs in the OS)
	mount_squashfs /mnt/rw/rootfs.squashfs && switch_os "http:$ROOTFS_URL"
	return 1
}

# ---- boot ------------------------------------------------------------------------
if [ "$RESCUE" = 1 ]; then
	REASON=e4; log "rescue requested (RESCUE=1 / ml.rescue=1)"
else
	try_initramfs_root
	pet_start
	try_usb_root
	try_ubi_root
	if net_up; then
		try_http_root
	else
		pc e8
	fi
	[ -n "$REASON" ] || REASON=e0
fi
pc "$REASON"
log "RESCUE MODE ($REASON)"

# ---- rescue: telnet + bounded petting ---------------------------------------------
pet_stop
if [ -z "$ADDR" ]; then
	net_up || { log "net: no address; NOT petting the watchdog (U-Boot watchdog resets the box)"; idle; }
fi
telnetd -b "$ADDR" -l /bin/sh && { pc c8; log "net: telnetd on $ADDR:23 ($IF)"; }
exec 3>/dev/watchdog || { log "watchdog: cannot open /dev/watchdog, not petting"; idle; }
start=$(upi)
end=$((start + WDT_MAX))
total=$WDT_MAX
pc c9
log "watchdog: rescue petting until uptime ${end}s (echo 1 > /tmp/extend adds 600 s, max 3600 s total)"
while [ "$(upi)" -lt "$end" ]; do
	echo -n . >&3
	if [ -e /tmp/extend ]; then
		rm -f /tmp/extend
		if [ $((total + 600)) -le 3600 ]; then
			total=$((total + 600))
			end=$((end + 600))
			log "watchdog: extended, petting until uptime ${end}s (total ${total}s)"
		else
			log "watchdog: extend refused, total already ${total}s"
		fi
	fi
	sleep 5
done
pc ca
log "watchdog: deadline reached at $(upi)s, petting stopped; hardware reset follows"
idle
