#!/sbin/openrc-run
# shellcheck shell=busybox
# SPDX-License-Identifier: GPL-2.0
# Optional Wi-Fi: loads bca_pcie_ipc.ko (the four PCIe radios) and runs
# hostapd on the configured radios. NOT enabled by default:
#   rc-update add gt-be98-wifi default ; rc-service gt-be98-wifi start
# Settings: /etc/conf.d/gt-be98-wifi, overridden by /etc/conf.d/gt-be98-wifi-ap
# when present (written by the web UI, saved to /jffs).
#
# ONE hostapd process serves every radio (so that it builds the Reduced
# Neighbor Report of the co-located 6 GHz BSSes, and so that one BSS can be
# added or removed without touching the others). It starts with only its
# global control socket (HOSTAPD_GLOBAL, default /run/hostapd-global) and
# each radio is added to it (ADD bss_config=<phy>:<radio config>): a radio
# that fails stays down alone, it does not stop the process or the others.
#   pid /run/hostapd-wifi.pid   log /var/log/hostapd.log
#   state /run/gt-be98-wifi/applied/<radio> (what hostapd runs), gen/ (the
#   rendered configs), l2.conf (the effective bridges/VLANs, for netguard)
# Two sources of radio configs, both may be used (on different radios):
#   WIFI_NETWORKS=/etc/hostapd/networks.conf   the Wi-Fi networks (see
#       /usr/sbin/gt-be98-wifi-gen): one BSS per (network, radio of its band
#       set) at a sticky slot (WIFI_SLOTS, default /etc/hostapd/wifi-slots;
#       slot 0 = the radio netdev bcawlN, slot k = bcawlN-k), with an
#       explicit BSSID (the firmware's mbss8 rule) and bridge=brwifi<network
#       id>. Their bridges, VLANs and isolation come from the list. At most
#       WIFI_MAX_BSS BSSes per radio (1..8); unset, the count the driver
#       advertises (`iw phy`: #{ AP } <= N, the firmware's own; the smallest
#       of the radios), 4 when no radio states one.
#   HOSTAPD_CONFS="/etc/hostapd/a.conf ..."    ready-made configs, one per
#       radio (interface= + bss= sections), as before.
# `rc-service gt-be98-wifi reload` applies new settings without touching the
# driver, through the global control socket:
#   - a radio whose radio-wide lines, anchor BSS (slot 0) or ready-made
#     config changed is restarted alone (REMOVE <radio>, ADD <radio config>):
#     hostapd removes every BSS of a radio with its first one, and the
#     driver's anchor start re-runs the radio prologue;
#   - a further BSS (slot k >= 1) that was added, removed or changed is
#     added (ADD bss_config=<phy>:<bss config>), removed (REMOVE <ifname>)
#     or both, the other BSSes of the radio left running; if that fails the
#     radio is restarted;
#   - unchanged radios and BSSes are not touched; a HOSTAPD_ARGS change or a
#     dead process restarts the process.
# A network list that is refused leaves everything running as it was. A
# network that fails its own checks (no VLAN, a bad passphrase, ...) does
# not refuse the list: it is skipped (gt-be98-wifi-gen -S, a warning and a
# "skipped <id>" plan line) and the other networks and the radios run, so
# one bad network never takes every radio down (at boot nothing would run).
#
# Schedules (schedule= of a network or radio in the list): the list is
# rendered for the current local time (gt-be98-wifi-sched now: only with a
# synchronised clock, else every schedule counts as on), so a network or
# radio outside its windows is simply not in the plan; the reload above
# removes and adds its BSSes. The daemon gt-be98-wifi-sched (started and
# stopped with this service, pid /run/gt-be98-wifi-sched.pid) checks at
# every minute boundary and reloads when the schedule state changed.
# WIFI_SCHED_TZ (same files): the schedules' POSIX TZ string, empty = UTC.
# 802.11k/v (kv=1 networks, while the generator's KV=1): the daemon
# gt-be98-wifi-steer (pid /run/gt-be98-wifi-steer.pid) runs while the
# applied plan has a kv line: it writes each kv BSS into the neighbour
# database of its sibling BSSes (same network, other radios) and, for the
# steer=1 networks, sends 802.11v BSS transition requests (its header).
#
# Monitor radios (monitor=1 of a radio in the list): the radio carries no
# BSS; once hostapd released it the radio netdev is set down (the driver
# refuses a monitor while it is up) and <dev>mon is created on its wiphy
# (iw phy <phy> interface add <dev>mon type monitor), set up and tuned to the
# radio's channel/width. A monitor no longer listed is deleted before the
# radio's BSSes start again; only what this service created ($STATE/monitors)
# is ever deleted.
#
# Driver re-probe (open-wifi radio_rebind, INV-RECOVERY): the driver may
# remove and re-probe ONE radio after a firmware trap; its netdev comes back
# under the same name with a new ifindex and a new wiphy, and hostapd /
# wpa_supplicant are still bound to the old one. $STATE/ids/<dev> holds the
# ifindex of each radio netdev this service started (hostapd radio, station
# or monitor); a reload restarts a radio whose netdev is no longer that one
# (REMOVE + ADD of that radio alone, its station restarted, its monitor made
# again), the other radios untouched. The daemon gt-be98-wifi-reprobe
# (started and stopped with this service, pid /run/gt-be98-wifi-reprobe.pid)
# notices the new netdev and runs that reload, debounced.
#
# A radio that fails to start (bounded supervised restart): hostapd runs
# with only its global socket (-g, no config file on its command line, so
# terminate_on_error is 0) and a radio whose setup fails is left by hostapd
# in its list in state DISABLED, the others running; a setup that fails
# inside the ADD answers FAIL. Either is a FAILURE of that radio, never
# "unchanged": $STATE/failed/<dev> records it (key=value: key = the radio's
# config checksum, state, reason = hostapd's last lines for it, tries, next
# = when the next retry is due, given_up), a syslog line says it, `status`
# prints it as an error and the web UI warns. The radio alone is restarted
# at most 3 times per config: 30 s after the failure, then 2 min and 10 min
# after each failed retry; then it is left DISABLED and reported. Starting
# states (COUNTRY_UPDATE, DFS, HT_SCAN, ACS, NO_IR, UNINITIALIZED) are never
# a failure. The record goes when the radio is ENABLED (said: recovered),
# when it leaves the plan, and on stop; a new config starts a new count.
# gt-be98-wifi-reprobe runs the due reloads (and one when the hostapd
# process died).
#
# Lifecycle (img41; img40 measured: daemons running under a service OpenRC
# called stopped, a stop that stopped nothing, reloads refused forever):
#   - start succeeds whenever this service runs something: a radio, a
#     config line or a station that fails leaves the service STARTED and
#     DEGRADED (said, `status` non-zero and lists it, the failed radios
#     retried as above). A failed start (OpenRC marks the service stopped,
#     and then never runs stop) is only one that runs nothing: the network
#     list refused, or hostapd not starting; it leaves nothing running.
#   - start, stop and reload never overlap (OpenRC locks start against
#     stop, never reload: a reload run by a daemon could restart hostapd
#     and the daemons under a stop). The lock is the directory
#     /run/gt-be98-wifi.lock (its holder's pid inside; a dead holder's lock
#     is taken over); a reload that finds the service stopping does nothing.
#   - start and stop also stop what runs of this service WITHOUT a pid file
#     naming it (its daemons and hostapd, found by their command line), and
#     each daemon exits by itself once its pid file no longer names it.
#
# LEDs (led=0|1 of a radio in the list): $STATE/leds lists the radios whose
# LED is off (WIFI_LEDS_OFF="bcawlN ..."); gt-be98-leds reads it, and is run
# after every start and reload.
#
# Station (Wi-Fi uplink, client mode: a station= block of the list): the
# radio's netdev bcawlN becomes a STATION run by wpa_supplicant (the
# firmware's AP+STA model: the station is bsscfg 0, the APs are
# secondaries), its networks run on virtual interfaces bcawlN-k only. The
# ORDER is the one measured on silicon (open-wifi docs/STA-WDS-2026-10-29.md
# §2/§24-28, stawds arm A1): (1) hostapd releases the radio netdev, (2) the
# first AP's virtual interface is created (iw ... type __ap), (3) the station
# connects (its connect arms apsta in its own core-down window because an AP
# interface exists), (4) hostapd starts the APs, on the uplink's channel
# (one channel per radio; the driver refuses another one, -EBUSY; the
# generator's -U). A virtual interface created while the station runs makes
# the station reconnect first, so (2) always precedes (3). The station's
# processes (wpa_supplicant, a DHCP client) and the routed networks (routed=:
# address, DHCP/DNS, NAT out of the station) are run by gt-be98-wifi-sta;
# its monitor daemon (pid /run/gt-be98-wifi-sta.pid, started and stopped
# with this service) restarts a dead process and reloads this service when
# the uplink moved the radio to another channel. $STATE/stations lists the
# station netdevs (gt-be98-netguard never lets one into a bridge: a
# 3-address station cannot be bridged), $STATE/repeaters the 4-address
# stations of a repeated network and their bridge (the one bridge netguard
# lets each into: generator repeater=, repeated=1), $STATE/vifs the virtual
# interfaces this service created, $STATE/routed the routed networks.
#
# Wi-Fi networks are pure L2: each network is a bridge brwifiN holding its
# BSSes and the 802.1Q sub-interface <trunk>.<vid> of the wired trunk port;
# no address on the box, no NAT. Besides the network list, settings (same
# files):
#   WIFI_BRIDGES="brwifi1 brwifi2"        the bridges of HOSTAPD_CONFS
#   WIFI_VLANS="brwifi1:100 brwifi2:200"  REQUIRED VLAN id (1-4094) per bridge
#   WIFI_TRUNK=rnr0                       trunk port, rnr0..rnr3 (default rnr0)
#   WIFI_ISOLATE="brwifi1"                bridges whose Wi-Fi ports are
#                                         isolated (reach the trunk only)
# Before any BSS starts, for each bridge with a VLAN: the bridge (no STP,
# forward_delay 0, up, IPv6 off: no address of the box on it), the trunk
# brought up if it is down (never down, never re-addressed: it keeps its
# untagged management address and dhcpcd), <trunk>.<vid> created (IPv6 off),
# up and enslaved. A bridge without a VLAN is never created, and a config
# naming it is refused. The trunk itself or any bare port is never enslaved.
# hostapd then only adds its BSS netdevs as ports (a bridge hostapd created
# itself would be deleted when it stops). reload creates new bridges and
# sub-interfaces and deletes the ones no longer listed after the BSSes
# using them stopped; only what this service created ($STATE/bridges,
# $STATE/vlans) is ever deleted. Only bcawl* netdevs in the configs
# (interface=, bss=). gt-be98-netguard allows exactly the listed
# <trunk>.<vid> in their bridges and keeps the isolation flags.
# Firmware: /lib/firmware/brcm/bca (gt-be98-vendor-firmware).
# shellcheck disable=SC2034 # read by openrc-run
description="Open Wi-Fi driver + hostapd (optional)"
# shellcheck disable=SC2034 # read by openrc-run
extra_started_commands="reload"

# (GT_BE98_*: the offline test harness only)
RUNDIR=${GT_BE98_RUN:-/run}
SYSNET=${GT_BE98_SYSNET:-/sys/class/net}
WIFI_GEN=${GT_BE98_WIFI_GEN:-/usr/sbin/gt-be98-wifi-gen}
WIFI_SCHED=${GT_BE98_WIFI_SCHED:-/usr/sbin/gt-be98-wifi-sched}
WIFI_STA=${GT_BE98_WIFI_STA:-/usr/sbin/gt-be98-wifi-sta}
WIFI_REPROBE=${GT_BE98_WIFI_REPROBE:-/usr/sbin/gt-be98-wifi-reprobe}
WIFI_STEER=${GT_BE98_WIFI_STEER:-/usr/sbin/gt-be98-wifi-steer}
STEER_PID=$RUNDIR/gt-be98-wifi-steer.pid
REPROBE_PID=$RUNDIR/gt-be98-wifi-reprobe.pid
STA_MON_PID=$RUNDIR/gt-be98-wifi-sta.pid
SCHED_PID=$RUNDIR/gt-be98-wifi-sched.pid
STATE=$RUNDIR/gt-be98-wifi
SVC_LOCK=$RUNDIR/gt-be98-wifi.lock
HAP_PID=$RUNDIR/hostapd-wifi.pid
HAP_LOG=${GT_BE98_HAP_LOG:-/var/log/hostapd.log}

depend() {
	need gt-be98-watchdog
	after gt-be98-drivers dhcpcd sshd
	use logger
}

wifi_loaded() { grep -q '^bca_pcie_ipc ' /proc/modules; }

# the web UI's settings (parsed, not sourced); WIFI_TRUNK defaults to rnr0
ap_override() {
	local f=/etc/conf.d/gt-be98-wifi-ap t
	[ -f "$f" ] || return 0
	HOSTAPD_CONFS=$(sed -n 's/^HOSTAPD_CONFS="\([^"$`\;]*\)"$/\1/p' "$f" | tail -n1)
	WIFI_BRIDGES=$(sed -n 's/^WIFI_BRIDGES="\([A-Za-z0-9 ]*\)"$/\1/p' "$f" | tail -n1)
	WIFI_VLANS=$(sed -n 's/^WIFI_VLANS="\([A-Za-z0-9: ]*\)"$/\1/p' "$f" | tail -n1)
	WIFI_ISOLATE=$(sed -n 's/^WIFI_ISOLATE="\([A-Za-z0-9 ]*\)"$/\1/p' "$f" | tail -n1)
	t=$(sed -n 's/^WIFI_TRUNK="\{0,1\}\([A-Za-z0-9]*\)"\{0,1\}$/\1/p' "$f" | tail -n1)
	WIFI_TRUNK=${t:-rnr0}
	# the network list (optional): a path, and the per-radio BSS limit
	WIFI_NETWORKS=$(sed -n 's/^WIFI_NETWORKS="\{0,1\}\([A-Za-z0-9/_.-]*\)"\{0,1\}$/\1/p' "$f" | tail -n1)
	t=$(sed -n 's/^WIFI_MAX_BSS="\{0,1\}\([0-9]*\)"\{0,1\}$/\1/p' "$f" | tail -n1)
	[ -z "$t" ] || WIFI_MAX_BSS=$t
}

valid_trunk() { case "$1" in rnr[0-3]) return 0 ;; *) return 1 ;; esac; }

# 1..4094, decimal, no leading zero
valid_vid() {
	case "$1" in ''|0*|*[!0-9]*) return 1 ;; esac
	[ ${#1} -le 4 ] && [ "$1" -ge 1 ] && [ "$1" -le 4094 ]
}

# the VLAN id of bridge $1 in the checked list $VLANS_OK ("br:vid ...")
br_vid() {
	local p
	for p in $VLANS_OK; do [ "${p%%:*}" = "$1" ] && { echo "${p#*:}"; return 0; }; done
	return 1
}

# check WIFI_VLANS into VLANS_OK: brwifiN:vid, one VLAN per bridge, a VLAN
# for one bridge only, the bridge listed in WIFI_BRIDGES
check_vlans() {
	local p b v seenb='' seenv='' rc=0
	VLANS_OK=
	for p in ${WIFI_VLANS:-}; do
		b=${p%%:*}; v=${p#*:}
		case "$p" in *:*:*|:*|*:) eerror "WIFI_VLANS '$p' refused (brwifiN:vid)"; rc=1; continue ;; esac
		[ "$b" != "$p" ] || { eerror "WIFI_VLANS '$p' refused (brwifiN:vid)"; rc=1; continue; }
		valid_bridge "$b" || { eerror "WIFI_VLANS '$p' refused: not a brwifiN bridge"; rc=1; continue; }
		valid_vid "$v" || { eerror "WIFI_VLANS '$p' refused: VLAN id must be 1-4094"; rc=1; continue; }
		case " $seenb " in *" $b "*) eerror "WIFI_VLANS '$p' refused: $b has a VLAN already"; rc=1; continue ;; esac
		case " $seenv " in *" $v "*) eerror "WIFI_VLANS '$p' refused: VLAN $v used by another bridge"; rc=1; continue ;; esac
		case " ${WIFI_BRIDGES:-} " in *" $b "*) ;; *) eerror "WIFI_VLANS '$p' refused: $b not in WIFI_BRIDGES"; rc=1; continue ;; esac
		seenb="$seenb $b"; seenv="$seenv $v"
		VLANS_OK="$VLANS_OK $p"
	done
	return $rc
}

vlan_owned() { grep -qx "$1" "$STATE/vlans" 2>/dev/null; }

# is $1 the 802.1Q sub-interface of $2 with id $3?
vlan_is() {
	awk -F'|' -v n="$1" -v d="$2" -v v="$3" '
		{ for (i = 1; i <= NF; i++) gsub(/^[ \t]+|[ \t]+$/, "", $i) }
		$1 == n && $2 == v && $3 == d { ok = 1 } END { exit !ok }' /proc/net/vlan/config 2>/dev/null
}

ipv6_off() { echo 1 > "/proc/sys/net/ipv6/conf/$1/disable_ipv6" 2>/dev/null; }

# <trunk>.<vid> into bridge $3: the trunk is only brought up if down
vlan_attach() {
	local t=$1 v=$2 b=$3 s=$1.$2 m
	if ! valid_trunk "$t" || ! valid_vid "$v"; then eerror "VLAN $s refused"; return 1; fi
	[ -e "/sys/class/net/$t" ] || { eerror "trunk $t not present: $b not bridged"; return 1; }
	if [ $(( $(cat "/sys/class/net/$t/flags") & 1 )) = 0 ]; then
		ip link set dev "$t" up || { eerror "trunk $t: up failed"; return 1; }
	fi
	if [ -e "/sys/class/net/$s" ]; then
		vlan_is "$s" "$t" "$v" || { eerror "$s exists and is not VLAN $v of $t"; return 1; }
	else
		ebegin "Creating VLAN $s for $b"
		ip link add link "$t" name "$s" type vlan id "$v"
		eend $? || return 1
		mkdir -p "$STATE"
		echo "$s" >> "$STATE/vlans"
	fi
	ipv6_off "$s"
	ip link set dev "$s" up || { eerror "$s: up failed"; return 1; }
	m=$(readlink "/sys/class/net/$s/master" 2>/dev/null); m=${m##*/}
	if [ "$m" != "$b" ]; then
		ip link set dev "$s" master "$b" || { eerror "$s: enslave into $b failed"; return 1; }
	fi
	bridge link set dev "$s" isolated off 2>/dev/null
	return 0
}

# owned sub-interfaces not in the list $1
vlan_prune() {
	local s
	# shellcheck disable=SC2013 # one validated name per line
	for s in $(cat "$STATE/vlans" 2>/dev/null); do
		case " $1 " in *" $s "*) continue ;; esac
		case "$s" in rnr[0-3].[0-9]*) ;; *) continue ;; esac
		if [ -e "/sys/class/net/$s" ]; then
			ebegin "Deleting VLAN $s"
			ip link del dev "$s"
			eend $? || continue
		fi
		grep -vx "$s" "$STATE/vlans" > "$STATE/vlans.new" 2>/dev/null
		mv -f "$STATE/vlans.new" "$STATE/vlans"
	done
}

# isolate the Wi-Fi ports of the WIFI_ISOLATE bridges (not the trunk VLAN)
isolate_ports() {
	local b p f
	for b in $1; do
		case " ${WIFI_ISOLATE:-} " in *" $b "*) f=on ;; *) f=off ;; esac
		for p in "/sys/class/net/$b/brif"/*; do
			[ -e "$p" ] || continue
			p=${p##*/}
			case "$p" in bcawl*) bridge link set dev "$p" isolated $f ;; esac
		done
	done
}

# brwifi<digits> only
valid_bridge() {
	case "$1" in brwifi[0-9]*) ;; *) return 1 ;; esac
	case "${1#brwifi}" in *[!0-9]*) return 1 ;; esac
}

br_owned() { grep -qx "$1" "$STATE/bridges" 2>/dev/null; }

# create (or adopt an existing) bridge $1: no STP, forward_delay 0, up
br_create() {
	local b=$1
	if [ -e "/sys/class/net/$b" ]; then
		[ -d "/sys/class/net/$b/bridge" ] || { eerror "$b exists and is not a bridge"; return 1; }
	else
		ebegin "Creating bridge $b"
		ip link add name "$b" type bridge stp_state 0 forward_delay 0
		eend $? || return 1
	fi
	ipv6_off "$b"
	if ! { ip link set dev "$b" type bridge stp_state 0 forward_delay 0 &&
		ip link set dev "$b" up; }; then
		eerror "$b: setup failed"; return 1
	fi
	mkdir -p "$STATE"
	br_owned "$b" || echo "$b" >> "$STATE/bridges"
}

# delete bridge $1 if this service owns it and it has no foreign port
br_remove() {
	local b=$1 p
	br_owned "$b" || return 0
	if [ -e "/sys/class/net/$b" ]; then
		for p in "/sys/class/net/$b/brif"/*; do
			[ -e "$p" ] || continue
			p=${p##*/}
			case "$p" in
			bcawl*) ;;
			*) vlan_owned "$p" && continue
			   ewarn "$b has port $p (not Wi-Fi): left in place"; return 1 ;;
			esac
		done
		ebegin "Deleting bridge $b"
		ip link del dev "$b"
		eend $? || return 1
	fi
	grep -vx "$b" "$STATE/bridges" > "$STATE/bridges.new" 2>/dev/null
	mv -f "$STATE/bridges.new" "$STATE/bridges"
}

# owned bridges not in the list $1
br_prune() {
	local b
	# shellcheck disable=SC2013 # one validated name per line
	for b in $(cat "$STATE/bridges" 2>/dev/null); do
		case " $1 " in *" $b "*) ;; *) br_remove "$b" ;; esac
	done
}

# a config may only name bcawl* netdevs and listed bridges
conf_check() {
	local c=$1 brs=$2 v
	# shellcheck disable=SC2013 # netdev names: no whitespace
	for v in $(sed -nE 's/^(interface|bss)=//p' "$c"); do
		case "$v" in
		bcawl[0-9]*) ;;
		*) eerror "$c: $v is not a Wi-Fi netdev (bcawl*)"; return 1 ;;
		esac
	done
	# shellcheck disable=SC2013 # bridge names: no whitespace
	for v in $(sed -n 's/^bridge=//p' "$c"); do
		case " $brs " in
		*" $v "*) ;;
		*) eerror "$c: bridge=$v is not in WIFI_BRIDGES"; return 1 ;;
		esac
	done
}

# interface= of a config (the first one: bss= sections follow it)
conf_iface() { sed -n 's/^interface=\([A-Za-z0-9_.-]*\)[[:space:]]*$/\1/p' "$1" | head -n1; }

conf_sum() {
	{ echo "$1"; cat "$1"; } | sha256sum | cut -d' ' -f1
}

# ---- the hostapd process and its global control socket ----

hap_global() { echo "${HOSTAPD_GLOBAL:-$RUNDIR/hostapd-global}"; }

# one command on the global control socket; its reply on stdout
hap_cmd() {
	local g
	g=$(hap_global)
	hostapd_cli -p "${g%/*}" -i "${g##*/}" raw "$@" 2>&1
}

# a global command that must answer OK
hap_ok() {
	local r
	r=$(hap_cmd "$@")
	[ "$(printf '%s\n' "$r" | tail -n1)" = OK ] && return 0
	eerror "hostapd: $1 ${2:-}: ${r:-no reply}"
	return 1
}

hap_running() {
	local p
	p=$(cat "$HAP_PID" 2>/dev/null) || return 1
	[ -n "$p" ] && kill -0 "$p" 2>/dev/null
}

# what the process was started with (a change restarts it)
hap_args_sum() { echo "$(hap_global) ${HOSTAPD_ARGS:-}" | sha256sum | cut -d' ' -f1; }

hap_daemon_stop() {
	if hap_running; then
		ebegin "Stopping hostapd"
		start-stop-daemon --stop --exec /usr/sbin/hostapd --pidfile "$HAP_PID" \
			--retry TERM/5/KILL/2
		eend $?
	fi
	rm -f "$HAP_PID" "$STATE/hostapd.args" "$(hap_global)"
	rm -rf "$STATE/applied"
}

# hostapd with only its global control socket; the radios are added to it
hap_daemon_start() {
	local g n=0
	g=$(hap_global)
	mkdir -p "$STATE/applied" "${g%/*}" "${HOSTAPD_CTRL:-$RUNDIR/hostapd}"
	rm -f "$g"
	ebegin "Starting hostapd (global control $g)"
	# shellcheck disable=SC2086 # HOSTAPD_ARGS: several options
	start-stop-daemon --start --exec /usr/sbin/hostapd --pidfile "$HAP_PID" \
		-- -B -P "$HAP_PID" -t -f "$HAP_LOG" -g "$g" ${HOSTAPD_ARGS:-}
	eend $? || return 1
	while [ "$(hap_cmd PING)" != PONG ] && [ $n -lt 5 ]; do
		sleep 1; n=$((n + 1))
	done
	[ "$(hap_cmd PING)" = PONG ] || { eerror "hostapd: no answer on $g"; return 1; }
	hap_args_sum > "$STATE/hostapd.args"
}

# the wiphy of a radio netdev (the key of ADD bss_config=), waiting for it
radio_phy() {
	local d=$1 n=0
	while [ ! -e "$SYSNET/$d" ] && [ $n -lt "${IFACE_WAIT:-20}" ]; do
		sleep 1; n=$((n + 1))
	done
	cat "$SYSNET/$d/phy80211/name" 2>/dev/null && return 0
	eerror "$d: not present after ${IFACE_WAIT:-20}s (or not a wiphy netdev)"
	return 1
}

# ---- radio identity: the netdev this service started (driver re-probe) ----

# the ifindex of radio netdev $1 ("" = absent)
radio_id() { cat "$SYSNET/$1/ifindex" 2>/dev/null; }

# radio $1 was started on its current netdev
id_record() {
	local i
	i=$(radio_id "$1") || return 0
	[ -n "$i" ] || return 0
	mkdir -p "$STATE/ids" && echo "$i" > "$STATE/ids/$1"
}

# the radios the driver re-probed since this service started them (netdev
# present under another ifindex than the one recorded) -> REPROBED, taken
# once at the start of an apply: the station and the hostapd unit of one
# radio must both see it (the station's restart records the new ifindex)
reprobed_scan() {
	local f d r i
	REPROBED=' '
	for f in "$STATE"/ids/*; do
		[ -f "$f" ] || continue
		d=${f##*/}; r=$(cat "$f" 2>/dev/null); i=$(radio_id "$d")
		[ -n "$r" ] && [ -n "$i" ] && [ "$i" != "$r" ] && REPROBED="$REPROBED$d "
	done
}

reprobed() { in_list "${REPROBED:- }" "$1"; }

# forget the radios not in the list $1 (" bcawl0 bcawl3 ")
ids_prune() {
	local f
	for f in "$STATE"/ids/*; do
		[ -f "$f" ] || continue
		in_list " $1 " "${f##*/}" || rm -f "$f"
	done
	# failure records of radios no longer planned
	for f in "$STATE"/failed/*; do
		[ -f "$f" ] || continue
		in_list " $1 " "${f##*/}" || rm -f "$f"
	done
}

# ---- units: one per radio ----
# $STATE/want/<dev> and $STATE/applied/<dev>:
#   conf <path>            the radio config (ADD of the whole radio)
#   radio <key>            radio-wide lines + anchor BSS (or the whole
#                          ready-made config): a change restarts the radio
#   bss <ifname> <sum> <path>   a further BSS, added/removed alone
#   first <ifname>         the config's interface= (hostapd's name of the
#                          radio: REMOVE/INTERFACES); the radio netdev, or a
#                          virtual interface on a station radio

unit_line() { sed -n "s/^$2 //p" "$1" 2>/dev/null; }

# the first interface of unit file $1 (a unit without one: radio netdev $2)
unit_first() {
	local f
	f=$(unit_line "$1" first)
	echo "${f:-$2}"
}

# remove radio $1 from hostapd (all its BSSes)
unit_remove() {
	local d=$1 f
	if [ -f "$STATE/applied/$d" ]; then
		f=$(unit_first "$STATE/applied/$d" "$d")
		ebegin "hostapd: removing radio $d ($f)"
		hap_ok REMOVE "$f"
		eend $?
	fi
	rm -f "$STATE/applied/$d"
}

# is $2 in the list $1 (" a b c ")?
in_list() { case "$1" in *" $2 "*) return 0 ;; esac; return 1; }

# hostapd's state of BSS $1 (ENABLED, COUNTRY_UPDATE, DISABLED, ...)
bss_state() {
	hostapd_cli -p "${HOSTAPD_CTRL:-$RUNDIR/hostapd}" -i "$1" status 2>/dev/null |
		sed -n 's/^state=//p' | head -n1
}

# the BSS netdevs hostapd runs, as " a b c "
hap_live() { echo " $(hap_cmd INTERFACES | tr '\n' ' ') "; }

# ---- failed radios: the bounded supervised restart (header) ----

now_s() { echo "${GT_BE98_NOW:-$(date +%s)}"; }

# a syslog line (GT_BE98_LOG: the offline test harness only)
slog() {
	if [ -n "${GT_BE98_LOG:-}" ]; then echo "$*" >> "$GT_BE98_LOG"
	elif command -v logger > /dev/null 2>&1; then logger -t gt-be98-wifi -- "$*"; fi
}

# field $2 of the failure record of radio $1
fail_get() { sed -n "s/^$2=//p" "$STATE/failed/$1" 2>/dev/null | head -n1; }

# hostapd's last words about interface $1, one line (the failure's reason):
# the error lines of the 8 log lines before its last real failure
# ("$1: interface state X->DISABLED", X not DISABLED: a REMOVE of a radio
# already down logs DISABLED->DISABLED) and that line. hostapd names no
# interface in many cause lines ("DFS start_dfs_cac() failed, -1",
# "Interface initialization failed"); lines naming ANOTHER interface are
# left out. No such failure in the log: its last error lines naming $1
hap_reason() {
	local r
	r=$(awk -v i="$1" '
		{ l[NR] = $0 }
		index($0, i ": interface state ") && /->DISABLED/ && !/DISABLED->DISABLED/ { last = NR }
		END {
			if (!last) exit
			out = ""
			for (k = (last > 8 ? last - 8 : 1); k <= last; k++) {
				s = l[k]
				if (s ~ /bcawl[0-9]/ && !index(s, i)) continue
				if (k < last && s !~ /initialization failed|Could not|[Ff]ailed|refused|not supported|Invalid|DFS-/) continue
				sub(/^[0-9.]+: /, "", s)
				out = out (out == "" ? "" : "; ") s
			}
			print out
		}' "$HAP_LOG" 2>/dev/null)
	[ -n "$r" ] || r=$(grep -a "$1" "$HAP_LOG" 2>/dev/null |
		grep -aE 'AP-DISABLED|initialization failed|Could not|[Ff]ailed|refused|DFS-|not supported|Invalid' |
		tail -n 2 | sed 's/^[0-9.]*: //' | tr '\n' ' ')
	printf '%s' "$r" | tr -d '\000-\010\013-\037' | tr '\n' ' ' | cut -c1-200
}

# the delay before the retry that follows try $1 (0: the first retry)
fail_backoff() { case "$1" in 0) echo 30 ;; 1) echo 120 ;; *) echo 600 ;; esac; }

# write the failure record of radio $1: key state reason tries next given_up since
fail_write() {
	mkdir -p "$STATE/failed"
	{
		echo "dev=$1"; echo "key=$2"; echo "state=$3"; echo "reason=$4"
		echo "tries=$5"; echo "next=$6"; echo "given_up=$7"; echo "since=$8"
	} > "$STATE/failed/$1.new" && mv -f "$STATE/failed/$1.new" "$STATE/failed/$1"
}

# radio $1 failed (state $2: DISABLED or ADD-FAILED, reason $3). Records it
# and says so; returns 0 when a retry is due NOW (the caller restarts it)
fail_note() {
	local d=$1 st=$2 why=$3 key t tries next gu since
	key=$(unit_line "$STATE/want/$d" radio); t=$(now_s)
	if [ ! -f "$STATE/failed/$d" ] || [ "$(fail_get "$d" key)" != "$key" ]; then
		next=$((t + $(fail_backoff 0)))
		fail_write "$d" "$key" "$st" "$why" 0 "$next" 0 "$t"
		slog "radio $d FAILED to start (hostapd: $st): ${why:-no reason in hostapd.log}; retry 1/3 in $(fail_backoff 0) s"
		eerror "radio $d failed to start ($st): ${why:-see $HAP_LOG}; retry 1/3 in $(fail_backoff 0) s"
		return 1
	fi
	tries=$(fail_get "$d" tries); next=$(fail_get "$d" next); gu=$(fail_get "$d" given_up); since=$(fail_get "$d" since)
	tries=${tries:-0}
	if [ "$gu" = 1 ]; then
		eerror "radio $d failed to start ($st), given up after 3 retries: $(fail_get "$d" reason)"
		return 1
	fi
	if [ -z "$next" ]; then
		# a retry ran and failed again
		if [ "$tries" -ge 3 ]; then
			fail_write "$d" "$key" "$st" "$why" "$tries" "" 1 "$since"
			slog "radio $d FAILED to start (hostapd: $st) after 3 retries: ${why:-no reason in hostapd.log}; left down"
			eerror "radio $d failed to start ($st) after 3 retries: ${why:-see $HAP_LOG}; left down"
			return 1
		fi
		next=$((t + $(fail_backoff "$tries")))
		fail_write "$d" "$key" "$st" "$why" "$tries" "$next" 0 "$since"
		slog "radio $d FAILED again (hostapd: $st, try $tries/3): ${why:-no reason in hostapd.log}; retry $((tries + 1))/3 in $(fail_backoff "$tries") s"
		eerror "radio $d failed again ($st, try $tries/3); retry $((tries + 1))/3 in $(fail_backoff "$tries") s"
		return 1
	fi
	if [ "$t" -lt "$next" ]; then
		eerror "radio $d failed to start ($st): retry $((tries + 1))/3 in $((next - t)) s"
		return 1
	fi
	tries=$((tries + 1))
	fail_write "$d" "$key" "$st" "$(fail_get "$d" reason)" "$tries" "" 0 "$since"
	slog "radio $d: retry $tries/3 (restarting it alone)"
	ewarn "radio $d: retry $tries/3 after a failed start"
	return 0
}

# radio $1 is ENABLED: its failure record (if any) goes
fail_clear() {
	[ -f "$STATE/failed/$1" ] || return 0
	slog "radio $1 recovered (ENABLED) after $(fail_get "$1" tries) retr$( [ "$(fail_get "$1" tries)" = 1 ] && echo y || echo ies)"
	rm -f "$STATE/failed/$1"
}

# (re)start radio $1 with all its BSSes
unit_restart() {
	local d=$1 w="$STATE/want/$1" c phy f o
	c=$(unit_line "$w" conf)
	f=$(unit_first "$w" "$d")
	o=$(unit_first "$STATE/applied/$d" "$d")
	if [ -f "$STATE/applied/$d" ] || in_list "$(hap_live)" "$o"; then
		ebegin "hostapd: removing radio $d ($o)"
		hap_ok REMOVE "$o"
		eend $?
		rm -f "$STATE/applied/$d"
	fi
	phy=$(radio_phy "$d") || return 1
	# a station radio: hostapd starts its first AP on a virtual interface
	# that must exist (gone with an earlier REMOVE when hostapd had made it)
	if [ "$f" != "$d" ]; then vif_add "$d" "$f" || return 1; fi
	ebegin "hostapd: starting radio $d ($c)"
	if ! hap_ok ADD "bss_config=$phy:$c"; then
		eend 1
		# a setup that failed inside the ADD: a failure of this radio too
		fail_note "$d" ADD-FAILED "$(hap_reason "$f")"
		return 1
	fi
	eend 0
	cp "$w" "$STATE/applied/$d"
	id_record "$d"
}

# bring radio $1 in line with its unit, per BSS where hostapd allows it
unit_apply() {
	local d=$1 w="$STATE/want/$1" a="$STATE/applied/$1" live i s p phy ok=1
	# the driver re-probed the radio: hostapd runs it on a netdev that no
	# longer exists, whatever its state says; the whole radio again
	if [ -f "$a" ] && reprobed "$d"; then
		ewarn "radio $d was re-probed by the Wi-Fi driver (a new netdev, ifindex $(radio_id "$d")): restarting it"
		unit_restart "$d"
		return
	fi
	if [ ! -f "$a" ] || [ "$(unit_line "$a" conf)" != "$(unit_line "$w" conf)" ] ||
	   [ "$(unit_line "$a" radio)" != "$(unit_line "$w" radio)" ]; then
		# a failed start of this same config: restarted only when its retry
		# is due (bounded, counted by fail_note); a new config starts over
		if [ ! -f "$a" ] && [ -f "$STATE/failed/$d" ] && [ "$(fail_get "$d" key)" = "$(unit_line "$w" radio)" ]; then
			if fail_note "$d" "$(fail_get "$d" state)" "$(fail_get "$d" reason)"; then unit_restart "$d"; fi
			return 1
		fi
		unit_restart "$d"
		return
	fi
	# what hostapd really runs: a BSS it lost is added again
	live=$(hap_live)
	in_list "$live" "$(unit_first "$a" "$d")" || { ewarn "hostapd lost radio $d"; unit_restart "$d"; return; }
	# a radio whose setup failed after the ADD: DISABLED is a FAILURE, never
	# "unchanged"; starting states are left alone; ENABLED clears a record
	s=$(bss_state "$(unit_first "$a" "$d")")
	case "$s" in
	DISABLED)
		if fail_note "$d" DISABLED "$(hap_reason "$(unit_first "$a" "$d")")"; then unit_restart "$d"; fi
		return 1 ;;
	ENABLED) fail_clear "$d" ;;
	esac
	if cmp -s "$a" "$w"; then
		while read -r i s p; do
			[ -z "$i" ] || in_list "$live" "$i" || ok=0
		done <<-EOF
		$(unit_line "$a" bss)
		EOF
		if [ $ok = 1 ]; then einfo "hostapd on $d: unchanged"; return 0; fi
		ok=1
	fi
	phy=$(cat "$SYSNET/$d/phy80211/name" 2>/dev/null) || { unit_restart "$d"; return; }
	# removed or changed BSSes first (frees their netdev name and BSSID)
	while read -r i s p; do
		[ -n "$i" ] || continue
		in_list "$live" "$i" || continue
		grep -qx "bss $i $s $p" "$w" && continue
		ebegin "hostapd: removing BSS $i"
		hap_ok REMOVE "$i"
		eend $? || ok=0
	done <<-EOF
	$(unit_line "$a" bss)
	EOF
	live=$(hap_live)
	while read -r i s p; do
		[ -n "$i" ] || continue
		in_list "$live" "$i" && continue
		ebegin "hostapd: adding BSS $i ($p)"
		hap_ok ADD "bss_config=$phy:$p"
		eend $? || ok=0
	done <<-EOF
	$(unit_line "$w" bss)
	EOF
	if [ $ok = 1 ]; then
		cp "$w" "$a"
		return 0
	fi
	ewarn "hostapd on $d: per-BSS change failed, restarting the radio"
	unit_restart "$d"
}

# the radios' own addresses, "band=mac ...": kept once all radios were seen
# since the driver loaded (hostapd may set a radio netdev's address to its
# first BSS's bssid=). At start, waits up to IFACE_WAIT s for the radios.
radio_macs() {
	local p d a m='' miss n=0
	[ -s "$STATE/radio-macs" ] && { cat "$STATE/radio-macs"; return 0; }
	while :; do
		m='' miss=0
		for p in ${WIFI_RADIO_DEVS:-2g=bcawl3 5gl=bcawl0 5gh=bcawl1 6g=bcawl2}; do
			d=${p#*=}
			if a=$(cat "$SYSNET/$d/address" 2>/dev/null); then m="$m ${p%%=*}=$a"; else miss=1; fi
		done
		[ $miss = 0 ] || [ "${WAIT_RADIOS:-0}" = 0 ] || [ $n -ge "${IFACE_WAIT:-20}" ] && break
		sleep 1; n=$((n + 1))
	done
	if [ $miss = 0 ]; then mkdir -p "$STATE"; echo "$m" > "$STATE/radio-macs"; fi
	echo "$m"
}

# the BSSes per radio for the network list: WIFI_MAX_BSS when set, else the
# AP count of the driver's interface combination (iw phy <phy> info:
# "#{ AP } <= N"), the smallest over the radios present; 4 when none says;
# never above 8 (the BSSID rule's indices). Sets MAX_BSS, written to
# $STATE/max-bss (not a $(...): a warning must not become the value).
wifi_max_bss() {
	local p d phy n m=''
	for p in ${WIFI_RADIO_DEVS:-2g=bcawl3 5gl=bcawl0 5gh=bcawl1 6g=bcawl2}; do
		d=${p#*=}
		phy=$(cat "$SYSNET/$d/phy80211/name" 2>/dev/null) || continue
		n=$(iw phy "$phy" info 2>/dev/null | sed -n 's/.*#{ *AP *} <= \([0-9][0-9]*\).*/\1/p' | head -n1)
		[ -n "$n" ] || continue
		[ -z "$m" ] || [ "$n" -lt "$m" ] && m=$n
	done
	n=${WIFI_MAX_BSS:-}
	case "$n" in
	'') n=${m:-4} ;;
	*[!0-9]*|0*) ewarn "WIFI_MAX_BSS=$n refused: ${m:-4} (1..8)"; n=${m:-4} ;;
	*) if [ -n "$m" ] && [ "$n" -gt "$m" ]; then
		ewarn "WIFI_MAX_BSS=$n: the driver advertises $m AP interfaces per radio: $m"; n=$m
	fi ;;
	esac
	[ "$n" -gt 8 ] && n=8
	MAX_BSS=$n
	mkdir -p "$STATE" && echo "$n" > "$STATE/max-bss"
}

# the radios ("<band> ...") whose driver advertises AP beacon protection
# (nl80211 NL80211_EXT_FEATURE_BEACON_PROTECTION, open-wifi SD-BCNPROT:
# `iw phy <phy> info` lists "[ BEACON_PROTECTION ]", never the _CLIENT one):
# the generator's -B, its SAE/OWE BSSes there get beacon_prot=1
bcnprot_bands() {
	local p d phy out=''
	for p in ${WIFI_RADIO_DEVS:-2g=bcawl3 5gl=bcawl0 5gh=bcawl1 6g=bcawl2}; do
		d=${p#*=}
		phy=$(cat "$SYSNET/$d/phy80211/name" 2>/dev/null) || continue
		iw phy "$phy" info 2>/dev/null | grep -q '\[ BEACON_PROTECTION \]' && out="$out ${p%%=*}"
	done
	echo "${out# }"
}

# the highest 6 GHz channel the 6 GHz radio's wiphy allows ("" = unread):
# the last channel of 5955-7115 MHz `iw phy <phy> info` lists without
# "disabled" (93 in DE/FR: 5945-6425 MHz). The generator's -6: a 320 MHz block
# must end inside it
six_top() {
	local p d phy
	for p in ${WIFI_RADIO_DEVS:-2g=bcawl3 5gl=bcawl0 5gh=bcawl1 6g=bcawl2}; do
		[ "${p%%=*}" = 6g ] && d=${p#*=}
	done
	[ -n "${d:-}" ] || return 0
	phy=$(cat "$SYSNET/$d/phy80211/name" 2>/dev/null) || return 0
	iw phy "$phy" info 2>/dev/null | awk '
		/ MHz \[[0-9]+\]/ && !/disabled/ {
			f = $2 + 0; c = $4; gsub(/[^0-9]/, "", c)
			if (f >= 5955 && f <= 7115 && c + 0 > m) m = c + 0
		}
		END { if (m) print m }'
}

# the network list -> $STATE/gen (configs + plan) and $STATE/slots; the
# bridges/VLANs/isolation of its networks are added to WIFI_*
# $1 = "again": the same list rendered once more with the stations'
# frequencies (-U) that changed since; the bridges/VLANs are not re-read
gen_networks() {
	local n=$WIFI_NETWORKS t a b c d cc='' net_br='' net_vl='' net_iso='' macs now='' up bp st
	rm -rf "$STATE/gen.new"
	[ -n "$n" ] || { rm -rf "$STATE/gen"; return 0; }
	[ -f "$n" ] || { eerror "WIFI_NETWORKS $n: missing"; return 1; }
	[ "${REGDB_OK:-0}" = 1 ] && cc=-c
	# the schedules are read at the current local time, if it can be trusted
	if grep -q '^[[:space:]]*schedule=[^[:space:]]' "$n"; then
		now=$("$WIFI_SCHED" now 2>/dev/null) ||
			ewarn "clock not synchronised (NTP): the Wi-Fi schedules are not applied, every scheduled network and radio runs"
	fi
	macs=$(radio_macs)
	wifi_max_bss
	up=$(sta_freqs)
	bp=$(bcnprot_bands)
	st=$(six_top)
	# shellcheck disable=SC2086 # $cc: an option or nothing
	"$WIFI_GEN" -n "$n" -o "$STATE/gen.new" -s "${WIFI_SLOTS:-/etc/hostapd/wifi-slots}" -m "$macs" \
		-C "$MAX_BSS" -x "${HOSTAPD_CTRL:-$RUNDIR/hostapd}" -R "${WIFI_RNR:-1}" \
		-K "${WIFI_ANCHOR_KEEP_BSSID:-1}" ${WIFI_RADIO_DEVS:+-d "$WIFI_RADIO_DEVS"} \
		-X "${WPA_CTRL:-$RUNDIR/wpa_supplicant}" ${up:+-U "$up"} ${bp:+-B "$bp"} ${st:+-6 "$st"} ${now:+-T "$now"} $cc -S ||
		{ eerror "$n refused: nothing changed"; rm -rf "$STATE/gen.new"; return 1; }
	# -S: a network that fails its own checks is left out (the generator's
	# warning says why); the other networks and the radios run
	t=$(awk '$1 == "skipped" { printf "%s%s", s, $2; s = " " }' "$STATE/gen.new/plan")
	[ -z "$t" ] || ewarn "Wi-Fi network(s) $t skipped (invalid, see the warnings above): not broadcast, the others run"
	rm -rf "$STATE/gen"
	mv "$STATE/gen.new" "$STATE/gen"
	# the generator wrote the configs under gen.new: point the plan at gen
	sed -i "s#$STATE/gen.new/#$STATE/gen/#g" "$STATE/gen/plan"
	[ "${1:-}" = again ] && return 0
	while read -r t a b c d; do
		case $t in
		net)	net_br="$net_br $b"; net_vl="$net_vl $b:$c" ;;
		routed) WIFI_ROUTED="${WIFI_ROUTED:-} $b=$c" ;;
		# repeated <id> <bridge> <isolate>: the isolate flag is the 4th field
		repeated) WIFI_REPEATED="${WIFI_REPEATED:-} $b"; [ "$c" = 1 ] && net_iso="$net_iso $b"; continue ;;
		*)	continue ;;
		esac
		[ "$d" = 1 ] && net_iso="$net_iso $b"
	done < "$STATE/gen/plan"
	WIFI_BRIDGES="${WIFI_BRIDGES:-}$net_br"
	WIFI_VLANS="${WIFI_VLANS:-}$net_vl"
	WIFI_ISOLATE="${WIFI_ISOLATE:-}$net_iso"
}

# the arguments, one space apart
words() { echo "$*"; }

# ---- monitor radios (plan: monitor <band> <dev> <MHz> <width> <centre MHz>) ----

mon_owned() { grep -qx "$1" "$STATE/monitors" 2>/dev/null; }

# the monitors the plan asks for, "<dev> <MHz> <width> <centre>" per line
mon_want() { awk '$1 == "monitor" { print $3, $4, $5, $6 }' "$STATE/gen/plan" 2>/dev/null; }

# delete monitor $1 (one this service created)
mon_del() {
	local m=$1
	if [ -e "$SYSNET/$m" ]; then
		ebegin "Deleting monitor $m"
		ip link set dev "$m" down 2>/dev/null
		iw dev "$m" del
		eend $? || return 1
	fi
	grep -vx "$m" "$STATE/monitors" > "$STATE/monitors.new" 2>/dev/null
	mv -f "$STATE/monitors.new" "$STATE/monitors"
}

# the owned monitors not in the list $1 (" bcawl0mon ... ")
mon_prune() {
	local m
	# shellcheck disable=SC2013 # one validated name per line
	for m in $(cat "$STATE/monitors" 2>/dev/null); do
		case "$m" in bcawl[0-9]*mon) ;; *) continue ;; esac
		in_list " $1 " "$m" || mon_del "$m"
	done
}

# monitor <dev>mon on radio $1 at $2 MHz, width $3 MHz, centre $4 MHz
mon_add() {
	local d=$1 f=$2 w=$3 c=$4 m="$1mon" phy
	case "$d$f$w$c" in *[!a-z0-9]*) eerror "monitor $d: refused"; return 1 ;; esac
	phy=$(radio_phy "$d") || return 1
	# the driver refuses a monitor while the radio's primary netdev is up
	ip link set dev "$d" down 2>/dev/null
	if [ ! -e "$SYSNET/$m" ]; then
		ebegin "Creating monitor $m on $d"
		iw phy "$phy" interface add "$m" type monitor
		eend $? || return 1
		mkdir -p "$STATE"
		mon_owned "$m" || echo "$m" >> "$STATE/monitors"
	fi
	ip link set dev "$m" up || { eerror "$m: up failed"; return 1; }
	if [ "$w" = 20 ]; then iw dev "$m" set freq "$f" HT20
	else iw dev "$m" set freq "$f" "$w" "$c"; fi || { eerror "$m: set freq $f/$w failed"; return 1; }
	einfo "monitor $m: $f MHz, $w MHz wide"
	id_record "$d"
}

# every monitor of the plan (after hostapd released those radios)
mon_apply() {
	local d f w c rc=0
	while read -r d f w c; do
		[ -n "$d" ] || continue
		mon_add "$d" "$f" "$w" "$c" || rc=1
	done <<-EOF
	$(mon_want)
	EOF
	return $rc
}

# the radios whose LED is off (led=0 in the list), for gt-be98-leds
write_leds() {
	local off
	mkdir -p "$STATE"
	off=$(awk '$1 == "led" && $4 == "0" { printf "%s%s", s, $3; s = " " }' "$STATE/gen/plan" 2>/dev/null)
	{
		echo "# written by gt-be98-wifi: the radios whose LED is off (led=0)"
		echo "WIFI_LEDS_OFF=\"$off\""
	} > "$STATE/leds.new" && mv -f "$STATE/leds.new" "$STATE/leds"
}

leds_apply() { [ -x /usr/sbin/gt-be98-leds ] && /usr/sbin/gt-be98-leds apply > /dev/null 2>&1; }

# the effective L2 settings, for gt-be98-netguard
write_l2() {
	local vl is
	# shellcheck disable=SC2086 # word lists, normalised by words
	vl=$(words ${WIFI_VLANS:-})
	# shellcheck disable=SC2086 # word lists, normalised by words
	is=$(words ${WIFI_ISOLATE:-})
	mkdir -p "$STATE"
	{
		echo "# written by gt-be98-wifi: the effective Wi-Fi network settings"
		echo "WIFI_TRUNK=\"${WIFI_TRUNK:-rnr0}\""
		echo "WIFI_VLANS=\"$vl\""
		echo "WIFI_ISOLATE=\"$is\""
	} > "$STATE/l2.conf.new" && mv -f "$STATE/l2.conf.new" "$STATE/l2.conf"
}

# the per-config hostapd instances of the previous versions of this service
stop_legacy() {
	local f
	for f in "$RUNDIR"/hostapd.pid "$RUNDIR"/hostapd-*.pid; do
		[ -f "$f" ] || continue
		[ "$f" = "$HAP_PID" ] && continue
		ebegin "Stopping hostapd (${f##*/})"
		start-stop-daemon --stop --exec /usr/sbin/hostapd --pidfile "$f" \
			--retry TERM/5/KILL/2
		eend $?
		rm -f "$f"
	done
	rm -f "$STATE"/bcawl*.conf "$STATE"/bcawl*.sum
}

# ---- the station (uplink) of a radio (plan: station <band> <dev> <conf> <sum> <first>) ----

sta_plan() { awk '$1 == "station" { print $2, $3, $4, $5, $6 }' "$STATE/gen/plan" 2>/dev/null; }

# the frequencies of the associated stations, "band=MHz ..." (generator -U)
sta_freqs() {
	local b d f out=''
	while read -r b d _; do
		[ -n "$d" ] || continue
		f=$("$WIFI_STA" freq "$d" 2>/dev/null) && [ -n "$f" ] && out="$out $b=$f"
	done <<-EOF
	$(sta_plan)
	EOF
	words $out
}

vif_owned() { grep -qx "$1" "$STATE/vifs" 2>/dev/null; }

# virtual AP interface $2 on radio $1 (created, recorded; an existing one is kept)
vif_add() {
	local d=$1 v=$2
	case "$v" in "$d"-[1-9]) ;; *) eerror "virtual interface $v refused"; return 1 ;; esac
	[ -e "$SYSNET/$v" ] && return 0
	ebegin "Creating AP interface $v on station radio $d"
	iw dev "$d" interface add "$v" type __ap
	eend $? || return 1
	mkdir -p "$STATE"
	vif_owned "$v" || echo "$v" >> "$STATE/vifs"
}

# delete the owned virtual interfaces that are neither in the list $1 nor
# run by hostapd
vif_prune() {
	local v live
	live=$(hap_live 2>/dev/null)
	# shellcheck disable=SC2013 # one validated name per line
	for v in $(cat "$STATE/vifs" 2>/dev/null); do
		case "$v" in bcawl[0-9]*-[1-9]) ;; *) continue ;; esac
		in_list " $1 " "$v" && continue
		in_list "$live" "$v" && continue
		if [ -e "$SYSNET/$v" ]; then
			ebegin "Deleting AP interface $v"
			iw dev "$v" del
			eend $? || continue
		fi
		grep -vx "$v" "$STATE/vifs" > "$STATE/vifs.new" 2>/dev/null
		mv -f "$STATE/vifs.new" "$STATE/vifs"
	done
}

# Stations before APs (see the header): stations no longer planned go
# first (their radio's hostapd leaves the virtual interfaces before the
# radio netdev is free again), then each planned station: the radio netdev
# released by hostapd, the first AP's virtual interface, the station.
# Returns 2 when a station's frequency changed (the plan must be rendered
# again with -U before the APs start).
sta_prepare() {
	local b d c s f a fr0 fr1 new keep='' firsts='' rc=0
	# shellcheck disable=SC2013 # one validated name per line
	for d in $(cat "$STATE/stations" 2>/dev/null); do
		sta_plan | awk -v d="$d" '$2 == d { f = 1 } END { exit !f }' && continue
		unit_remove "$d"
		"$WIFI_STA" down "$d" || rc=1
	done
	while read -r b d c s f; do
		[ -n "$d" ] || continue
		keep="$keep $d"
		[ "$f" = - ] || firsts="$firsts $f"
		# an AP on the radio netdev itself leaves it to the station
		if [ -f "$STATE/applied/$d" ] && [ "$(unit_first "$STATE/applied/$d" "$d")" = "$d" ]; then
			unit_remove "$d"
		fi
		fr0=$("$WIFI_STA" freq "$d" 2>/dev/null)
		new=
		# a re-probed radio: wpa_supplicant is bound to the old netdev
		if reprobed "$d"; then
			ewarn "station $d: the radio was re-probed by the Wi-Fi driver: restarting the station"
			new=restart
		fi
		if [ "$f" != - ] && [ ! -e "$SYSNET/$f" ]; then
			vif_add "$d" "$f" || { rc=1; continue; }
			new=restart	# an AP interface appeared under a running station
		fi
		if "$WIFI_STA" up "$d" "$c" "$s" $new; then id_record "$d"; else rc=1; fi
		fr1=$("$WIFI_STA" freq "$d" 2>/dev/null)
		[ "$fr0" = "$fr1" ] || [ $rc != 0 ] || rc=2
	done <<-EOF
	$(sta_plan)
	EOF
	mkdir -p "$STATE"
	words $keep | tr ' ' '\n' | grep . > "$STATE/stations.new"
	mv -f "$STATE/stations.new" "$STATE/stations"
	STA_FIRSTS=$firsts
	return $rc
}

# the routed networks (plan: routed <id> <bridge> <cidr> <isolate>) for
# gt-be98-wifi-sta route: "<bridge> <cidr>" per line
write_routed() {
	mkdir -p "$STATE"
	awk '$1 == "routed" { print $3, $4 }' "$STATE/gen/plan" 2>/dev/null > "$STATE/routed.new"
	mv -f "$STATE/routed.new" "$STATE/routed"
}

# the repeater stations (plan: repeater <dev> <mode> <bridge>), for
# gt-be98-netguard: "<dev> <bridge>" per line, written before any station
# joins its bridge (netguard detaches a station that is not listed)
write_repeaters() {
	mkdir -p "$STATE"
	awk '$1 == "repeater" && $4 ~ /^brwifi[0-9]+$/ { print $2, $4 }' "$STATE/gen/plan" 2>/dev/null > "$STATE/repeaters.new"
	mv -f "$STATE/repeaters.new" "$STATE/repeaters"
}

# the station monitor daemon (gt-be98-wifi-sta monitor), while a station is planned
sta_mon_running() {
	local p
	p=$(cat "$STA_MON_PID" 2>/dev/null) || return 1
	[ -n "$p" ] && kill -0 "$p" 2>/dev/null
}

sta_mon_apply() {
	if [ -s "$STATE/stations" ]; then
		sta_mon_running && return 0
		start-stop-daemon --start --background --make-pidfile --pidfile "$STA_MON_PID" \
			--exec "$WIFI_STA" -- monitor
	elif [ -f "$STA_MON_PID" ]; then
		start-stop-daemon --stop --pidfile "$STA_MON_PID" --retry TERM/5/KILL/2 > /dev/null 2>&1
		rm -f "$STA_MON_PID"
	fi
}

# bring hostapd in line with the settings: only what changed
apply_hostapd() {
	local c i b v want='' brs='' subs='' rc=0 t d p plan="$STATE/gen/plan"
	reprobed_scan
	[ "$REPROBED" = ' ' ] || ewarn "re-probed by the Wi-Fi driver:${REPROBED% }: restarting those radios"
	ap_override
	stop_legacy
	# APPLY_HARD=1: nothing of the configuration runs (start: a failed
	# start, header: Lifecycle); any other failure is one part of it
	APPLY_HARD=0
	gen_networks || { APPLY_HARD=1; return 1; }
	t=${WIFI_TRUNK:-rnr0}
	valid_trunk "$t" || { eerror "trunk '$t' refused (rnr0..rnr3): no Wi-Fi network bridged"; t=; rc=1; }
	check_vlans || rc=1
	write_l2
	write_leds
	# monitors no longer listed first: their radios may start BSSes below
	mon_prune " $(mon_want | awk '{ printf "%smon ", $1 }')"
	# drop the sub-interfaces no longer wanted first (old trunk, changed
	# VLAN): a bridge never holds the VLANs of two trunks, not even briefly
	if [ -n "$t" ]; then
		for b in ${WIFI_BRIDGES:-}; do
			valid_bridge "$b" && v=$(br_vid "$b") && subs="$subs $t.$v"
		done
	fi
	vlan_prune "$subs"
	subs=
	# bridges and their trunk VLANs first: hostapd must find them
	for b in ${WIFI_BRIDGES:-}; do
		case " $brs " in *" $b "*) continue ;; esac
		valid_bridge "$b" || { eerror "bridge '$b' refused (brwifiN only)"; rc=1; continue; }
		v=$(br_vid "$b") || { eerror "$b has no VLAN (WIFI_VLANS): not bridged"; rc=1; continue; }
		[ -n "$t" ] || { rc=1; continue; }
		br_create "$b" || { rc=1; continue; }
		vlan_attach "$t" "$v" "$b" || { rc=1; continue; }
		brs="$brs $b"; subs="$subs $t.$v"
	done
	# the routed networks' bridges: no VLAN, no trunk (gt-be98-wifi-sta
	# addresses and NATs them)
	for p in ${WIFI_ROUTED:-}; do
		b=${p%%=*}
		valid_bridge "$b" || { eerror "routed bridge '$b' refused"; rc=1; continue; }
		case " $brs " in *" $b "*) eerror "$b: routed and bridged to a VLAN"; rc=1; continue ;; esac
		br_create "$b" || { rc=1; continue; }
		brs="$brs $b"
	done
	# the repeated network's bridge (repeater): no VLAN, no trunk, no
	# address; its uplink is the 4-address station (gt-be98-wifi-sta joins
	# it). A trunk VLAN there would join the wired LAN to the Wi-Fi
	# uplink's segment: refused here, and detached by gt-be98-netguard
	for b in ${WIFI_REPEATED:-}; do
		valid_bridge "$b" || { eerror "repeated bridge '$b' refused"; rc=1; continue; }
		case " $brs " in *" $b "*) eerror "$b: repeated and bridged to a VLAN or routed"; rc=1; continue ;; esac
		br_create "$b" || { rc=1; continue; }
		brs="$brs $b"
	done
	write_routed
	write_repeaters
	# the stations before the APs; a frequency that changed renders the
	# plan once more (-U: the APs of a station radio follow its uplink)
	sta_prepare
	case $? in
	0) ;;
	2) gen_networks again || rc=1 ;;
	*) rc=1 ;;
	esac
	# the units: generated radios, then ready-made configs
	rm -rf "$STATE/want"; mkdir -p "$STATE/want"
	if [ -f "$plan" ]; then
		while read -r d c v f; do
			[ -n "$d" ] || continue
			f=${f:-$d}
			conf_check "$c" "$brs" || { rc=1; continue; }
			{
				echo "conf $c"
				echo "first $f"
				# radio-wide lines + the first section (the anchor, or a station
				# radio's first virtual interface)
				echo "radio $v $(awk -v d="$d" -v f="$f" '$1 == "bss" && $2 == d && $3 == f { print $3 ":" $10 }' "$plan")"
				awk -v d="$d" -v f="$f" '$1 == "bss" && $2 == d && $3 != f { print "bss " $3 " " $10 " " $9 }' "$plan"
			} > "$STATE/want/$d"
			want="$want $d"
		done <<-EOF
		$(awk '$1 == "radio" { print $3, $4, $5, $6 }' "$plan")
		EOF
	fi
	for c in ${HOSTAPD_CONFS:-}; do
		if [ ! -f "$c" ]; then eerror "$c missing"; rc=1; continue; fi
		i=$(conf_iface "$c")
		if [ -z "$i" ]; then eerror "$c: no interface="; rc=1; continue; fi
		conf_check "$c" "$brs" || { rc=1; continue; }
		case " $want " in
		*" $i "*) eerror "$c: radio $i already configured (WIFI_NETWORKS or another config)"; rc=1; continue ;;
		esac
		{ echo "conf $c"; echo "first $i"; echo "radio $(conf_sum "$c")"; } > "$STATE/want/$i"
		want="$want $i"
	done
	if [ -z "$want" ]; then
		einfo "no Wi-Fi network or HOSTAPD_CONFS: driver only"
		hap_daemon_stop
		vif_prune ""
		vlan_prune "$subs"; br_prune "$brs"
		"$WIFI_STA" route || rc=1
		sta_mon_apply
		mon_apply || rc=1
		ids_prune "$(ids_want "")"
		return $rc
	fi
	# the process: (re)started when dead or started with other arguments
	if ! hap_running || [ "$(cat "$STATE/hostapd.args" 2>/dev/null)" != "$(hap_args_sum)" ] ||
	   [ "$(hap_cmd PING)" != PONG ]; then
		[ -f "$HAP_PID" ] && ! hap_running && ewarn "hostapd had died"
		hap_daemon_stop
		hap_daemon_start || { APPLY_HARD=1; vlan_prune "$subs"; br_prune "$brs"; return 1; }
	fi
	# radios no longer configured
	for p in "$STATE"/applied/*; do
		[ -f "$p" ] || continue
		d=${p##*/}
		case " $want " in *" $d "*) ;; *) unit_remove "$d" ;; esac
	done
	for d in $want; do
		unit_apply "$d" || rc=1
	done
	isolate_ports "$brs"
	# virtual interfaces, VLANs and bridges no longer listed, now that no BSS
	# uses them
	vif_prune "${STA_FIRSTS:-}"
	vlan_prune "$subs"
	br_prune "$brs"
	# the routed networks (address, DHCP/DNS, NAT out of the station)
	"$WIFI_STA" route || rc=1
	sta_mon_apply
	# the monitors, now that hostapd released their radios
	mon_apply || rc=1
	ids_prune "$(ids_want "$want")"
	return $rc
}

# the radios whose netdev identity is kept: hostapd radios $1, stations,
# monitors
ids_want() {
	echo "$1 $(cat "$STATE/stations" 2>/dev/null | tr '\n' ' ') $(mon_want | awk '{ printf "%s ", $1 }')"
}

# the schedule daemon (gt-be98-wifi-sched run), started when not running
# (never stopped by reload: the daemon itself runs the reload)
sched_running() {
	local p
	p=$(cat "$SCHED_PID" 2>/dev/null) || return 1
	[ -n "$p" ] && kill -0 "$p" 2>/dev/null
}

sched_start() {
	[ -x "$WIFI_SCHED" ] || return 0
	sched_running && return 0
	start-stop-daemon --start --background --make-pidfile --pidfile "$SCHED_PID" \
		--exec "$WIFI_SCHED" -- run
}

sched_stop() {
	[ -f "$SCHED_PID" ] || return 0
	start-stop-daemon --stop --pidfile "$SCHED_PID" --retry TERM/5/KILL/2 > /dev/null 2>&1
	rm -f "$SCHED_PID"
}

# the re-probe daemon (gt-be98-wifi-reprobe run), started when not running
# (never stopped by reload: the daemon itself runs the reload)
reprobe_running() {
	local p
	p=$(cat "$REPROBE_PID" 2>/dev/null) || return 1
	[ -n "$p" ] && kill -0 "$p" 2>/dev/null
}

reprobe_start() {
	[ -x "$WIFI_REPROBE" ] || return 0
	reprobe_running && return 0
	start-stop-daemon --start --background --make-pidfile --pidfile "$REPROBE_PID" \
		--exec "$WIFI_REPROBE" -- run
}

reprobe_stop() {
	[ -f "$REPROBE_PID" ] || return 0
	start-stop-daemon --stop --pidfile "$REPROBE_PID" --retry TERM/5/KILL/2 > /dev/null 2>&1
	rm -f "$REPROBE_PID"
}

# the 802.11k/v daemon (gt-be98-wifi-steer run: neighbour lists of the kv=1
# networks, steering of the steer=1 ones): runs while the applied plan has a
# kv line, stopped otherwise (no kv network: nothing for it to do)
steer_running() {
	local p
	p=$(cat "$STEER_PID" 2>/dev/null) || return 1
	[ -n "$p" ] && kill -0 "$p" 2>/dev/null
}

steer_stop() {
	[ -f "$STEER_PID" ] || return 0
	start-stop-daemon --stop --pidfile "$STEER_PID" --retry TERM/5/KILL/2 > /dev/null 2>&1
	rm -f "$STEER_PID"
	rm -f "$RUNDIR"/gt-be98-wifi-steer/*	# its samples and neighbour records
}

steer_apply() {
	[ -x "$WIFI_STEER" ] || return 0
	if grep -q '^kv ' "$STATE/gen/plan" 2>/dev/null; then
		steer_running && return 0
		start-stop-daemon --start --background --make-pidfile --pidfile "$STEER_PID" \
			--exec "$WIFI_STEER" -- run
	else
		steer_stop
	fi
}

# ---- the service's lifecycle (header: Lifecycle) ----

# the lock start, stop and reload hold (OpenRC never locks a reload). A
# directory, atomically made; a holder that died leaves it to the next one
svc_lock() {
	local n=0 o
	while ! mkdir "$SVC_LOCK" 2>/dev/null; do
		o=$(cat "$SVC_LOCK/pid" 2>/dev/null)
		if [ -n "$o" ] && ! kill -0 "$o" 2>/dev/null; then
			rm -rf "$SVC_LOCK"; continue
		fi
		sleep 1
		n=$((n + 1))
		if [ $n -ge "${SVC_LOCK_WAIT:-120}" ]; then
			ewarn "gt-be98-wifi: lock held by pid ${o:-?} for $n s: taken over"
			slog "lock held by pid ${o:-?} for $n s: taken over by ${RC_CMD:-?}"
			rm -rf "$SVC_LOCK"; n=0
		fi
	done
	echo $$ > "$SVC_LOCK/pid"
}

svc_unlock() {
	[ "$(cat "$SVC_LOCK/pid" 2>/dev/null)" = $$ ] && rm -rf "$SVC_LOCK"
	return 0
}

# OpenRC: this service is started (not starting, stopping or stopped)
svc_started() {
	command -v service_started > /dev/null 2>&1 || return 0
	service_started
}

# the processes of this service, from their command lines (a pid file can
# be stale or gone): "<what> <pid>" per line. The daemons as start-stop-
# daemon runs them (<shell> <daemon> <command>), hostapd by its global
# control socket (no other hostapd uses it)
svc_procs() {
	local c p a g
	g=$(hap_global)
	for c in /proc/[0-9]*/cmdline; do
		p=${c#/proc/}; p=${p%/cmdline}
		[ "$p" = $$ ] && continue
		a=$(tr '\0' ' ' < "$c" 2>/dev/null) || continue
		case "$a" in
		*" $WIFI_REPROBE run ") echo "gt-be98-wifi-reprobe $p" ;;
		*" $WIFI_SCHED run ") echo "gt-be98-wifi-sched $p" ;;
		*" $WIFI_STEER run ") echo "gt-be98-wifi-steer $p" ;;
		*" $WIFI_STA monitor ") echo "gt-be98-wifi-sta $p" ;;
		*hostapd" "*" -g $g "*) echo "hostapd $p" ;;
		esac
	done
}

# stop every process of this service still running once its pid files were
# used (stop), or before anything starts (start): TERM, KILL after 5 s.
# Each one found is said: none should be (a pid file names each)
orphans_stop() {
	local l p w left='' n=0
	l=$(svc_procs)
	[ -n "$l" ] || return 0
	while read -r w p; do
		[ -n "$p" ] || continue
		ewarn "$w (pid $p) ran without a pid file naming it: stopped"
		slog "$w (pid $p) ran without a pid file naming it (${RC_CMD:-?}): stopped"
		kill "$p" 2>/dev/null
		left="$left $p"
	done <<-EOF
	$l
	EOF
	while [ -n "$left" ] && [ $n -lt 5 ]; do
		sleep 1; n=$((n + 1)); l=$left; left=
		for p in $l; do kill -0 "$p" 2>/dev/null && left="$left $p"; done
	done
	# shellcheck disable=SC2086 # pid list
	[ -z "$left" ] || kill -9 $left 2>/dev/null
	return 0
}

stop_hostapd() {
	local d
	stop_legacy
	hap_daemon_stop
	# the stations after the APs, then their routing and interfaces
	# shellcheck disable=SC2013 # one validated name per line
	for d in $(cat "$STATE/stations" 2>/dev/null); do "$WIFI_STA" down "$d"; done
	rm -f "$STATE/stations" "$STATE/stations.new" "$STATE/routed"
	sta_mon_apply
	"$WIFI_STA" unroute
	vif_prune ""
	mon_prune ""
	rm -f "$STATE/leds"
	vlan_prune ""
	br_prune ""
	rm -f "$STATE/l2.conf"
	rm -rf "$STATE/ids" "$STATE/reprobe" "$STATE/failed"
}

start() {
	svc_lock
	# what an earlier failed start, or anything else, left running
	orphans_stop
	# cfg80211 loads regulatory.db at boot from the initramfs (post-image.sh).
	# The reload checks that a database is in use (REGDB_OK gates
	# country_code: without one hostapd would hang in COUNTRY_UPDATE) and
	# picks up the rootfs copy in /lib/firmware (wireless-regdb, signed; the
	# kernel carries the regdb keys).
	if iw reg reload 2>/dev/null; then
		einfo "regulatory database loaded"; REGDB_OK=1
	else
		ewarn "iw reg reload failed: leave country_code out of hostapd.conf"; REGDB_OK=0
	fi
	if ! wifi_loaded; then
		ebegin "Loading bca_pcie_ipc ${WIFI_ARGS}"
		# shellcheck disable=SC2086 # WIFI_ARGS: module parameters
		if [ -n "${WIFI_KO:-}" ]; then insmod "$WIFI_KO" $WIFI_ARGS
		else modprobe bca_pcie_ipc $WIFI_ARGS; fi
		eend $? || { svc_unlock; return 1; }
	fi
	WAIT_RADIOS=1 apply_hostapd
	local rc=$?
	if [ "${APPLY_HARD:-0}" = 1 ]; then
		# a failed start: OpenRC marks the service stopped and will never
		# run stop, so nothing of it may stay running
		eerror "gt-be98-wifi not started: nothing of the configuration runs (above)"
		stop_hostapd
		sched_stop
		reprobe_stop
		steer_stop
		orphans_stop
		svc_unlock
		return 1
	fi
	sched_stop
	sched_start
	reprobe_stop
	reprobe_start
	steer_stop
	steer_apply
	# the radios' LEDs come with the driver (gt-be98-leds)
	leds_apply
	if [ $rc != 0 ]; then
		# started, degraded: a failed start here would leave hostapd and the
		# daemons running under a service OpenRC calls stopped (img40)
		ewarn "gt-be98-wifi started DEGRADED: a part of the configuration failed (above); \`rc-service gt-be98-wifi status\` lists it, a failed radio is retried"
		slog "started DEGRADED: a part of the configuration failed (rc-service gt-be98-wifi status)"
	fi
	svc_unlock
	return 0
}

# new settings without reloading the driver: only what changed
reload() {
	local rc
	svc_lock
	# a reload queued behind a stop (or run while one runs): nothing to do,
	# and it must not start hostapd or a daemon again
	if ! svc_started; then
		ewarn "gt-be98-wifi is stopping or stopped: reload skipped"
		svc_unlock
		return 0
	fi
	if iw reg reload 2>/dev/null; then REGDB_OK=1; else REGDB_OK=0; fi
	apply_hostapd
	rc=$?
	sched_start
	reprobe_start
	steer_apply	# a kv network added or gone
	leds_apply	# led= of the list may have changed
	svc_unlock
	return $rc
}

stop() {
	# after a reload in flight (it may have started hostapd or a daemon)
	svc_lock
	sched_stop
	steer_stop
	# first: an unload must not look like a re-probe
	reprobe_stop
	stop_hostapd
	# anything of this service its pid files did not name
	orphans_stop
	if [ "${WIFI_UNLOAD_ON_STOP:-yes}" = yes ] && wifi_loaded; then
		ebegin "Unloading bca_pcie_ipc"
		rmmod bca_pcie_ipc
		eend $?
		rm -f "$STATE/radio-macs"
	fi
	svc_unlock
}

status() {
	local rc i d p live ports iso
	default_status
	rc=$?
	if wifi_loaded; then einfo "driver: bca_pcie_ipc loaded"; else einfo "driver: not loaded"; fi
	# the effective isolation (incl. the network list's) while running
	iso=$(sed -n 's/^WIFI_ISOLATE="\(.*\)"$/\1/p' "$STATE/l2.conf" 2>/dev/null)
	[ -f "$STATE/l2.conf" ] || iso=${WIFI_ISOLATE:-}
	# shellcheck disable=SC2013 # one validated name per line
	for i in $(cat "$STATE/bridges" 2>/dev/null); do
		if [ -d "/sys/class/net/$i/bridge" ]; then
			ports=
			for p in "/sys/class/net/$i/brif"/*; do [ -e "$p" ] && ports="$ports${p##*/} "; done
			einfo "bridge $i: ports $ports$(case " $iso " in *" $i "*) echo "(Wi-Fi ports isolated)" ;; esac)"
		else
			eerror "bridge $i: missing"
		fi
	done
	for i in $(cat "$STATE/monitors" 2>/dev/null); do
		if [ -e "$SYSNET/$i" ]; then einfo "monitor $i"; else eerror "monitor $i: missing"; fi
	done
	[ -s "$STATE/stations" ] && "$WIFI_STA" status
	if ! hap_running; then
		[ -d "$STATE/applied" ] && eerror "hostapd: not running"
		return $rc
	fi
	einfo "hostapd: running (pid $(cat "$HAP_PID")), global control $(hap_global)"
	for p in "$STATE"/failed/*; do
		[ -f "$p" ] || continue
		d=${p##*/}
		if [ "$(fail_get "$d" given_up)" = 1 ]; then
			eerror "radio $d FAILED to start ($(fail_get "$d" state)), given up after 3 retries: $(fail_get "$d" reason)"
		else
			eerror "radio $d FAILED to start ($(fail_get "$d" state)), retry $(( $(fail_get "$d" tries) + 1 ))/3 pending: $(fail_get "$d" reason)"
		fi
		rc=1
	done
	[ -s "$STATE/gen/sched" ] && einfo "schedules: $(tr '\n' ' ' < "$STATE/gen/sched")"
	live=$(hap_live)
	for p in "$STATE"/applied/*; do
		[ -f "$p" ] || continue
		d=${p##*/}
		i=$(unit_first "$p" "$d")
		if in_list "$live" "$i"; then
			einfo "radio $d: $(bss_state "$i") ($i), $(unit_line "$p" conf)"
		else
			eerror "radio $d: not in hostapd ($(unit_line "$p" conf))"
		fi
		while read -r i _ _; do
			[ -n "$i" ] || continue
			if in_list "$live" "$i"; then einfo "  BSS $i: $(bss_state "$i")"; else eerror "  BSS $i: missing"; fi
		done <<-EOF
		$(unit_line "$p" bss)
		EOF
	done
	return $rc
}
