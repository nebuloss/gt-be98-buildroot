#!/sbin/openrc-run
# SPDX-License-Identifier: GPL-2.0
# Optional Wi-Fi: loads bca_pcie_ipc.ko (the four PCIe radios) and runs
# hostapd on the configured interfaces. NOT enabled by default:
#   rc-update add gt-be98-wifi default ; rc-service gt-be98-wifi start
# HOSTAPD_CONFS: /etc/conf.d/gt-be98-wifi, overridden by
# /etc/conf.d/gt-be98-wifi-ap when present (written by the web UI's Wi-Fi AP
# page, saved to /jffs).
#
# One hostapd process per config file (one per radio; extra SSIDs are bss=
# sections of that radio's config, their netdevs created by hostapd), keyed
# by the config's interface=:
#   pid  /run/hostapd-<iface>.pid    log  /var/log/hostapd-<iface>.log
#   state /run/gt-be98-wifi/<iface>.conf (config path) and .sum (checksum of
#   the config content, its path and HOSTAPD_ARGS)
# `rc-service gt-be98-wifi reload` applies new configs without touching the
# driver: instances whose checksum changed (or that died) are restarted,
# new configs started, removed ones stopped, the others left running.
#
# Wi-Fi networks are pure L2: each network is a bridge brwifiN holding its
# BSSes (bss=bcawlN-k) and the 802.1Q sub-interface <trunk>.<vid> of the wired
# trunk port; no address on the box, no NAT. Settings (same files as
# HOSTAPD_CONFS):
#   WIFI_BRIDGES="brwifi1 brwifi2"        the networks' bridges
#   WIFI_VLANS="brwifi1:100 brwifi2:200"  REQUIRED VLAN id (1-4094) per bridge
#   WIFI_TRUNK=rnr0                       trunk port, rnr0..rnr3 (default rnr0)
#   WIFI_ISOLATE="brwifi1"                bridges whose Wi-Fi ports are
#                                         isolated (reach the trunk only)
# Before any hostapd starts, for each bridge with a VLAN: the bridge (no STP,
# forward_delay 0, up, IPv6 off: no address of the box on it), the trunk
# brought up if it is down (never down, never re-addressed: it keeps its
# untagged management address and dhcpcd), <trunk>.<vid> created (IPv6 off),
# up and enslaved. A bridge without a VLAN is never created, and a config
# naming it is refused. The trunk itself or any bare port is never enslaved.
# hostapd then only adds its BSS netdevs as ports (a bridge hostapd created
# itself would be deleted when it stops). reload creates new bridges and
# sub-interfaces and deletes the ones no longer listed after the instances
# using them stopped; only what this service created ($STATE/bridges,
# $STATE/vlans) is ever deleted. Only bcawl* netdevs in the configs
# (interface=, bss=). gt-be98-netguard allows exactly the listed
# <trunk>.<vid> in their bridges and keeps the isolation flags.
# Firmware: /lib/firmware/brcm/bca (gt-be98-vendor-firmware).
description="Open Wi-Fi driver + hostapd (optional)"
extra_started_commands="reload"

STATE=/run/gt-be98-wifi

depend() {
	need gt-be98-watchdog
	after gt-be98-drivers dhcpcd sshd
	use logger
}

wifi_loaded() { grep -q '^bca_pcie_ipc ' /proc/modules; }

# the web UI's settings (parsed, not sourced); WIFI_TRUNK defaults to rnr0
ap_override() {
	local f=/etc/conf.d/gt-be98-wifi-ap t
	[ -f "$f" ] || return 0
	HOSTAPD_CONFS=$(sed -n 's/^HOSTAPD_CONFS="\([^"$`\;]*\)"$/\1/p' "$f" | tail -n1)
	WIFI_BRIDGES=$(sed -n 's/^WIFI_BRIDGES="\([A-Za-z0-9 ]*\)"$/\1/p' "$f" | tail -n1)
	WIFI_VLANS=$(sed -n 's/^WIFI_VLANS="\([A-Za-z0-9: ]*\)"$/\1/p' "$f" | tail -n1)
	WIFI_ISOLATE=$(sed -n 's/^WIFI_ISOLATE="\([A-Za-z0-9 ]*\)"$/\1/p' "$f" | tail -n1)
	t=$(sed -n 's/^WIFI_TRUNK="\{0,1\}\([A-Za-z0-9]*\)"\{0,1\}$/\1/p' "$f" | tail -n1)
	WIFI_TRUNK=${t:-rnr0}
}

valid_trunk() { case "$1" in rnr[0-3]) return 0 ;; *) return 1 ;; esac; }

# 1..4094, decimal, no leading zero
valid_vid() {
	case "$1" in ''|0*|*[!0-9]*) return 1 ;; esac
	[ ${#1} -le 4 ] && [ "$1" -ge 1 ] && [ "$1" -le 4094 ]
}

# the VLAN id of bridge $1 in the checked list $VLANS_OK ("br:vid ...")
br_vid() {
	local p
	for p in $VLANS_OK; do [ "${p%%:*}" = "$1" ] && { echo "${p#*:}"; return 0; }; done
	return 1
}

# check WIFI_VLANS into VLANS_OK: brwifiN:vid, one VLAN per bridge, a VLAN
# for one bridge only, the bridge listed in WIFI_BRIDGES
check_vlans() {
	local p b v seenb= seenv= rc=0
	VLANS_OK=
	for p in ${WIFI_VLANS:-}; do
		b=${p%%:*}; v=${p#*:}
		case "$p" in *:*:*|:*|*:) eerror "WIFI_VLANS '$p' refused (brwifiN:vid)"; rc=1; continue ;; esac
		[ "$b" != "$p" ] || { eerror "WIFI_VLANS '$p' refused (brwifiN:vid)"; rc=1; continue; }
		valid_bridge "$b" || { eerror "WIFI_VLANS '$p' refused: not a brwifiN bridge"; rc=1; continue; }
		valid_vid "$v" || { eerror "WIFI_VLANS '$p' refused: VLAN id must be 1-4094"; rc=1; continue; }
		case " $seenb " in *" $b "*) eerror "WIFI_VLANS '$p' refused: $b has a VLAN already"; rc=1; continue ;; esac
		case " $seenv " in *" $v "*) eerror "WIFI_VLANS '$p' refused: VLAN $v used by another bridge"; rc=1; continue ;; esac
		case " ${WIFI_BRIDGES:-} " in *" $b "*) ;; *) eerror "WIFI_VLANS '$p' refused: $b not in WIFI_BRIDGES"; rc=1; continue ;; esac
		seenb="$seenb $b"; seenv="$seenv $v"
		VLANS_OK="$VLANS_OK $p"
	done
	return $rc
}

vlan_owned() { grep -qx "$1" "$STATE/vlans" 2>/dev/null; }

# is $1 the 802.1Q sub-interface of $2 with id $3?
vlan_is() {
	awk -F'|' -v n="$1" -v d="$2" -v v="$3" '
		{ for (i = 1; i <= NF; i++) gsub(/^[ \t]+|[ \t]+$/, "", $i) }
		$1 == n && $2 == v && $3 == d { ok = 1 } END { exit !ok }' /proc/net/vlan/config 2>/dev/null
}

ipv6_off() { echo 1 > "/proc/sys/net/ipv6/conf/$1/disable_ipv6" 2>/dev/null; }

# <trunk>.<vid> into bridge $3: the trunk is only brought up if down
vlan_attach() {
	local t=$1 v=$2 b=$3 s=$1.$2 m
	valid_trunk "$t" && valid_vid "$v" || { eerror "VLAN $s refused"; return 1; }
	[ -e "/sys/class/net/$t" ] || { eerror "trunk $t not present: $b not bridged"; return 1; }
	if [ $(( $(cat "/sys/class/net/$t/flags") & 1 )) = 0 ]; then
		ip link set dev "$t" up || { eerror "trunk $t: up failed"; return 1; }
	fi
	if [ -e "/sys/class/net/$s" ]; then
		vlan_is "$s" "$t" "$v" || { eerror "$s exists and is not VLAN $v of $t"; return 1; }
	else
		ebegin "Creating VLAN $s for $b"
		ip link add link "$t" name "$s" type vlan id "$v"
		eend $? || return 1
		mkdir -p "$STATE"
		echo "$s" >> "$STATE/vlans"
	fi
	ipv6_off "$s"
	ip link set dev "$s" up || { eerror "$s: up failed"; return 1; }
	m=$(readlink "/sys/class/net/$s/master" 2>/dev/null); m=${m##*/}
	if [ "$m" != "$b" ]; then
		ip link set dev "$s" master "$b" || { eerror "$s: enslave into $b failed"; return 1; }
	fi
	bridge link set dev "$s" isolated off 2>/dev/null
	return 0
}

# owned sub-interfaces not in the list $1
vlan_prune() {
	local s
	for s in $(cat "$STATE/vlans" 2>/dev/null); do
		case " $1 " in *" $s "*) continue ;; esac
		case "$s" in rnr[0-3].[0-9]*) ;; *) continue ;; esac
		if [ -e "/sys/class/net/$s" ]; then
			ebegin "Deleting VLAN $s"
			ip link del dev "$s"
			eend $? || continue
		fi
		grep -vx "$s" "$STATE/vlans" > "$STATE/vlans.new" 2>/dev/null
		mv -f "$STATE/vlans.new" "$STATE/vlans"
	done
}

# isolate the Wi-Fi ports of the WIFI_ISOLATE bridges (not the trunk VLAN)
isolate_ports() {
	local b p f
	for b in $1; do
		case " ${WIFI_ISOLATE:-} " in *" $b "*) f=on ;; *) f=off ;; esac
		for p in $(ls "/sys/class/net/$b/brif" 2>/dev/null); do
			case "$p" in bcawl*) bridge link set dev "$p" isolated $f ;; esac
		done
	done
}

# brwifi<digits> only
valid_bridge() {
	case "$1" in brwifi[0-9]*) ;; *) return 1 ;; esac
	case "${1#brwifi}" in *[!0-9]*) return 1 ;; esac
}

br_owned() { grep -qx "$1" "$STATE/bridges" 2>/dev/null; }

# create (or adopt an existing) bridge $1: no STP, forward_delay 0, up
br_create() {
	local b=$1
	if [ -e "/sys/class/net/$b" ]; then
		[ -d "/sys/class/net/$b/bridge" ] || { eerror "$b exists and is not a bridge"; return 1; }
	else
		ebegin "Creating bridge $b"
		ip link add name "$b" type bridge stp_state 0 forward_delay 0
		eend $? || return 1
	fi
	ipv6_off "$b"
	ip link set dev "$b" type bridge stp_state 0 forward_delay 0 &&
		ip link set dev "$b" up || { eerror "$b: setup failed"; return 1; }
	mkdir -p "$STATE"
	br_owned "$b" || echo "$b" >> "$STATE/bridges"
}

# delete bridge $1 if this service owns it and it has no foreign port
br_remove() {
	local b=$1 p
	br_owned "$b" || return 0
	if [ -e "/sys/class/net/$b" ]; then
		for p in $(ls "/sys/class/net/$b/brif" 2>/dev/null); do
			case "$p" in
			bcawl*) ;;
			*) vlan_owned "$p" && continue
			   ewarn "$b has port $p (not Wi-Fi): left in place"; return 1 ;;
			esac
		done
		ebegin "Deleting bridge $b"
		ip link del dev "$b"
		eend $? || return 1
	fi
	grep -vx "$b" "$STATE/bridges" > "$STATE/bridges.new" 2>/dev/null
	mv -f "$STATE/bridges.new" "$STATE/bridges"
}

# owned bridges not in the list $1
br_prune() {
	local b
	for b in $(cat "$STATE/bridges" 2>/dev/null); do
		case " $1 " in *" $b "*) ;; *) br_remove "$b" ;; esac
	done
}

# a config may only name bcawl* netdevs and listed bridges
conf_check() {
	local c=$1 brs=$2 v
	for v in $(sed -nE 's/^(interface|bss)=//p' "$c"); do
		case "$v" in
		bcawl[0-9]*) ;;
		*) eerror "$c: $v is not a Wi-Fi netdev (bcawl*)"; return 1 ;;
		esac
	done
	for v in $(sed -n 's/^bridge=//p' "$c"); do
		case " $brs " in
		*" $v "*) ;;
		*) eerror "$c: bridge=$v is not in WIFI_BRIDGES"; return 1 ;;
		esac
	done
}

# interface= of a config (the first one: bss= sections follow it)
conf_iface() { sed -n 's/^interface=\([A-Za-z0-9_.-]*\)[[:space:]]*$/\1/p' "$1" | head -n1; }

conf_sum() {
	{ echo "$1"; echo "${HOSTAPD_ARGS:-}"; cat "$1"; } | sha256sum | cut -d' ' -f1
}

hap_pid() { echo "/run/hostapd-$1.pid"; }

hap_running() {
	local p
	p=$(cat "$(hap_pid "$1")" 2>/dev/null) || return 1
	[ -n "$p" ] && kill -0 "$p" 2>/dev/null
}

# start the instance of config $1 for interface $2
hap_start() {
	local c=$1 i=$2 n=0
	while [ ! -e "/sys/class/net/$i" ] && [ $n -lt ${IFACE_WAIT:-20} ]; do
		sleep 1; n=$((n + 1))
	done
	[ -e "/sys/class/net/$i" ] || ewarn "$i not present after ${IFACE_WAIT:-20}s, starting hostapd anyway"
	mkdir -p "$STATE"
	ebegin "Starting hostapd on $i ($c)"
	start-stop-daemon --start --exec /usr/sbin/hostapd --pidfile "$(hap_pid "$i")" \
		-- -B -P "$(hap_pid "$i")" -t -f "/var/log/hostapd-$i.log" ${HOSTAPD_ARGS:-} "$c"
	if eend $?; then
		echo "$c" > "$STATE/$i.conf"
		conf_sum "$c" > "$STATE/$i.sum"
	else
		rm -f "$STATE/$i.conf" "$STATE/$i.sum"
		return 1
	fi
}

hap_stop() {
	local i=$1
	# a dead instance has nothing to stop (ssd would report a failure)
	if hap_running "$i"; then
		ebegin "Stopping hostapd on $i"
		start-stop-daemon --stop --exec /usr/sbin/hostapd --pidfile "$(hap_pid "$i")" \
			--retry TERM/5/KILL/2
		eend $?
	fi
	rm -f "$(hap_pid "$i")" "$STATE/$i.conf" "$STATE/$i.sum"
}

# interfaces with an instance (state or pidfile)
hap_instances() {
	local f i seen=
	for f in "$STATE"/*.conf /run/hostapd-*.pid; do
		[ -e "$f" ] || continue
		case "$f" in
		"$STATE"/*) i=${f#"$STATE"/}; i=${i%.conf} ;;
		*) i=${f#/run/hostapd-}; i=${i%.pid} ;;
		esac
		case " $seen " in *" $i "*) ;; *) seen="$seen $i" ;; esac
	done
	echo $seen
}

# the single hostapd of the previous version of this service
stop_legacy() {
	[ -f /run/hostapd.pid ] || return 0
	ebegin "Stopping hostapd (single instance)"
	start-stop-daemon --stop --exec /usr/sbin/hostapd --pidfile /run/hostapd.pid \
		--retry TERM/5/KILL/2
	eend $?
	rm -f /run/hostapd.pid
}

# bring the instances in line with HOSTAPD_CONFS: start new or changed
# configs, stop removed ones, leave unchanged running ones alone
apply_hostapd() {
	local c i b v want= pairs= brs= subs= rc=0 t
	ap_override
	stop_legacy
	t=${WIFI_TRUNK:-rnr0}
	valid_trunk "$t" || { eerror "trunk '$t' refused (rnr0..rnr3): no Wi-Fi network bridged"; t=; rc=1; }
	check_vlans || rc=1
	# drop the sub-interfaces no longer wanted first (old trunk, changed
	# VLAN): a bridge never holds the VLANs of two trunks, not even briefly
	if [ -n "$t" ]; then
		for b in ${WIFI_BRIDGES:-}; do
			valid_bridge "$b" && v=$(br_vid "$b") && subs="$subs $t.$v"
		done
	fi
	vlan_prune "$subs"
	subs=
	# bridges and their trunk VLANs first: hostapd must find them
	for b in ${WIFI_BRIDGES:-}; do
		valid_bridge "$b" || { eerror "bridge '$b' refused (brwifiN only)"; rc=1; continue; }
		v=$(br_vid "$b") || { eerror "$b has no VLAN (WIFI_VLANS): not bridged"; rc=1; continue; }
		[ -n "$t" ] || { rc=1; continue; }
		br_create "$b" || { rc=1; continue; }
		vlan_attach "$t" "$v" "$b" || { rc=1; continue; }
		brs="$brs $b"; subs="$subs $t.$v"
	done
	for c in ${HOSTAPD_CONFS:-}; do
		if [ ! -f "$c" ]; then eerror "$c missing"; rc=1; continue; fi
		i=$(conf_iface "$c")
		if [ -z "$i" ]; then eerror "$c: no interface="; rc=1; continue; fi
		conf_check "$c" "$brs" || { rc=1; continue; }
		case " $want " in
		*" $i "*) eerror "$c: interface $i already used by another config"; rc=1; continue ;;
		esac
		want="$want $i"
		pairs="$pairs$i $c
"
	done
	# removed configs
	for i in $(hap_instances); do
		case " $want " in *" $i "*) ;; *) hap_stop "$i" ;; esac
	done
	if [ -z "$want" ]; then
		einfo "no HOSTAPD_CONFS: driver only"
		vlan_prune "$subs"; br_prune "$brs"
		return $rc
	fi
	for i in $want; do
		c=$(printf '%s' "$pairs" | awk -v i="$i" '$1 == i { print $2; exit }')
		if hap_running "$i" && [ "$(cat "$STATE/$i.conf" 2>/dev/null)" = "$c" ] &&
		   [ "$(cat "$STATE/$i.sum" 2>/dev/null)" = "$(conf_sum "$c")" ]; then
			einfo "hostapd on $i: unchanged"
			continue
		fi
		hap_running "$i" || [ ! -f "$(hap_pid "$i")" ] || ewarn "hostapd on $i had died"
		hap_stop "$i"
		hap_start "$c" "$i" || rc=1
	done
	isolate_ports "$brs"
	# VLANs and bridges no longer listed, now that no instance uses them
	vlan_prune "$subs"
	br_prune "$brs"
	return $rc
}

stop_hostapd() {
	local i
	stop_legacy
	for i in $(hap_instances); do hap_stop "$i"; done
	vlan_prune ""
	br_prune ""
}

start() {
	# cfg80211 is built in and asks for regulatory.db before the rootfs is
	# mounted: that first load fails and is not retried, so country_code in
	# hostapd would hang in COUNTRY_UPDATE. Reload it from /lib/firmware
	# (wireless-regdb, signed; the kernel carries the regdb keys).
	iw reg reload 2>/dev/null && einfo "regulatory database loaded" ||
		ewarn "iw reg reload failed: leave country_code out of hostapd.conf"
	if ! wifi_loaded; then
		ebegin "Loading bca_pcie_ipc ${WIFI_ARGS}"
		if [ -n "${WIFI_KO:-}" ]; then insmod "$WIFI_KO" $WIFI_ARGS
		else modprobe bca_pcie_ipc $WIFI_ARGS; fi
		eend $? || return 1
	fi
	apply_hostapd
}

# new hostapd configs without reloading the driver: only what changed
reload() {
	apply_hostapd
}

stop() {
	stop_hostapd
	if [ "${WIFI_UNLOAD_ON_STOP:-yes}" = yes ] && wifi_loaded; then
		ebegin "Unloading bca_pcie_ipc"
		rmmod bca_pcie_ipc
		eend $?
	fi
}

status() {
	local rc i c
	default_status
	rc=$?
	if wifi_loaded; then einfo "driver: bca_pcie_ipc loaded"; else einfo "driver: not loaded"; fi
	for i in $(cat "$STATE/bridges" 2>/dev/null); do
		if [ -d "/sys/class/net/$i/bridge" ]; then
			einfo "bridge $i: ports $(ls "/sys/class/net/$i/brif" 2>/dev/null | tr '\n' ' ')$(case " ${WIFI_ISOLATE:-} " in *" $i "*) echo "(Wi-Fi ports isolated)" ;; esac)"
		else
			eerror "bridge $i: missing"
		fi
	done
	for i in $(hap_instances); do
		c=$(cat "$STATE/$i.conf" 2>/dev/null)
		if hap_running "$i"; then
			if [ -n "$c" ] && [ -f "$c" ] && [ "$(cat "$STATE/$i.sum" 2>/dev/null)" != "$(conf_sum "$c")" ]; then
				ewarn "hostapd on $i: running (pid $(cat "$(hap_pid "$i")")), ${c}: changed since start (reload)"
			else
				einfo "hostapd on $i: running (pid $(cat "$(hap_pid "$i")")), ${c:-?}"
			fi
		else
			eerror "hostapd on $i: not running (${c:-?})"
		fi
	done
	return $rc
}
