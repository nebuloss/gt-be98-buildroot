#!/sbin/openrc-run
# SPDX-License-Identifier: GPL-2.0
# OpenSSH server, public-key authentication only (/etc/ssh/sshd_config).
description="OpenSSH server"

command="/usr/sbin/sshd"
command_args="-D -e ${SSHD_OPTS}"
supervisor="supervise-daemon"
respawn_delay=2
respawn_max=0
output_log="/var/log/sshd.log"
error_log="/var/log/sshd.log"

depend() {
	use logger dhcpcd
	after gt-be98-watchdog dhcpcd
}

start_pre() {
	checkpath -d -m 0755 /run/sshd /var/empty
	# only the keys sshd serves (HostKey lines; normally gt-be98-hostkeys has
	# made them already). Not "ssh-keygen -A": it also makes an unused
	# mldsa44_ed25519 key, a new one at every boot (it is not kept in /jffs).
	local k t
	for k in $(awk '$1 == "HostKey" { print $2 }' /etc/ssh/sshd_config); do
		[ -s "$k" ] && continue
		t=$(basename "$k" | sed -n 's/^ssh_host_\(.*\)_key$/\1/p')
		[ -n "$t" ] || return 1
		rm -f "$k" "$k.pub"
		/usr/bin/ssh-keygen -q -N '' -t "$t" -f "$k" >/dev/null </dev/null || return 1
	done
	/usr/sbin/sshd -t || return 1
}

start_post() {
	gt-be98-postcode f6 "sshd started"
}
