#!/sbin/openrc-run
# SPDX-License-Identifier: GPL-2.0
# SSH host keys generated on the box, never in the image.
#
# A release image (RELEASE=1) carries no ssh_host_*_key: this service makes
# them at the first boot and saves them at once to the persistent store, so
# the box keeps one identity from then on:
#   - keys already in /etc/ssh (restored from /jffs/mainline-os by
#     gt-be98-jffs, from /data/etc-overlay by gt-be98-persist, or baked in
#     by a lab build with SSH_HOSTKEY_DIR): nothing to do;
#   - a key missing: ssh-keygen makes exactly the keys the HostKey lines of
#     /etc/ssh/sshd_config name (not "ssh-keygen -A": OpenSSH 10.5 -A also
#     makes an mldsa44_ed25519 key that sshd does not serve and /jffs does
#     not keep, so a new one appeared at every boot), then, when /jffs is read-write
#     (NAND=rw-jffs, the default), gt-be98-save --local writes the state
#     (ALLOW_PATHS of /etc/conf.d/gt-be98-jffs holds the host keys) through
#     the UBI write fence;
#   - /jffs not writable (NAND=off/ro, or the fenced setup failed): the keys
#     live in RAM only and the next boot makes new ones (logged at warning
#     level, and in /etc/motd).
description="Generate the SSH host keys on the box and keep them in /jffs"

depend() {
	need localmount
	after gt-be98-watchdog gt-be98-persist gt-be98-jffs
	before sshd
	use logger
}

# the host key files sshd serves (HostKey lines), e.g. /etc/ssh/ssh_host_ed25519_key
hostkeys() { awk '$1 == "HostKey" { print $2 }' /etc/ssh/sshd_config; }

missing() {
	local k m=
	for k in $(hostkeys); do
		[ -s "$k" ] && [ -s "$k.pub" ] || m="$m $k"
	done
	echo $m
}

# ssh_host_<type>_key -> <type>
keytype() { basename "$1" | sed -n 's/^ssh_host_\(.*\)_key$/\1/p'; }

start() {
	local m fp k t
	m=$(missing)
	if [ -z "$m" ]; then
		einfo "SSH host keys present"
		return 0
	fi
	ebegin "Generating SSH host keys ($m)"
	mkdir -p /etc/ssh
	for k in $m; do
		t=$(keytype "$k")
		[ -n "$t" ] || { eend 1 "$k: no key type in the name"; return 1; }
		rm -f "$k" "$k.pub"
		/usr/bin/ssh-keygen -q -N '' -t "$t" -f "$k" >/dev/null </dev/null || { eend 1 "ssh-keygen -t $t failed"; return 1; }
		chmod 0600 "$k"
	done
	eend 0
	m=$(missing)
	[ -z "$m" ] || { eerror "still missing:$m"; return 1; }
	fp=$(/usr/bin/ssh-keygen -l -f /etc/ssh/ssh_host_ed25519_key.pub 2>/dev/null | cut -d' ' -f2)
	logger -t gt-be98-hostkeys "new SSH host keys generated on the box (ed25519 $fp)"
	if grep -qE '^ubi0:[^ ]+ /jffs ubifs rw' /proc/mounts; then
		if gt-be98-save --local >/dev/null 2>&1; then
			einfo "SSH host keys saved to /jffs (ed25519 $fp)"
			logger -t gt-be98-hostkeys "SSH host keys saved to /jffs/mainline-os"
			return 0
		fi
		ewarn "gt-be98-save --local failed: the host keys are not persistent yet (gt-be98-autosave retries)"
		logger -p daemon.warn -t gt-be98-hostkeys "saving the new host keys to /jffs failed"
		return 0
	fi
	ewarn "/jffs is not read-write: these host keys live in RAM only, the next boot makes new ones"
	logger -p daemon.warn -t gt-be98-hostkeys "host keys not persistent (/jffs not read-write)"
	sed -i '/^WARNING: SSH host keys/d' /etc/motd 2>/dev/null
	echo "WARNING: SSH host keys are not persistent (/jffs not read-write): new keys next boot" >> /etc/motd
	return 0
}
