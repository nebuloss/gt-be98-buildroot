#!/sbin/openrc-run
# SPDX-License-Identifier: GPL-2.0
# Wi-Fi router mode (optional, NOT enabled by default; the web UI's Wi-Fi AP
# page enables it): each Wi-Fi radio is its own routed subnet, with DHCP + DNS
# from a dnsmasq bound to the Wi-Fi interfaces only, and NAT out of the WAN.
# Nothing is bridged; only bcawl* interfaces may be router LANs.
#   $ROUTER_DIR/router.conf   ROUTER_WAN="rnr0" ROUTER_LANS="bcawl3=192.168.83.1/24 ..."
#   $ROUTER_DIR/router.nft    table ip gt_be98_router (forward + masquerade)
#   $ROUTER_DIR/dnsmasq.conf  this instance's dnsmasq config
# Settings: /etc/conf.d/gt-be98-router. Saved to /jffs with the AP configs.
description="Wi-Fi router mode: routed Wi-Fi subnets, DHCP/DNS, NAT out of the WAN"

ROUTER_DIR=${ROUTER_DIR:-/etc/gt-be98-router}
DNSMASQ_PID=/run/gt-be98-router-dnsmasq.pid
APPLIED=/run/gt-be98-router.applied

depend() {
	need gt-be98-wifi
	after gt-be98-drivers dhcpcd gt-be98-netguard
	use logger
}

# router.conf is parsed (not sourced) and re-checked: a wired port is never
# a router LAN, the WAN is never a Wi-Fi interface or a bridge
load_conf() {
	local f=$ROUTER_DIR/router.conf l
	[ -f "$f" ] || { eerror "no $f (configure router mode in the web UI)"; return 1; }
	ROUTER_WAN=$(sed -n 's/^ROUTER_WAN="\([A-Za-z0-9_.-]*\)"$/\1/p' "$f" | tail -n1)
	ROUTER_LANS=$(sed -n 's|^ROUTER_LANS="\([A-Za-z0-9_.=/ -]*\)"$|\1|p' "$f" | tail -n1)
	case "$ROUTER_WAN" in
	''|bcawl*|br*|-*) eerror "router WAN '$ROUTER_WAN' refused"; return 1 ;;
	esac
	[ -n "$ROUTER_LANS" ] || { eerror "no ROUTER_LANS"; return 1; }
	for l in $ROUTER_LANS; do
		case "${l%%=*}" in
		bcawl[0-9]|bcawl[0-9][0-9]) ;;
		*) eerror "router LAN '${l%%=*}' refused: Wi-Fi radios (bcawl*) only"; return 1 ;;
		esac
		echo "${l#*=}" | grep -qE '^[0-9]{1,3}(\.[0-9]{1,3}){3}/[0-9]{1,2}$' ||
			{ eerror "router LAN address '${l#*=}' refused"; return 1; }
	done
}

start() {
	load_conf || return 1
	local l i a n
	ebegin "Router mode: $ROUTER_LANS, NAT out of $ROUTER_WAN"
	: > $APPLIED
	for l in $ROUTER_LANS; do
		i=${l%%=*}; a=${l#*=}; n=0
		while [ ! -e "/sys/class/net/$i" ] && [ $n -lt ${IFACE_WAIT:-20} ]; do
			sleep 1; n=$((n + 1))
		done
		if [ ! -e "/sys/class/net/$i" ]; then
			ewarn "$i: no such interface, skipped"
			continue
		fi
		if [ -e "/sys/class/net/$i/brport" ]; then
			eend 1 "$i is a bridge port: refused"
			return 1
		fi
		ip addr replace "$a" dev "$i" || { eend 1 "$a on $i failed"; return 1; }
		echo "$l" >> $APPLIED
	done
	nft -c -f "$ROUTER_DIR/router.nft" && nft -f "$ROUTER_DIR/router.nft" ||
		{ eend 1 "router.nft rejected"; return 1; }
	sysctl -q -w net.ipv4.ip_forward=1
	start-stop-daemon --start --exec /usr/sbin/dnsmasq --pidfile $DNSMASQ_PID -- \
		--conf-file="$ROUTER_DIR/dnsmasq.conf" --pid-file=$DNSMASQ_PID
	eend $?
}

stop() {
	local l
	ebegin "Stopping router mode"
	if [ -f $DNSMASQ_PID ]; then
		start-stop-daemon --stop --exec /usr/sbin/dnsmasq --pidfile $DNSMASQ_PID --retry TERM/5/KILL/2
		rm -f $DNSMASQ_PID
	fi
	sysctl -q -w net.ipv4.ip_forward=0
	nft delete table ip gt_be98_router 2>/dev/null
	# the addresses this instance set (router.conf may already be the next one)
	if [ -f $APPLIED ]; then
		while read -r l; do
			ip addr del "${l#*=}" dev "${l%%=*}" 2>/dev/null
		done < $APPLIED
		rm -f $APPLIED
	fi
	eend 0
}
