#!/sbin/openrc-run
# SPDX-License-Identifier: GPL-2.0
# sysklogd: /var/log/messages (RAM, rotated), the kernel log included, plus
# /etc/syslog.d/*.conf: the persistent copy on a USB stick (gt-be98-persist)
# and the optional remote target (SYSLOG_REMOTE at build time).
description="System logger (sysklogd)"

command="/sbin/syslogd"
# -l: keep the kernel's console logging. Without it syslogd turns it off
# (klogctl CONSOLE_OFF: console loglevel 1) after opening /dev/kmsg, and the
# "<2>BE98PC xx" post-codes no longer reach the be98pc earlycon. The level
# stays the one of loglevel=4 / kernel.printk / conf.d/dmesg.
command_args="-F -l ${SYSLOGD_OPTS}"
supervisor="supervise-daemon"
respawn_delay=2

depend() {
	provide logger
	after gt-be98-persist
	before net
}

start_pre() {
	checkpath -d -m 0755 /var/log
}
