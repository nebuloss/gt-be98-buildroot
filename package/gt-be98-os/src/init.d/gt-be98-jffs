#!/sbin/openrc-run
# SPDX-License-Identifier: GPL-2.0
# Access to the stock /jffs and the persistent state the mainline OS keeps
# there (NAND.md, NAND-PHASE2.md). Two switches in /etc/conf.d/gt-be98-jffs,
# both OFF by default:
#   FENCE_VOLUMES empty (PHASE 1): read-only.
#     1. the NAND "image" MTD partition must be read-only (DT), or writable
#        (NAND=rw-jffs image) with brcmnand.allow_write=0 and no UBI fence;
#        otherwise stop;
#     2. ubiattach on it -> UBI cannot write (ro_mode=1, or every write
#        refused by the MTD write fence);
#     3. mount the stock UBIFS volume "jffs2" read-only on /jffs;
#     4. apply /jffs/mainline-os/: state.tgz (from gt-be98-save, sha256-checked
#        against state.tgz.sha256 when present), then the overlay/ tree, both
#        restricted to the allowed paths (ALLOW_PATHS). Missing = defaults.
#   FENCE_VOLUMES set (PHASE 2, NAND=rw-jffs image only): UBI attached with
#     the write fence on those volumes, checked in debugfs, then
#     brcmnand.allow_write=1; /jffs mounted read-only, and remounted
#     read-write only with JFFS_MODE=rw and jffs2 in FENCE_VOLUMES. Any
#     failure: back to the phase-1 state.
description="Stock /jffs (UBIFS on NAND), read-only, and the saved mainline state"

depend() {
	need localmount
	after gt-be98-watchdog gt-be98-persist
	before sshd dhcpcd chronyd webui gt-be98-webui-guard gt-be98-drivers syslogd
	use logger
}

nand_mtd() {	# the mtd number of the partition labelled $1
	sed -n "s/^mtd\([0-9]*\): [0-9a-f]* [0-9a-f]* \"$1\"$/\1/p" /proc/mtd | head -n1
}

AW=/sys/module/brcmnand/parameters/allow_write
UF=/sys/module/ubi/parameters/fence
FD=/sys/kernel/debug/ubi/ubi0/fence

# back to the phase-1 state: no writes possible
lock_down() {
	mountpoint -q /jffs && umount /jffs
	[ -e /sys/class/ubi/ubi0 ] && ubidetach -d 0 >/dev/null 2>&1
	[ -w "$AW" ] && echo 0 > "$AW"
	[ -w "$UF" ] && echo "" > "$UF"
}

start() {
	[ "${JFFS:-yes}" = yes ] || { einfo "JFFS=no"; return 0; }
	local m flags writable mode=${JFFS_MODE:-ro}
	case "$mode" in ro|rw) ;; *) ewarn "JFFS_MODE=$mode: using ro"; mode=ro ;; esac
	m=$(nand_mtd "$IMAGE_MTD")
	if [ -z "$m" ]; then
		einfo "no NAND \"$IMAGE_MTD\" partition (image built without NAND=ro/rw-jffs): image defaults"
		return 0
	fi
	# MTD_WRITEABLE = 0x400
	flags=$(cat /sys/class/mtd/mtd$m/flags)
	writable=$(( (flags & 0x400) != 0 ))
	if [ -n "$FENCE_VOLUMES" ] && [ $writable = 0 ]; then
		ewarn "FENCE_VOLUMES=$FENCE_VOLUMES but mtd$m is read-only (image not built with NAND=rw-jffs): read-only"
	elif [ -n "$FENCE_VOLUMES" ]; then
		start_rw "$m" && { apply_state; [ "$mode" = rw ] && remount_rw; return 0; }
		eerror "fenced attach failed: falling back to read-only"
		lock_down
	elif [ "$mode" = rw ]; then
		ewarn "JFFS_MODE=rw needs FENCE_VOLUMES (with $JFFS_VOLUME): read-only"
	fi
	start_ro "$m" $writable || return 0
	apply_state
	return 0
}

start_ro() {	# $1 mtd, $2 writable
	lock_down
	ebegin "Attaching UBI read-only on mtd$1 ($IMAGE_MTD)"
	ubiattach -m "$1" -d 0 >/dev/null 2>&1
	eend $? || return 1
	if [ "$(cat /sys/class/ubi/ubi0/ro_mode 2>/dev/null)" != 1 ]; then
		if [ "$2" = 1 ] && [ "$(cat $AW 2>/dev/null)" = N ]; then
			ewarn "mtd$1 is writable (NAND=rw-jffs image) but brcmnand.allow_write=0 and no UBI fence: nothing can be written"
		else
			eerror "ubi0 is NOT in read-only mode: detaching"
			lock_down
			return 1
		fi
	fi
	mkdir -p /jffs
	ebegin "Mounting ubi0:$JFFS_VOLUME read-only on /jffs"
	mount -t ubifs -o ro ubi0:"$JFFS_VOLUME" /jffs
	eend $?
}

start_rw() {	# $1 mtd: fenced attach, checked, then allow_write
	local v
	lock_down
	[ -w "$UF" ] && [ -w "$AW" ] || { eerror "kernel without the write fence"; return 1; }
	echo "$FENCE_VOLUMES" > "$UF"
	ebegin "Attaching UBI on mtd$1 with the write fence ($FENCE_VOLUMES)"
	ubiattach -m "$1" -d 0 >/dev/null 2>&1
	eend $? || return 1
	if ! grep -q '^state active' "$FD" 2>/dev/null; then
		eerror "UBI fence not active ($FD)"; return 1
	fi
	for v in $(echo "$FENCE_VOLUMES" | tr ',' ' '); do
		grep -q "^volumes.* $v:" "$FD" || { eerror "fence does not cover $v"; return 1; }
	done
	[ "$(cat /sys/class/ubi/ubi0/ro_mode)" = 0 ] || { eerror "ubi0 in read-only mode"; return 1; }
	einfo "fence: $(grep -E '^(volumes|pebs)' "$FD" | tr '\n' ' ')"
	echo 1 > "$AW"
	logger -t gt-be98-jffs "write fence active ($FENCE_VOLUMES), brcmnand.allow_write=1"
	mkdir -p /jffs
	ebegin "Mounting ubi0:$JFFS_VOLUME read-only on /jffs"
	mount -t ubifs -o ro ubi0:"$JFFS_VOLUME" /jffs
	eend $?
}

remount_rw() {
	case ",$FENCE_VOLUMES," in
	*,"$JFFS_VOLUME",*) ;;
	*) einfo "/jffs stays read-only ($JFFS_VOLUME is not in FENCE_VOLUMES)"; return 0 ;;
	esac
	ebegin "Remounting /jffs read-write (fenced)"
	mount -o remount,rw /jffs
	eend $? || { lock_down; return 1; }
}

allowed() {	# copy the allowed paths of tree $1 over /
	local src=$1 p
	for p in $ALLOW_PATHS; do
		[ -e "$src/$p" ] || continue
		mkdir -p "/$(dirname "$p")"
		cp -a "$src/$p" "/$(dirname "$p")/" && einfo "  restored /$p"
	done
}

apply_state() {
	local d=/jffs/$STATE_DIR t want got
	[ -d "$d" ] || { einfo "no /jffs/$STATE_DIR: image defaults"; return 0; }
	if [ -f "$d/state.tgz" ]; then
		if [ -f "$d/state.tgz.sha256" ]; then
			want=$(cut -d' ' -f1 "$d/state.tgz.sha256")
			got=$(sha256sum "$d/state.tgz" | cut -d' ' -f1)
			[ "$want" = "$got" ] || { eerror "state.tgz sha256 mismatch: not applied"; want=; }
		else
			want=nocheck
		fi
		if [ -n "$want" ]; then
			t=$(mktemp -d)
			if tar -xzf "$d/state.tgz" -C "$t" 2>/dev/null; then
				einfo "Applying /jffs/$STATE_DIR/state.tgz"
				allowed "$t"
			else
				eerror "state.tgz unreadable: not applied"
			fi
			rm -rf "$t"
		fi
	fi
	if [ -d "$d/overlay" ]; then
		einfo "Applying /jffs/$STATE_DIR/overlay"
		allowed "$d/overlay"
	fi
	# keep secrets private whatever the source
	chmod 0600 /etc/ssh/ssh_host_*_key /etc/webui/auth.conf /etc/webui/webui.db 2>/dev/null
	chmod 0700 /etc/webui /root/.ssh 2>/dev/null
	logger -t gt-be98-jffs "state from /jffs/$STATE_DIR applied"
}

stop() {
	sync
	lock_down
	return 0
}
