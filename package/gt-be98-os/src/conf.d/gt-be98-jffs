# /etc/conf.d/gt-be98-jffs - stock /jffs (NAND.md, NAND-PHASE2.md)
JFFS=yes
# Two independent switches, both OFF by default (NAND-PHASE2.md); they only
# take effect on an image built with NAND=rw-jffs (otherwise: read-only).
# FENCE_VOLUMES: empty (default) = phase 1, UBI attached read-only, nothing
#   writable. Non-empty = UBI attached with the write fence on exactly these
#   volumes (comma-separated) and brcmnand.allow_write=1: only they (and free
#   PEBs) can be written. "mltest" for the sacrificial-volume step (G7),
#   "jffs2" for the real /jffs (G8).
FENCE_VOLUMES=
# JFFS_MODE: /jffs itself. ro (default) = mounted read-only (with any
#   FENCE_VOLUMES). rw = remounted read-write; needs JFFS_VOLUME in
#   FENCE_VOLUMES, otherwise it stays read-only.
JFFS_MODE=ro
# NAND MTD partition holding the UBI device (DT label)
IMAGE_MTD=image
# stock UBIFS volume mounted on /jffs
JFFS_VOLUME=jffs2
# directory on /jffs with the mainline state (state.tgz[.sha256], overlay/)
STATE_DIR=mainline-os
# paths (relative to /) restored from it; anything else is ignored
ALLOW_PATHS="etc/webui etc/ssh/ssh_host_ed25519_key etc/ssh/ssh_host_ed25519_key.pub etc/ssh/ssh_host_ecdsa_key etc/ssh/ssh_host_ecdsa_key.pub etc/ssh/ssh_host_rsa_key etc/ssh/ssh_host_rsa_key.pub etc/ssh/authorized_keys root/.ssh var/lib/dhcpcd var/lib/chrony"
