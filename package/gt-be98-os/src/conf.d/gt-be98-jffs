# /etc/conf.d/gt-be98-jffs - stock /jffs (NAND.md, NAND-PHASE2.md)
JFFS=yes
# ro (default): read-only. rw: re-attach UBI with the write fence
# (FENCE_VOLUMES only) and remount /jffs read-write; needs an image built
# with NAND=rw-jffs, otherwise it stays read-only. OFF until approved.
JFFS_MODE=ro
# the only UBI volumes the fence lets mainline write (rw mode); "mltest" for
# the sacrificial-volume step (G7), "jffs2" afterwards
FENCE_VOLUMES=jffs2
# NAND MTD partition holding the UBI device (DT label)
IMAGE_MTD=image
# stock UBIFS volume mounted on /jffs
JFFS_VOLUME=jffs2
# directory on /jffs with the mainline state (state.tgz[.sha256], overlay/)
STATE_DIR=mainline-os
# paths (relative to /) restored from it; anything else is ignored
ALLOW_PATHS="etc/webui etc/ssh/ssh_host_ed25519_key etc/ssh/ssh_host_ed25519_key.pub etc/ssh/ssh_host_ecdsa_key etc/ssh/ssh_host_ecdsa_key.pub etc/ssh/ssh_host_rsa_key etc/ssh/ssh_host_rsa_key.pub etc/ssh/authorized_keys root/.ssh var/lib/dhcpcd var/lib/chrony"
