# /etc/conf.d/gt-be98-wifi (service disabled by default)
# module parameters, e.g. the M1 single-radio set:
#WIFI_ARGS="bind_domain=2 max_eps=1 hybrid_msi=0 rx_nullbuf=0"
WIFI_ARGS=
WIFI_KO=
# The Wi-Fi networks (see /etc/hostapd/networks.conf.example and
# /usr/sbin/gt-be98-wifi-gen): each network becomes one BSS on each radio of
# its band set, all radios in one hostapd process. Their bridges brwifi<id>,
# VLANs and isolation come from the list. Empty: none.
WIFI_NETWORKS=
# sticky slot + BSSID index per (network, radio); keep it with the list
WIFI_SLOTS=/etc/hostapd/wifi-slots
# the time zone of the schedules (schedule= in the list), a POSIX TZ string
# (the image has no zoneinfo), e.g. CET-1CEST,M3.5.0,M10.5.0/3; empty: UTC.
# Schedules apply only while chrony reports a synchronised clock.
WIFI_SCHED_TZ=
# BSSes per radio, the anchor included (1..8). Empty: the count the driver
# advertises (iw phy: #{ AP } <= N, the firmware's mbss8 => 8 on this box);
# a value above it is lowered to it. The radio's clients are shared by its
# BSSes (8 per radio today, the driver's peer table).
WIFI_MAX_BSS=
# rnr=1 on the 2.4/5 GHz BSSes (hostapd adds the co-located 6 GHz BSSes to
# the Reduced Neighbor Report on its own, since all radios share a process)
WIFI_RNR=1
# 1 (default since RC2: the driver applies a non-default MAC to bsscfg 0,
# open-wifi e0f00e1a BSS0-MAC): a network promoted to slot 0 (the anchor
# left the radio) keeps its BSSID, a network's own MAC on a radio's first
# network is applied, and the 6 GHz anchor takes a locally administered
# block of its own (8 networks on 6 GHz). ⚠Existing 6 GHz networks change
# BSSID once on the upgrade to it (clients re-scan and re-join).
# 0: the radio's first network always has the radio address (RC1 behaviour)
WIFI_ANCHOR_KEEP_BSSID=1
# band -> radio netdev, default "2g=bcawl3 5gl=bcawl0 5gh=bcawl1 6g=bcawl2"
WIFI_RADIO_DEVS=
# ready-made hostapd configurations, one per radio (space separated; see
# /etc/hostapd/*.example). Shipped defaults, four radios: the 2.4 GHz netdev
# is bcawl3 (PCI domain 2). May be combined with WIFI_NETWORKS on other radios.
HOSTAPD_CONFS=
# their bridges (brwifiN), each with a REQUIRED VLAN on the trunk port
# (brwifiN:vid, 1-4094); the configs' bridge= must name one of them. The web
# UI writes these into /etc/conf.d/gt-be98-wifi-ap.
WIFI_BRIDGES=
WIFI_VLANS=
WIFI_TRUNK=rnr0
WIFI_ISOLATE=
# multicast on the Wi-Fi bridges (they always snoop IGMP/MLD): 1 (default) =
# each BSS port sends a multicast group to each of its listeners as unicast
# frames (bridge multicast_to_unicast), 0 = as multicast at the basic rate.
# The bridge converts only while a querier exists on the network: the
# routed networks' bridges run their own; for the VLAN networks the LAN's
# router normally queries. WIFI_MCAST_QUERIER=1 makes the VLAN bridges query
# too (IGMPv3 from 0.0.0.0: they have no address; it can win the querier
# election against the LAN router's, so only where the LAN has no querier).
WIFI_MCAST_TO_UNICAST=1
WIFI_MCAST_QUERIER=0
# the one hostapd process: extra options, global control socket, and the
# ctrl_interface of the generated BSSes
HOSTAPD_ARGS=
HOSTAPD_GLOBAL=/run/hostapd-global
HOSTAPD_CTRL=/run/hostapd
IFACE_WAIT=20
# Station (Wi-Fi uplink: a station= block in WIFI_NETWORKS; gt-be98-wifi-sta).
# STA_WAIT: s a new station may take to associate before the radio's APs
# start (on the configured channel; they follow the uplink's later);
# STA_POLL: the monitor's period (dead processes, channel follow);
# STA_METRIC: the metric of the box's own default route through the uplink
# (above every management route, so the lifeline keeps the box's default);
# STA_DEFAULT_ROUTE=0: no such route (only the routed networks use it);
# STA_TABLE: the routing table of the routed networks (gt-be98-router: 180);
# STA_DHCP=0: no DHCP client on the station; WPA_CTRL: wpa_supplicant's
# control directory (wpa_cli -p).
STA_WAIT=30
STA_POLL=10
STA_METRIC=3000
STA_DEFAULT_ROUTE=1
STA_TABLE=181
STA_DHCP=1
STA_FOLLOW_MIN=120
WPA_CTRL=/run/wpa_supplicant
WIFI_UNLOAD_ON_STOP=yes
