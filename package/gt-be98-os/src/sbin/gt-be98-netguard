#!/bin/sh
# SPDX-License-Identifier: GPL-2.0
# gt-be98-netguard: the OS owns the base network config. Two invariants hold
# whatever else runs (the web UI, a script, a typo):
#   1. no protected interface (NETGUARD_PROTECT: rnr*, eth*, usb*, enx*: the
#      LAN ports and the USB lifeline) is ever a bridge port: one is
#      detached the moment it is enslaved (a bridged/looped LAN port caused a
#      broadcast storm on the owner's LAN). This holds for the bare ports
#      (rnr0 above all: the trunk and management port). An 802.1Q
#      sub-interface of a protected port (<port>.<vid>) may be a bridge port
#      only as a Wi-Fi network's trunk VLAN: <WIFI_TRUNK>.<vid> in bridge
#      brwifiN, listed as brwifiN:<vid> in WIFI_VLANS (gt-be98-wifi), or
#      the one gt-be98-l2 runs brwifiN on (its state; a network bridge kept
#      for the VLAN jacks while Wi-Fi does not run);
#      anything else is detached;
#   2. no bridge port ever has hairpin mode on;
#   3. the Wi-Fi ports (bcawl*) of the WIFI_ISOLATE bridges are isolated,
#      those of other brwifi bridges and the trunk VLANs are not;
#   4. a Wi-Fi STATION (the uplink of gt-be98-wifi, listed in
#      $GT_BE98_WIFI_STATIONS) is never a bridge port: a 3-address station
#      cannot be bridged (cfg80211 refuses it too, IFF_DONT_BRIDGE); its
#      networks are routed (gt-be98-wifi-sta). Except a REPEATER: a
#      4-address station listed in $GT_BE98_WIFI_REPEATERS ("<dev>
#      <bridge>") may be a port of that one brwifi bridge (the repeated
#      network's), never isolated, and that bridge holds no 802.1Q
#      sub-interface of a protected port: with a Wi-Fi uplink in it, a trunk
#      VLAN would join the wired LAN to the uplink's segment (a loop when
#      the uplink AP sits on that LAN).
#   5. the BSS ports (bcawl*) of the brwifi bridges have multicast_to_unicast
#      as gt-be98-wifi sets it (WIFI_MCAST_TO_UNICAST, default 1), the
#      repeater's uplink port never (a port whose kernel lacks the
#      attribute is left alone).
#   6. a GATEWAY network's VLAN is never carried upstream (the two-gateway
#      rule, gt-be98-l2's header): <WIFI_TRUNK>.<vid> is never a bridge port
#      when <vid> is a network whose line of the web UI's list
#      (/etc/gt-be98-networks.conf) says mode=gateway, or when gt-be98-l2
#      runs the bridge as one ("trunk -" in its state), even if a stale
#      WIFI_VLANS lists it. Such a bridge's wired members (rnr1.<vid>) and
#      bare jacks are admitted as for any network bridge (its state's
#      "uplink" is the current trunk).
#   7. the MESH BACKHAUL (buildroot docs/MESH-BACKHAUL-DESIGN.md, gt-be98-l2's
#      trunk-add/uplink, gt-be98-mesh): a leaf's AP_VLAN on the root's
#      backhaul BSS (<backhaul ifname>.sta<N>, the plan's backhaul line) is
#      never a bridge port (the untagged link carries EAPOL and management
#      only); its 802.1Q sub-interface bh<k>.<vid> is a port only of the
#      bridge gt-be98-l2 recorded it for (a "bh" line of its state); a
#      leaf's bhs.<vid> only of the bridge gt-be98-l2 runs on bhs.<vid>. A
#      LEAF's bridge (its uplink is bhs) never holds a wired trunk VLAN
#      (<port>.<vid> of a protected port other than the 2.5G jacks' recorded
#      rnr1.<vid>): the wired port and the backhaul would close a loop
#      through the upstream LAN. LOOP GUARD on the leaf (while gt-be98-l2
#      has the uplink bhs): table bridge gt_be98_bh_guard drops and counts a
#      frame whose SOURCE is the leaf station's own address entering a leaf
#      bridge anywhere but bhs.* (it can only have come back around a loop:
#      out of the backhaul, through the root's LAN, into a jack); every
#      BH_PROBE_EVERY sweeps (default 6) an ARP probe (arping -D, from the
#      station's address) leaves on each bhs.<vid> so a loop shows within
#      ~30 s even when the leaf is idle. A count on rnr2/rnr3 latches that
#      jack, on rnr1.<V> the 2.5G jack the switch learned the station's
#      address on (its L2 lookup on each VLAN V a jack carries; none found:
#      every jack of those VLANs), as the BPDU guard latches (the tripped
#      file; rc-service gt-be98-lan restart clears it); a count elsewhere (a
#      BSS port: a client bridging two networks) is dropped and logged. The
#      leaf's management veth (gt-be98-mesh mgmt): bhm0p only in the bridge
#      of the plan's bhmgmt line, bhm0 (the box's address) in no bridge.
# One exception to 1., the wired LAN (gt-be98-lan, off by default): a bare
# port listed in LAN_PORTS may be a port of the bridge LAN_BRIDGE (br-lan),
# and of no other bridge, when it is rnr1, rnr2 or rnr3 and not the Wi-Fi
# trunk port. rnr0 never is, even when listed: it is the uplink and the
# management port, on the owner's LAN, and br-lan holds no rnr0 member of
# any kind (rnr0 is detached by 1., its sub-interfaces are allowed in
# brwifiN only), so no bridge ever joins a LAN jack to rnr0's segment
# (docs: open-ethernet docs/eth-lan-2026-11-02.md §3).
# Second exception, the VLAN jacks (gt-be98-lan LAN_PORT_<port>="native=<vid>
# ..."): bare rnr2 or rnr3 (never rnr0, never the Wi-Fi trunk port) may
# be a port of the brwifi bridge that gt-be98-l2 runs on <trunk>.<vid> with
# that <vid> and the current trunk (its state /run/gt-be98-l2/<bridge>), and
# of no other: a jack is never carried into another VLAN (a network whose
# VLAN moved loses its jacks at once). Bare rnr1 never is any more: the
# RTL8372 tags each 2.5G jack's native VLAN V on rnr1 (gt-be98-lan
# LAN_JACK_4..7), so the jacks of VLAN V are the 802.1Q device rnr1.<V>,
# which may be a port of brwifi bridge B only when gt-be98-l2 runs B on
# <trunk>.<V> (the current trunk, rnr1 not the trunk) and records rnr1.<V>
# as a wired member of B (its "wired" line): never in another VLAN's bridge.
# BPDU guard (gt-be98-lan's nft table bridge gt_be98_lan_guard): a VLAN jack
# rnr2/rnr3 whose bpdu_in_<port> counter moved is added to
# /run/gt-be98-lan.tripped (the kernel already drops all its flooded
# traffic) and DETACHED from its bridge (nomaster), and detached again
# whenever something re-attaches it. A BPDU entering on rnr1.<V> (one of
# the 2.5G jacks of VLAN V) is dropped and its SOURCE MAC kept in the set
# bpdu_src_<V>; each new source is ATTRIBUTED to a jack: the RTL8372 driver
# looks the MAC up in the switch's L2 table on VLAN V (sysfs l2_lookup);
# a port 4..7 that carries VLAN V (gt-be98-lan's applied "jack" lines, its
# native VLAN, and "jacktag" lines, its tagged ones: a BPDU tagged V on a
# jack reaches rnr1.V too) latches that jack, anything else (not found,
# another port, a failed lookup) latches ALL the jacks carrying VLAN V. A latched jack is a "jack<N>"
# line of the same tripped file and a bit of the driver's jack_block (the
# switch disables the port in every MSTI and flushes its learned entries:
# the jack is cut inside the switch, the other jacks of VLAN V keep
# working); the mask is written again whenever the driver's differs (a
# module reload; gt-be98-lan also writes it after every jack_profiles).
# Loop guard (RLDP): the RTL8372 probes its four jacks with its own frames
# and flags a jack whose probe comes back (a loop through equipment that
# sends no BPDU: a dumb switch with two of its ports cabled, two jacks into
# one switch). While gt-be98-lan has a jack set applied (its "jacks" line)
# each sweep reads the driver's jack_status; a jack with loop=1 is latched
# like a BPDU's: a "jack<N>" line of the tripped file, its looped-with port
# in the .loop companion, the switch's jack_block (the driver re-arms its
# probes when a jack is unblocked, so a restart judges the jack afresh).
# Not a bridge port state: a port state is bridge-level policy, which the
# Runner's offloaded bridged flows bypass (an offloaded unicast flow never
# reaches the bridge: q254 B, ping 5/5 after the trip with state 0). The
# detach is a netdev event: the bridge flushes the port's FDB and the Runner
# flow cache removes every hardware flow of the port (NETDEV_CHANGEUPPER ->
# fc_flush_dev). One `nft` per sweep, only while the guard is loaded.
# Reacts to every link event (ip monitor) and sweeps every NETGUARD_SWEEP s.
# Settings: /etc/conf.d/gt-be98-netguard, /etc/conf.d/gt-be98-lan.
# `gt-be98-netguard --selftest` checks the bridge-port verdicts, the 2.5G jacks'
# BPDU attribution and the driver's lookup answers on fixed cases.
set -u
NETGUARD_PROTECT=${NETGUARD_PROTECT:-"rnr* eth* usb* enx*"}
NETGUARD_SWEEP=${NETGUARD_SWEEP:-5}

WIFI_AP=/etc/conf.d/gt-be98-wifi-ap
WIFI_DEF=/etc/conf.d/gt-be98-wifi
WIFI_L2=${GT_BE98_WIFI_L2:-/run/gt-be98-wifi/l2.conf}
WIFI_STATIONS=${GT_BE98_WIFI_STATIONS:-/run/gt-be98-wifi/stations}
WIFI_REPEATERS=${GT_BE98_WIFI_REPEATERS:-/run/gt-be98-wifi/repeaters}
LAN_CONF=${GT_BE98_LAN_CONF:-/etc/conf.d/gt-be98-lan}
L2_STATE=${GT_BE98_L2_STATE:-${GT_BE98_RUN:-/run}/gt-be98-l2}
LAN_APPLIED=${GT_BE98_LAN_APPLIED:-${GT_BE98_RUN:-/run}/gt-be98-lan.applied}
LAN_TRIPPED=${GT_BE98_LAN_TRIPPED:-${GT_BE98_RUN:-/run}/gt-be98-lan.tripped}
# the latch lock, shared with gt-be98-lan (its lan_lock_try: the same code)
LAN_LOCK=$LAN_TRIPPED.lock
NETWORKS=${GT_BE98_NETWORKS:-/etc/gt-be98-networks.conf}
WIFI_PLAN=${GT_BE98_WIFI_PLAN:-${GT_BE98_RUN:-/run}/gt-be98-wifi/gen/plan}
BH_PROBE_EVERY=${BH_PROBE_EVERY:-6}
# the RTL8372 driver's sysfs directory (one device; GT_BE98_RTL8372: a fixed
# directory, the offline tests)
RTL_GLOB=${GT_BE98_RTL8372:-/sys/bus/mdio_bus/drivers/rtl8372/*}

NL='
'
SYSNET=${GT_BE98_SYSNET:-/sys/class/net}	# (GT_BE98_*: the offline tests only)

log() { logger -t gt-be98-netguard -- "$*" 2>/dev/null; echo "gt-be98-netguard: $*" 2>/dev/null > /dev/kmsg; }
# A sweep forks nothing unless it changes something (img40: lane tx-cpu
# measured 0.03 of a core for this daemon on img39, about 30 forks per 5 s
# sweep): files and sysfs are read with `read`, the bridges' ports are
# listed from <bridge>/brif, the verdict is a variable, not a command
# substitution. Same rules, same order of the checks per port.
# the patterns are matched, never expanded as file names (set -f)
protected() {
	local p r=1
	set -f
	for p in $NETGUARD_PROTECT; do
		# shellcheck disable=SC2254 # $p is a pattern
		case "$1" in $p) r=0; break ;; esac
	done
	set +f
	return $r
}
# the Wi-Fi stations and repeaters of gt-be98-wifi, read once per sweep:
# STA_LIST one name per line, REP_LIST "<dev> <bridge>" per line
load_lists() {
	local a b
	STA_LIST=$NL REP_LIST=$NL
	if [ -r "$WIFI_STATIONS" ]; then
		while IFS= read -r a || [ -n "$a" ]; do STA_LIST="$STA_LIST$a$NL"; done < "$WIFI_STATIONS"
	fi
	if [ -r "$WIFI_REPEATERS" ]; then
		while read -r a b _ || [ -n "${a:-}" ]; do
			[ -n "${a:-}" ] && REP_LIST="$REP_LIST$a ${b:-}$NL"
		done < "$WIFI_REPEATERS"
	fi
}
# is $1 a Wi-Fi station of gt-be98-wifi? (a whole line of the list)
station() { case "$STA_LIST" in *"$NL$1$NL"*) return 0 ;; esac; return 1; }
# is $1 the repeater station of bridge $2 (both given: a brwifi bridge)?
repeater_of() {
	case "$2" in brwifi[0-9]*) ;; *) return 1 ;; esac
	case "$REP_LIST" in *"$NL$1 $2$NL"*) return 0 ;; esac
	return 1
}
# does bridge $1 hold a repeater station (listed for it)?
repeater_bridge() {
	case "$1" in brwifi[0-9]*) ;; *) return 1 ;; esac
	case "$REP_LIST" in *" $1$NL"*) return 0 ;; esac
	return 1
}
# cfg_last FILE KEY CHARS: the value of the LAST line KEY=value, KEY="value"
# of FILE whose value holds only CHARS (a case bracket set), into CFG; ""
# when none (the same lines the former sed -n 's/^KEY="\{0,1\}\([CHARS]*\)"\{0,1\}$/\1/p' | tail -n1 took)
cfg_last() {
	local l v
	CFG=
	[ -r "$1" ] || return 0
	while IFS= read -r l || [ -n "$l" ]; do
		case "$l" in "$2="*) ;; *) continue ;; esac
		v=${l#"$2="}; v=${v#\"}; v=${v%\"}
		# shellcheck disable=SC2254 # $3 is a pattern
		case "$v" in *[!$3]*) continue ;; esac
		CFG=$v
	done < "$1"
}
# Wi-Fi network settings as gt-be98-wifi applies them: its effective file
# while it runs (it adds the VLANs and isolation of its network list,
# WIFI_NETWORKS), else the web UI's file when present, else the defaults
# (WIFI_TRUNK defaults to rnr0)
wifi_conf() {
	local f=$WIFI_DEF
	[ -f "$WIFI_AP" ] && f=$WIFI_AP
	[ -f "$WIFI_L2" ] && f=$WIFI_L2
	cfg_last "$f" WIFI_VLANS 'A-Za-z0-9: '; VLANS=$CFG
	cfg_last "$f" WIFI_ISOLATE 'A-Za-z0-9 '; ISOLATE=$CFG
	cfg_last "$f" WIFI_TRUNK 'A-Za-z0-9'; TRUNK=${CFG:-rnr0}
	cfg_last "$f" WIFI_MCAST_TO_UNICAST '01'; M2U=${CFG:-1}
	# bhs: a mesh leaf's trunk (its station, rule 7)
	case "$TRUNK" in rnr[0-3]|bhs) ;; *) TRUNK= ;; esac
	# the root's backhaul BSS (plan line "backhaul <band> <dev> <ifname> ..."): BHIF
	# and its one leaf (the generator's accept-<ifname>): BHLEAF
	BHIF= BHLEAF= BHMGMT=
	if [ -r "$WIFI_PLAN" ]; then
		local t a b c
		while read -r t a b c _; do
			case "$t" in backhaul) BHIF=$c ;; bhmgmt) BHMGMT=$b ;; esac
		done < "$WIFI_PLAN"
		[ -n "$BHIF" ] && [ -r "${WIFI_PLAN%/plan}/accept-$BHIF" ] &&
			{ read -r BHLEAF _ < "${WIFI_PLAN%/plan}/accept-$BHIF"; } 2>/dev/null
	fi
}
# the gateway networks' VLANs of the web UI's list into GW_VIDS (" 40 41 ",
# read with `read`, once per sweep; keys in any order, unknown ignored)
gw_conf() {
	local l w v m
	GW_VIDS=' '
	[ -r "$NETWORKS" ] || return 0
	set -f
	while IFS= read -r l || [ -n "$l" ]; do
		case "$l" in ''|'#'*) continue ;; esac
		v= m=
		# shellcheck disable=SC2086 # word split, no glob
		for w in $l; do
			case "$w" in vlan=*) v=${w#vlan=} ;; mode=*) m=${w#mode=} ;; esac
		done
		case "$v" in ''|0*|*[!0-9]*) continue ;; esac
		[ "$m" = gateway ] && GW_VIDS="$GW_VIDS$v "
	done < "$NETWORKS"
	set +f
}
# invariant 6: is sub-interface $1 of a protected port the trunk VLAN of a
# gateway network (the list, or a bridge gt-be98-l2 runs as one)? Why into GWHY
gw_trunk_vlan() {
	local v=${1#*.} f
	GWHY=
	[ -n "$TRUNK" ] && [ "${1%%.*}" = "$TRUNK" ] || return 1
	case "$v" in ''|0*|*[!0-9]*) return 1 ;; esac
	case "${GW_VIDS:- }" in *" $v "*) GWHY="VLAN $v is a gateway network (mode=gateway)"; return 0 ;; esac
	# gt-be98-l2 runs a bridge on VLAN v as a gateway network ("trunk -")
	for f in "$L2_STATE"/brwifi*; do
		[ -f "$f" ] || continue
		l2_state "${f##*/}"
		[ "$L2V" = "$v" ] && [ "$L2T" = - ] && { GWHY="gt-be98-l2 runs ${f##*/} on VLAN $v as a gateway network"; return 0; }
	done
	return 1
}
# the bridge's trunk as gt-be98-l2 records it is the current one: L2T, or
# for a gateway network's bridge ("trunk -") the uplink its users asked for
l2_on_trunk() {
	[ "$L2T" = "$TRUNK" ] && return 0
	[ "$L2T" = - ] && [ "${L2U:-$TRUNK}" = "$TRUNK" ]
}
# is sub-interface $1 the listed trunk VLAN of bridge $2?
wifi_vlan_ok() {
	local p v
	[ -n "$TRUNK" ] || return 1
	case "$2" in brwifi[0-9]*) ;; *) return 1 ;; esac
	for p in $VLANS; do
		v=${p#*:}
		case "$v" in ''|0*|*[!0-9]*) continue ;; esac
		[ "${p%%:*}" = "$2" ] && [ "$1" = "$TRUNK.$v" ] && return 0
	done
	# a network bridge gt-be98-l2 runs for the VLAN jacks alone (Wi-Fi not
	# running, or a network without an SSID: brwifi<100000 + id> with no BSS
	# port, gt-be98-lan its only user): its own trunk VLAN
	l2_state "$2"
	[ -n "$L2V" ] && [ "$L2T" = "$TRUNK" ] && [ "$1" = "$TRUNK.$L2V" ]
}
# is sub-interface $1 (rnr1.<V>: the 2.5G jacks of VLAN V) the wired member
# gt-be98-l2 records for brwifi bridge $2, which it runs on <trunk>.<V>?
jack_vlan_ok() {
	case "$1" in rnr1.*) ;; *) return 1 ;; esac
	case "$2" in brwifi[0-9]*) ;; *) return 1 ;; esac
	[ -n "$TRUNK" ] && [ "$TRUNK" != rnr1 ] || return 1
	l2_state "$2"
	[ -n "$L2V" ] && l2_on_trunk && [ "$1" = "rnr1.$L2V" ] || return 1
	case " $L2W " in *" $1 "*) return 0 ;; esac
	return 1
}
# wired LAN settings (gt-be98-lan): LAN_PORTS, LAN_BRIDGE, the VLAN-jack
# profiles' native VLANs (VN_rnr1..3: "" = no jack), parsed not sourced
lan_conf() {
	local p w n e
	cfg_last "$LAN_CONF" LAN_PORTS 'A-Za-z0-9 '; LPORTS=$CFG
	cfg_last "$LAN_CONF" LAN_BRIDGE 'A-Za-z0-9_-'; LBRIDGE=${CFG:-br-lan}
	VN_rnr1=	# the 2.5G jacks: rnr1.<V>, never bare rnr1 (jack_vlan_ok)
	for p in rnr2 rnr3; do
		cfg_last "$LAN_CONF" "LAN_PORT_$p" 'a-z0-9=, '
		n= e=1
		for w in $CFG; do
			case "$w" in native=*) n=${w#native=} ;; enabled=*) e=${w#enabled=} ;; esac
		done
		[ "$e" = 1 ] || n=
		case "$n" in ''|0*|*[!0-9]*) n= ;; esac
		eval "VN_$p=\$n"
	done
}
# the VLAN gt-be98-l2 runs bridge $1 on, into L2V ("" none), L2T (trunk,
# "-" for a gateway network), L2U (the uplink trunk, "" in an older state)
# and L2W (its wired members, space-separated)
l2_state() {
	local k v w
	L2V= L2T= L2U= L2W=
	[ -r "$L2_STATE/$1" ] || return 0
	while read -r k v w _; do
		case "$k" in vid) L2V=$v ;; trunk) L2T=$v ;; uplink) L2U=$v ;; wired) L2W="$L2W $w" ;; esac
	done < "$L2_STATE/$1"
}
# may bare port $1 be a port of brwifi bridge $2 as a VLAN jack?
vport_ok() {
	local n
	case "$1" in rnr[23]) ;; *) return 1 ;; esac	# bare rnr1: never (rnr1.<V>)
	case "$2" in brwifi[0-9]*) ;; *) return 1 ;; esac
	[ -n "$TRUNK" ] && [ "$1" != "$TRUNK" ] || return 1
	eval "n=\${VN_$1:-}"
	[ -n "$n" ] || return 1
	l2_state "$2"
	[ "$L2V" = "$n" ] && l2_on_trunk
}
# may bare port $1 be a port of bridge $2 as a wired LAN port?
lan_port_ok() {
	local p
	case "$1" in rnr[1-3]) ;; *) return 1 ;; esac	# never rnr0, never another port
	[ "$2" = "$LBRIDGE" ] || return 1
	case "$LBRIDGE" in brwifi*|'') return 1 ;; esac
	[ "$1" != "$TRUNK" ] || return 1		# the Wi-Fi trunk port stays a trunk
	for p in $LPORTS; do [ "$p" = "$1" ] && return 0; done
	return 1
}
# the verdict on bridge port $1 of bridge $2 into VERDICT: keep, or why it is detached
# rule 7: is $1 a leaf's AP_VLAN on the root's backhaul BSS (BHIF)?
mesh_link() {
	[ -n "${BHIF:-}" ] || return 1
	case "$1" in "$BHIF".sta[0-9]*) ;; *) return 1 ;; esac
	case "${1#"$BHIF".sta}" in *[!0-9]*) return 1 ;; esac
}
# rule 7: may backhaul VLAN $1 (bh<k>.<vid>, bhs.<vid>) be a port of bridge $2?
bh_port_ok() {
	local k v _w
	case "$2" in brwifi[0-9]*) ;; *) return 1 ;; esac
	case "$1" in
	bhs.*)	l2_state "$2"
		[ "$L2T" = bhs ] && [ -n "$L2V" ] && [ "$1" = "bhs.$L2V" ] ;;
	bh[0-7].*)
		# the link's peer is the backhaul's one leaf (design §8.2)
		if [ -n "${BHLEAF:-}" ]; then
			v=
			[ -r "$L2_STATE/trunks/${1%%.*}" ] && while read -r k _w; do [ "$k" = peer ] && v=$_w; done < "$L2_STATE/trunks/${1%%.*}"
			[ "$v" = "$BHLEAF" ] || return 1
		fi
		[ -r "$L2_STATE/$2" ] || return 1
		while read -r k v _w; do [ "$k" = bh ] && [ "$v" = "$1" ] && return 0; done < "$L2_STATE/$2"
		return 1 ;;
	*)	return 1 ;;
	esac
}
# rule 7: is bridge $1 a mesh leaf's (gt-be98-l2 runs it on bhs)?
leaf_bridge() {
	case "$1" in brwifi[0-9]*) ;; *) return 1 ;; esac
	l2_state "$1"
	[ "$L2T" = bhs ] || [ "${L2U:-}" = bhs ]
}
verdict() {
	VERDICT=keep
	# rule 7: the mesh backhaul's links and VLANs
	if mesh_link "$1"; then
		VERDICT="a mesh leaf's link (AP_VLAN of the backhaul BSS $BHIF): never bridged untagged (its VLANs bh<k>.<vid> are)"; return
	fi
	# the leaf's management port (gt-be98-mesh mgmt): bhm0p only in the
	# plan's management bridge, bhm0 (the box's own address) never
	case "$1" in
	bhm0) VERDICT="the mesh leaf's management netdev: never a bridge port"; return ;;
	bhm0p) [ -n "${BHMGMT:-}" ] && [ "$2" = "$BHMGMT" ] || VERDICT="the mesh leaf's management port: only in the management VLAN's bridge (${BHMGMT:-none planned})"
		return ;;
	esac
	case "$1" in
	bh[0-7].*|bhs.*)
		bh_port_ok "$1" "$2" || VERDICT="a mesh backhaul VLAN: a port only of the network bridge gt-be98-l2 runs it for, on the link of the backhaul's leaf"
		return ;;
	esac
	case "$1" in
	*.*)	# 802.1Q sub-interface of a protected port: listed trunk VLANs only
		# a mesh leaf's bridge: its uplink is the backhaul, never a wired
		# trunk VLAN (rule 7: a loop through the upstream LAN)
		if protected "${1%%.*}" && leaf_bridge "$2" && ! jack_vlan_ok "$1" "$2"; then
			VERDICT="$2 is a mesh leaf's bridge (uplink bhs): no wired trunk VLAN in it (the backhaul and the wired port would close a loop)"; return
		fi
		# a gateway network's VLAN is never carried upstream (rule 6)
		if protected "${1%%.*}" && gw_trunk_vlan "$1"; then
			VERDICT="$GWHY: its trunk VLAN is never bridged (the box is that network's gateway)"; return
		fi
		if protected "${1%%.*}" && ! wifi_vlan_ok "$1" "$2" && ! jack_vlan_ok "$1" "$2"; then
			VERDICT="not a listed Wi-Fi VLAN of $2, nor the 2.5G jacks' VLAN (rnr1.<vid>) gt-be98-l2 runs $2 on"; return
		fi
		if protected "${1%%.*}" && repeater_bridge "$2"; then
			VERDICT="$2 is a repeater bridge (Wi-Fi uplink): no wired VLAN in it"; return
		fi ;;
	*)	if tripped "$1"; then
			VERDICT="latched off by the BPDU guard (rc-service gt-be98-lan restart clears it)"; return
		fi
		if protected "$1" && ! lan_port_ok "$1" "$2" && ! vport_ok "$1" "$2"; then
			VERDICT="protected port: never bridged except a LAN_PORTS port in $LBRIDGE or a VLAN jack (rnr2, rnr3) in its native VLAN's network bridge"; return
		fi
		if station "$1" && ! repeater_of "$1" "$2"; then
			VERDICT="a Wi-Fi station: never bridged (a repeater only into its own repeated bridge)"; return
		fi ;;
	esac
}
# the RTL8372 driver's directory into RTL ("" when the driver is not bound)
rtl_dir() {
	local d
	RTL=
	for d in $RTL_GLOB; do [ -e "$d/jack_block" ] && { RTL=${d%/}; return 0; }; done
	return 1
}
# the switch's L2 lookup of MAC $1 on VLAN $2 into LK: the port (0-9),
# "none" (not learned), "" (no driver, or the lookup failed)
l2_lookup() {
	local l
	LK=
	[ -n "$RTL" ] || return 1
	{ echo "$1 $2" > "$RTL/l2_lookup"; } 2>/dev/null || return 1
	l=; { read -r l < "$RTL/l2_lookup"; } 2>/dev/null
	lk_parse "$l" "$2"
}
# the driver's answer $1 ("<mac> <vid> port=<n>" or "<mac> <vid> none") to
# a lookup on VLAN $2 into LK; rc 1 (LK "") for anything else
lk_parse() {
	local v=$2
	LK=
	set -f
	# shellcheck disable=SC2086 # word split, no glob
	set -- $1
	set +f
	[ $# = 3 ] && [ "$2" = "$v" ] || return 1
	case "$3" in none) LK=none ;; port=[0-9]) LK=${3#port=} ;; *) return 1 ;; esac
}
# which jacks a BPDU on rnr1.<V> latches: V $1, the lookup's answer $2 (LK),
# the jacks applied on VLAN V $3; into ATT (jack numbers) and ATT_HOW
jack_attribute() {
	ATT=
	case "$2" in
	[4-7])	case " $3 " in *" $2 "*)
			ATT=$2; ATT_HOW="attributed: the switch learned the source on port $2, a jack of VLAN $1"; return ;;
		esac
		ATT_HOW="not attributed: the switch learned the source on port $2, not a jack of VLAN $1" ;;
	[0-9])	ATT_HOW="not attributed: the switch learned the source on port $2, not a LAN jack" ;;
	none)	ATT_HOW="not attributed: the source is not in the switch's L2 table on VLAN $1" ;;
	*)	ATT_HOW="not attributed: no answer from the switch's L2 lookup" ;;
	esac
	ATT_HOW="$ATT_HOW, so every jack of VLAN $1"
	set -f
	# shellcheck disable=SC2086 # word split, no glob
	set -- $3
	set +f
	ATT=$*
	[ -n "$ATT" ] || ATT_HOW="$ATT_HOW (none is applied: nothing to latch)"
}
# a BPDU from MAC $1 entered on rnr1.<$2>: attribute it once per source, latch
jack_trip() {
	local x y w jv= n f
	case "$2" in ''|0*|*[!0-9]*) return 0 ;; esac
	if [ -r "$LAN_TRIPPED.src" ]; then
		while read -r x y _; do [ "$x $y" = "$1 $2" ] && return 0; done < "$LAN_TRIPPED.src"
	fi
	for w in $JACKS_APPLIED; do [ "${w#*:}" = "$2" ] && jv="$jv ${w%%:*}"; done
	LK=; rtl_dir; l2_lookup "$1" "$2"
	jack_attribute "$2" "$LK" "$jv"
	for n in $ATT; do
		f=0
		[ -r "$LAN_TRIPPED" ] && while read -r x _; do [ "$x" = "jack$n" ] && f=1; done < "$LAN_TRIPPED"
		[ $f = 1 ] || echo "jack$n" >> "$LAN_TRIPPED"
	done
	echo "$1 $2" >> "$LAN_TRIPPED.src"
	log "BPDU guard: a BPDU from $1 entered on rnr1.$2 (a 2.5G jack of VLAN $2 reaches a switch: a loop risk): jack(s) ${ATT:-none} latched off ($ATT_HOW; rc-service gt-be98-lan restart clears it)"
}
# a jack_status line $1 ("port=6 link=up ... loop=1 loop_pair=6") into
# JS_PORT (4..7, "" otherwise), JS_LOOP (1, 0, ?: not read, "": an older
# driver) and JS_PAIR (the looped-with port, - unknown)
js_parse() {
	local w
	JS_PORT= JS_LOOP= JS_PAIR=-
	set -f
	# shellcheck disable=SC2086 # word split, no glob
	set -- $1
	set +f
	for w; do
		case "$w" in
		port=[4-7]) JS_PORT=${w#port=} ;;
		loop=*) JS_LOOP=${w#loop=} ;;
		loop_pair=[0-9]) JS_PAIR=${w#loop_pair=} ;;
		esac
	done
}
# the loop guard (header): every jack the driver reports in a loop, latched
loop_guard() {
	local l n f x
	rtl_dir || return 0
	[ -r "$RTL/jack_status" ] || return 0
	while IFS= read -r l || [ -n "$l" ]; do
		js_parse "$l"
		[ -n "$JS_PORT" ] && [ "$JS_LOOP" = 1 ] || continue
		n=$JS_PORT f=0
		[ -r "$LAN_TRIPPED" ] && while read -r x _; do [ "$x" = "jack$n" ] && f=1; done < "$LAN_TRIPPED"
		[ $f = 1 ] && continue
		echo "jack$n" >> "$LAN_TRIPPED"
		echo "jack$n $JS_PAIR" >> "$LAN_TRIPPED.loop"
		log "loop guard: the switch's RLDP probe came back to jack $n (looped with port $JS_PAIR: a loop through equipment that sends no BPDU): jack $n latched off (rc-service gt-be98-lan restart clears it)"
	done < "$RTL/jack_status"
}
# the latched jacks (jack<N> lines) as the driver's jack_block: written when
# the driver's differs (after a module reload, or a write gt-be98-lan missed)
jack_block_sync() {
	local m=0 l c
	[ -r "$LAN_TRIPPED" ] || return 0
	while read -r l _; do
		case "$l" in jack[4-7]) m=$(( m | (1 << ${l#jack}) )) ;; esac
	done < "$LAN_TRIPPED"
	[ $m != 0 ] || return 0
	rtl_dir || return 0
	c=; { read -r c < "$RTL/jack_block"; } 2>/dev/null
	case "$c" in ''|*[!0-9a-fA-Fx]*) ;; *) [ $(( c )) = $m ] && { BLOCK_ERR=; return 0; } ;; esac
	if { echo "$m" > "$RTL/jack_block"; } 2>/dev/null; then
		BLOCK_ERR=; log "BPDU guard: the switch's jack_block was ${c:-unread}, written $m (the latched jacks)"
	elif [ -z "${BLOCK_ERR:-}" ]; then
		BLOCK_ERR=1; log "BPDU guard: writing jack_block $m FAILED (retried every sweep)"
	fi
}
# the BPDU guard (header): latch the VLAN jacks whose counter moved, and the
# 2.5G jacks a BPDU source on rnr1.<V> is attributed to
# the latch lock (gt-be98-lan's header, "the latch lock"): never waited
# for; a sweep that does not get it skips the latching (the next one runs it)
lan_lock_try() {
	local p
	if mkdir "$LAN_LOCK" 2>/dev/null; then echo $$ > "$LAN_LOCK/pid"; return 0; fi
	p=; { read -r p < "$LAN_LOCK/pid"; } 2>/dev/null
	if [ -n "$p" ] && ! kill -0 "$p" 2>/dev/null; then
		rm -rf "$LAN_LOCK"
		mkdir "$LAN_LOCK" 2>/dev/null && { echo $$ > "$LAN_LOCK/pid"; return 0; }
	fi
	return 1
}
# the guard under the latch lock: every reading it latches on (the applied
# file, the nft counters, jack_status, the tripped file) is taken after the
# last clear by gt-be98-lan and written before the next one
guard() {
	local p
	if lan_lock_try; then
		guard_locked
		rm -rf "$LAN_LOCK"
	fi
	# the latched ports, for verdict: never a bridge port (detached by the
	# sweep below, at once after the trip and every time after)
	TRIP_LIST=$NL
	[ -r "$LAN_TRIPPED" ] || return 0
	while read -r p _; do
		[ -n "$p" ] && TRIP_LIST="$TRIP_LIST$p$NL"
	done < "$LAN_TRIPPED"
}
guard_locked() {
	local l p n a b c d jk=
	l= JACKS_APPLIED=
	if [ -r "$LAN_APPLIED" ]; then
		while read -r a b c d _; do
			case "$a" in
			guard) l=guard ;;
			jacks) jk=1 ;;	# a jack set is in the switch: the loop guard runs
			# jack|jacktag <n> <bridge> <vid>: the VLANs each jack carries
			jack|jacktag) [ -n "${d:-}" ] && JACKS_APPLIED="$JACKS_APPLIED $b:$d" ;;
			esac
		done < "$LAN_APPLIED"
	fi
	if [ "$l" = guard ]; then
		# one nft: "counter bpdu_in_<port> {" then "packets N bytes M";
		# "set bpdu_src_<vid> {" ... "elements = { <mac>, ... }" ... "}"
		nft list table bridge gt_be98_lan_guard 2>/dev/null | {
			p= v=
			set -f
			while read -r l; do
				# shellcheck disable=SC2086 # word split, no glob (set -f)
				set -- $l
				case "${1:-} ${2:-}" in
				"counter bpdu_in_"*) p=${2#bpdu_in_}; continue ;;
				"packets "*) [ -n "$p" ] && [ "$2" != 0 ] && echo "port $p"; p=; continue ;;
				"set bpdu_src_"*) v=${2#bpdu_src_}; p=; continue ;;
				esac
				p=
				[ -n "$v" ] || continue
				[ "$l" = "}" ] && { v=; continue; }
				for w; do
					w=${w#\{}; w=${w%,}; w=${w%\}}
					case "$w" in [0-9a-f][0-9a-f]:[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f]) echo "src $w $v" ;; esac
				done
			done
		} > "$LAN_TRIPPED.seen" 2>/dev/null
		while read -r a p b _; do
			case "$a" in
			src) jack_trip "$p" "$b"; continue ;;
			port) ;;
			*) continue ;;
			esac
			case "$p" in rnr[23]) ;; *) continue ;; esac
			n=0
			[ -r "$LAN_TRIPPED" ] && while read -r l _; do [ "$l" = "$p" ] && n=1; done < "$LAN_TRIPPED"
			[ $n = 1 ] && continue
			echo "$p" >> "$LAN_TRIPPED"
			log "BPDU guard: a BPDU entered from $p (it reaches a switch: a loop risk): $p latched off (rc-service gt-be98-lan restart clears it)"
		done < "$LAN_TRIPPED.seen"
		rm -f "$LAN_TRIPPED.seen"
	fi
	[ -z "$jk" ] || loop_guard
	jack_block_sync
}
tripped() { case "${TRIP_LIST:-}" in *"$NL$1$NL"*) return 0 ;; esac; return 1; }
# ---- the loop guard of a mesh leaf (rule 7) ----
# the leaf's uplink (gt-be98-l2's trunk bhs) into BH_DEV, BH_MAC ("" none)
bh_uplink() {
	local k v
	BH_DEV= BH_MAC=
	[ -r "$L2_STATE/trunks/bhs" ] || return 1
	while read -r k v _; do [ "$k" = dev ] && BH_DEV=$v; done < "$L2_STATE/trunks/bhs"
	[ -n "$BH_DEV" ] || return 1
	{ read -r BH_MAC < "$SYSNET/$BH_DEV/address"; } 2>/dev/null
	case "$BH_MAC" in [0-9a-f][0-9a-f]:[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f]) return 0 ;; esac
	BH_MAC=; return 1
}
# the guard's rule set for station address $1 (bh_guard loads it)
bh_ruleset() {
	cat <<-EOF
	table bridge gt_be98_bh_guard
	delete table bridge gt_be98_bh_guard
	table bridge gt_be98_bh_guard {
		counter loop_rnr1 { }
		counter loop_rnr2 { }
		counter loop_rnr3 { }
		counter loop_other { }
		chain pre {
			type filter hook prerouting priority -300; policy accept;
			iifname "bhs.*" accept
			ether saddr $1 iifname "rnr1.*" counter name loop_rnr1 drop
			ether saddr $1 iifname "rnr2" counter name loop_rnr2 drop
			ether saddr $1 iifname "rnr3" counter name loop_rnr3 drop
			ether saddr $1 counter name loop_other drop
		}
	}
	EOF
}
# "<counter> <packets>" per loop counter of the guard's listing on stdin
bh_counts() {
	local c= l
	set -f
	while read -r l; do
		# shellcheck disable=SC2086 # word split, no glob (set -f)
		set -- $l
		case "${1:-} ${2:-}" in
		"counter loop_"*) c=${2#loop_} ;;
		"packets "*) [ -n "$c" ] && echo "$c $2"; c= ;;
		esac
	done
	set +f
}
# a loop came back on $1 (rnr1, rnr2, rnr3 or other): the jack(s) latched
bh_latch() {
	local w jv= v n f x att=
	case "$1" in
	rnr2|rnr3)
		f=0; [ -r "$LAN_TRIPPED" ] && while read -r x _; do [ "$x" = "$1" ] && f=1; done < "$LAN_TRIPPED"
		[ $f = 1 ] || echo "$1" >> "$LAN_TRIPPED"
		TRIP_LIST="${TRIP_LIST:-$NL}$1$NL"
		log "loop guard (backhaul): the leaf station's own frame ($BH_MAC) came back in on $1 (the wired jack and the backhaul close a loop through the upstream LAN): $1 latched off (rc-service gt-be98-lan restart clears it)" ;;
	rnr1)	# the 2.5G jacks: the switch's L2 table says where it entered
		rtl_dir
		for w in $JACKS_APPLIED; do
			v=${w#*:}
			case " $jv " in *" $v "*) continue ;; esac
			jv="$jv $v"
			LK=; l2_lookup "$BH_MAC" "$v"
			case "$LK" in [4-7]) case " $att " in *" $LK "*) ;; *) att="$att $LK" ;; esac ;; esac
		done
		if [ -z "$att" ]; then
			for w in $JACKS_APPLIED; do case " $att " in *" ${w%%:*} "*) ;; *) att="$att ${w%%:*}" ;; esac; done
		fi
		for n in $att; do
			f=0; [ -r "$LAN_TRIPPED" ] && while read -r x _; do [ "$x" = "jack$n" ] && f=1; done < "$LAN_TRIPPED"
			[ $f = 1 ] || echo "jack$n" >> "$LAN_TRIPPED"
		done
		log "loop guard (backhaul): the leaf station's own frame ($BH_MAC) came back in on a 2.5G jack (rnr1.<vid>): jack(s)${att:- none} latched off (rc-service gt-be98-lan restart clears it)" ;;
	*)	log "loop guard (backhaul): the leaf station's own frame ($BH_MAC) came back in on a Wi-Fi port of a leaf bridge (a client bridging two networks?): dropped" ;;
	esac
}
# the guard (header, rule 7): loaded while the leaf has its uplink, its
# counters read, the probes sent; nothing forks without an uplink
bh_guard() {
	local c n d v
	if ! bh_uplink; then
		[ -n "${BHG_MAC:-}" ] && { nft delete table bridge gt_be98_bh_guard 2>/dev/null; BHG_MAC=; log "loop guard (backhaul): off (no mesh uplink)"; }
		return 0
	fi
	# a table this guard loaded before (a netguard restart, or --sweep):
	# adopted as it is, its counters kept
	if [ "${BHG_MAC:-}" != "$BH_MAC" ] && nft list table bridge gt_be98_bh_guard 2>/dev/null | grep -q "ether saddr $BH_MAC iifname \"rnr2\""; then
		BHG_MAC=$BH_MAC
	fi
	if [ "${BHG_MAC:-}" != "$BH_MAC" ]; then
		if bh_ruleset "$BH_MAC" | nft -f - 2>/dev/null; then
			BHG_MAC=$BH_MAC; BHG_N=0
			log "loop guard (backhaul): on, station $BH_DEV ($BH_MAC)"
		else
			[ -n "${BHG_ERR:-}" ] || log "loop guard (backhaul): loading table bridge gt_be98_bh_guard FAILED (retried every sweep)"
			BHG_ERR=1; return 0
		fi
		BHG_ERR=
	fi
	nft list table bridge gt_be98_bh_guard 2>/dev/null | bh_counts > "${LAN_TRIPPED}.bh" 2>/dev/null
	n=0
	while read -r c v; do
		[ -n "$v" ] && [ "$v" != 0 ] || continue
		bh_latch "$c"; n=1
	done < "${LAN_TRIPPED}.bh"
	rm -f "${LAN_TRIPPED}.bh"
	[ $n = 0 ] || nft reset counters table bridge gt_be98_bh_guard > /dev/null 2>&1
	# the probes: one ARP DAD probe per backhaul VLAN every BH_PROBE_EVERY sweeps
	BHG_N=$(( ${BHG_N:-0} + 1 ))
	[ "$BHG_N" -ge "$BH_PROBE_EVERY" ] || return 0
	BHG_N=0
	for d in "$SYSNET"/bhs.*; do
		[ -e "$d" ] || continue
		arping -D -q -c 1 -w 1 -I "${d##*/}" 169.254.0.1 > /dev/null 2>&1 &
	done
	wait
	return 0
}
sweep() {
	local b m pp i n f v
	wifi_conf
	lan_conf
	gw_conf
	load_lists
	guard
	bh_guard
	for b in "$SYSNET"/*/brif; do
		[ -d "$b" ] || continue
		m=${b%/brif}; m=${m##*/}
		for pp in "$b"/*; do
			[ -e "$pp" ] || [ -L "$pp" ] || continue
			i=${pp##*/}; n=$SYSNET/$i
			[ -e "$n/brport" ] || continue
			verdict "$i" "$m"
			if [ "$VERDICT" != keep ]; then
				ip link set "$i" nomaster &&
					log "detached $i from bridge $m ($VERDICT)"
				continue
			fi
			v=; { read -r v < "$n/brport/hairpin_mode"; } 2>/dev/null
			if [ "$v" = 1 ]; then
				echo 0 > "$n/brport/hairpin_mode" &&
					log "hairpin turned off on $i (bridge $m)"
			fi
			# Wi-Fi port isolation (the trunk VLAN is never isolated)
			case "$m" in
			brwifi[0-9]*)
				f=0
				case "$i" in bcawl*) case " $ISOLATE " in *" $m "*) f=1 ;; esac ;; esac
				# the repeater's uplink port is the way out: never isolated
				repeater_of "$i" "$m" && f=0
				v=; { read -r v < "$n/brport/isolated"; } 2>/dev/null
				[ "$v" = "$f" ] ||
					{ echo "$f" > "$n/brport/isolated" 2>/dev/null &&
						log "isolated=$f on $i (bridge $m)"; }
				# multicast-to-unicast on the BSS ports (rule 5)
				case "$i" in
				bcawl*)	f=$M2U
					repeater_of "$i" "$m" && f=0
					v=; { read -r v < "$n/brport/multicast_to_unicast"; } 2>/dev/null
					[ -z "$v" ] || [ "$v" = "$f" ] ||
						{ echo "$f" > "$n/brport/multicast_to_unicast" 2>/dev/null &&
							log "multicast_to_unicast=$f on $i (bridge $m)"; } ;;
				esac ;;
			esac
		done
	done
}

# fixed cases, each with its control (the same case with one input changed)
selftest() {
	local fail=0 n=0 c
	log() { :; }	# fixed cases: nothing to the system log
	NETGUARD_PROTECT="rnr* eth* usb* enx*"
	WIFI_STATIONS=$(mktemp); printf 'bcawl5\nbcawl6\n' > "$WIFI_STATIONS"
	WIFI_REPEATERS=$(mktemp); echo 'bcawl6 brwifi60' > "$WIFI_REPEATERS"
	check() {	# <expect keep|detach> <port> <bridge> <LAN_PORTS> <trunk> <vlans>
		LPORTS=$4; LBRIDGE=br-lan; TRUNK=$5; VLANS=$6
		load_lists; verdict "$2" "$3"; c=$VERDICT; [ "$c" = keep ] || c=detach
		n=$((n + 1))
		if [ "$c" = "$1" ]; then echo "ok   $1 $2 in $3 (LAN_PORTS='$4' trunk=$5)"
		else echo "FAIL want $1, got $c: $2 in $3 (LAN_PORTS='$4' trunk=$5)"; fail=$((fail + 1)); fi
	}
	check keep   rnr1    br-lan  "rnr1"          rnr0 ""
	check detach rnr1    br-lan  ""              rnr0 ""		# control: LAN off
	check keep   rnr3    br-lan  "rnr1 rnr2 rnr3" rnr0 ""
	check detach rnr0    br-lan  "rnr0 rnr1"     rnr0 ""		# the uplink, even listed
	check detach rnr0    br-lan  "rnr0"          rnr1 ""		# ... even when not the trunk
	check detach rnr1    brwifi1 "rnr1"          rnr0 "brwifi1:20"	# LAN port in a Wi-Fi bridge
	check detach rnr1    brx     "rnr1"          rnr0 ""		# any other bridge
	check detach rnr2    br-lan  "rnr1"          rnr0 ""		# not listed
	check detach rnr1    br-lan  "rnr1"          rnr1 ""		# the Wi-Fi trunk port
	check keep   rnr1    br-lan  "rnr1"          rnr2 ""		# control: trunk elsewhere
	check detach eth0    br-lan  "eth0"          rnr0 ""		# USB lifeline, even listed
	check keep   rnr0.20 brwifi1 ""              rnr0 "brwifi1:20"	# trunk VLAN (unchanged rule)
	check detach rnr0.20 br-lan  "rnr1"          rnr0 "brwifi1:20"	# trunk VLAN into br-lan
	check detach rnr1.20 br-lan  "rnr1"          rnr0 ""		# sub-interface of a LAN port
	check keep   bcawl0  br-lan  "rnr1"          rnr0 ""		# Wi-Fi joins the wired LAN
	check detach bcawl5  br-lan  "rnr1"          rnr0 ""		# a Wi-Fi station (unchanged rule)
	check keep   bcawl6  brwifi60 ""             rnr0 ""		# the repeater, in its bridge
	check detach bcawl6  brwifi61 ""             rnr0 ""		# ... in another brwifi bridge
	check detach bcawl6  br-lan  "rnr1"          rnr0 ""		# ... in the wired LAN
	check detach bcawl5  brwifi60 ""             rnr0 ""		# a station not listed for it
	check detach rnr0.60 brwifi60 ""             rnr0 "brwifi60:60"	# a trunk VLAN in a repeater bridge, even listed
	check keep   rnr0.61 brwifi61 ""             rnr0 "brwifi61:61"	# control: the same VLAN rule elsewhere
	check keep   bcawl0  brwifi60 ""             rnr0 ""		# an AP of the repeated network
	# VLAN jacks: <expect> <port> <bridge> <native of the port's profile> <l2 vid> <l2 trunk> <trunk>
	L2_STATE=$(mktemp -d)
	vcheck() {
		LPORTS=; LBRIDGE=br-lan; TRUNK=$7; VLANS=${VCV:-}; VN_rnr1= VN_rnr2= VN_rnr3=
		case "$2" in *.*) ;; *) eval "VN_$2=\$4" ;; esac
		rm -f "$L2_STATE"/*
		[ -n "$5" ] && printf 'trunk %s\nvid %s\nmade_bridge 1\nmade_vlan 1\nuser lan\n' "$6" "$5" > "$L2_STATE/$3"
		load_lists; verdict "$2" "$3"; c=$VERDICT; [ "$c" = keep ] || c=detach
		n=$((n + 1))
		if [ "$c" = "$1" ]; then echo "ok   $1 VLAN jack $2 in $3 (native '$4', bridge on $6.$5, trunk $7)"
		else echo "FAIL want $1, got $c: VLAN jack $2 in $3 (native '$4', bridge on $6.$5, trunk $7)"; fail=$((fail + 1)); fi
	}
	vcheck keep   rnr2 brwifi1  921 921 rnr0 rnr0	# the jack in its native VLAN's bridge
	vcheck detach rnr2 brwifi1  ""  921 rnr0 rnr0	# control: no profile
	vcheck detach rnr2 brwifi1  922 921 rnr0 rnr0	# the bridge carries another VLAN
	vcheck detach rnr2 brwifi1  921 ""  rnr0 rnr0	# a bridge gt-be98-l2 does not run
	vcheck detach rnr2 brwifi1  921 921 rnr3 rnr0	# its VLAN on another trunk
	vcheck detach rnr2 br-lan   921 921 rnr0 rnr0	# a profile never admits br-lan
	vcheck detach rnr2 brx      921 921 rnr0 rnr0	# nor another bridge
	vcheck detach rnr1 brwifi1  921 921 rnr0 rnr0	# bare rnr1 never (the 2.5G jacks are rnr1.<vid>), even with a profile
	vcheck detach rnr0 brwifi1  921 921 rnr0 rnr0	# the uplink, never
	vcheck detach rnr0 brwifi1  921 921 rnr1 rnr1	# ... not even when rnr1 is the trunk
	vcheck detach rnr2 brwifi1  921 921 rnr2 rnr2	# the trunk port itself
	vcheck keep   rnr3 brwifi7  30  30  rnr0 rnr0	# rnr3 (a direct jack)
	vcheck detach eth0 brwifi1  921 921 rnr0 rnr0	# the USB lifeline, never
	# a jack latched by the BPDU guard: never a bridge port, profile or not
	TRIP_LIST="${NL}rnr2$NL"
	vcheck detach rnr2 brwifi1  921 921 rnr0 rnr0	# latched: detached in its own native bridge
	TRIP_LIST="${NL}rnr3$NL"
	vcheck keep   rnr2 brwifi1  921 921 rnr0 rnr0	# control: another port latched
	TRIP_LIST=$NL
	# the trunk VLAN of a bridge gt-be98-l2 runs (no WIFI_VLANS: Wi-Fi off)
	vcheck keep   rnr0.921 brwifi1 "" 921 rnr0 rnr0
	vcheck detach rnr0.922 brwifi1 "" 921 rnr0 rnr0	# another VLAN than it runs
	vcheck detach rnr0.921 brwifi1 "" ""  rnr0 rnr0	# a bridge it does not run
	vcheck detach rnr0.921 brwifi1 "" 921 rnr0 rnr2	# the trunk moved
	vcheck detach rnr0.921 br-lan  "" 921 rnr0 rnr0	# never outside brwifi
	# a network without an SSID (gt-be98-lan's brwifi<100000 + id>, no BSS): its trunk VLAN while Wi-Fi runs too
	VCV="brwifi7:921" vcheck keep   rnr0.930 brwifi100003 "" 930 rnr0 rnr0	# Wi-Fi running, 930 not in its WIFI_VLANS: gt-be98-l2 runs the bridge on 930
	VCV="brwifi7:921" vcheck detach rnr0.931 brwifi100003 "" 930 rnr0 rnr0	# control: another VLAN
	VCV="brwifi7:921" vcheck keep   rnr2     brwifi100003 930 930 rnr0 rnr0	# a bare jack (rnr2) native 930 in it
	# the 2.5G jacks of VLAN V (rnr1.<V>): <expect> <port> <bridge> <l2 vid> <l2 trunk> <trunk> <l2 wired members>
	jcheck() {
		LPORTS=; LBRIDGE=br-lan; TRUNK=$6; VLANS=; VN_rnr1= VN_rnr2= VN_rnr3=
		rm -f "$L2_STATE"/*
		if [ -n "$4" ]; then
			printf 'trunk %s\nvid %s\nmade_bridge 1\nmade_vlan 1\nuser lan\n' "$5" "$4" > "$L2_STATE/$3"
			for c in $7; do echo "wired lan $c 1" >> "$L2_STATE/$3"; done
		fi
		load_lists; verdict "$2" "$3"; c=$VERDICT; [ "$c" = keep ] || c=detach
		n=$((n + 1))
		if [ "$c" = "$1" ]; then echo "ok   $1 jacks' VLAN $2 in $3 (bridge on $5.$4, wired '$7', trunk $6)"
		else echo "FAIL want $1, got $c: jacks' VLAN $2 in $3 (bridge on $5.$4, wired '$7', trunk $6)"; fail=$((fail + 1)); fi
	}
	jcheck keep   rnr1.921 brwifi1 921 rnr0 rnr0 "rnr1.921"	# the jacks of 921 in the bridge gt-be98-l2 runs on 921
	jcheck detach rnr1.921 brwifi1 921 rnr0 rnr0 ""		# control: not its recorded wired member
	jcheck detach rnr1.921 brwifi1 922 rnr0 rnr0 "rnr1.922"	# the bridge carries another VLAN
	jcheck detach rnr1.921 brwifi1 922 rnr0 rnr0 "rnr1.921"	# ... even if recorded (stale)
	jcheck detach rnr1.921 brwifi1 ""  rnr0 rnr0 ""		# a bridge gt-be98-l2 does not run
	jcheck detach rnr1.921 brwifi1 921 rnr2 rnr0 "rnr1.921"	# the trunk moved
	jcheck detach rnr1.921 br-lan  921 rnr0 rnr0 "rnr1.921"	# never outside brwifi
	jcheck detach rnr2.921 brwifi1 921 rnr0 rnr0 "rnr2.921"	# only rnr1 carries tagged jacks
	jcheck keep   rnr1.60  brwifi61 60 rnr0 rnr0 "rnr1.60"	# control for the next one
	jcheck detach rnr1.60  brwifi60 60 rnr0 rnr0 "rnr1.60"	# a repeater bridge: no wired VLAN in it
	jcheck keep   rnr1.930 brwifi100003 930 rnr0 rnr0 "rnr1.930"	# the jacks of a network without an SSID
	jcheck detach rnr1.930 brwifi100003 930 rnr0 rnr0 ""		# control: not recorded
	# a BPDU source on rnr1.<V> -> the jacks latched: <expect ATT> <V> <lookup answer> <jacks of V>
	acheck() {
		jack_attribute "$2" "$3" "$4"
		n=$((n + 1))
		if [ "$ATT" = "$1" ]; then echo "ok   latch [$1]: VLAN $2, lookup '$3', jacks of VLAN $2 '$4' ($ATT_HOW)"
		else echo "FAIL want latch [$1] got [$ATT]: VLAN $2, lookup '$3', jacks '$4'"; fail=$((fail + 1)); fi
	}
	acheck "6"   921 6    "4 6"	# found on a jack of the VLAN: that jack only
	acheck "4 6" 921 none "4 6"	# not learned: every jack of the VLAN
	acheck "4 6" 921 5    "4 6"	# learned on a jack of another VLAN: every jack of this one
	acheck "4 6" 921 3    "4 6"	# learned on the uplink: every jack of the VLAN
	acheck "4 6" 921 ""   "4 6"	# no answer: every jack of the VLAN
	acheck ""    921 none ""	# no jack applied on it: nothing to latch
	# a VLAN jacks carry tagged ("jacktag" lines): the same rule over them
	acheck "6"   40  6    "4 6"	# jack 6 carries 40 tagged, the source learned there
	acheck "4 6" 40  7    "4 6"	# learned on jack 7, which does not carry 40
	# the driver's lookup answer: <expect LK> <answer line> <vid asked>
	lcheck() {
		lk_parse "$2" "$3"
		n=$((n + 1))
		if [ "$LK" = "$1" ]; then echo "ok   lookup answer '$2' (VLAN $3) -> '$1'"
		else echo "FAIL lookup answer '$2' (VLAN $3): want '$1' got '$LK'"; fail=$((fail + 1)); fi
	}
	lcheck 6    "02:00:00:00:0a:01 921 port=6" 921
	lcheck none "02:00:00:00:0a:01 921 none" 921
	lcheck ""   "02:00:00:00:0a:01 922 port=6" 921	# another lookup's answer
	lcheck ""   "02:00:00:00:0a:01 921 port=12" 921
	lcheck ""   "02:00:00:00:0a:01 921" 921		# what was written (a plain file, no driver)
	lcheck ""   "none" 921				# before any lookup
	# rule 6: a gateway network's trunk VLAN, never a bridge port; its
	# bridge's wired members and jacks still are (gt-be98-l2 "trunk -")
	gcheck() {	# <expect> <port> <bridge> <GW_VIDS> <l2 trunk|""> <l2 uplink> <vid> <wired> <WIFI_VLANS> <native of rnr2>
		LPORTS=; LBRIDGE=br-lan; TRUNK=rnr0; VLANS=$9; VN_rnr1= VN_rnr2=${10:-} VN_rnr3=; GW_VIDS=$4
		rm -f "$L2_STATE"/*
		if [ -n "$5" ]; then
			printf 'trunk %s\nuplink %s\nvid %s\nmade_bridge 1\nmade_vlan 0\nuser lan\n' "$5" "$6" "$7" > "$L2_STATE/$3"
			for c in $8; do echo "wired lan $c 1" >> "$L2_STATE/$3"; done
		fi
		load_lists; verdict "$2" "$3"; c=$VERDICT; [ "$c" = keep ] || c=detach
		n=$((n + 1))
		if [ "$c" = "$1" ]; then echo "ok   $1 gateway: $2 in $3 (gw vids '$4', l2 trunk '$5' uplink '$6', WIFI_VLANS '$9')"
		else echo "FAIL want $1, got $c: gateway: $2 in $3 (gw vids '$4', l2 trunk '$5' uplink '$6', WIFI_VLANS '$9')"; fail=$((fail + 1)); fi
	}
	gcheck detach rnr0.40 brwifi7 " 40 " rnr0 rnr0 40 "" "brwifi7:40"		# listed in WIFI_VLANS, but 40 is a gateway network
	gcheck keep   rnr0.40 brwifi7 " 41 " rnr0 rnr0 40 "" "brwifi7:40"		# control: another VLAN is the gateway
	gcheck detach rnr0.40 brwifi7 " "    -    rnr0 40 "" "brwifi7:40"		# the list says nothing, gt-be98-l2 runs it as a gateway ("trunk -")
	gcheck detach rnr0.40 brwifi100004 " 40 " - rnr0 40 "" ""			# a network without an SSID
	gcheck detach rnr0.40 brx     " 40 " ""   ""   ""  "" ""			# in any bridge
	gcheck keep   rnr1.40 brwifi7 " 40 " -    rnr0 40 "rnr1.40" ""		# the 2.5G jacks of the gateway network: kept
	gcheck detach rnr1.40 brwifi7 " 40 " -    rnr0 40 "" ""			# control: not a recorded wired member
	gcheck detach rnr1.40 brwifi7 " 40 " -    rnr3 40 "rnr1.40" ""		# control: its uplink is not the current trunk
	gcheck keep   rnr2    brwifi7 " 40 " -    rnr0 40 "" "" 40			# a bare jack native 40 in the gateway bridge
	gcheck detach rnr2    brwifi7 " 40 " -    rnr0 40 "" "" 41			# control: its native is another VLAN
	GW_VIDS=' '
	# rule 7, the mesh backhaul: <expect> <port> <bridge> <its l2 state, printf format> <trunk> <WIFI_VLANS> <backhaul ifname>
	mcheck() {
		LPORTS=; LBRIDGE=br-lan; TRUNK=$5; VLANS=$6; BHIF=$7; VN_rnr1= VN_rnr2= VN_rnr3=
		rm -f "$L2_STATE"/* 2>/dev/null
		[ -n "$4" ] && printf "$4" > "$L2_STATE/$3"
		load_lists; verdict "$2" "$3"; c=$VERDICT; [ "$c" = keep ] || c=detach
		n=$((n + 1))
		if [ "$c" = "$1" ]; then echo "ok   $1 mesh: $2 in $3 (trunk $5, backhaul BSS '${7:-}')"
		else echo "FAIL want $1, got $c: mesh: $2 in $3 (trunk $5, backhaul BSS '${7:-}'): $VERDICT"; fail=$((fail + 1)); fi
	}
	R='trunk rnr0\nuplink rnr0\nvid 10\nmade_bridge 1\nmade_vlan 1\nuser wifi\n'
	mcheck keep   bh0.10 brwifi10 "${R}bh bh0.10 1\n" rnr0 "brwifi10:10" bcawl0-1	# the root's downlink, recorded for the bridge
	mkdir -p "$L2_STATE/trunks"; printf 'dev bcawl0-1.sta1\nrole down\npeer 02:00:00:00:00:0a\n' > "$L2_STATE/trunks/bh0"
	BHLEAF=02:00:00:00:00:0a mcheck keep bh0.10 brwifi10 "${R}bh bh0.10 1\n" rnr0 "brwifi10:10" bcawl0-1	# its peer is the leaf
	BHLEAF=02:00:00:00:00:0b mcheck detach bh0.10 brwifi10 "${R}bh bh0.10 1\n" rnr0 "brwifi10:10" bcawl0-1	# its peer is not the leaf
	rm -rf "$L2_STATE/trunks"; BHLEAF=
	mcheck detach bh0.10 brwifi10 "$R" rnr0 "brwifi10:10" bcawl0-1				# control: not recorded
	mcheck detach bh0.10 brwifi11 "${R}bh bh0.11 1\n" rnr0 "" bcawl0-1			# recorded for another VLAN
	mcheck detach bh0.10 br-lan "" rnr0 "" bcawl0-1						# never outside brwifi
	mcheck keep   bh1.444 brwifi41 'trunk -\nuplink rnr0\nvid 44\nuser wifi\nbh bh1.444 1\n' rnr0 "" bcawl0-1	# a gateway network on its bhvid
	L='trunk bhs\nuplink bhs\nvid 10\nmade_bridge 1\nmade_vlan 1\nuser wifi\n'
	mcheck keep   bhs.10 brwifi10 "$L" bhs "brwifi10:10" ""					# the leaf's uplink VLAN
	mcheck detach bhs.11 brwifi10 "$L" bhs "brwifi10:10" ""					# another VID than the bridge runs
	mcheck detach bhs.10 brwifi10 "$R" rnr0 "brwifi10:10" ""					# a bridge on the wired trunk
	mcheck detach bcawl0-1.sta1 brwifi10 "${R}bh bh0.10 1\n" rnr0 "brwifi10:10" bcawl0-1	# the untagged link: never bridged
	mcheck detach bcawl0-1.sta12 br-lan "" rnr0 "" bcawl0-1					# ... in no bridge
	mcheck keep   bcawl0-2.sta1 brwifi10 "$R" rnr0 "brwifi10:10" bcawl0-1		# control: an AP_VLAN of another BSS (today's rule)
	mcheck keep   bcawl0-1.sta1 brwifi10 "$R" rnr0 "brwifi10:10" ""				# control: no backhaul BSS planned
	mcheck detach rnr0.10 brwifi10 "$L" rnr0 "brwifi10:10" ""					# a leaf bridge: no wired trunk VLAN, even listed
	mcheck keep   rnr0.10 brwifi10 "$R" rnr0 "brwifi10:10" ""					# control: the root's bridge keeps its uplink
	mcheck detach rnr0.10 brwifi10 "$L" bhs "brwifi10:10" ""					# the leaf's trunk is bhs: rnr0.10 is no trunk VLAN
	mcheck keep   rnr1.10 brwifi10 "${L}wired lan rnr1.10 1\n" bhs "brwifi10:10" ""	# the leaf's 2.5G jacks of VLAN 10 (recorded)
	mcheck detach rnr1.10 brwifi10 "$L" bhs "brwifi10:10" ""					# control: not recorded
	VN_rnr2=10; LPORTS=; LBRIDGE=br-lan; TRUNK=bhs; VLANS=; BHIF=; rm -f "$L2_STATE"/*; printf "$L" > "$L2_STATE/brwifi10"
	verdict rnr2 brwifi10; n=$((n + 1))
	if [ "$VERDICT" = keep ]; then echo "ok   keep mesh: a leaf's bare jack rnr2 native 10 in brwifi10"; else echo "FAIL a leaf's bare jack rnr2 native 10: $VERDICT"; fail=$((fail + 1)); fi
	BHIF=
	# the leaf's management veth: <expect> <port> <bridge> <BHMGMT>
	vmcheck() {
		LPORTS=; LBRIDGE=br-lan; TRUNK=bhs; VLANS=; BHIF=; BHMGMT=$4
		load_lists; verdict "$2" "$3"; c=$VERDICT; [ "$c" = keep ] || c=detach
		n=$((n + 1))
		if [ "$c" = "$1" ]; then echo "ok   $1 mesh mgmt: $2 in $3 (planned '$4')"; else echo "FAIL want $1, got $c: mesh mgmt $2 in $3 (planned '$4')"; fail=$((fail + 1)); fi
	}
	vmcheck keep   bhm0p brwifi10 brwifi10	# the management port in the planned bridge
	vmcheck detach bhm0p brwifi20 brwifi10	# another bridge
	vmcheck detach bhm0p brwifi10 ""		# no management planned
	vmcheck detach bhm0  brwifi10 brwifi10	# the box's own address side: never a port
	BHMGMT=
	# the loop guard's counters: <expect> <nft listing>
	bcheck() {
		c=$(printf "$2" | bh_counts | tr '\n' '|')
		n=$((n + 1))
		if [ "$c" = "$1" ]; then echo "ok   bh guard counters -> '$1'"; else echo "FAIL bh guard counters: want '$1' got '$c'"; fail=$((fail + 1)); fi
	}
	bcheck "rnr1 0|rnr2 3|rnr3 0|other 0|" 'table bridge gt_be98_bh_guard {\n\tcounter loop_rnr1 {\n\t\tpackets 0 bytes 0\n\t}\n\tcounter loop_rnr2 {\n\t\tpackets 3 bytes 180\n\t}\n\tcounter loop_rnr3 {\n\t\tpackets 0 bytes 0\n\t}\n\tcounter loop_other {\n\t\tpackets 0 bytes 0\n\t}\n\tchain pre {\n\t}\n}\n'
	bcheck "" 'table bridge other {\n\tchain pre {\n\t}\n}\n'
	# the latch: <expect tripped lines> <counter> <jacks applied>
	BLT=$(mktemp -d)
	latchk() {
		LAN_TRIPPED=$BLT/tripped; rm -f "$LAN_TRIPPED"; RTL_GLOB=/nonexistent; JACKS_APPLIED=$3; BH_MAC=02:00:00:00:00:5a; TRIP_LIST=$NL
		bh_latch "$2"
		c=$({ tr '\n' ' ' < "$LAN_TRIPPED"; } 2>/dev/null)
		n=$((n + 1))
		if [ "$c" = "$1" ]; then echo "ok   bh guard latch $2 -> '$1'"; else echo "FAIL bh guard latch $2: want '$1' got '$c'"; fail=$((fail + 1)); fi
	}
	latchk "rnr2 " rnr2 ""				# the bare jack the loop came back on
	latchk "rnr3 " rnr3 " 4:10"			# ... rnr3, whatever the 2.5G jacks
	latchk "jack4 jack6 " rnr1 " 4:10 6:20 4:20"	# a 2.5G jack, no switch lookup: every jack carrying a VLAN, once each
	latchk "" rnr1 ""				# no jack applied: nothing to latch
	latchk "" other " 4:10"				# a Wi-Fi port: dropped and logged, nothing latched
	rm -rf "$BLT"; LAN_TRIPPED=/nonexistent; JACKS_APPLIED=
	# the loop guard: the driver's jack_status line -> <expect "port loop pair"> <line>
	scheck() {
		js_parse "$2"
		n=$((n + 1))
		if [ "$JS_PORT $JS_LOOP $JS_PAIR" = "$1" ]; then echo "ok   jack_status '$2' -> '$1'"
		else echo "FAIL jack_status '$2': want '$1' got '$JS_PORT $JS_LOOP $JS_PAIR'"; fail=$((fail + 1)); fi
	}
	scheck "6 1 6" "port=6 link=up speed=1000 vid=921 blocked=0 tagged=none enabled=1 loop=1 loop_pair=6"
	scheck "5 0 -" "port=5 link=down speed=? vid=off blocked=0 tagged=none enabled=0 loop=0 loop_pair=-"
	scheck "7 ? -" "port=7 link=down speed=? vid=off blocked=0 tagged=none enabled=1 loop=? loop_pair=-"	# RLDP not running
	scheck "4  -" "port=4 link=up speed=2500 vid=921 blocked=0 tagged=none"		# an older driver: no loop word
	scheck " 1 4" "port=3 link=up speed=10000 loop=1 loop_pair=4"			# never a jack: the uplink
	scheck "6 1 -" "port=6 loop=1 loop_pair=12"					# a pair out of range: unknown
	# the loop guard on a driver directory: <expect tripped lines|loop lines> <jack_status lines>
	RTLT=$(mktemp -d)
	lgcheck() {
		printf "$2" > "$RTLT/jack_status"; : > "$RTLT/jack_block"
		LAN_TRIPPED=$RTLT/tripped RTL_GLOB=$RTLT
		[ -n "${3:-}" ] || rm -f "$LAN_TRIPPED" "$LAN_TRIPPED.loop"
		loop_guard
		c="$({ tr '\n' ' ' < "$LAN_TRIPPED"; } 2>/dev/null)|$({ tr '\n' ' ' < "$LAN_TRIPPED.loop"; } 2>/dev/null)"
		n=$((n + 1))
		if [ "$c" = "$1" ]; then echo "ok   loop guard: '$1'"
		else echo "FAIL loop guard: want '$1' got '$c'"; fail=$((fail + 1)); fi
	}
	lgcheck "jack6 |jack6 6 " "port=4 loop=0 loop_pair=-\nport=5 loop=0 loop_pair=-\nport=6 loop=1 loop_pair=6\nport=7 loop=0 loop_pair=-\n"
	lgcheck "jack6 |jack6 6 " "port=6 loop=1 loop_pair=6\n" again		# still looped: latched once, not twice
	lgcheck "jack6 jack4 jack5 |jack6 6 jack4 5 jack5 4 " "port=4 loop=1 loop_pair=5\nport=5 loop=1 loop_pair=4\n" again	# jacks 4 and 5 added to the latched 6
	lgcheck "jack4 jack5 |jack4 5 jack5 4 " "port=4 loop=1 loop_pair=5\nport=5 loop=1 loop_pair=4\n"	# two jacks cabled into one switch: both latched
	lgcheck "|" "port=4 loop=0 loop_pair=-\nport=6 loop=? loop_pair=-\nport=7 link=up\n"	# control: no loop, unread, an older driver
	lgcheck "|" "port=3 loop=1 loop_pair=4\n"						# control: the uplink is never latched
	rm -rf "$RTLT"; LAN_TRIPPED=/nonexistent RTL_GLOB=/nonexistent
	rm -rf "$L2_STATE"
	rm -f "$WIFI_STATIONS" "$WIFI_REPEATERS"
	echo "selftest: $((n - fail))/$n ok"
	[ $fail -eq 0 ]
}
[ "${1:-}" = --selftest ] && { selftest; exit $?; }
[ "${1:-}" = --sweep ] && { sweep; exit 0; }	# one sweep (the offline tests)

sweep
log "guarding: never bridged: $NETGUARD_PROTECT (sub-interfaces: listed Wi-Fi VLANs in brwifi* only; wired LAN: LAN_PORTS of rnr1-3 in ${LBRIDGE:-br-lan} only, VLAN jacks rnr2-3 only in their native VLAN's network bridge, the 2.5G jacks' rnr1.<vid> only in the bridge gt-be98-l2 runs on <vid>, never rnr0; BPDU guard on the VLAN jacks, a 2.5G jack latched in the switch by attribution); hairpin never on"
# one event stream: every link change from the kernel, plus a periodic tick
# (the tick waits with `read -t` on a FIFO nobody writes: no sleep fork;
# sleep where the shell has no `read -t`)
TICK=${GT_BE98_RUN:-/run}/gt-be98-netguard.tick
{
	ip -o monitor link &
	t=sleep
	if (read -t 0 _ < /dev/null) 2>/dev/null || [ $? = 1 ]; then
		[ -p "$TICK" ] || { rm -f "$TICK"; mkfifo -m 600 "$TICK"; } 2>/dev/null
		[ -p "$TICK" ] && exec 4<> "$TICK" && t=fifo
	fi
	while :; do
		if [ "$t" = fifo ]; then read -t "$NETGUARD_SWEEP" _ <&4; else sleep "$NETGUARD_SWEEP"; fi
		echo tick
	done
} | while read -r _; do sweep; done
