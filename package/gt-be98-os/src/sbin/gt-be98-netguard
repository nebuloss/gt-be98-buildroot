#!/bin/sh
# SPDX-License-Identifier: GPL-2.0
# gt-be98-netguard: the OS owns the base network config. Two invariants hold
# whatever else runs (the web UI, a script, a typo):
#   1. no protected interface (NETGUARD_PROTECT: rnr*, eth*, usb*, enx*: the
#      LAN ports and the USB lifeline) is ever a bridge port: one is
#      detached the moment it is enslaved (a bridged/looped LAN port caused a
#      broadcast storm on the owner's LAN). This holds for the bare ports
#      (rnr0 above all: the trunk and management port). An 802.1Q
#      sub-interface of a protected port (<port>.<vid>) may be a bridge port
#      only as a Wi-Fi network's trunk VLAN: <WIFI_TRUNK>.<vid> in bridge
#      brwifiN, listed as brwifiN:<vid> in WIFI_VLANS (gt-be98-wifi);
#      anything else is detached;
#   2. no bridge port ever has hairpin mode on;
#   3. the Wi-Fi ports (bcawl*) of the WIFI_ISOLATE bridges are isolated,
#      those of other brwifi bridges and the trunk VLANs are not;
#   4. a Wi-Fi STATION (the uplink of gt-be98-wifi, listed in
#      $GT_BE98_WIFI_STATIONS) is never a bridge port: a 3-address station
#      cannot be bridged (cfg80211 refuses it too, IFF_DONT_BRIDGE); its
#      networks are routed (gt-be98-wifi-sta). Except a REPEATER: a
#      4-address station listed in $GT_BE98_WIFI_REPEATERS ("<dev>
#      <bridge>") may be a port of that one brwifi bridge (the repeated
#      network's), never isolated, and that bridge holds no 802.1Q
#      sub-interface of a protected port: with a Wi-Fi uplink in it, a trunk
#      VLAN would join the wired LAN to the uplink's segment (a loop when
#      the uplink AP sits on that LAN).
# One exception to 1., the wired LAN (gt-be98-lan, off by default): a bare
# port listed in LAN_PORTS may be a port of the bridge LAN_BRIDGE (br-lan),
# and of no other bridge, when it is rnr1, rnr2 or rnr3 and not the Wi-Fi
# trunk port. rnr0 never is, even when listed: it is the uplink and the
# management port, on the owner's LAN, and br-lan holds no rnr0 member of
# any kind (rnr0 is detached by 1., its sub-interfaces are allowed in
# brwifiN only), so no bridge ever joins a LAN jack to rnr0's segment
# (docs: open-ethernet docs/eth-lan-2026-11-02.md §3).
# Reacts to every link event (ip monitor) and sweeps every NETGUARD_SWEEP s.
# Settings: /etc/conf.d/gt-be98-netguard, /etc/conf.d/gt-be98-lan.
# `gt-be98-netguard --selftest` checks the bridge-port verdicts on fixed cases.
set -u
NETGUARD_PROTECT=${NETGUARD_PROTECT:-"rnr* eth* usb* enx*"}
NETGUARD_SWEEP=${NETGUARD_SWEEP:-5}

WIFI_AP=/etc/conf.d/gt-be98-wifi-ap
WIFI_DEF=/etc/conf.d/gt-be98-wifi
WIFI_L2=${GT_BE98_WIFI_L2:-/run/gt-be98-wifi/l2.conf}
WIFI_STATIONS=${GT_BE98_WIFI_STATIONS:-/run/gt-be98-wifi/stations}
WIFI_REPEATERS=${GT_BE98_WIFI_REPEATERS:-/run/gt-be98-wifi/repeaters}
LAN_CONF=${GT_BE98_LAN_CONF:-/etc/conf.d/gt-be98-lan}

NL='
'
SYSNET=${GT_BE98_SYSNET:-/sys/class/net}	# (GT_BE98_*: the offline tests only)

log() { logger -t gt-be98-netguard -- "$*" 2>/dev/null; echo "gt-be98-netguard: $*" 2>/dev/null > /dev/kmsg; }
# A sweep forks nothing unless it changes something (img40: lane tx-cpu
# measured 0.03 of a core for this daemon on img39, about 30 forks per 5 s
# sweep): files and sysfs are read with `read`, the bridges' ports are
# listed from <bridge>/brif, the verdict is a variable, not a command
# substitution. Same rules, same order of the checks per port.
# the patterns are matched, never expanded as file names (set -f)
protected() {
	local p r=1
	set -f
	for p in $NETGUARD_PROTECT; do
		# shellcheck disable=SC2254 # $p is a pattern
		case "$1" in $p) r=0; break ;; esac
	done
	set +f
	return $r
}
# the Wi-Fi stations and repeaters of gt-be98-wifi, read once per sweep:
# STA_LIST one name per line, REP_LIST "<dev> <bridge>" per line
load_lists() {
	local a b
	STA_LIST=$NL REP_LIST=$NL
	if [ -r "$WIFI_STATIONS" ]; then
		while IFS= read -r a || [ -n "$a" ]; do STA_LIST="$STA_LIST$a$NL"; done < "$WIFI_STATIONS"
	fi
	if [ -r "$WIFI_REPEATERS" ]; then
		while read -r a b _ || [ -n "${a:-}" ]; do
			[ -n "${a:-}" ] && REP_LIST="$REP_LIST$a ${b:-}$NL"
		done < "$WIFI_REPEATERS"
	fi
}
# is $1 a Wi-Fi station of gt-be98-wifi? (a whole line of the list)
station() { case "$STA_LIST" in *"$NL$1$NL"*) return 0 ;; esac; return 1; }
# is $1 the repeater station of bridge $2 (both given: a brwifi bridge)?
repeater_of() {
	case "$2" in brwifi[0-9]*) ;; *) return 1 ;; esac
	case "$REP_LIST" in *"$NL$1 $2$NL"*) return 0 ;; esac
	return 1
}
# does bridge $1 hold a repeater station (listed for it)?
repeater_bridge() {
	case "$1" in brwifi[0-9]*) ;; *) return 1 ;; esac
	case "$REP_LIST" in *" $1$NL"*) return 0 ;; esac
	return 1
}
# cfg_last FILE KEY CHARS: the value of the LAST line KEY=value, KEY="value"
# of FILE whose value holds only CHARS (a case bracket set), into CFG; ""
# when none (the same lines the former sed -n 's/^KEY="\{0,1\}\([CHARS]*\)"\{0,1\}$/\1/p' | tail -n1 took)
cfg_last() {
	local l v
	CFG=
	[ -r "$1" ] || return 0
	while IFS= read -r l || [ -n "$l" ]; do
		case "$l" in "$2="*) ;; *) continue ;; esac
		v=${l#"$2="}; v=${v#\"}; v=${v%\"}
		# shellcheck disable=SC2254 # $3 is a pattern
		case "$v" in *[!$3]*) continue ;; esac
		CFG=$v
	done < "$1"
}
# Wi-Fi network settings as gt-be98-wifi applies them: its effective file
# while it runs (it adds the VLANs and isolation of its network list,
# WIFI_NETWORKS), else the web UI's file when present, else the defaults
# (WIFI_TRUNK defaults to rnr0)
wifi_conf() {
	local f=$WIFI_DEF
	[ -f "$WIFI_AP" ] && f=$WIFI_AP
	[ -f "$WIFI_L2" ] && f=$WIFI_L2
	cfg_last "$f" WIFI_VLANS 'A-Za-z0-9: '; VLANS=$CFG
	cfg_last "$f" WIFI_ISOLATE 'A-Za-z0-9 '; ISOLATE=$CFG
	cfg_last "$f" WIFI_TRUNK 'A-Za-z0-9'; TRUNK=${CFG:-rnr0}
	case "$TRUNK" in rnr[0-3]) ;; *) TRUNK= ;; esac
}
# is sub-interface $1 the listed trunk VLAN of bridge $2?
wifi_vlan_ok() {
	local p v
	[ -n "$TRUNK" ] || return 1
	case "$2" in brwifi[0-9]*) ;; *) return 1 ;; esac
	for p in $VLANS; do
		v=${p#*:}
		case "$v" in ''|0*|*[!0-9]*) continue ;; esac
		[ "${p%%:*}" = "$2" ] && [ "$1" = "$TRUNK.$v" ] && return 0
	done
	return 1
}
# wired LAN settings (gt-be98-lan): LAN_PORTS, LAN_BRIDGE, parsed not sourced
lan_conf() {
	cfg_last "$LAN_CONF" LAN_PORTS 'A-Za-z0-9 '; LPORTS=$CFG
	cfg_last "$LAN_CONF" LAN_BRIDGE 'A-Za-z0-9_-'; LBRIDGE=${CFG:-br-lan}
}
# may bare port $1 be a port of bridge $2 as a wired LAN port?
lan_port_ok() {
	local p
	case "$1" in rnr[1-3]) ;; *) return 1 ;; esac	# never rnr0, never another port
	[ "$2" = "$LBRIDGE" ] || return 1
	case "$LBRIDGE" in brwifi*|'') return 1 ;; esac
	[ "$1" != "$TRUNK" ] || return 1		# the Wi-Fi trunk port stays a trunk
	for p in $LPORTS; do [ "$p" = "$1" ] && return 0; done
	return 1
}
# the verdict on bridge port $1 of bridge $2 into VERDICT: keep, or why it is detached
verdict() {
	VERDICT=keep
	case "$1" in
	*.*)	# 802.1Q sub-interface of a protected port: listed trunk VLANs only
		if protected "${1%%.*}" && ! wifi_vlan_ok "$1" "$2"; then
			VERDICT="not a listed Wi-Fi VLAN of $2"; return
		fi
		if protected "${1%%.*}" && repeater_bridge "$2"; then
			VERDICT="$2 is a repeater bridge (Wi-Fi uplink): no wired VLAN in it"; return
		fi ;;
	*)	if protected "$1" && ! lan_port_ok "$1" "$2"; then
			VERDICT="protected port: never bridged except a LAN_PORTS port in $LBRIDGE"; return
		fi
		if station "$1" && ! repeater_of "$1" "$2"; then
			VERDICT="a Wi-Fi station: never bridged (a repeater only into its own repeated bridge)"; return
		fi ;;
	esac
}
sweep() {
	local b m pp i n f v
	wifi_conf
	lan_conf
	load_lists
	for b in "$SYSNET"/*/brif; do
		[ -d "$b" ] || continue
		m=${b%/brif}; m=${m##*/}
		for pp in "$b"/*; do
			[ -e "$pp" ] || [ -L "$pp" ] || continue
			i=${pp##*/}; n=$SYSNET/$i
			[ -e "$n/brport" ] || continue
			verdict "$i" "$m"
			if [ "$VERDICT" != keep ]; then
				ip link set "$i" nomaster &&
					log "detached $i from bridge $m ($VERDICT)"
				continue
			fi
			v=; { read -r v < "$n/brport/hairpin_mode"; } 2>/dev/null
			if [ "$v" = 1 ]; then
				echo 0 > "$n/brport/hairpin_mode" &&
					log "hairpin turned off on $i (bridge $m)"
			fi
			# Wi-Fi port isolation (the trunk VLAN is never isolated)
			case "$m" in
			brwifi[0-9]*)
				f=0
				case "$i" in bcawl*) case " $ISOLATE " in *" $m "*) f=1 ;; esac ;; esac
				# the repeater's uplink port is the way out: never isolated
				repeater_of "$i" "$m" && f=0
				v=; { read -r v < "$n/brport/isolated"; } 2>/dev/null
				[ "$v" = "$f" ] ||
					{ echo "$f" > "$n/brport/isolated" 2>/dev/null &&
						log "isolated=$f on $i (bridge $m)"; } ;;
			esac
		done
	done
}

# fixed cases, each with its control (the same case with one input changed)
selftest() {
	local fail=0 n=0 c
	NETGUARD_PROTECT="rnr* eth* usb* enx*"
	WIFI_STATIONS=$(mktemp); printf 'bcawl5\nbcawl6\n' > "$WIFI_STATIONS"
	WIFI_REPEATERS=$(mktemp); echo 'bcawl6 brwifi60' > "$WIFI_REPEATERS"
	check() {	# <expect keep|detach> <port> <bridge> <LAN_PORTS> <trunk> <vlans>
		LPORTS=$4; LBRIDGE=br-lan; TRUNK=$5; VLANS=$6
		load_lists; verdict "$2" "$3"; c=$VERDICT; [ "$c" = keep ] || c=detach
		n=$((n + 1))
		if [ "$c" = "$1" ]; then echo "ok   $1 $2 in $3 (LAN_PORTS='$4' trunk=$5)"
		else echo "FAIL want $1, got $c: $2 in $3 (LAN_PORTS='$4' trunk=$5)"; fail=$((fail + 1)); fi
	}
	check keep   rnr1    br-lan  "rnr1"          rnr0 ""
	check detach rnr1    br-lan  ""              rnr0 ""		# control: LAN off
	check keep   rnr3    br-lan  "rnr1 rnr2 rnr3" rnr0 ""
	check detach rnr0    br-lan  "rnr0 rnr1"     rnr0 ""		# the uplink, even listed
	check detach rnr0    br-lan  "rnr0"          rnr1 ""		# ... even when not the trunk
	check detach rnr1    brwifi1 "rnr1"          rnr0 "brwifi1:20"	# LAN port in a Wi-Fi bridge
	check detach rnr1    brx     "rnr1"          rnr0 ""		# any other bridge
	check detach rnr2    br-lan  "rnr1"          rnr0 ""		# not listed
	check detach rnr1    br-lan  "rnr1"          rnr1 ""		# the Wi-Fi trunk port
	check keep   rnr1    br-lan  "rnr1"          rnr2 ""		# control: trunk elsewhere
	check detach eth0    br-lan  "eth0"          rnr0 ""		# USB lifeline, even listed
	check keep   rnr0.20 brwifi1 ""              rnr0 "brwifi1:20"	# trunk VLAN (unchanged rule)
	check detach rnr0.20 br-lan  "rnr1"          rnr0 "brwifi1:20"	# trunk VLAN into br-lan
	check detach rnr1.20 br-lan  "rnr1"          rnr0 ""		# sub-interface of a LAN port
	check keep   bcawl0  br-lan  "rnr1"          rnr0 ""		# Wi-Fi joins the wired LAN
	check detach bcawl5  br-lan  "rnr1"          rnr0 ""		# a Wi-Fi station (unchanged rule)
	check keep   bcawl6  brwifi60 ""             rnr0 ""		# the repeater, in its bridge
	check detach bcawl6  brwifi61 ""             rnr0 ""		# ... in another brwifi bridge
	check detach bcawl6  br-lan  "rnr1"          rnr0 ""		# ... in the wired LAN
	check detach bcawl5  brwifi60 ""             rnr0 ""		# a station not listed for it
	check detach rnr0.60 brwifi60 ""             rnr0 "brwifi60:60"	# a trunk VLAN in a repeater bridge, even listed
	check keep   rnr0.61 brwifi61 ""             rnr0 "brwifi61:61"	# control: the same VLAN rule elsewhere
	check keep   bcawl0  brwifi60 ""             rnr0 ""		# an AP of the repeated network
	rm -f "$WIFI_STATIONS" "$WIFI_REPEATERS"
	echo "selftest: $((n - fail))/$n ok"
	[ $fail -eq 0 ]
}
[ "${1:-}" = --selftest ] && { selftest; exit $?; }
[ "${1:-}" = --sweep ] && { sweep; exit 0; }	# one sweep (the offline tests)

sweep
log "guarding: never bridged: $NETGUARD_PROTECT (sub-interfaces: listed Wi-Fi VLANs in brwifi* only; wired LAN: LAN_PORTS of rnr1-3 in ${LBRIDGE:-br-lan} only, never rnr0); hairpin never on"
# one event stream: every link change from the kernel, plus a periodic tick
# (the tick waits with `read -t` on a FIFO nobody writes: no sleep fork;
# sleep where the shell has no `read -t`)
TICK=${GT_BE98_RUN:-/run}/gt-be98-netguard.tick
{
	ip -o monitor link &
	t=sleep
	if (read -t 0 _ < /dev/null) 2>/dev/null || [ $? = 1 ]; then
		[ -p "$TICK" ] || { rm -f "$TICK"; mkfifo -m 600 "$TICK"; } 2>/dev/null
		[ -p "$TICK" ] && exec 4<> "$TICK" && t=fifo
	fi
	while :; do
		if [ "$t" = fifo ]; then read -t "$NETGUARD_SWEEP" _ <&4; else sleep "$NETGUARD_SWEEP"; fi
		echo tick
	done
} | while read -r _; do sweep; done
