#!/bin/sh
# SPDX-License-Identifier: GPL-2.0
# gt-be98-wifi-gen: render the hostapd configs of the Wi-Fi networks.
#
# A Wi-Fi network (SSID, security, VLAN, band set) is one BSS on each radio
# of its band set. Per radio this writes one hostapd config: the radio-wide
# lines, the radio's anchor BSS (slot 0, the radio netdev bcawlN) and one
# bss= section per further network (slot k, netdev bcawlN-k). All the radio
# configs are run by ONE hostapd process (gt-be98-wifi) so that hostapd
# builds the 6 GHz Reduced Neighbor Report and a BSS can be added/removed at
# runtime through the global control socket. For that, each BSS also gets a
# single-BSS config (ADD bss_config=<phy>:<file>).
#
#   gt-be98-wifi-gen -n NETWORKS -o OUTDIR [-s SLOTS] [-m "2g=MAC 5gl=MAC ..."]
#                    [-d "2g=bcawl3 5gl=bcawl0 5gh=bcawl1 6g=bcawl2"]
#                    [-C MAX_BSS] [-x CTRL_DIR] [-c] [-R 0|1] [-K 0|1] [-N]
#                    [-T "D HH:MM"] [-Q] [-U "2g=MHz ..."] [-X STA_CTRL_DIR] [-S]
#                    [-B "BANDS"]
#   gt-be98-wifi-gen -F
#
#   -n  the network list (format below)          -o  output dir (created)
#   -s  slot state file: read, and rewritten when the plan is valid (unless
#       -N). Sticky slot and BSSID index per (network, radio).
#   -m  the radios' own MAC addresses (default: /sys/class/net/<dev>/address)
#   -d  band -> radio netdev (default the driver's fixed names, ifname_fixed=1)
#   -C  BSSes per radio, the anchor included, 1..8 (default 4). The service
#       passes the count the driver advertises (`iw phy`: #{ AP } <= N, the
#       firmware's own mbss8 on this box); 8 is also all the BSSID rule
#       below can give (one radio address + 7)
#   -x  ctrl_interface of every BSS (default /run/hostapd)
#   -c  write country_code (only when the regulatory database is loaded:
#       without it hostapd hangs in COUNTRY_UPDATE)
#   -R  rnr=1 on the 2.4/5 GHz BSSes (default 1)
#   -K  the driver applies a non-default address to the radio's FIRST BSS
#       (bsscfg 0, the anchor). Then: a network promoted to the anchor keeps
#       its BSSID, a bssid.<band>= on the anchor is applied, and the 6 GHz
#       anchor takes a locally administered block of its own (radio address
#       with the LA bit, low 3 bits 0) so 6 GHz carries 8 BSSes. Default 0:
#       open-wifi's driver does not set bsscfg 0's address yet (its MBSS MAC
#       set skips bsscfg 0), so the anchor is always the radio's own address
#   -N  dry run: the slot file is not rewritten (OUTDIR/slots.new is)
#   -S  skip a network that fails its OWN checks (ssid, security,
#       passphrase, RADIUS, bands, vlan=/routed=/repeated=, bssid, an
#       unknown or refused key) instead of refusing the whole list: a
#       warning "network N skipped: <why>" and a plan line "skipped <id>";
#       the other networks, the radios and the station are rendered as if
#       it were not listed (it loses its sticky slots, like a deleted one).
#       A network that clashes with a skipped one (same ssid, vlan, bssid,
#       routed subnet, a second repeated=1) is skipped too. The service
#       passes it, so one bad network never takes every radio down; the web
#       UI's dry run does not (-N without -S), so a bad network is refused
#       at the save. List-wide errors still refuse the list: country=,
#       radio=/station= blocks, a network id or block listed twice, the
#       per-radio limit, slot.<band>=, bssid.6g= on a secondary
#   -T  the local time the schedules are evaluated at: D = ISO weekday
#       (1 = Monday .. 7 = Sunday, `date +%u`), HH:MM. Without -T every
#       schedule is checked but treated as on (the service passes -T only
#       when the clock is synchronised: gt-be98-wifi-sched now)
#   -Q  query: check the list, print the schedule state (OUTDIR/sched
#       format, below) on stdout and write nothing; -o is not needed
#   -U  the frequency (MHz) each ASSOCIATED station is on, "band=MHz ...":
#       the APs of a station radio take the uplink's channel (one channel per
#       radio: the driver refuses an AP on another one, -EBUSY), the width
#       lowered to the widest block that holds it (a warning says so). The
#       service passes what wpa_supplicant reports (gt-be98-wifi-sta freq)
#   -X  ctrl_interface of the station's wpa_supplicant (default
#       /run/wpa_supplicant)
#   -6  the highest 6 GHz channel the country allows (the service reads it
#       from the 6 GHz radio's `iw phy` channel list, e.g. 93 in DE/FR:
#       5945-6425 MHz). A 320 MHz block must end inside it. Default: 233
#       with country=US, else 93 (the 5945-6425 MHz band of the EU and
#       most other regulators)
#   -B  the radios (bands, "2g 5gl ...") whose driver advertises AP beacon
#       protection (nl80211 NL80211_EXT_FEATURE_BEACON_PROTECTION: `iw phy
#       <phy> info` lists "[ BEACON_PROTECTION ]"; the service passes them).
#       On those radios every SAE (sae, psk2sae) and OWE BSS gets
#       beacon_prot=1 (BIGTK, 802.11-2020 beacon protection), as stock does
#       (its bcnprot enable = 1 on SAE, 0 on WPA2); WPA2-only, Enterprise
#       and open BSSes never. Without -B none. NB hostapd 2.12 itself
#       (a) clears beacon_prot when the driver lacks the feature
#       (wpa_auth_glue.c) and advertises it (Extended Capabilities bit 84)
#       only with it, and (b) turns it ON by itself on every BSS with PMF
#       of an EHT radio (ieee80211be=1, the default: ap_config.c "Enabling
#       beacon protection as IEEE 802.11be is enabled"), Enterprise with
#       PMF included. So -B decides for HE-only radios (be=0) and states
#       the intent; on EHT radios hostapd's own rule wins
#   -F  print what this generator supports (one "<what> <values>" per
#       line: feature <name> 0|1, width <band> <MHz...>, security <modes>,
#       station_security <modes>, max_clients <min> <max>) and exit. The web
#       UI reads it: a feature another change adds to the generator shows up
#       there by itself. Radio keys: feature he (ax=), eht (be=),
#       twt_responder (twt=), zwdfs, monitor, led; feature station (station= blocks), routed
#       (routed= networks).
#
# Network list (hostapd-like: key=value, the value is the rest of the line,
# never quoted; '#' comment lines; a block starts at network= or radio=):
#   country=XX                      global, before the first block; absent:
#                                   FR (owner D20: the default country).
#                                   With -c it is written as country_code
#                                   (+ ieee80211d, and ieee80211h on 5 GHz);
#                                   hostapd hints it to cfg80211 and the
#                                   driver puts the firmware in that country
#                                   at the radio's next start (open-wifi
#                                   bca_reg.c: E0 locale + abbrev override)
#   radio=2g|5gl|5gh|6g             radio-wide settings of one radio
#     enabled=1  channel=N  width=20|40|80|160|320
#                                   (a 5 GHz DFS channel, 52-144, needs
#                                   -c: hostapd runs DFS only with
#                                   ieee80211h, which needs the country_code;
#                                   without -c a warning, and the radio
#                                   does not start; a 5 GHz radio is
#                                   always written hostapd's chanlist= of
#                                   its own channels, 5gl 36-64, 5gh
#                                   100-144 149-177, so a move after a
#                                   radar stays in the radio's band)
#                                   2g: 20, 40 (40: rendered at 20 MHz
#                                   with a warning while HT40_2G=0, see
#                                   below); 5gl/5gh: 20, 40, 80, 160
#                                   (160: the blocks 36-64 and 100-128,
#                                   centre 50/114, [VHT160]; each holds
#                                   DFS channels, so 160 MHz needs -c like
#                                   a DFS channel; 5gh 100-128 holds the
#                                   ETSI weather channels 120-128: a 10 min
#                                   CAC in an ETSI country);
#                                   6g: 20, 40, 80, 160, 320 (HE, op_class
#                                   131-134; 320 is EHT, op_class 137,
#                                   rendered with ieee80211be=1). The
#                                   channel must have a block of that width
#                                   (6g: none at 40 for 233, none at 80/160/
#                                   320 for 225-233); 320 takes the 320-1
#                                   block (centre 31/95/159) that fits in
#                                   the country's 6 GHz band (-6), else the
#                                   320-2 block (centre 63/127/191) that
#                                   holds the channel and fits: in DE/FR
#                                   (5945-6425 MHz, channels 1-93) ch 1-61
#                                   -> 31, ch 65-93 -> 63; no 320 block
#                                   fits: rendered at 160 with a warning.
#                                   6g default width: 320 (owner 11-10;
#                                   160 with be=0); others 20
#     schedule=WINDOWS              optional: the radio runs only inside
#                                   these windows (all its BSSes stop
#                                   outside them; format below)
#     airtime=0|1|2|3               hostapd airtime_mode: 0 off (default),
#                                   1 static weights, 2 dynamic (per-BSS
#                                   shares), 3 limit (airtime_limit BSSes
#                                   capped at their share). With 2|3 a
#                                   network without airtime_weight gets 1
#     ax=0|1                        HE (802.11ax, Wi-Fi 6): default 1, writes
#                                   ieee80211ax=1 (5 GHz: the HE operation
#                                   width/centre = the VHT ones). The driver
#                                   (open-wifi om-he-off 1341a24f, owner D18)
#                                   turns the firmware's HE off when hostapd
#                                   sends no HE element: ax=0 = no HE on air.
#                                   6g is HE only: ax=0 there is refused
#     be=0|1                        EHT (802.11be, Wi-Fi 7): default 1 when
#                                   ax=1 (EHT on every radio, like stock),
#                                   writes ieee80211be=1 and the EHT operation
#                                   width/centre = the HE ones (hostapd takes
#                                   the channel width from them when be=1);
#                                   6g 320 MHz: eht_oper_chwidth=9. Needs HE:
#                                   be=1 with ax=0 is refused (ax=0 alone
#                                   means be=0); 320 MHz needs be=1. The
#                                   driver turns EHT off without ieee80211be
#                                   Transmit beamforming (no key: always,
#                                   stock's set, open-wifi PHYF-5): 5gl/5gh
#                                   vht_capab=[SU-BEAMFORMER][SU-BEAMFORMEE]
#                                   [MU-BEAMFORMER]; 5gl/5gh/6g with HE
#                                   he_su/he_mu_beamformer=1, with EHT
#                                   eht_su/eht_mu_beamformer=1; 2g SU only:
#                                   he_su_beamformer=1, eht_su_beamformer=1
#     twt=0|1                       hostapd he_twt_responder (radio-wide in
#                                   hostapd): default 1, hostapd's own
#                                   default; 0 writes he_twt_responder=0.
#                                   Acts only with HE (hostapd advertises
#                                   TWT with HE only)
#     zwdfs=0|1                     5gl/5gh: zero-wait DFS, hostapd
#                                   enable_background_radar=1 (the driver
#                                   runs the CAC of a DFS channel= in the
#                                   background while the radio starts on a
#                                   non-DFS channel, then hostapd moves to
#                                   it). Acts on a DFS channel with the
#                                   country written (-c: ieee80211h=1).
#                                   US and JP only: in every other country
#                                   (an ETSI DFS region) it is DROPPED with
#                                   a warning, never written (open-wifi
#                                   ZW-N3: the driver refuses a background
#                                   CAC there, and hostapd 2.12 then fails
#                                   the radio's setup: the AP would not
#                                   start)
#     monitor=0|1                   1: the radio is a monitor, no BSS: its
#                                   networks are not rendered there (they
#                                   keep their slots) and the plan gets a
#                                   monitor line (its channel/width); the
#                                   service creates <dev>mon on it
#     led=0|1                       the radio's LED (gt-be98-leds): default
#                                   1 (radio up + traffic), 0 off; a led
#                                   line per radio in the plan
#   network=ID                      1..99999, the bridge is brwifiID
#     ssid=...                      1-32 bytes
#     security=open|owe|open-owe|psk2|psk2sae|sae|wpa2-eap|wpa3-eap|wpa2-wpa3-eap
#                                   open-owe: open on 2.4/5 GHz, OWE on 6 GHz;
#                                   psk2sae: WPA2/WPA3, pure SAE on 6 GHz;
#                                   *-eap: Enterprise (802.1X, external RADIUS):
#                                   wpa2-eap WPA-EAP; wpa3-eap WPA-EAP-SHA256,
#                                   PMF required; wpa2-wpa3-eap both, PMF
#                                   optional, wpa3-eap on 6 GHz
#     passphrase=...                8-63 printable ASCII (psk2: or 64 hex)
#     radius_server=IP              *-eap: the RADIUS authentication server,
#                                   an IPv4 or IPv6 address (no host name)
#     radius_port=1..65535          default 1812
#     radius_secret=...             *-eap: the RADIUS shared secret, 1-128
#                                   printable ASCII, no leading/trailing space
#     radius_acct_server=IP  radius_acct_port=1..65535 (default 1813)
#     radius_acct_secret=...        optional RADIUS accounting (default secret:
#                                   radius_secret)
#     bands=2g 5gl 5gh 6g           any non-empty subset
#     vlan=1..4094                  one VLAN per network: required, unless
#                                   the network is routed=
#     routed=A.B.C.1/P              instead of vlan=: the network is ROUTED
#                                   behind the station uplink (station=): its
#                                   bridge brwifiID holds only its BSSes and
#                                   gets the address A.B.C.1/P (the first host
#                                   of a private subnet, RFC 1918, P = 16..30,
#                                   no overlap with another routed network);
#                                   the service serves DHCP/DNS on it and NATs
#                                   it out of the station (gt-be98-wifi-sta).
#                                   A 3-address station cannot be bridged (no
#                                   4-address/WDS uplink): routed is the only
#                                   way a network reaches a Wi-Fi uplink
#                                   (a 4-address one: repeated=1).
#                                   Needs a station= block in the list
#     repeated=1                    instead of vlan=/routed=: the network is
#                                   BRIDGED to the station uplink (Wi-Fi
#                                   repeater, layer 2): its bridge brwifiID
#                                   holds its BSSes and the station netdev in
#                                   4-address mode, no VLAN, no trunk port,
#                                   no address, no DHCP/NAT from the box (the
#                                   uplink's LAN serves its clients). Needs a
#                                   station= block with repeater= set; at most
#                                   one repeated network (the station is one
#                                   bridge port)
#     hidden=0|1  isolate=0|1  max_clients=1..2007
#                                   max_clients: hostapd max_num_sta, per
#                                   BSS (a client beyond it is
#                                   disassociated, reason 5 "AP busy")
#     schedule=WINDOWS              optional: the network runs only inside
#                                   these windows (its BSSes are removed
#                                   outside them, keeping their slots)
#     airtime_weight=1..1000        hostapd airtime_bss_weight: radio
#                                   airtime=1, the weight of its stations
#                                   (mac80211 default 256); 2|3, the BSS's
#                                   relative share
#     airtime_limit=0|1             hostapd airtime_bss_limit (airtime=3)
#     airtime_sta_weight=MAC W      one station's weight, W = 1..65535
#                                   (airtime=1); the key repeats, at most
#                                   64 per network
#     kv=0|1                        802.11k/v roaming help: hostapd
#                                   rrm_neighbor_report=1 + bss_transition=1
#                                   (neighbor reports, BSS transition
#                                   management). Rendered only while KV=1
#                                   (below; -F feature kv): until the driver
#                                   passes the RRM/WNM action frames through
#                                   (open-wifi INV-T6) kv=1 is DROPPED with
#                                   a warning, never written
#     twt=0|1  wds=0|1              network level: refused (-F: feature
#                                   twt 0, feature wds 0). TWT is radio-wide
#                                   in hostapd (radio twt=, feature
#                                   twt_responder); wds is reserved for
#                                   4-address clients
#     slot.<band>=K  mac.<band>=S   optional explicit sticky slot / BSSID
#                                   index S = 1..7 (0: the anchor's)
#     bssid.<band>=MAC              optional: this BSS's own address (default
#                                   automatic, below); bssid=MAC for a
#                                   one-band network. Unicast, never a
#                                   radio's address or another BSS's;
#                                   warned when not locally administered.
#                                   2.4/5 GHz secondary: the radio's other
#                                   secondaries move into its block (the
#                                   firmware MBSS rule: one block, one index
#                                   each, never the anchor's index; two
#                                   custom addresses on one radio must share
#                                   the block). The anchor (slot 0): only
#                                   with -K. 6 GHz: only the anchor (with
#                                   -K); the secondaries are its
#                                   nontransmitted BSSIDs, derived, and a
#                                   bssid.6g= on one is refused
#   station=2g|5gl|5gh|6g           the radio's STATION (Wi-Fi uplink, client
#                                   mode): wpa_supplicant on the radio netdev
#                                   bcawlN itself (bsscfg 0, the firmware's
#                                   AP+STA model). At most one station= block.
#                                   The radio's networks then run on virtual
#                                   interfaces only (slots 1.., at most -C - 1
#                                   of them: slot 0 and the radio's own
#                                   address are the station's), on the
#                                   uplink's channel once associated (-U)
#     enabled=0|1                   default 1; 0 keeps the settings, the
#                                   radio is AP-only (no station)
#     ssid=...                      1-32 bytes; empty or absent: the station
#                                   runs with no network (it only scans)
#     security=psk2|sae             psk2: WPA2-PSK (CCMP); sae: WPA3-SAE (H2E
#                                   or hunting-and-pecking, PMF required);
#                                   6g: sae only
#     passphrase=...                psk2: 8-63 printable ASCII (not both '"'
#                                   and '#': wpa_supplicant's comment rule)
#                                   or 64 hex; sae: 8-63 printable ASCII
#     bssid=aa:bb:cc:dd:ee:ff       optional: join this AP only
#     repeater=0|4addr|multiap      the station's uplink mode: 0 (default)
#                                   3-address, its networks are routed=;
#                                   4addr: nl80211 4-address mode on before
#                                   the join (an uplink with hostapd
#                                   wds_sta=1, or a Broadcom DWDS AP);
#                                   multiap: Multi-AP backhaul STA
#                                   (wpa_supplicant multi_ap_backhaul_sta=1,
#                                   an EasyMesh/Multi-AP backhaul BSS; the
#                                   join is refused by an AP without it).
#                                   Either one is bridged into the repeated=
#                                   network's bridge; routed= networks need
#                                   repeater=0 (a bridge port routes nothing)
#
# Schedules (radio= and network= blocks): WINDOWS is 1-32 windows
# separated by blanks or commas, each DAYS@HH:MM-HH:MM in local time; DAYS
# is daily, weekdays (mon-fri), weekend (sat-sun), a day mon..sun or a range
# of days (fri-mon wraps). A window whose end is not after its start runs
# past midnight into the next day (22:00-06:00); 24:00 is the end of the
# day. Empty or absent: always on. Outside every window the network (or
# radio) is not rendered: a network keeps its slot and BSSID index (they
# are not handed to another network), except slot 0, whose radio needs an
# anchor (the next network is promoted, as when the anchor is deleted).
# The per-radio limit counts the scheduled-off networks too, so that a list
# accepted at one time is accepted at every time.
#
# Slots: a network keeps the slot it got on a radio (remembered in -s, or
# given as slot.<band>) as long as it stays on that radio: deleting another
# network never renumbers it. A new network takes the lowest free slot, in
# list order. When the anchor (slot 0) leaves a radio, the network with the
# lowest slot becomes the anchor (that radio restarts once).
#
# BSSIDs (explicit bssid= in every section) follow the FIRMWARE's MBSS
# rule (mbss8, proven on silicon: open-wifi docs/AUDIT-2026-10-27-MULTI-
# SSID-STATUS.md §9): a BSS's ucode index is the low 3 bits of its address's
# last byte; every BSS of a radio needs its own index, the anchor's (the
# radio address) included, and all the secondaries of a radio share one
# address block (octets 0-4 and the bits of octet 5 above the index).
# Anything else is refused by the firmware (bsscfg:cur_etheraddr -21) and
# the BSS does not start. Radio MAC m, index S = 1..7:
#   octet 0    = (0x60 + ((m5 + adj) % 15) * 8) | 0x02 - locally
#                administered, one prefix per radio (the stock ASUS prefix,
#                rc gen_mssid_hwaddr_mac0), so radios whose addresses share
#                a block (consecutive board MACs) get disjoint blocks
#   octets 1-4 = those of m (never a carry: the block stays fixed)
#   octet 5    = (m5 & 0xf8) | ((m5 + S) & 7)
# so index (m5 + S) & 7 is never the anchor's (m5 & 7) and the 7 indices of
# a radio are distinct. S = 0 is the radio's own address (the anchor). An
# index whose BSSID equals any radio's address or another BSS's BSSID (any
# radio) is never handed out (another index of the block is). The same rule
# holds unchanged under a 4-bit (mbss16) mask.
# ★6 GHz: octet 0 is the radio's own (no LA prefix). On 6 GHz the firmware
# advertises the radio's secondaries as NONTRANSMITTED BSSIDs in the
# anchor's Multiple BSSID element, and a client derives each one from the
# anchor's address by the 802.11 BSSID-index rule (the low bits + index,
# every other bit the anchor's). A secondary whose own address differs (the
# LA prefix) is advertised under one address and owned under another: the
# client authenticates to an address nobody answers (release-soak
# 1102-1500: OWE on bcawl2-1 = a2:..:09, the client tried 20:..:09 and timed
# out). [HYP, measured for index 1 only: the derived index is the low
# bits of the secondary's own address; mbss8 and mbss16 agree while the
# radio address's low 3 bits are 0, as on this board.]
#
# The block in force per radio (anchor address A, index a = A & 7; the
# secondaries' block B): by default A = the radio address, B as above
# (6g: B = A); a custom anchor sets A (6g: B = A too); a custom 2.4/5 GHz
# secondary sets B; with -K the 6 GHz A = B = the radio address with the LA
# bit and the low 3 bits 0 (when no address of that block is in use, else
# the radio address and a warning). Secondary S = B's octets 0-4 and the
# bits of octet 5 above the index, index (a + S) & 7.
#
# OUTDIR: hostapd-<dev>.conf, bss-<ifname>.conf, hdr-<dev>, sec-<ifname>
# (mode 0600: they hold the passphrases and RADIUS secrets) and plan:
#   radio <band> <dev> <conf> <sha256 of the radio-wide lines> <first BSS ifname>
#     (the first BSS is the config's interface=: the radio netdev, or on a
#     station radio the virtual interface of its lowest slot, which the
#     service creates before hostapd starts it)
#   bss <dev> <ifname> <slot> <net> <index> <bssid> <bridge> <conf> <sha256 of the section>
#   net <id> <bridge> <vlan> <isolate 0|1>     (networks on >= 1 radio)
#   routed <id> <bridge> <A.B.C.1/P> <isolate 0|1>   (routed= networks on >= 1 radio)
#   station <band> <dev> <conf> <sha256 of conf> <first AP ifname or ->
#                                              (an enabled station on a live radio;
#                                               conf: sta-<dev>.conf, wpa_supplicant)
#   repeated <id> <bridge> <isolate 0|1>       (the repeated=1 network, on >= 1 radio)
#   repeater <dev> <4addr|multiap> <bridge or ->   (a live station with repeater= set:
#                                               the bridge it joins, - when no
#                                               repeated network is rendered)
#   monitor <band> <dev> <MHz> <width> <centre MHz>   (monitor=1 radios)
#   led <band> <dev> 0|1                       (every radio of -d)
#   skipped <id>                               (-S: a network left out, see -S)
# and sched (also -Q's output), one line per network/radio that has a
# schedule, in list/band order: net <id> on|off, radio <band> on|off
# Exit 1 with the reasons on stderr when the list is refused: then nothing
# but OUTDIR is written.
set -u
# [open-wifi INV-HT40-2G] THE one switch of 2.4 GHz 40 MHz. 0 (interim, owner
# OD1 pending its bench arm): the driver's 2.4 GHz wiphy advertises HT20 only
# (open-wifi ap_2ghz_ht=1: no IEEE80211_HT_CAP_SUP_WIDTH_20_40), so hostapd
# would refuse ht_capab=[HT40+/-] and the radio stay dark: a radio=2g width=40
# is RENDERED AT 20 MHz with a warning (accepted, so a stored 40 never stops
# the radio). 1: width=40 renders ht_capab=[HT40+/-] (set it once the bench
# shows the firmware holds 40 MHz on 2.4 GHz and the driver advertises it).
# -F says which: feature ht40_2g 0|1 (the web UI warns on 0).
# (GT_BE98_HT40_2G: the offline test harness only)
HT40_2G=${GT_BE98_HT40_2G:-0}
# [open-wifi INV-T6] THE one switch of 802.11k/v (network kv=1). 0 (prepared,
# disabled): the driver does not pass the RRM / WNM action frames between the
# firmware and hostapd yet (.mgmt_tx refuses them, no action-frame RX), so
# hostapd's neighbor report / BSS transition answers could never reach a
# client: kv=1 is accepted and dropped with a warning. 1 once the driver
# lane lands the frames (owner OD4 (a)) AND the OS hostapd is built with
# CONFIG_WNM (BR2_PACKAGE_GT_BE98_OS_HOSTAPD_WNM=y, off today): without it
# hostapd 2.12 does not know bss_transition= ("unknown configuration item",
# config_file.c #ifdef CONFIG_WNM_AP) and refuses the WHOLE radio config.
# -F: feature kv 0|1 (the web UI offers the option only on 1).
# (GT_BE98_KV: the offline test harness only)
KV=${GT_BE98_KV:-0}
NETS='' OUT='' SLOTS='' MACS='' DEVS='' CAP=4 CTRL=/run/hostapd CC=0 RNR=1 KEEP=0 DRY=0
NOW='' QUERY=0 UPF='' STACTRL=/run/wpa_supplicant SKIP=0 BPB='' SIXTOP=''
SYSNET=${GT_BE98_SYSNET:-/sys/class/net}
usage() { sed -n '/^#   gt-be98-wifi-gen -n/,/^#   -F  /p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2; }
# what this generator supports (-F): keep it in line with the checks below
features() {
	cat <<-'EOF'
	# gt-be98-wifi-gen features: <what> <values>
	security open owe open-owe psk2 psk2sae sae wpa2-eap wpa3-eap wpa2-wpa3-eap
	max_clients 1 2007
	width 2g 20 40
	width 5gl 20 40 80 160
	width 5gh 20 40 80 160
	width 6g 20 40 80 160 320
	feature country 1
	feature hidden 1
	feature isolate 1
	feature max_clients 1
	feature schedule 1
	feature enterprise 1
	feature width320 1
	feature airtime 1
	feature he 1
	feature eht 1
	feature twt_responder 1
	feature zwdfs 1
	feature monitor 1
	feature led 1
	feature bssid 1
	feature twt 0
	feature wds 0
	feature station 1
	feature routed 1
	feature repeater 1
	feature beacon_prot 1
	station_security psk2 sae
	EOF
	echo "feature ht40_2g $HT40_2G"
	echo "feature kv $KV"
}
while getopts n:o:s:m:d:C:x:cR:K:NT:QFU:X:SB:6: o; do
	case $o in
	n) NETS=$OPTARG ;; o) OUT=$OPTARG ;; s) SLOTS=$OPTARG ;; m) MACS=$OPTARG ;;
	d) DEVS=$OPTARG ;; C) CAP=$OPTARG ;; x) CTRL=$OPTARG ;; c) CC=1 ;;
	R) RNR=$OPTARG ;; K) KEEP=$OPTARG ;; N) DRY=1 ;;
	T) NOW=$OPTARG ;; Q) QUERY=1 ;; F) features; exit 0 ;;
	U) UPF=$OPTARG ;; X) STACTRL=$OPTARG ;; S) SKIP=1 ;; B) BPB=$OPTARG ;; 6) SIXTOP=$OPTARG ;; *) usage ;;
	esac
done
[ "$QUERY" = 1 ] && [ -z "$OUT" ] && OUT=/dev/null
[ -n "$NETS" ] && [ -n "$OUT" ] || usage
[ -f "$NETS" ] || { echo "gt-be98-wifi-gen: $NETS: no such file" >&2; exit 1; }
case "$NOW" in
''|[1-7]\ [01][0-9]:[0-5][0-9]|[1-7]\ 2[0-3]:[0-5][0-9]) ;;
*) echo "gt-be98-wifi-gen: -T $NOW: \"D HH:MM\", D = 1 (Monday) .. 7" >&2; exit 1 ;;
esac
case "$CAP" in [1-8]) ;; *) echo "gt-be98-wifi-gen: -C $CAP: 1..8" >&2; exit 1 ;; esac
case "$HT40_2G" in 0|1) ;; *) echo "gt-be98-wifi-gen: HT40_2G=$HT40_2G: 0 or 1" >&2; exit 1 ;; esac
case "$SIXTOP" in ''|[1-9]|[1-9][0-9]|1[0-9][0-9]|2[0-2][0-9]|23[0-3]) ;; *) echo "gt-be98-wifi-gen: -6 $SIXTOP: a 6 GHz channel 1..233" >&2; exit 1 ;; esac
case "$KV" in 0|1) ;; *) echo "gt-be98-wifi-gen: KV=$KV: 0 or 1" >&2; exit 1 ;; esac
case "$CTRL" in /*) ;; *) echo "gt-be98-wifi-gen: -x must be absolute" >&2; exit 1 ;; esac
case "$CTRL" in *[!A-Za-z0-9/_.-]*) echo "gt-be98-wifi-gen: -x $CTRL refused" >&2; exit 1 ;; esac
case "$STACTRL" in /*) ;; *) echo "gt-be98-wifi-gen: -X must be absolute" >&2; exit 1 ;; esac
case "$STACTRL" in *[!A-Za-z0-9/_.-]*) echo "gt-be98-wifi-gen: -X $STACTRL refused" >&2; exit 1 ;; esac
DEVS=${DEVS:-"2g=bcawl3 5gl=bcawl0 5gh=bcawl1 6g=bcawl2"}
# default radio MACs: the radio netdevs' current addresses
if [ -z "$MACS" ]; then
	for p in $DEVS; do
		d=${p#*=}
		a=$(cat "$SYSNET/$d/address" 2>/dev/null) && MACS="$MACS ${p%%=*}=$a"
	done
fi
umask 077
if [ "$QUERY" = 0 ]; then
	mkdir -p "$OUT" || exit 1
	rm -f "$OUT"/hostapd-*.conf "$OUT"/bss-*.conf "$OUT"/hdr-* "$OUT"/sec-* "$OUT"/sta-*.conf \
		"$OUT"/plan "$OUT"/plan.raw "$OUT"/slots.new "$OUT"/sched
fi
S=${SLOTS:-/dev/null}
[ -f "$S" ] || S=/dev/null

LC_ALL=C awk -v cap="$CAP" -v ctrl="$CTRL" -v devlist="$DEVS" -v maclist="$MACS" \
	-v ccok="$CC" -v rnr="$RNR" -v keep="$KEEP" -v out="$OUT" -v slotsf="$S" \
	-v now="$NOW" -v query="$QUERY" -v upf="$UPF" -v stactrl="$STACTRL" -v skipbad="$SKIP" \
	-v ht402g="$HT40_2G" -v bpbands="$BPB" -v kvon="$KV" -v sixtop="$SIXTOP" '
function err(m) { print "gt-be98-wifi-gen: " m > "/dev/stderr"; nerr++ }
function warn(m) { print "gt-be98-wifi-gen: warning: " m > "/dev/stderr" }
# an error of network i itself: with -S the network is skipped (a warning),
# else the list is refused
function nerrf(i, m,    p) {
	if (!skipbad) { err(m); return }
	p = "network " net[i] ": "
	if (index(m, p) == 1) m = substr(m, length(p) + 1)
	bad[i] = 1
	warn("network " net[i] " skipped: " m)
}
function trim(s) { sub(/^[ \t]+/, "", s); sub(/[ \t]+$/, "", s); return s }
# decimal, no leading zero; NB values cut out of a line are strings: compare
# them as numbers with "+ 0"
function isnum(s) { return s ~ /^[0-9]+$/ && s !~ /^0[0-9]/ }
function hexv(c) { return index("0123456789abcdef", tolower(c)) - 1 }
function hex2(n) { return sprintf("%02x", n) }
function validband(b) { return b == "2g" || b == "5gl" || b == "5gh" || b == "6g" }
# the DFS region of a country as the WiFi driver labels it (open-wifi
# bca_reg.c bca_reg_dfs_region: US = FCC, JP = JP, every other country ETSI;
# its wiphy is self-managed, so the wireless-regdb region is not the one used)
function dfsetsi(c) { return c != "US" && c != "JP" }
# MAC "aa:bb:cc:dd:ee:ff" -> o[0..5]; 1 on success
function parsemac(m, o,    i, p, n) {
	m = tolower(m)
	if (m !~ /^[0-9a-f][0-9a-f](:[0-9a-f][0-9a-f])(:[0-9a-f][0-9a-f])(:[0-9a-f][0-9a-f])(:[0-9a-f][0-9a-f])(:[0-9a-f][0-9a-f])$/)
		return 0
	n = split(m, p, ":")
	for (i = 1; i <= 6; i++) o[i - 1] = hexv(substr(p[i], 1, 1)) * 16 + hexv(substr(p[i], 2, 1))
	return 1
}
# BSSID of index s (0..7) on radio b (the firmware mbss8 rule, see the header)
# the default secondaries block of radio b (an address: its octets 0-4 and
# the bits of octet 5 above the index count): 2.4/5 GHz the LA-prefixed
# block, 6 GHz the radio address (nontransmitted BSSIDs, see the header)
function defblk(b,    o, i, r, adj, o0) {
	parsemac(bmac[b], o)
	adj = (o[0] == 96 && o[5] % 15 == 0) ? 1 : 0
	o0 = 96 + ((o[5] + adj) % 15) * 8
	if (int(o0 / 2) % 2 == 0) o0 += 2	# ETHER_SET_LOCALADDR
	# 6 GHz: the firmware advertises the secondaries as nontransmitted
	# BSSIDs of the anchor (802.11 Multiple BSSID): a client derives their
	# address from the anchor address, octet 0 included (see the header)
	if (b == "6g") o0 = o[0]
	r = hex2(o0)
	for (i = 1; i <= 4; i++) r = r ":" hex2(o[i])
	return r ":" hex2(o[5])
}
# address of BSSID index s (0..7) on radio b: anc/blk/aix (the block in force)
function bssid(b, s,    o, i, r) {
	if (s == 0) return anc[b]
	parsemac(blk[b], o)
	r = hex2(o[0])
	for (i = 1; i <= 4; i++) r = r ":" hex2(o[i])
	return r ":" hex2(o[5] - o[5] % 8 + (aix[b] + s) % 8)
}
# the block key of an address: octets 0-4 and octet 5 above the 3 index bits
function blockof(a,    o) { parsemac(a, o); return substr(a, 1, 14) ":" int(o[5] / 8) }
function lastbyte(a,    o) { parsemac(a, o); return o[5] }
function printable(s) { return s ~ /^[ -~]*$/ }
function ishex64(s) { return length(s) == 64 && s ~ /^[0-9A-Fa-f]+$/ }
function iseap(s) { return s == "wpa2-eap" || s == "wpa3-eap" || s == "wpa2-wpa3-eap" }
function isport(s) { return isnum(s) && s + 0 >= 1 && s + 0 <= 65535 }
# a unicast IP literal (auth_server_addr takes no host name)
function isip(s,    p, n, i, c) {
	if (s ~ /^[0-9.]+$/) {
		if (split(s, p, ".") != 4) return 0
		for (i = 1; i <= 4; i++) if (!isnum(p[i]) || p[i] + 0 > 255) return 0
		return p[1] + 0 != 0 && p[1] + 0 < 224
	}
	# IPv6: hex groups and colons, "::" at most once, not multicast
	# (ff00::/8), not link-local (fe80::/10: no scope id here)
	if (s !~ /^[0-9A-Fa-f:]+$/ || length(s) > 39 || s ~ /:::/ || tolower(s) ~ /^(ff|fe[89ab])/) return 0
	if (s == "::" || s ~ /^:[^:]/ || s ~ /[^:]:$/) return 0
	c = index(s, "::")
	if (c && index(substr(s, c + 2), "::")) return 0
	n = split(s, p, ":")
	for (i = 1; i <= n; i++) if (length(p[i]) > 4 || (!c && p[i] == "")) return 0
	return c ? n <= 9 : n == 8
}
# "A.B.C.D" -> its 32-bit value, -1 if not a dotted quad (never printed:
# mawk would print a value above 2^31 in exponent form)
function ip2n(s,    p, i, n) {
	if (s !~ /^[0-9.]+$/ || split(s, p, ".") != 4) return -1
	n = 0
	for (i = 1; i <= 4; i++) { if (!isnum(p[i]) || p[i] + 0 > 255) return -1; n = n * 256 + p[i] }
	return n
}
# routed=A.B.C.1/P: 1 if A.B.C.1 is the first host of a private (RFC 1918)
# subnet of prefix 16..30; sets RNET (its network) and RSZ (its size)
function routedok(s,    a, p, n, i) {
	if (split(s, a, "/") != 2 || !isnum(a[2])) return 0
	p = a[2] + 0
	if (p < 16 || p > 30) return 0
	n = ip2n(a[1])
	if (n < 0) return 0
	# no "^": busybox awk may be built without math support
	RSZ = 1
	for (i = p; i < 32; i++) RSZ *= 2
	RNET = n - n % RSZ
	if (n != RNET + 1) return 0
	return (RNET >= ip2n("10.0.0.0") && RNET + RSZ <= ip2n("11.0.0.0")) ||
	    (RNET >= ip2n("172.16.0.0") && RNET + RSZ <= ip2n("172.32.0.0")) ||
	    (RNET >= ip2n("192.168.0.0") && RNET + RSZ <= ip2n("192.169.0.0"))
}
# the hex form of a string (wpa_supplicant ssid=, sae_password=: no quoting rule)
function hexs(s,    i, h) {
	h = ""
	for (i = 1; i <= length(s); i++) h = h hex2(ord[substr(s, i, 1)])
	return h
}
# the channel of frequency f (MHz) on band b (may be fractional: not a channel)
function f2ch(b, f) { return b == "2g" ? (f - 2407) / 5 : b == "6g" ? (f - 5950) / 5 : (f - 5000) / 5 }
# has channel ch a w MHz block on band b?
function widthok(b, ch, w) {
	if (w == 20) return 1
	if (b == "6g") return c6(ch, w) != 0
	if (b == "2g") return w == 40
	if (w == 40) return ht40(b, ch) != ""
	if (w == 80) return vht80(ch) != 0
	if (w == 160) return vht160(ch) != 0
	return 0
}
function secretok(s) { return printable(s) && length(s) >= 1 && length(s) <= 128 && s !~ /^ / && s !~ / $/ }
# "aa:bb:cc:dd:ee:ff W" (a unicast MAC, W = 1..65535) -> AMAC (lower case), AW (a number); 1 if valid
function airsta(s,    p, o) {
	if (split(s, p, /[ \t]+/) != 2 || !parsemac(p[1], o) || o[0] % 2) return 0
	if (!isnum(p[2]) || p[2] + 0 < 1 || p[2] + 0 > 65535) return 0
	AMAC = tolower(p[1]); AW = p[2] + 0
	return 1
}
function chans(b, ch) {
	if (b == "2g") return isnum(ch) && ch >= 1 && ch <= 13
	if (b == "5gl") return isnum(ch) && ch >= 36 && ch <= 64 && ch % 4 == 0
	if (b == "5gh") return isnum(ch) && ((ch >= 100 && ch <= 144 && ch % 4 == 0) || (ch >= 149 && ch <= 177 && (ch - 149) % 4 == 0))
	if (b == "6g") return isnum(ch) && ch >= 1 && ch <= 233 && (ch - 1) % 4 == 0
	return 0
}
function ht40(b, ch,    base) {
	if (b == "2g") return ch <= 7 ? "+" : "-"
	if (ch > 161) return ""
	base = ch >= 149 ? 149 : 36
	return (int((ch - base) / 4) % 2 == 0) ? "+" : "-"
}
function vht80(ch,    i, n, bs) {
	n = split("36 52 100 116 132 149", bs, " ")
	for (i = 1; i <= n; i++) if (ch >= bs[i] + 0 && ch <= bs[i] + 12) return bs[i] + 6
	return 0
}
# 5 GHz 160 MHz (open-wifi INV-160-5G, owner OD2): the centre channel of the
# 160 MHz block that holds ch, 0 if none offered. Two blocks: 36-64 (centre
# 50, 5gl) and 100-128 (centre 114, 5gh); 149-177 is not offered (outside
# the ETSI band, never measured on the box)
function vht160(ch) { return (ch >= 36 && ch <= 64) ? 50 : (ch >= 100 && ch <= 128) ? 114 : 0 }
# 5 GHz: the VHT/HE/EHT operation width code (0: 20/40, 1: 80, 2: 160) and
# the centre channel index (80/160 MHz only)
function chw5(w) { return w == 160 ? 2 : w == 80 ? 1 : 0 }
function c5(ch, w) { return w == 160 ? vht160(ch) : vht80(ch) }
# a 5 GHz radio whose channel block (at width w) holds a DFS (radar)
# channel, 52-144: a DFS primary, or 160 MHz (36-64 holds 52-64)
function dfs5(b, ch, w) { return (b == "5gl" || b == "5gh") && ((ch >= 52 && ch <= 144) || (w == 160 && vht160(ch) != 0)) }
# 6 GHz (802.11ax-2021 Annex E, op_class 131-134/137): the centre channel
# index of the w MHz block that holds channel ch, 0 if the band has none (its
# top channels). 40/80/160: blocks of 2/4/8 channels from channel 1 (centres
# 3, 7, 15 + k * 8/16/32). 320: the 320-1 block that holds it (centres 31,
# 95, 159) when it ends at or below T6 (the country top 6 GHz channel, -6),
# else the 320-2 block that holds it (centres 63, 127, 191) when that fits;
# 0 when neither does (in DE/FR, T6 93: ch 1-61 -> 31, ch 65-93 -> 63).
function c6(ch, w,    n, c) {
	if (w == 20) return ch + 0
	n = w / 5	# the span of the block, in channel numbers
	if (w == 320) {
		c = int((ch - 1) / 64) * 64 + 31
		if (c + 30 <= T6) return c
		if (ch < 33) return 0
		c = int((ch - 33) / 64) * 64 + 63
		return (c + 30 <= T6 && c + 30 <= 233) ? c : 0
	}
	c = int((ch - 1) / n) * n + n / 2 - 1
	return (c + n / 2 - 2 <= 233) ? c : 0	# its top channel exists
}
function opclass6(w) { return w == 20 ? 131 : w == 40 ? 132 : w == 80 ? 133 : w == 160 ? 134 : 137 }
# the frequency (MHz) of channel ch on band b
function freq(b, ch) { return b == "2g" ? 2407 + 5 * ch : b == "6g" ? 5950 + 5 * ch : 5000 + 5 * ch }
# the centre frequency of the w MHz channel whose primary is ch (checked)
function cfreq(b, ch, w) {
	if (w == 20) return freq(b, ch)
	if (b == "6g") return 5950 + 5 * c6(ch, w)
	if (w == 40) return freq(b, ch) + (ht40(b, ch) == "+" ? 10 : -10)
	return 5000 + 5 * c5(ch, w)
}
# ---- schedules (see the header) ----
# mon..sun -> 1..7, else 0
function dayno(s,    i) {
	if (s !~ /^[a-z][a-z][a-z]$/) return 0
	i = index("mon tue wed thu fri sat sun ", s " ")
	return (i % 4 == 1) ? (i + 3) / 4 : 0
}
# "HH:MM" -> minutes 0..1440 (24:00 = 1440), -1 if malformed
function hm(s,    m) {
	if (s !~ /^[0-2][0-9]:[0-5][0-9]$/) return -1
	m = substr(s, 1, 2) * 60 + substr(s, 4, 2)
	return m <= 1440 ? m : -1
}
# one window DAYS@HH:MM-HH:MM -> wd[1..7] (its days), WS, WE; 1 if valid
function win(w, wd,    at, d, t, p, n, a, b, i) {
	for (i = 1; i <= 7; i++) wd[i] = 0
	at = index(w, "@")
	if (!at) return 0
	d = substr(w, 1, at - 1); t = substr(w, at + 1)
	if (d == "daily") { for (i = 1; i <= 7; i++) wd[i] = 1 }
	else if (d == "weekdays") { for (i = 1; i <= 5; i++) wd[i] = 1 }
	else if (d == "weekend") { wd[6] = 1; wd[7] = 1 }
	else {
		n = split(d, p, "-")
		if (n == 1) { a = dayno(p[1]); if (!a) return 0; wd[a] = 1 }
		else if (n == 2) {
			a = dayno(p[1]); b = dayno(p[2])
			if (!a || !b || a == b) return 0
			i = a
			while (1) { wd[i] = 1; if (i == b) break; i = i % 7 + 1 }
		} else return 0
	}
	if (split(t, p, "-") != 2) return 0
	WS = hm(p[1]); WE = hm(p[2])
	return WS >= 0 && WE >= 0 && WS < 1440 && WS != WE
}
function schedok(s,    w, n, i, k, wd) {
	n = split(s, w, /[ \t,]+/); k = 0
	for (i = 1; i <= n; i++) {
		if (w[i] == "") continue
		if (!win(w[i], wd)) return 0
		k++
	}
	return k >= 1 && k <= 32
}
# is schedule s on at weekday dow (1..7), minute mn?
function schedon(s, dow, mn,    w, n, i, wd, prev) {
	prev = (dow == 1) ? 7 : dow - 1
	n = split(s, w, /[ \t,]+/)
	for (i = 1; i <= n; i++) {
		if (w[i] == "" || !win(w[i], wd)) continue
		if (WS < WE) { if (wd[dow] && mn >= WS && mn < WE) return 1 }
		else if ((wd[dow] && mn >= WS) || (wd[prev] && mn < WE)) return 1
	}
	return 0
}
function ssidline(s,    i, h) {
	if (printable(s) && s !~ /^ / && s !~ / $/) return "ssid=" s
	h = ""
	for (i = 1; i <= length(s); i++) h = h hex2(ord[substr(s, i, 1)])
	return "ssid2=" h
}
BEGIN {
	nbands = split("2g 5gl 5gh 6g", BANDS, " ")
	for (i = 1; i < 256; i++) ord[sprintf("%c", i)] = i
	n = split(devlist, t, " ")
	for (i = 1; i <= n; i++) {
		split(t[i], kv, "="); b = kv[1]; d = kv[2]
		if (!validband(b) || d !~ /^bcawl[0-9]+$/) { err("-d " t[i] ": band=bcawlN"); continue }
		dev[b] = d
	}
	n = split(maclist, t, " ")
	for (i = 1; i <= n; i++) {
		split(t[i], kv, "="); b = kv[1]
		if (!validband(b) || !parsemac(kv[2], o)) { err("-m " t[i] ": band=aa:bb:cc:dd:ee:ff"); continue }
		if (o[0] % 2) { err("-m " t[i] ": a multicast address"); continue }
		bmac[b] = tolower(kv[2])
	}
	nnet = 0; cur = ""; country = "FR"	# owner D20: the default country
	# -T "D HH:MM" (checked by the shell): the time the schedules are read at
	havenow = (now != "")
	# -U "band=MHz ...": the frequencies of the associated stations
	n = split(upf, t, " ")
	for (i = 1; i <= n; i++) {
		split(t[i], kv, "=")
		if (!validband(kv[1]) || !isnum(kv[2])) { err("-U " t[i] ": band=MHz"); continue }
		ufreq[kv[1]] = kv[2] + 0
	}
	# -B: the radios whose driver advertises beacon protection
	n = split(bpbands, t, /[ \t,]+/)
	for (i = 1; i <= n; i++) {
		if (t[i] == "") continue
		if (!validband(t[i])) { err("-B " t[i] ": a band (2g 5gl 5gh 6g)"); continue }
		bpok[t[i]] = 1
	}
	nsta = 0
	if (havenow) { split(now, t, " "); tdow = t[1] + 0; tmin = hm(t[2]) }
}
# ---- slot state: "<band> <slot> <net> <index>" ----
FILENAME == slotsf {
	if ($0 ~ /^#/ || NF == 0) next
	if (NF != 4 || !validband($1) || !isnum($2) || !isnum($3) || !isnum($4)) {
		warn(slotsf ":" FNR ": ignored"); next
	}
	st_slot[$1, $3] = $2 + 0; st_mac[$1, $3] = $4 + 0
	next
}
# ---- network list ----
/^#/ || /^[ \t]*$/ { next }
{
	if ($0 ~ /\r/) { err("line " FNR ": carriage return"); next }
	eq = index($0, "=")
	if (!eq) { err("line " FNR ": not key=value"); next }
	k = trim(substr($0, 1, eq - 1)); v = substr($0, eq + 1)
	if (k != "ssid" && k != "passphrase" && k != "radius_secret" && k != "radius_acct_secret") v = trim(v)
}
k == "network" {
	if (!isnum(v) || v + 0 < 1 || v + 0 > 99999) { err("line " FNR ": network id 1..99999"); cur = "x"; next }
	if (v in nid) { err("network " v " listed twice"); cur = "x"; next }
	nnet++; net[nnet] = v; nid[v] = nnet; cur = "n"; ci = nnet
	sec[ci] = ""; ssid[ci] = ""; pass[ci] = ""; vlan[ci] = ""; hid[ci] = 0; iso[ci] = 0; maxc[ci] = ""
	nsch[ci] = ""
	aw[ci] = ""; alim[ci] = 0; nasw[ci] = 0
	nb[ci] = 0; nra[ci] = 0
	rs[ci] = ""; rp[ci] = ""; rk[ci] = ""; as[ci] = ""; ap[ci] = ""; ak[ci] = ""
	rtd[ci] = ""; rep[ci] = 0; kv[ci] = 0
	next
}
k == "radio" {
	if (!validband(v)) { err("line " FNR ": radio 2g|5gl|5gh|6g"); cur = "x"; next }
	if (v in rseen) { err("radio " v " listed twice"); cur = "x"; next }
	rseen[v] = 1; cur = "r"; cr = v
	next
}
k == "station" {
	if (!validband(v)) { err("line " FNR ": station 2g|5gl|5gh|6g"); cur = "x"; next }
	if (nsta) { err("station " v ": one station= block only (station " stab " is listed)"); cur = "x"; next }
	nsta = 1; stab = v; cur = "s"; stenab = 1; stssid = ""; stsec = ""; stpass = ""; stbssid = ""
	strep = "0"
	next
}
cur == "" {
	if (k == "country") {
		if (v !~ /^[A-Z][A-Z]$/) err("country " v ": two upper-case letters")
		else country = v
	} else err("line " FNR ": " k " before the first network=/radio=/station=")
	next
}
cur == "x" { next }
cur == "s" {
	if (k == "enabled" && (v == "0" || v == "1")) stenab = v + 0
	else if (k == "ssid") stssid = v
	else if (k == "security") stsec = v
	else if (k == "passphrase") stpass = v
	else if (k == "bssid") stbssid = v
	else if (k == "repeater" && (v == "0" || v == "4addr" || v == "multiap")) strep = v
	else if (k == "repeater") err("station " stab ": repeater=" v " refused (0, 4addr or multiap)")
	else err("station " stab ": unknown key " k)	# never echo a value that may be a secret
	next
}
cur == "r" {
	if (k == "enabled" && (v == "0" || v == "1")) renab[cr] = v
	else if (k == "channel" && isnum(v)) rch[cr] = v + 0
	else if (k == "width" && (v == "20" || v == "40" || v == "80" || v == "160" || v == "320")) rw[cr] = v + 0
	else if (k == "schedule" && (v == "" || schedok(v))) rsch[cr] = v
	# v is a STRING: store the number ("0" is TRUE in awk)
	else if (k == "airtime" && v ~ /^[0-3]$/) rair[cr] = v + 0
	else if (k == "ax" && (v == "0" || v == "1")) rax[cr] = v + 0
	else if (k == "be" && (v == "0" || v == "1")) rbe[cr] = v + 0
	else if (k == "twt" && (v == "0" || v == "1")) rtwt[cr] = v + 0
	else if (k == "zwdfs" && (v == "0" || v == "1")) rzw[cr] = v + 0
	else if (k == "monitor" && (v == "0" || v == "1")) rmon[cr] = v + 0
	else if (k == "led" && (v == "0" || v == "1")) rled[cr] = v + 0
	else err("radio " cr ": " k "=" v " refused")
	next
}
cur == "n" {
	if (k == "ssid") ssid[ci] = v
	else if (k == "security") sec[ci] = v
	else if (k == "passphrase") pass[ci] = v
	# RADIUS: checked in END (never echo a secret)
	else if (k == "radius_server") { rs[ci] = v; nra[ci]++ }
	else if (k == "radius_port") { rp[ci] = v; nra[ci]++ }
	else if (k == "radius_secret") { rk[ci] = v; nra[ci]++ }
	else if (k == "radius_acct_server") { as[ci] = v; nra[ci]++ }
	else if (k == "radius_acct_port") { ap[ci] = v; nra[ci]++ }
	else if (k == "radius_acct_secret") { ak[ci] = v; nra[ci]++ }
	else if (k == "bands") {
		nb[ci] = split(v, t, /[ \t,]+/)
		for (i = 1; i <= nb[ci]; i++) {
			if (!validband(t[i]) || ((ci, t[i]) in hasb)) { nerrf(ci, "network " net[ci] ": band " t[i] " refused"); continue }
			hasb[ci, t[i]] = 1
		}
	}
	else if (k == "vlan") vlan[ci] = v
	else if (k == "routed") rtd[ci] = v
	else if (k == "repeated" && (v == "0" || v == "1")) rep[ci] = v + 0
	# v is a substr() result, a STRING: "0" is non-empty and so TRUE in awk; store the number
	else if (k == "hidden" && (v == "0" || v == "1")) hid[ci] = v + 0
	else if (k == "isolate" && (v == "0" || v == "1")) iso[ci] = v + 0
	else if (k == "kv" && (v == "0" || v == "1")) kv[ci] = v + 0
	else if (k == "max_clients" && isnum(v) && v + 0 >= 1 && v + 0 <= 2007) maxc[ci] = v + 0
	else if (k == "schedule" && (v == "" || schedok(v))) nsch[ci] = v
	else if (k == "airtime_weight" && isnum(v) && v + 0 >= 1 && v + 0 <= 1000) aw[ci] = v + 0
	else if (k == "airtime_limit" && (v == "0" || v == "1")) alim[ci] = v + 0
	else if (k == "airtime_sta_weight" && airsta(v) && nasw[ci] < 64) {
		if ((ci, AMAC) in aswseen) nerrf(ci, "network " net[ci] ": airtime_sta_weight " AMAC " listed twice")
		else { aswseen[ci, AMAC] = 1; asw[ci, ++nasw[ci]] = AMAC " " AW }
	}
	else if (k ~ /^slot\./ && validband(substr(k, 6)) && isnum(v)) ex_slot[substr(k, 6), net[ci]] = v + 0
	else if (k ~ /^mac\./ && validband(substr(k, 5)) && isnum(v) && v + 0 <= 7) ex_mac[substr(k, 5), net[ci]] = v + 0
	# a custom address (checked in END): bssid= (one band) or bssid.<band>=
	else if (k == "bssid" && parsemac(v, tmo)) cmac0[ci] = tolower(v)
	else if (k ~ /^bssid\./ && validband(substr(k, 7)) && parsemac(v, tmo)) cmac[ci, substr(k, 7)] = tolower(v)
	else if (k ~ /^(repeated|hidden|isolate|kv|max_clients|schedule|airtime_weight|airtime_limit|airtime_sta_weight|slot\.[0-9a-z]+|mac\.[0-9a-z]+|bssid|bssid\.[0-9a-z]+)$/) nerrf(ci, "network " net[ci] ": " k "=" v " refused")
	else nerrf(ci, "network " net[ci] ": unknown key " k)	# never echo a value that may be a secret
	next
}
END {
	# the top 6 GHz channel a 320 MHz block may reach (-6, else by country)
	T6 = (sixtop != "") ? sixtop + 0 : (country == "US") ? 233 : 93
	# ---- validate each network ----
	for (i = 1; i <= nnet; i++) {
		id = net[i]; tag = "network " id
		if (length(ssid[i]) < 1 || length(ssid[i]) > 32 || ssid[i] ~ /[\001-\037\177]/)
			nerrf(i, tag ": ssid must be 1-32 bytes, no control characters")
		else if (ssid[i] in ssidseen) nerrf(i, tag ": ssid also used by network " ssidseen[ssid[i]])
		else ssidseen[ssid[i]] = id
		s = sec[i]
		if (s == "open" || s == "owe" || s == "open-owe") {
			if (pass[i] != "") nerrf(i, tag ": security " s " takes no passphrase")
		} else if (s == "psk2") {
			if (!((printable(pass[i]) && length(pass[i]) >= 8 && length(pass[i]) <= 63) || ishex64(pass[i])))
				nerrf(i, tag ": the WPA2 passphrase must be 8-63 printable ASCII characters, or 64 hex digits")
		} else if (s == "psk2sae" || s == "sae") {
			if (!(printable(pass[i]) && length(pass[i]) >= 8 && length(pass[i]) <= 63))
				nerrf(i, tag ": the WPA3 (SAE) passphrase must be 8-63 printable ASCII characters")
		} else if (iseap(s)) {
			if (pass[i] != "") nerrf(i, tag ": security " s " takes no passphrase (the RADIUS server authenticates)")
			if (!isip(rs[i])) nerrf(i, tag ": security " s " needs radius_server=<IPv4 or IPv6 address>")
			if (rp[i] == "") rp[i] = 1812
			else if (!isport(rp[i])) nerrf(i, tag ": radius_port must be 1..65535")
			if (!secretok(rk[i])) nerrf(i, tag ": radius_secret must be 1-128 printable ASCII characters, no leading/trailing space")
			if (as[i] != "" || ap[i] != "" || ak[i] != "") {
				if (!isip(as[i])) nerrf(i, tag ": radius_acct_server=<IPv4 or IPv6 address> is required with radius_acct_port/radius_acct_secret")
				if (ap[i] == "") ap[i] = 1813
				else if (!isport(ap[i])) nerrf(i, tag ": radius_acct_port must be 1..65535")
				if (ak[i] == "") ak[i] = rk[i]
				else if (!secretok(ak[i])) nerrf(i, tag ": radius_acct_secret must be 1-128 printable ASCII characters, no leading/trailing space")
			}
		} else nerrf(i, tag ": security must be open, owe, open-owe, psk2, psk2sae, sae, wpa2-eap, wpa3-eap or wpa2-wpa3-eap")
		if (!iseap(s) && nra[i]) nerrf(i, tag ": radius_* only with security wpa2-eap, wpa3-eap or wpa2-wpa3-eap")
		if (nb[i] == 0) nerrf(i, tag ": no band")
		# custom addresses (bssid=, bssid.<band>=)
		if (i in cmac0) {
			if (nb[i] != 1) nerrf(i, tag ": bssid= needs a one-band network (several bands: bssid.<band>=, one address per radio)")
			else for (bi = 1; bi <= nbands; bi++) if ((i, BANDS[bi]) in hasb) cmac[i, BANDS[bi]] = cmac0[i]
		}
		for (bi = 1; bi <= nbands; bi++) {
			b = BANDS[bi]
			if (!((i, b) in cmac)) continue
			a = cmac[i, b]; parsemac(a, tmo)
			if (!((i, b) in hasb)) { nerrf(i, tag ": bssid." b "=" a " but the network is not on " b); continue }
			if (tmo[0] % 2) { nerrf(i, tag ": bssid." b "=" a " is a multicast address (bit 0 of the first octet)"); continue }
			if (int(tmo[0] / 2) % 2 == 0) warn(tag ": bssid." b "=" a " is not locally administered (bit 1 of the first octet): it may clash with a real device")
			for (bj = 1; bj <= nbands; bj++) if ((BANDS[bj] in bmac) && bmac[BANDS[bj]] == a) nerrf(i, tag ": bssid." b "=" a " is the address of radio " BANDS[bj])
			if (a in cseen) nerrf(i, tag ": bssid." b "=" a " is also " cseen[a])
			else cseen[a] = "network " id " on " b
		}
		if (((i, "6g") in hasb) && (s == "open" || s == "psk2" || s == "wpa2-eap"))
			nerrf(i, tag ": 6 GHz needs WPA3: SAE (sae, psk2sae), OWE (owe, open-owe) or WPA3-Enterprise (wpa3-eap, wpa2-wpa3-eap)")
		if (rep[i]) {
			if (vlan[i] != "" || rtd[i] != "") nerrf(i, tag ": repeated=1 excludes vlan= and routed= (the network is bridged to the Wi-Fi uplink)")
			if (nrep++) nerrf(i, tag ": repeated=1: network " repid " is already repeated (one network per station uplink)")
			else repid = id
			if (!nsta) nerrf(i, tag ": repeated=1 needs a station= uplink in the list")
			else if (strep == "0") nerrf(i, tag ": repeated=1 needs the station repeater=4addr or repeater=multiap (a 3-address station cannot be bridged)")
		} else if (rtd[i] != "") {
			if (vlan[i] != "") nerrf(i, tag ": vlan= and routed= exclude each other (a routed network has no VLAN)")
			if (!routedok(rtd[i])) nerrf(i, tag ": routed=" rtd[i] ": the first host of a private subnet, A.B.C.1/P, P = 16..30 (10/8, 172.16/12, 192.168/16)")
			else {
				for (j = 1; j < i; j++)
					if ((j in rnetv) && RNET < rnetv[j] + rszv[j] && rnetv[j] < RNET + RSZ) nerrf(i, tag ": routed=" rtd[i] " overlaps network " net[j])
				rnetv[i] = RNET; rszv[i] = RSZ
			}
			if (!nsta) nerrf(i, tag ": routed= needs a station= uplink in the list")
			else if (strep != "0") nerrf(i, tag ": routed= needs the station repeater=0 (a 4-address station is a bridge port of the repeated network)")
		} else if (!isnum(vlan[i]) || vlan[i] + 0 < 1 || vlan[i] + 0 > 4094) nerrf(i, tag ": vlan 1..4094 is required (or routed=)")
		else if (vlan[i] in vseen) nerrf(i, tag ": vlan " vlan[i] " also used by network " vseen[vlan[i]])
		else vseen[vlan[i]] = id
	}
	# -S: a skipped network is no longer in the list (no band: no BSS, no
	# slot, no net/routed/repeated line; no schedule)
	for (i = 1; i <= nnet; i++) if (i in bad) {
		for (bi = 1; bi <= nbands; bi++) delete hasb[i, BANDS[bi]]
		nsch[i] = ""
	}
	# [open-wifi INV-T6] KV=0 (header): kv=1 dropped, said once per network
	for (i = 1; i <= nnet; i++) if (kv[i] && !(kvon + 0) && !(i in bad)) {
		warn("network " net[i] ": kv=1 ignored: 802.11k/v (neighbor reports, BSS transition) waits for the Wi-Fi driver to pass the RRM/WNM action frames (open-wifi INV-T6); rrm_neighbor_report/bss_transition are not written")
		kv[i] = 0
	}
	# the station (uplink): never echo its passphrase
	if (nsta) {
		tag = "station " stab
		if (stssid != "") {
			if (length(stssid) > 32 || stssid ~ /[\001-\037\177]/) err(tag ": ssid must be 1-32 bytes, no control characters")
			if (stsec == "psk2") {
				if (!((printable(stpass) && length(stpass) >= 8 && length(stpass) <= 63) || ishex64(stpass)))
					err(tag ": the WPA2 passphrase must be 8-63 printable ASCII characters, or 64 hex digits")
				else if (index(stpass, "\"") && index(stpass, "#"))
					err(tag ": a WPA2 passphrase with both a double quote and # cannot be given to wpa_supplicant (its comment rule): give the 64-hex-digit PSK instead")
			} else if (stsec == "sae") {
				if (!(printable(stpass) && length(stpass) >= 8 && length(stpass) <= 63))
					err(tag ": the WPA3 (SAE) passphrase must be 8-63 printable ASCII characters")
			} else err(tag ": security must be psk2 or sae")
			if (stab == "6g" && stsec != "sae") err(tag ": 6 GHz needs WPA3 (security=sae)")
		} else if (stsec != "" || stpass != "") err(tag ": security/passphrase given without an ssid")
		if (stbssid != "") {
			if (!parsemac(stbssid, o) || o[0] % 2) err(tag ": bssid " stbssid ": a unicast MAC address")
			else stbssid = tolower(stbssid)
		}
	}
	for (bi = 1; bi <= nbands; bi++) {
		b = BANDS[bi]
		if (!(b in dev)) { err("no netdev for radio " b " (-d)"); continue }
		# rax/rtwt/rzw/rmon/rled hold numbers (the "0" string trap)
		if (rzw[b] && b != "5gl" && b != "5gh") err("radio " b ": zwdfs=1 refused (zero-wait DFS: 5gl, 5gh only)")
		# [open-wifi ZW-N3] no background CAC in an ETSI DFS region: the driver
		# refuses it (-EOPNOTSUPP) and hostapd 2.12 (dfs.c) then fails the
		# interface setup, so enable_background_radar=1 would keep the radio
		# down. Dropped, not refused: a zwdfs=1 stored before a country
		# change must not stop the radio
		else if (rzw[b] && dfsetsi(country)) {
			warn("radio " b ": zwdfs=1 ignored: zero-wait DFS (background CAC) is not offered in country " country " (an ETSI DFS region: US and JP only), enable_background_radar is not written")
			rzw[b] = 0
		}
		if (!(b in rtwt)) rtwt[b] = 1
		if (!(b in rled)) rled[b] = 1
		# HE / EHT: rax/rbe hold numbers; defaults ax=1, be=ax
		if (b == "6g" && (b in rax) && rax[b] == 0) err("radio 6g: ax=0 refused (6 GHz is HE/EHT only)")
		if (!(b in rax)) rax[b] = 1
		if ((b in rbe) && rbe[b] == 1 && rax[b] == 0) err("radio " b ": be=1 refused with ax=0 (EHT needs HE)")
		if (!(b in rbe)) rbe[b] = rax[b]
		if (b in rch) {
			if (!chans(b, rch[b])) { err("radio " b ": channel " rch[b] " is not a channel of this radio"); continue }
		} else rch[b] = (b == "2g") ? 6 : (b == "5gl") ? 36 : (b == "5gh") ? 100 : 37
		# 6 GHz default: 320 MHz (owner 11-10), 160 without EHT; others 20
		if (!(b in rw)) rw[b] = (b == "6g") ? (rbe[b] ? 320 : 160) : 20
		if (b == "6g" && rw[b] == 320 && !rbe[b]) err("radio 6g: 320 MHz needs EHT (be=1)")
		# 320 MHz with no block inside the country band (T6): 160, said
		if (b == "6g" && rw[b] == 320 && rbe[b] && c6(rch[b], 320) == 0 && c6(rch[b], 160) != 0) {
			if (renab[b] != "0") warn("radio 6g: channel " rch[b] " has no 320 MHz block inside this country 6 GHz band (channels up to " T6 "): rendered at 160 MHz")
			rw[b] = 160
		}
		if (b == "6g" && c6(rch[b], rw[b]) == 0) err("radio 6g: channel " rch[b] " has no " rw[b] " MHz block (the 6 GHz band ends at channel " (rw[b] == 320 ? T6 : 233) ")")
		if ((b == "2g" && rw[b] >= 160) || (b != "6g" && rw[b] == 320)) err("radio " b ": " rw[b] " MHz is " (rw[b] == 320 ? "6 GHz" : "5/6 GHz") " only (this radio: " (b == "2g" ? "20, 40" : "20, 40, 80, 160") " MHz)")
		if (b == "2g" && rw[b] == 80) err("radio 2g: 80 MHz is 5/6 GHz only")
		if ((b == "5gl" || b == "5gh") && rw[b] == 160 && vht160(rch[b]) == 0) err("radio " b ": channel " rch[b] " has no 160 MHz block (5 GHz 160 MHz: channels 36-64 and 100-128)")
		# [open-wifi INV-HT40-2G] HT40_2G=0 (header): 40 MHz on 2.4 GHz is
		# rendered at 20 (the driver advertises HT20 only there); said once
		if (b == "2g" && rw[b] == 40 && !(ht402g + 0)) {
			if (renab[b] != "0") warn("radio 2g: width=40 rendered at 20 MHz: the Wi-Fi driver advertises 20 MHz only on 2.4 GHz (open-wifi INV-HT40-2G), hostapd would refuse HT40 and the radio would not start")
			rw[b] = 20
		}
		if ((b == "5gl" || b == "5gh") && rw[b] == 40 && ht40(b, rch[b]) == "") err("radio " b ": channel " rch[b] " has no 40 MHz pair")
		if ((b == "5gl" || b == "5gh") && rw[b] == 80 && vht80(rch[b]) == 0) err("radio " b ": channel " rch[b] " has no 80 MHz block")
		# a DFS channel (5 GHz 52-144; their 40/80 MHz blocks never straddle
		# a non-DFS one; a 160 MHz block always holds DFS channels: 36-64
		# holds 52-64) is usable only with IEEE 802.11h, which hostapd
		# allows only with 11d and a country_code: without them hostapd marks
		# every radar channel DISABLED itself (hw_features.c: "Hardware does
		# not support configured channel"), and on 5gh (the firmware keeps
		# 100-140 only) that is every channel. Said loudly; the web UI refuses
		if (dfs5(b, rch[b], rw[b]) && renab[b] != "0" && !rmon[b] && !(ccok && country != "")) {
			m = 0; for (i = 1; i <= nnet; i++) if ((i, b) in hasb) m++
			if (m) warn("radio " b ": " (rch[b] >= 52 ? "channel " rch[b] " is a DFS (radar) channel" : "the 160 MHz block of channel " rch[b] " (36-64) holds DFS (radar) channels") " and the regulatory database is not loaded (no -c, so no country_code): hostapd cannot run DFS without a country_code, so the BSSes of this radio will not start")
		}
	}
	if (nerr) exit 1

	# ---- schedules: what is off now (nothing without -T) ----
	for (i = 1; i <= nnet; i++) noff[i] = (havenow && nsch[i] != "" && !schedon(nsch[i], tdow, tmin)) ? 1 : 0
	for (bi = 1; bi <= nbands; bi++) {
		b = BANDS[bi]
		roff[b] = (havenow && rsch[b] != "" && !schedon(rsch[b], tdow, tmin)) ? 1 : 0
	}
	sch = ""
	for (i = 1; i <= nnet; i++) if (nsch[i] != "") sch = sch "net " net[i] " " (noff[i] ? "off" : "on") "\n"
	for (bi = 1; bi <= nbands; bi++) { b = BANDS[bi]; if (rsch[b] != "") sch = sch "radio " b " " (roff[b] ? "off" : "on") "\n" }
	if (query) { printf "%s", sch; exit 0 }

	# ---- slots, per radio: sticky, slot 0 = anchor ----
	for (bi = 1; bi <= nbands; bi++) {
		b = BANDS[bi]
		live[b] = (renab[b] != "0") && (b in bmac) && !roff[b] && !rmon[b]
		# an enabled station takes slot 0 (the radio netdev) and the radio address:
		# stw (whatever the time: the limit) and ista (now)
		stw[b] = (nsta && stab == b && stenab && renab[b] != "0" && (b in bmac) && !rmon[b]) ? 1 : 0
		ista[b] = (stw[b] && live[b]) ? 1 : 0
		# a monitor radio carries no BSS (the driver refuses a monitor while
		# the primary netdev of the radio is up); its networks keep their slots
		ismon[b] = rmon[b] && (renab[b] != "0") && (b in bmac) && !roff[b]
		if (ismon[b]) {
			for (i = 1; i <= nnet; i++) if ((i, b) in hasb) { warn("radio " b " (" dev[b] ") is a monitor: its networks are not rendered there"); break }
		}
		if (renab[b] != "0" && !(b in bmac)) {
			for (i = 1; i <= nnet; i++) if ((i, b) in hasb) { warn("radio " b " (" dev[b] "): no MAC address (radio absent?): its networks are not rendered"); break }
		}
		# the limit counts every network of the radio, scheduled off or not
		m = 0
		for (i = 1; i <= nnet; i++) if ((i, b) in hasb) m++
		if ((renab[b] != "0") && (b in bmac) && m > cap - stw[b]) { err("radio " b ": " m " networks, at most " (cap - stw[b]) " per radio" (stw[b] ? " (its station takes one of " cap ")" : "")); continue }
		if (!live[b]) continue
		for (k = 0; k < cap; k++) used[b, k] = ""
		m = 0; mo = 0
		for (i = 1; i <= nnet; i++) if ((i, b) in hasb) {
			if (noff[i]) offm[b, ++mo] = i
			else mem[b, ++m] = i
		}
		nmem[b] = m; noffm[b] = mo
		# explicit slots first, then the remembered ones
		for (j = 1; j <= m; j++) {
			i = mem[b, j]; id = net[i]; sl[b, id] = -1
			if ((b, id) in ex_slot) {
				k = ex_slot[b, id]
				if (k >= cap) err("network " id ": slot." b "=" k ": at most " cap " BSS per radio (slots 0.." cap - 1 ")")
				else if (k == 0 && ista[b]) err("network " id ": slot." b "=0 is the station (the radio netdev)")
				else if (used[b, k] != "") err("network " id ": slot." b "=" k " also network " net[used[b, k]])
				else { used[b, k] = i; sl[b, id] = k }
			}
		}
		for (j = 1; j <= m; j++) {
			i = mem[b, j]; id = net[i]
			if (sl[b, id] >= 0 || !((b, id) in st_slot)) continue
			k = st_slot[b, id]
			if (k < cap && used[b, k] == "" && !(k == 0 && ista[b])) { used[b, k] = i; sl[b, id] = k }
			else warn("network " id ": remembered slot " k " on " b " not available: reallocated")
		}
		# a network scheduled off keeps its slot for when it comes back;
		# slot 0 only while no network runs on the radio (else the radio
		# needs an anchor: the next network is promoted below)
		for (j = 1; j <= mo; j++) {
			i = offm[b, j]; id = net[i]
			if ((b, id) in ex_slot) k = ex_slot[b, id]
			else if ((b, id) in st_slot) k = st_slot[b, id]
			else continue
			if ((k > 0 || (m == 0 && !ista[b])) && k < cap && used[b, k] == "" && !((b, k) in rsv)) { rsv[b, k] = id; kept[b, id] = k }
		}
		# the anchor left: the lowest slot becomes the anchor (one radio restart)
		if (m && !ista[b] && used[b, 0] == "") {
			best = -1
			for (k = 1; k < cap; k++) if (used[b, k] != "") { best = k; break }
			if (best > 0) {
				i = used[b, best]; used[b, best] = ""; used[b, 0] = i; sl[b, net[i]] = 0
				promoted[b, net[i]] = 1
			}
		}
		# new networks, in list order: lowest free slot
		for (j = 1; j <= m; j++) {
			i = mem[b, j]; id = net[i]
			if (sl[b, id] >= 0) continue
			for (k = ista[b]; k < cap; k++) if (used[b, k] == "" && !((b, k) in rsv)) break
			if (k >= cap) { err("radio " b ": no free slot for network " id); continue }
			used[b, k] = i; sl[b, id] = k
		}
	}
	if (nerr) exit 1

	# ---- the address block in force per radio (header: anc, blk, aix) ----
	for (bi = 1; bi <= nbands; bi++) {
		b = BANDS[bi]
		if (!(b in bmac)) continue
		anc[b] = bmac[b]; blk[b] = defblk(b); aix[b] = lastbyte(bmac[b]) % 8
		if (!live[b]) continue
		i0 = used[b, 0]
		# 6 GHz with -K: an LA block of its own for the anchor (8 BSSes)
		if (b == "6g" && keep && !(i0 != "" && ((i0, b) in cmac))) {
			parsemac(bmac[b], tmo)
			if (int(tmo[0] / 2) % 2 == 0) {
				cand = hex2(tmo[0] + 2) substr(bmac[b], 3, 12) ":" hex2(tmo[5] - tmo[5] % 8)
				ok6 = 1
				for (s = 0; s <= 7; s++) {
					x = substr(cand, 1, 15) hex2(tmo[5] - tmo[5] % 8 + s)
					for (bj = 1; bj <= nbands; bj++) if ((BANDS[bj] in bmac) && bmac[BANDS[bj]] == x) ok6 = 0
					if (x in cseen) ok6 = 0
				}
				if (ok6) { anc[b] = cand; blk[b] = cand; aix[b] = 0 }
				else warn("radio 6g: the locally administered block of " cand " holds an address in use: the anchor stays the radio address")
			}
		}
		# a custom anchor (slot 0)
		if (i0 != "" && ((i0, b) in cmac)) {
			if (!keep) err("network " net[i0] ": bssid." b "=" cmac[i0, b] " is on the first network of the radio (the anchor): the driver does not apply an address to it yet (-K)")
			else { anc[b] = cmac[i0, b]; aix[b] = lastbyte(anc[b]) % 8; if (b == "6g") blk[b] = anc[b] }
		}
		# custom secondaries: 2.4/5 GHz only, one block per radio
		cb = ""
		for (k = 1; k < cap; k++) {
			i = used[b, k]; if (i == "" || !((i, b) in cmac)) continue
			a = cmac[i, b]
			if (b == "6g") { err("network " net[i] ": bssid.6g= refused: on 6 GHz only the first network of the radio takes an address, the others are its nontransmitted BSSIDs (derived from it)"); continue }
			if (cb != "" && blockof(a) != cb) { err("network " net[i] ": bssid." b "=" a " is not in the block of " cbn " (the firmware: every secondary of a radio in one address block, octets 0-4 and the bits above the last 3)"); continue }
			if (lastbyte(a) % 8 == aix[b]) { err("network " net[i] ": bssid." b "=" a ": its last 3 bits (" lastbyte(a) % 8 ") are the index of the first network of the radio"); continue }
			cb = blockof(a); cbn = a; blk[b] = a
			cidx[b, net[i]] = (lastbyte(a) % 8 - aix[b] + 8) % 8
		}
	}
	if (nerr) exit 1
	# ---- BSSID indices: sticky, unique per radio, no BSSID twice anywhere ----
	for (bi = 1; bi <= nbands; bi++) { b = BANDS[bi]; if (b in bmac) { owner[bmac[b]] = "radio " b; if (anc[b] != bmac[b]) owner[anc[b]] = "radio " b " (its anchor)" } }
	# the BSSID indices of the networks scheduled off that kept their slot
	for (bi = 1; bi <= nbands; bi++) {
		b = BANDS[bi]
		if (!live[b]) continue
		for (j = 1; j <= noffm[b]; j++) {
			i = offm[b, j]; id = net[i]
			if (!((b, id) in kept)) continue
			s = ((b, id) in ex_mac) ? ex_mac[b, id] : ((b, id) in st_mac) ? st_mac[b, id] : 0
			if (s < 1 || s > 7 || ((b, s) in idxused) || (bssid(b, s) in owner)) continue
			idxused[b, s] = 1; owner[bssid(b, s)] = "network " id " on " b " (scheduled off)"; offmi[b, id] = s
		}
	}
	for (bi = 1; bi <= nbands; bi++) {
		b = BANDS[bi]
		if (!live[b]) continue
		for (k = 0; k < cap; k++) {
			i = used[b, k]; if (i == "") continue
			id = net[i]; want = -1
			if (k == 0 && !(keep && promoted[b, id])) want = 0
			else if ((b, id) in cidx) want = cidx[b, id]
			else if ((b, id) in ex_mac) want = ex_mac[b, id]
			else if ((b, id) in st_mac) {
				want = st_mac[b, id]
				# a state file of the old 4-bit rule: indices 8..15 do not exist
				if (want > 7) { warn("network " id ": BSSID index " want " on " b " is outside 1..7 (firmware mbss8): reallocated"); want = -1 }
			}
			if (k > 0 && want == 0) want = -1
			if (want >= 0) {
				a = bssid(b, want)
				if (want > 0 && (a in owner)) {
					if ((b, id) in cidx) { err("network " id ": bssid." b "=" a " is already " owner[a]); continue }
					if ((b, id) in ex_mac) { err("network " id ": mac." b "=" want " gives " a ", already " owner[a]); continue }
					warn("network " id ": BSSID index " want " on " b " collides with " owner[a] ": reallocated")
					want = -1
				} else if (want > 0 && ((b, want) in idxused)) {
					if ((b, id) in cidx) { err("network " id ": bssid." b "=" a ": its index is taken on " b); continue }
					warn("network " id ": BSSID index " want " on " b " taken: reallocated"); want = -1
				}
			}
			mi[b, id] = want
			if (want >= 0) { idxused[b, want] = 1; if (want > 0) owner[bssid(b, want)] = "network " id " on " b }
		}
	}
	for (bi = 1; bi <= nbands; bi++) {
		b = BANDS[bi]
		if (!live[b]) continue
		for (k = 0; k < cap; k++) {
			i = used[b, k]; if (i == "") continue
			id = net[i]
			if (mi[b, id] >= 0) continue
			for (s = 1; s <= 7; s++) if (!((b, s) in idxused) && !(bssid(b, s) in owner)) break
			if (s > 7) { err("radio " b ": no free BSSID for network " id); continue }
			mi[b, id] = s; idxused[b, s] = 1; owner[bssid(b, s)] = "network " id " on " b
		}
	}
	if (nerr) exit 1

	# ---- a station radio takes the channel of its uplink (-U) ----
	for (bi = 1; bi <= nbands; bi++) {
		b = BANDS[bi]
		if (!ista[b] || !(b in ufreq)) continue
		ch = f2ch(b, ufreq[b])
		if (ch != int(ch) || !chans(b, ch)) { warn("radio " b ": the station is on " ufreq[b] " MHz, not a channel of this radio: ignored"); continue }
		if (ch != rch[b]) warn("radio " b ": channel " ch " (the station uplink, " ufreq[b] " MHz) instead of " rch[b])
		rch[b] = ch; w = rw[b]
		while (w > 20 && !widthok(b, ch, w)) w = (w == 320) ? 160 : w / 2
		if (w != rw[b]) warn("radio " b ": " w " MHz instead of " rw[b] " (no " rw[b] " MHz block holds channel " ch ")")
		rw[b] = w
	}

	# ---- render ----
	plan = out "/plan.raw"
	printf "" > plan	# exists even for an empty list
	for (i = 1; i <= nnet; i++) if (i in bad) print "skipped " net[i] > plan
	for (bi = 1; bi <= nbands; bi++) {
		b = BANDS[bi]
		if (!live[b] || nmem[b] == 0) continue
		d = dev[b]; ch = rch[b]; w = rw[b]
		hdr = out "/hdr-" d
		print "driver=nl80211" > hdr
		if (b == "2g") {
			print "hw_mode=g" > hdr; print "channel=" ch > hdr; print "ieee80211n=1" > hdr
			if (w == 40) print "ht_capab=[HT40" ht40(b, ch) "]" > hdr
			# HE/EHT (header: ax=, be=); 20/40 MHz: no operation width lines
			if (rax[b]) print "ieee80211ax=1" > hdr
			if (rbe[b]) print "ieee80211be=1" > hdr
			# transmit beamformer: stock 2.4 GHz txbf_bfr_cap 37 = SU only
			# (VHT, HE, EHT); no MU line, so hostapd clears the MU bits
			if (rax[b]) print "he_su_beamformer=1" > hdr
			if (rbe[b]) print "eht_su_beamformer=1" > hdr
		} else if (b == "6g") {
			# the op_class sets the width (hostapd derives he/eht_oper_chwidth
			# and the secondary channel from it on 6 GHz); the centre indices
			# go into the HE (and EHT) Operation elements. 320 MHz: HE runs
			# the 160 MHz half that holds the primary, EHT the whole block
			print "hw_mode=a" > hdr; print "op_class=" opclass6(w) > hdr; print "channel=" ch > hdr
			print "ieee80211ax=1" > hdr
			if (w > 20) {
				print "he_oper_chwidth=" (w == 40 ? 0 : w == 80 ? 1 : 2) > hdr
				print "he_oper_centr_freq_seg0_idx=" c6(ch, w == 320 ? 160 : w) > hdr
			}
			if (w == 320) {
				print "ieee80211be=1" > hdr; print "eht_oper_chwidth=9" > hdr
				print "eht_oper_centr_freq_seg0_idx=" c6(ch, 320) > hdr
			} else if (rbe[b]) {
				# hostapd reads the centre index from the EHT lines once be=1
				print "ieee80211be=1" > hdr
				if (w > 20) {
					print "eht_oper_chwidth=" (w == 40 ? 0 : w == 80 ? 1 : 2) > hdr
					print "eht_oper_centr_freq_seg0_idx=" c6(ch, w) > hdr
				}
			}
			# transmit beamformer, SU and MU: stock 6 GHz txbf_bfr_cap 255
			print "he_su_beamformer=1" > hdr; print "he_mu_beamformer=1" > hdr
			if (w == 320 || rbe[b]) { print "eht_su_beamformer=1" > hdr; print "eht_mu_beamformer=1" > hdr }
		} else {
			print "hw_mode=a" > hdr; print "channel=" ch > hdr
			print "ieee80211n=1" > hdr; print "ieee80211ac=1" > hdr
			if (w == 20) print "vht_oper_chwidth=0" > hdr
			else if (w == 40) { print "ht_capab=[HT40" ht40(b, ch) "]" > hdr; print "vht_oper_chwidth=0" > hdr }
			else { print "ht_capab=[HT40" ht40(b, ch) "]" > hdr; print "vht_oper_chwidth=" chw5(w) > hdr; print "vht_oper_centr_freq_seg0_idx=" c5(ch, w) > hdr }
			# transmit beamformer, SU and MU on every generation: stock 5 GHz
			# txbf_bfr_cap 255 (the driver clears each bit an element sent
			# without it; hostapd defaults are all "no"). SU-BEAMFORMEE is
			# the stock line; the driver keeps the stock beamformee per band
			# 160 MHz: [VHT160] (hostapd checks it against the VHT
			# capabilities of the driver; the box-proven 160 MHz set, perf-wide 1104-1551)
			print "vht_capab=[SU-BEAMFORMER][SU-BEAMFORMEE][MU-BEAMFORMER]" (w == 160 ? "[VHT160]" : "") > hdr
			# HE/EHT (header: ax=, be=): their operation width/centre are the
			# VHT ones (hostapd takes the channel width from the EHT lines
			# when be=1, from the HE lines when ax=1)
			if (rax[b]) {
				print "ieee80211ax=1" > hdr
				if (w >= 80) { print "he_oper_chwidth=" chw5(w) > hdr; print "he_oper_centr_freq_seg0_idx=" c5(ch, w) > hdr }
				else print "he_oper_chwidth=0" > hdr
				print "he_su_beamformer=1" > hdr; print "he_mu_beamformer=1" > hdr
			}
			if (rbe[b]) {
				print "ieee80211be=1" > hdr
				if (w >= 80) { print "eht_oper_chwidth=" chw5(w) > hdr; print "eht_oper_centr_freq_seg0_idx=" c5(ch, w) > hdr }
				else print "eht_oper_chwidth=0" > hdr
				print "eht_su_beamformer=1" > hdr; print "eht_mu_beamformer=1" > hdr
			}
			# zero-wait DFS: hostapd background radar (the ZW-DFS of the driver)
			if (rzw[b]) print "enable_background_radar=1" > hdr
			# the channel picks hostapd makes itself stay on the channels of
			# this radio (the set chans() accepts): after a radar during a CAC
			# or in service (the driver declares no DFS offload on these
			# radios, so hostapd chooses) and for the background CAC chain
			# (dfs.c is_in_chanlist). Without it a radar on 5gh ch100 moved
			# 5gh onto the 36/80 block of 5gl (run 1104-2058). Channels the
			# regulatory domain disables stay off.
			# (no apostrophe in this program: it is a single-quoted string)
			print "chanlist=" (b == "5gl" ? "36-64" : "100-144 149-177") > hdr
		}
		# TWT responder: on by hostapd default; rtwt[] holds numbers
		if (!rtwt[b]) print "he_twt_responder=0" > hdr
		if (ccok && country != "") {
			print "country_code=" country > hdr; print "ieee80211d=1" > hdr
			if (b != "2g" && b != "6g") print "ieee80211h=1" > hdr
		}
		# hostapd airtime policy (CONFIG_AIRTIME_POLICY): radio-wide mode; rair[] holds numbers
		if (rair[b]) print "airtime_mode=" rair[b] > hdr
		close(hdr)
		# the first BSS (interface= of the radio config): slot 0, else the
		# lowest slot (a station radio: a virtual interface)
		for (k = 0; k < cap; k++) if (used[b, k] != "") break
		print "radio " b " " d " " out "/hostapd-" d ".conf " (k == 0 ? d : d "-" k) > plan
		for (k = 0; k < cap; k++) {
			i = used[b, k]; if (i == "") continue
			id = net[i]; ifn = (k == 0) ? d : d "-" k
			a = bssid(b, mi[b, id]); br = "brwifi" id
			f = out "/sec-" ifn
			print "# network " id " slot " k " (BSSID index " mi[b, id] ")" > f
			print "ctrl_interface=" ctrl > f
			print "bssid=" a > f
			print "bridge=" br > f
			print ssidline(ssid[i]) > f
			print "utf8_ssid=1" > f
			# REQUIRED: without WMM the firmware RSN capabilities (0x000c) do
			# not match hostapd 3/4 RSN IE and clients drop (reason 17)
			print "wmm_enabled=1" > f
			# U-APSD advertised in the WMM element, as stock: hostapd defaults
			# to not advertising it, and the driver follows the per-BSS
			# setting hostapd sends (open-wifi INV-UAPSD), so without this
			# line every BSS would lose U-APSD
			print "uapsd_advertisement_enabled=1" > f
			print "auth_algs=1" > f
			if (hid[i]) print "ignore_broadcast_ssid=1" > f
			if (iso[i]) print "ap_isolate=1" > f
			if (maxc[i] != "") print "max_num_sta=" maxc[i] > f
			# 802.11k/v (kv=1, KV=1 only): neighbor reports + BSS transition management
			if (kv[i]) { print "rrm_neighbor_report=1" > f; print "bss_transition=1" > f }
			# airtime: only on a radio whose airtime mode is on (hostapd ignores them at 0)
			if (rair[b]) {
				if (aw[i] != "") print "airtime_bss_weight=" aw[i] > f
				else if (rair[b] >= 2) print "airtime_bss_weight=1" > f
				if (alim[i]) print "airtime_bss_limit=1" > f
				for (aj = 1; aj <= nasw[i]; aj++) print "airtime_sta_weight=" asw[i, aj] > f
			}
			if (rnr && b != "6g") print "rnr=1" > f
			# 6 GHz in-band discovery, one frame every 20 TU (802.11ax: a 6 GHz AP
			# sends unsolicited broadcast probe responses or FILS discovery frames),
			# so a client need not wait for a 100 TU beacon. Radio scope in the
			# driver (open-wifi F-6G-DISC: nbr_discovery_cap 0x20 / 0x40 +
			# fd_prb_rsp_period; the firmware builds the frame). The FIRMWARE starts
			# the probe-response timer ONLY ON A PSC CHANNEL (channel % 16 == 5:
			# wlc_ap_start_upr_fd_timer, stock wl.ko 0x083ac404) and FILS discovery
			# anywhere; measured on air: 273 probe responses in 8 s on ch 37 (one
			# BSS, 1027-1506), none in 6 s on ch 1 (two BSSes, 1103-1507). So PSC:
			# probe responses (a passive scan learns every BSS, the Multiple-BSSID
			# secondaries included), else FILS discovery. Written on every 6 GHz BSS
			# so a secondary asks what the anchor runs
			if (b == "6g") {
				if (ch % 16 == 5) print "unsol_bcast_probe_resp_interval=20" > f
				else print "fils_discovery_max_interval=20" > f
			}
			s = sec[i]
			if (b == "6g") { if (s == "psk2sae") s = "sae"; else if (s == "open-owe") s = "owe"; else if (s == "wpa2-wpa3-eap") s = "wpa3-eap" }
			else if (s == "open-owe") s = "open"
			if (s == "open") print "wpa=0" > f
			else {
				print "wpa=2" > f; print "rsn_pairwise=CCMP" > f
				if (s == "owe") {
					print "wpa_key_mgmt=OWE" > f; print "ieee80211w=2" > f
					# no PMKSA caching on OWE: the firmware composes the association
					# response without a PMKID, so the driver answers a cached OWE
					# rejoin with status 53 (open-wifi ledger FSEC-N2); every join
					# runs the full DH exchange instead
					print "disable_pmksa_caching=1" > f
				}
				else if (s == "psk2") print "wpa_key_mgmt=WPA-PSK" > f
				else if (s == "wpa2-eap") print "wpa_key_mgmt=WPA-EAP" > f
				else if (s == "wpa2-wpa3-eap") { print "wpa_key_mgmt=WPA-EAP WPA-EAP-SHA256" > f; print "ieee80211w=1" > f }
				else if (s == "wpa3-eap") { print "wpa_key_mgmt=WPA-EAP-SHA256" > f; print "ieee80211w=2" > f }
				else if (s == "psk2sae") { print "wpa_key_mgmt=WPA-PSK SAE" > f; print "ieee80211w=1" > f; print "sae_pwe=2" > f }
				else { print "wpa_key_mgmt=SAE" > f; print "ieee80211w=2" > f; print "sae_require_mfp=1" > f; print "sae_pwe=" (b == "6g" ? 1 : 2) > f }
				# beacon protection (-B: the driver advertises it): SAE and
				# OWE BSSes, PMF on in each (stock: bcnprot 1 on SAE, 0 on WPA2)
				if ((b in bpok) && (s == "sae" || s == "psk2sae" || s == "owe")) print "beacon_prot=1" > f
				if (iseap(s)) {
					# 802.1X: hostapd is the authenticator, the EAP
					# conversation is relayed to the RADIUS server
					print "ieee8021x=1" > f
					print "auth_server_addr=" rs[i] > f
					print "auth_server_port=" rp[i] > f
					print "auth_server_shared_secret=" rk[i] > f
					if (as[i] != "") {
						print "acct_server_addr=" as[i] > f
						print "acct_server_port=" ap[i] > f
						print "acct_server_shared_secret=" ak[i] > f
					}
				} else if (s != "owe") {
					if (ishex64(pass[i])) print "wpa_psk=" tolower(pass[i]) > f
					else print "wpa_passphrase=" pass[i] > f
				}
			}
			close(f)
			print "bss " d " " ifn " " k " " id " " mi[b, id] " " a " " br " " out "/bss-" ifn ".conf" > plan
			onradio[id] = 1
		}
	}
	for (i = 1; i <= nnet; i++) if (net[i] in onradio) {
		if (rep[i]) print "repeated " net[i] " brwifi" net[i] " " iso[i] > plan
		else if (rtd[i] != "") print "routed " net[i] " brwifi" net[i] " " rtd[i] " " iso[i] > plan
		else print "net " net[i] " brwifi" net[i] " " vlan[i] " " iso[i] > plan
	}
	# the station: its wpa_supplicant config (0600, umask) and plan line
	for (bi = 1; bi <= nbands; bi++) {
		b = BANDS[bi]
		if (!ista[b]) continue
		d = dev[b]; f = out "/sta-" d ".conf"
		print "# generated by gt-be98-wifi-gen - do not edit: the station (uplink) of radio " b > f
		print "ctrl_interface=" stactrl > f
		print "update_config=0" > f
		print "ap_scan=1" > f
		if (stssid != "") {
			print "network={" > f
			print "\tssid=" hexs(stssid) > f
			print "\tscan_ssid=1" > f
			if (stbssid != "") print "\tbssid=" stbssid > f
			# a Multi-AP backhaul STA: wpa_supplicant asks for the backhaul BSS
			# and turns nl80211 4addr on from the association response of the AP
			if (strep == "multiap") print "\tmulti_ap_backhaul_sta=1" > f
			if (stsec == "psk2") {
				print "\tkey_mgmt=WPA-PSK" > f; print "\tproto=RSN" > f; print "\tpairwise=CCMP" > f
				print "\tieee80211w=0" > f
				if (ishex64(stpass)) print "\tpsk=" tolower(stpass) > f
				else print "\tpsk=\"" stpass "\"" > f
			} else {
				# SAE: H2E or hunting-and-pecking, PMF required (the box-verified set)
				print "\tkey_mgmt=SAE" > f; print "\tieee80211w=2" > f; print "\tsae_pwe=2" > f
				print "\tsae_password=" hexs(stpass) > f
			}
			print "}" > f
		}
		close(f)
		for (k = 1; k < cap; k++) if (used[b, k] != "") break
		print "station " b " " d " " f " " ((k < cap && live[b]) ? d "-" k : "-") > plan
		if (strep != "0") print "repeater " d " " strep " " ((nrep && (repid in onradio)) ? "brwifi" repid : "-") > plan
	}
	for (bi = 1; bi <= nbands; bi++) {
		b = BANDS[bi]
		if (ismon[b]) print "monitor " b " " dev[b] " " freq(b, rch[b]) " " rw[b] " " cfreq(b, rch[b], rw[b]) > plan
	}
	for (bi = 1; bi <= nbands; bi++) { b = BANDS[bi]; if (b in dev) print "led " b " " dev[b] " " rled[b] > plan }
	close(plan)
	printf "%s", sch > (out "/sched")
	close(out "/sched")
	# ---- slot state ----
	sf = out "/slots.new"
	print "# gt-be98-wifi-gen: sticky slot and BSSID index per (network, radio): <band> <slot> <network> <index>" > sf
	for (bi = 1; bi <= nbands; bi++) {
		b = BANDS[bi]
		for (i = 1; i <= nnet; i++) {
			id = net[i]
			if (!((i, b) in hasb)) continue
			if (live[b] && !noff[i]) print b " " sl[b, id] " " id " " mi[b, id] > sf
			else if (live[b]) { if ((b, id) in kept) print b " " kept[b, id] " " id " " ((b, id) in offmi ? offmi[b, id] : 0) > sf }
			else if ((b, id) in st_slot) print b " " st_slot[b, id] " " id " " st_mac[b, id] > sf
		}
	}
	close(sf)
}
' "$S" "$NETS" || exit 1
[ "$QUERY" = 1 ] && exit 0

# assemble the configs; the section/header checksums drive per-BSS changes
H="# generated by gt-be98-wifi-gen - do not edit, regenerated on every change"
sum() { sha256sum "$1" | cut -d' ' -f1; }
: > "$OUT/plan"
first=
while read -r t a b c d e f g h; do
	case $t in
	radio)	# radio <band> <dev> <conf> <first BSS ifname>
		first=$d
		{ echo "$H"; echo "interface=$first"; cat "$OUT/hdr-$b"; } > "$c"
		echo "radio $a $b $c $(sum "$OUT/hdr-$b") $first" >> "$OUT/plan" ;;
	bss)	# bss <dev> <ifname> <slot> <net> <index> <bssid> <bridge> <conf>
		if [ "$b" = "$first" ]; then
			{ echo; cat "$OUT/sec-$b"; } >> "$OUT/hostapd-$a.conf"
		else
			{ echo; echo "bss=$b"; cat "$OUT/sec-$b"; } >> "$OUT/hostapd-$a.conf"
		fi
		{ echo "$H"; echo "interface=$b"; cat "$OUT/hdr-$a"; echo; cat "$OUT/sec-$b"; } > "$h"
		echo "bss $a $b $c $d $e $f $g $h $(sum "$OUT/sec-$b")" >> "$OUT/plan" ;;
	net|routed) echo "$t $a $b $c $d" >> "$OUT/plan" ;;
	repeated|repeater) echo "$t $a $b $c" >> "$OUT/plan" ;;
	station) # station <band> <dev> <conf> <first AP ifname or ->
		echo "station $a $b $c $(sum "$c") $d" >> "$OUT/plan" ;;
	monitor) echo "$t $a $b $c $d $e" >> "$OUT/plan" ;;
	led)	echo "$t $a $b $c" >> "$OUT/plan" ;;
	skipped) echo "$t $a" >> "$OUT/plan" ;;
	esac
done < "$OUT/plan.raw"
rm -f "$OUT/plan.raw"
if [ -n "$SLOTS" ] && [ "$DRY" = 0 ]; then
	if ! cmp -s "$OUT/slots.new" "$SLOTS" 2>/dev/null; then
		cp "$OUT/slots.new" "$SLOTS.new" && chmod 0644 "$SLOTS.new" && mv -f "$SLOTS.new" "$SLOTS" || exit 1
	fi
fi
exit 0
