#!/bin/sh
# SPDX-License-Identifier: GPL-2.0
# gt-be98-save: package the mainline OS state for the stock /jffs.
#
#   ssh root@<box> gt-be98-save > state.tgz          (tar.gz on stdout)
#   gt-be98-save -o /tmp/state.tgz                    (and state.tgz.sha256)
#   gt-be98-save --local                              (PHASE 2, JFFS_MODE=rw + FENCE_VOLUMES=jffs2:
#                         write /jffs/mainline-os/state.tgz directly, through
#                         the UBI write fence; the previous one is kept .prev)
#
# The archive holds exactly the paths gt-be98-jffs restores (ALLOW_PATHS of
# /etc/conf.d/gt-be98-jffs): the web UI state (/etc/webui: webui.db,
# platform.conf, auth.conf, ssh/), the SSH host keys, authorized_keys,
# dhcpcd and chrony state. Without --local nothing is written to the NAND:
# the archive is stored in /jffs/mainline-os/ on the next STOCK boot
# (board/gt-be98-mainline/NAND.md, stock-apply-state.sh).
set -eu
ALLOW_PATHS=
. /etc/conf.d/gt-be98-jffs
out=
loc=0
[ "${1:-}" = -o ] && out=${2:?gt-be98-save -o FILE}
if [ "${1:-}" = --local ]; then
	grep -qE '^ubi0:[^ ]+ /jffs ubifs rw' /proc/mounts ||
		{ echo "gt-be98-save: /jffs is not mounted read-write (JFFS_MODE=rw with FENCE_VOLUMES=jffs2, NAND-PHASE2.md)" >&2; exit 1; }
	loc=1
	umask 077
	mkdir -p /jffs/mainline-os
	chmod 0700 /jffs/mainline-os
	out=/jffs/mainline-os/state.tgz.new
fi
list=
for p in $ALLOW_PATHS; do [ -e "/$p" ] && list="$list $p"; done
[ -n "$list" ] || { echo "gt-be98-save: nothing to save" >&2; exit 1; }
if [ -n "$out" ]; then
	tar -czf "$out" -C / $list
	if [ $loc = 1 ]; then
		d=/jffs/mainline-os
		[ -f $d/state.tgz ] && cp $d/state.tgz $d/state.tgz.prev
		sum=$(sha256sum $d/state.tgz.new | cut -d' ' -f1)
		mv $d/state.tgz.new $d/state.tgz
		echo "$sum  state.tgz" > $d/state.tgz.sha256
		chmod 0600 $d/*
		sync
		echo "gt-be98-save: $d/state.tgz ($(wc -c < $d/state.tgz) B) written to the NAND through the fence" >&2
		exit 0
	fi
	(cd "$(dirname "$out")" && sha256sum "$(basename "$out")" > "$(basename "$out").sha256")
	echo "gt-be98-save: $out ($(wc -c < "$out") B), $out.sha256" >&2
else
	[ -t 1 ] && { echo "gt-be98-save: stdout is a terminal; redirect it or use -o FILE" >&2; exit 1; }
	tar -czf - -C / $list
fi
