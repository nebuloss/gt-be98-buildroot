#!/bin/sh
# SPDX-License-Identifier: GPL-2.0
# gt-be98-l2: the one owner of the VLAN networks' bridges (brwifiN + the
# trunk's 802.1Q sub-interface <trunk>.<vid>). A network bridge has USERS:
# gt-be98-wifi (its BSSes) and gt-be98-lan (the LAN jacks whose native VLAN is
# the network's). The bridge and its trunk VLAN exist while at least one user
# holds them, whichever started first, and are deleted (only what this tool
# created) when the last user lets go: a Wi-Fi restart never drops the wired
# members, and a VLAN with jacks and no running SSID still has its bridge.
#
#   gt-be98-l2 up <user> <bridge> <trunk> <vid> [<wired>]
#       the bridge (created or adopted: no STP, forward_delay 0, IPv6 off but
#       on a bridge gt-be98-gw holds, up), <trunk>.<vid> (created or adopted,
#       IPv6 off, up, enslaved, not isolated; the trunk is brought up if
#       down, never re-addressed); user
#       recorded. <wired> (rnr1..rnr3, never rnr0, never the trunk): the
#       user's WIRED MEMBER <wired>.<vid> too, created or adopted like the
#       trunk VLAN and recorded as that user's (the RTL8372 tags each jack's
#       native VLAN V on rnr1, so the jacks of VLAN V reach the SoC on
#       rnr1.V: gt-be98-lan passes rnr1). An `up` without <wired>, or with
#       another one, drops the user's former wired member (deleted when
#       this tool created it): one call states all the user wants.
#       A bridge whose trunk or VLAN changed loses the old
#       sub-interface first (deleted when this tool created it), its wired
#       members and its bare wired ports (rnr*: they joined the old VLAN),
#       and forgets its other users (they come back with `up`). A failed up
#       is undone (as by `down` of that user). Refused: a
#       VLAN another bridge holds, a name that is not brwifi<digits>,
#       rnr0..rnr3, 1..4094, a wired port that is rnr0 or the trunk.
#   gt-be98-l2 down <user> <bridge>
#       the user let go (its wired member is removed: deleted when this
#       tool created it); the last one deletes the sub-interface and the bridge
#       this tool created (a bridge with a port other than a BSS (bcawl*) or
#       its own trunk VLAN is left in place, with a warning)
#   gt-be98-l2 vid <bridge>       the VLAN id the bridge carries (rc 1: none)
#   gt-be98-l2 list               "<bridge> <trunk> <vid> <user>..." per bridge
#                                 (<trunk> "-": a gateway network's bridge)
#   gt-be98-l2 mode <vid> [<bridge>]  "gateway" or "vlan": what this tool
#                                 does with <vid>'s trunk sub-interface
#   gt-be98-l2 sync               every bridge's trunk sub-interface made to
#                                 follow its mode (removed for a gateway
#                                 network, added back for a VLAN-only one),
#                                 and its backhaul VLANs to their VID:
#                                 gt-be98-gw runs it after each change
#   gt-be98-l2 trunk-add <dev> [<peer MAC>]
#                                 MESH ROOT: a leaf's 4-address link (the
#                                 AP_VLAN hostapd made, <bss>.sta<aid>) is a
#                                 DOWNLINK trunk: it gets the alias bh<k>
#                                 (k = 0..7, the lowest free; printed; the
#                                 same alias again for a dev already added)
#                                 and every network bridge whose uplink is a
#                                 wired trunk gets bh<k>.<bhvid> (created,
#                                 IPv6 off, up, enslaved, recorded as the
#                                 bridge's "bh" member). The untagged
#                                 AP_VLAN itself is no bridge port (EAPOL
#                                 and management only). gt-be98-mesh runs
#                                 it on hostapd's WDS-STA-INTERFACE-ADDED
#   gt-be98-l2 trunk-del <dev>    the link went: its bh<k>.<vid> deleted
#                                 (the ones made here), the alias freed
#   gt-be98-l2 uplink <dev>|-     MESH LEAF: the 4-address station <dev> is
#                                 the UPLINK trunk "bhs" (`up <user> <bridge>
#                                 bhs <vid>` then makes bhs.<vid> on <dev>);
#                                 "-" forgets it. A new <dev> moves every
#                                 bridge running on bhs to it at once
#   gt-be98-l2 trunks             "<alias> <dev> <down|up> <peer|->" per trunk
# BACKHAUL VID (D-MESH4, design §3.4 C3): a VLAN-only network crosses the
# backhaul on its vlan=; a gateway network (mode=gateway in the web UI's
# list, /etc/gt-be98-networks.conf) on the bhvid= of its line (2..4094: the
# root stays its gateway, the leaf bridges it and never routes it), and not
# at all without one (an older web UI, or not meant to cross). Two bridges
# wanting one backhaul VID: the second is not carried (logged). A bridge
# whose uplink is bhs (a leaf's) never gets a downlink: no loop on a box,
# and a chain of leaves is not offered.
# GATEWAY NETWORKS (the two-gateway rule; buildroot docs/ROUTED-NETWORKS-
# DESIGN.md §1): a network of the web UI's list (/etc/gt-be98-networks.conf)
# whose line says mode=gateway is routed by the box (gt-be98-gw: its address,
# DHCP, NAT), never bridged upstream: its bridge has NO <trunk>.<vid> (the
# upstream router's DHCP and the box's would both answer the segment). The
# VLAN id keeps its meaning on the LAN side (the jacks' rnr1.<vid>, bare
# jacks, tagged jack trunks, BSSes). The state records "trunk -" and the
# trunk the users asked for as "uplink <trunk>". A line without mode= is VLAN
# only, whatever its subnet= (the explicit key, owner D-GW1). While
# gt-be98-gw holds a bridge (its address on it: $GW_HOLD/<bridge>) the trunk
# sub-interface stays out even when the file says VLAN only again:
# gt-be98-gw removes its address first, lets go, then runs `sync`, so the
# segment never has two gateways, not even briefly. Switching a bridge
# between the two modes adds or removes ONLY the trunk sub-interface: its
# wired members, bare jacks and users stay (same VLAN).
# A NETWORK WITHOUT AN SSID (the web UI's /etc/gt-be98-networks.conf, a
# wired-only network as in UniFi) has no Wi-Fi bridge: gt-be98-lan names its
# bridge brwifi<100000 + network id> (never a Wi-Fi network's: those are
# brwifi1..brwifi99999) and is its only user. When the Wi-Fi then bridges
# that VLAN itself (an SSID bound to the network: `up wifi brwifiN` on a
# VLAN such a lan-only bridge holds), the Wi-Fi's bridge takes the VLAN
# over: the lan-only bridge is let go (its bare rnr* ports evicted, its
# wired members and sub-interface removed, deleted when made here) and
# gt-be98-lan's reload (gt-be98-wifi runs it after its own) puts the jacks
# into brwifiN. One bridge per VLAN holds throughout.
# State: /run/gt-be98-l2/<bridge> (trunk, vid, made_bridge, made_vlan, user
# lines, and "wired <user> <dev> <made>" per wired member). gt-be98-netguard
# reads it (a LAN port in a brwifi bridge only while the bridge carries the
# port's native VLAN; rnr1.<vid> only as a wired member recorded here on a
# bridge that carries <vid>).
set -u
RUNDIR=${GT_BE98_RUN:-/run}
L2=${GT_BE98_L2_STATE:-$RUNDIR/gt-be98-l2}
SYSNET=${GT_BE98_SYSNET:-/sys/class/net}
VLANCFG=${GT_BE98_VLANCFG:-/proc/net/vlan/config}
PROCNET=${GT_BE98_PROCNET:-/proc/sys/net}
NETWORKS=${GT_BE98_NETWORKS:-/etc/gt-be98-networks.conf}
GW_HOLD=${GT_BE98_GW_HOLD:-$RUNDIR/gt-be98-gw/hold}

err() { echo "gt-be98-l2: $*" >&2; logger -t gt-be98-l2 -- "$*" 2>/dev/null; return 1; }

valid_bridge() {
	case "$1" in brwifi[0-9]*) ;; *) return 1 ;; esac
	case "${1#brwifi}" in *[!0-9]*) return 1 ;; esac
}
valid_trunk() { case "$1" in rnr[0-3]|bhs) return 0 ;; *) return 1 ;; esac; }
# a mesh link netdev: an AP_VLAN (<bss>.sta<aid>) or a Wi-Fi station
valid_link() {
	case "$1" in bcawl[0-9]*|wlan[0-9]*) ;; *) return 1 ;; esac
	case "$1" in *[!A-Za-z0-9._-]*) return 1 ;; esac
	[ ${#1} -le 15 ]
}
valid_mac() {
	case "$1" in [0-9a-f][0-9a-f]:[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f]) return 0 ;; esac
	return 1
}
TR=$L2/trunks
# trunk alias $1 into T_DEV T_ROLE T_PEER (rc 1: none)
tr_read() {
	local k v
	T_DEV= T_ROLE= T_PEER=-
	[ -f "$TR/$1" ] || return 1
	while read -r k v _; do
		case "$k" in dev) T_DEV=$v ;; role) T_ROLE=$v ;; peer) T_PEER=$v ;; esac
	done < "$TR/$1"
	[ -n "$T_DEV" ]
}
# the netdev a trunk name stands for: rnr* itself, bhs the leaf's station
trunk_dev() {
	case "$1" in
	bhs) tr_read bhs && echo "$T_DEV" ;;
	*) echo "$1" ;;
	esac
}
valid_wired() { case "$1" in rnr[1-3]) return 0 ;; *) return 1 ;; esac; }
valid_vid() {
	case "$1" in ''|0*|*[!0-9]*) return 1 ;; esac
	[ ${#1} -le 4 ] && [ "$1" -ge 1 ] && [ "$1" -le 4094 ]
}
valid_user() { case "$1" in ''|*[!a-z]*) return 1 ;; esac; }

# the short critical section of every change (two services may call at once)
lock() {
	local n=0 o
	mkdir -p "$L2" || return 1
	while ! mkdir "$L2/.lock" 2>/dev/null; do
		o=$(cat "$L2/.lock/pid" 2>/dev/null)
		if [ -n "$o" ] && ! kill -0 "$o" 2>/dev/null; then rm -rf "$L2/.lock"; continue; fi
		n=$((n + 1)); [ $n -ge 30 ] && { rm -rf "$L2/.lock"; n=0; continue; }
		sleep 1
	done
	echo $$ > "$L2/.lock/pid"
}
unlock() { rm -rf "$L2/.lock"; }

# state of bridge $1 into S_TRUNK S_UPLINK S_VID S_MB S_MV S_USERS S_WIRED
# ("" when none; S_TRUNK "-" for a gateway network, S_UPLINK the trunk the
# users asked for, = S_TRUNK in a state written before it existed;
# S_WIRED: "<user>:<dev>:<made>" words)
st_read() {
	local k v w x
	S_TRUNK= S_UPLINK= S_VID= S_MB=0 S_MV=0 S_USERS= S_WIRED= S_BH=
	[ -f "$L2/$1" ] || return 1
	while read -r k v w x; do
		case "$k" in
		trunk) S_TRUNK=$v ;; uplink) S_UPLINK=$v ;; vid) S_VID=$v ;;
		made_bridge) S_MB=$v ;; made_vlan) S_MV=$v ;;
		user) S_USERS="$S_USERS $v" ;;
		wired) S_WIRED="$S_WIRED $v:$w:$x" ;;
		bh) S_BH="$S_BH $v:$w" ;;
		esac
	done < "$L2/$1"
	[ -n "$S_UPLINK" ] || S_UPLINK=$S_TRUNK
	return 0
}
st_write() {
	local u w
	{
		echo "trunk $S_TRUNK"; echo "uplink $S_UPLINK"; echo "vid $S_VID"
		echo "made_bridge $S_MB"; echo "made_vlan $S_MV"
		for u in $S_USERS; do echo "user $u"; done
		for w in $S_WIRED; do u=${w#*:}; echo "wired ${w%%:*} ${u%%:*} ${u#*:}"; done
		for w in ${S_BH:-}; do echo "bh ${w%%:*} ${w#*:}"; done
	} > "$L2/$1.new" && mv -f "$L2/$1.new" "$L2/$1"
}

# is $1 the 802.1Q sub-interface of $2 with id $3?
vlan_is() {
	awk -F'|' -v n="$1" -v d="$2" -v v="$3" '
		{ for (i = 1; i <= NF; i++) gsub(/^[ \t]+|[ \t]+$/, "", $i) }
		$1 == n && $2 == v && $3 == d { ok = 1 } END { exit !ok }' "$VLANCFG" 2>/dev/null
}
ipv6_off() { echo 1 > "$PROCNET/ipv6/conf/$1/disable_ipv6" 2>/dev/null; return 0; }
master_of() { local m; m=$(readlink "$SYSNET/$1/master" 2>/dev/null); echo "${m##*/}"; }

# wired member $2 ("<user>:<dev>:<made>") of bridge $1 leaves it: deleted
# when this tool created it, else only released
wired_drop() {
	local d=${2#*:} m
	m=${d#*:}; d=${d%%:*}
	[ -e "$SYSNET/$d" ] || return 0
	if [ "$m" = 1 ]; then
		ip link del dev "$d" || return 1
	elif [ "$(master_of "$d")" = "$1" ]; then
		ip link set dev "$d" nomaster || return 1
	fi
}
# the wired members of bridge $1 of user $2 ("" = every user) except dev $3
# leave it; S_WIRED keeps the others (and one whose removal failed)
wired_prune() {
	local w u d k=
	for w in $S_WIRED; do
		u=${w%%:*}; d=${w#*:}; d=${d%%:*}
		if { [ -z "$2" ] || [ "$u" = "$2" ]; } && [ "$d" != "${3:-}" ]; then
			wired_drop "$1" "$w" && continue
			err "$1: wired member $d not removed"
		fi
		k="$k $w"
	done
	S_WIRED=$k
}

# the old sub-interface of bridge $1 (state S_*) leaves it
sub_drop() {
	local s=$S_TRUNK.$S_VID
	[ -n "$S_TRUNK" ] && [ "$S_TRUNK" != - ] && [ -n "$S_VID" ] || return 0
	[ -e "$SYSNET/$s" ] || return 0
	if [ "$S_MV" = 1 ]; then
		ip link del dev "$s" || return 1
	elif [ "$(master_of "$s")" = "$1" ]; then
		ip link set dev "$s" nomaster || return 1
	fi
}

# the mode of VLAN $1 (bridge $2, optional) into MODE: gateway when the
# network list has a line with vlan=$1 and mode=gateway (vlan 2..4094), or
# while gt-be98-gw holds bridge $2 (header); else vlan. Keys in any order,
# unknown keys ignored; read with `read` (no fork).
vid_mode() {
	local l w v m
	MODE=vlan
	[ -n "${2:-}" ] && [ -e "$GW_HOLD/$2" ] && { MODE=gateway; return 0; }
	case "$1" in 1) return 0 ;; esac
	[ -r "$NETWORKS" ] || return 0
	set -f
	while IFS= read -r l || [ -n "$l" ]; do
		case "$l" in ''|'#'*) continue ;; esac
		v= m=
		# shellcheck disable=SC2086 # word split, no glob
		for w in $l; do
			case "$w" in vlan=*) v=${w#vlan=} ;; mode=*) m=${w#mode=} ;; esac
		done
		[ "$v" = "$1" ] && [ "$m" = gateway ] && { MODE=gateway; break; }
	done < "$NETWORKS"
	set +f
	return 0
}

# the trunk sub-interface $S_TRUNK.$S_VID of bridge $1: created or adopted,
# IPv6 off, up, enslaved, not isolated (S_* written as it goes)
sub_up() {
	local b=$1 t=$S_TRUNK v=$S_VID s=$S_TRUNK.$S_VID o d
	# the netdev under the trunk name (bhs: the leaf's station)
	d=$(trunk_dev "$t"); [ -n "$d" ] || { err "trunk $t: no netdev (gt-be98-l2 uplink)"; return 1; }
	o=$(master_of "$s")
	[ -z "$o" ] || [ "$o" = "$b" ] || { err "$s is a port of $o: $b refused"; return 1; }
	if [ $(( $(cat "$SYSNET/$d/flags" 2>/dev/null || echo 0) & 1 )) = 0 ]; then
		ip link set dev "$d" up || { err "trunk $d: up failed"; return 1; }
	fi
	if [ -e "$SYSNET/$s" ]; then
		vlan_is "$s" "$d" "$v" || { err "$s exists and is not VLAN $v of $d"; return 1; }
	else
		ip link add link "$d" name "$s" type vlan id "$v" || { err "cannot create $s"; return 1; }
		S_MV=1; st_write "$b"
	fi
	ipv6_off "$s"
	ip link set dev "$s" up || { err "$s: up failed"; return 1; }
	[ "$(master_of "$s")" = "$b" ] || ip link set dev "$s" master "$b" ||
		{ err "$s: enslave into $b failed"; return 1; }
	bridge link set dev "$s" isolated off 2>/dev/null
	return 0
}

# is bridge $1 one gt-be98-lan names for a network without an SSID
# (brwifi<100000 + id>, above every Wi-Fi network's brwifi1..99999)?
wired_only_net() {
	local n=${1#brwifi}
	case "$n" in ''|0*|*[!0-9]*) return 1 ;; esac
	[ ${#n} -ge 6 ]
}
# a lan-only bridge $1 lets its VLAN go: bare rnr* ports evicted, then lan's
# down (wired members, sub-interface, the bridge made here)
yield_bridge() {
	local p
	if [ -d "$SYSNET/$1/brif" ]; then
		for p in "$SYSNET/$1/brif"/rnr*; do
			[ -e "$p" ] || [ -L "$p" ] || continue
			p=${p##*/}
			case "$p" in *.*) continue ;; esac
			ip link set dev "$p" nomaster || return 1
		done
	fi
	cmd_down lan "$1"
	[ ! -f "$L2/$1" ]
}

# ---- the mesh backhaul (header: trunk-add, trunk-del, uplink) ----

# the backhaul VID of VLAN $1 (header) into BHV ("": not carried): $1, or
# for a mode=gateway line the bhvid= of it (read with `read`, keys in any order)
bh_vid() {
	local l w v x m
	BHV=$1
	[ -r "$NETWORKS" ] || return 0
	set -f
	while IFS= read -r l || [ -n "$l" ]; do
		case "$l" in ''|'#'*) continue ;; esac
		v= x= m=
		# shellcheck disable=SC2086 # word split, no glob
		for w in $l; do
			case "$w" in vlan=*) v=${w#vlan=} ;; bhvid=*) x=${w#bhvid=} ;; mode=*) m=${w#mode=} ;; esac
		done
		[ "$v" = "$1" ] || continue
		if [ "$m" = gateway ]; then
			BHV=
			valid_vid "$x" && [ "$x" != 1 ] && BHV=$x
		fi
		break
	done < "$NETWORKS"
	set +f
	return 0
}
# backhaul member $2 ("<sub>:<made>") of bridge $1 leaves it: deleted when
# this tool created it, else only released
bh_drop() {
	local d=${2%%:*} m=${2#*:}
	[ -e "$SYSNET/$d" ] || return 0
	if [ "$m" = 1 ]; then
		ip link del dev "$d" || return 1
	elif [ "$(master_of "$d")" = "$1" ]; then
		ip link set dev "$d" nomaster || return 1
	fi
}
# the backhaul members of bridge $1 (state S_*) of alias $2 ("" = all) leave
# it; S_BH keeps the others (and one whose removal failed); state written
bh_prune() {
	local w k=
	for w in ${S_BH:-}; do
		if [ -n "$2" ] && [ "${w%%.*}" != "$2" ]; then k="$k $w"; continue; fi
		bh_drop "$1" "$w" && continue
		err "$1: backhaul VLAN ${w%%:*} not removed"
		k="$k $w"
	done
	S_BH=$k
	[ -f "$L2/$1" ] && st_write "$1"
	return 0
}
# is backhaul sub-interface $2 recorded by another bridge than $1?
bh_taken() {
	local f o k v _w
	for f in "$L2"/brwifi*; do
		[ -f "$f" ] || continue
		o=${f##*/}; case "$o" in *.new) continue ;; esac
		[ "$o" = "$1" ] && continue
		while read -r k v _w; do
			[ "$k" = bh ] && [ "$v" = "$2" ] && { BH_BY=$o; return 0; }
		done < "$f"
	done
	return 1
}
# downlink trunk $2 (bh<k>) carries bridge $1's backhaul VID (state S_* of
# $1 loaded; written as it goes). A leaf's bridge (uplink bhs) never: rc 0
bh_attach() {
	local b=$1 a=$2 s w k= made=1 o
	[ "$S_UPLINK" != bhs ] && [ -n "$S_VID" ] || return 0
	tr_read "$a" && [ "$T_ROLE" = down ] || return 0
	bh_vid "$S_VID"; s=$a.${BHV:--}
	# the alias's member of another VID (bhvid= moved or gone) goes first
	for w in ${S_BH:-}; do
		if [ "${w%%.*}" = "$a" ] && [ "${w%%:*}" != "$s" ]; then
			bh_drop "$b" "$w" || { err "$b: backhaul VLAN ${w%%:*} not removed"; k="$k $w"; }
			continue
		fi
		k="$k $w"
	done
	S_BH=$k; st_write "$b"
	[ -n "$BHV" ] || return 0	# a gateway network without bhvid=: not carried
	if bh_taken "$b" "$s"; then
		err "$s: backhaul VID $BHV is carried for $BH_BY already: $b (VLAN $S_VID) not carried over the backhaul (give it another bhvid=)"
		return 1
	fi
	o=$(master_of "$s")
	[ -z "$o" ] || [ "$o" = "$b" ] || { err "$s is a port of $o: $b not carried over the backhaul"; return 1; }
	[ -e "$SYSNET/$T_DEV" ] || { err "backhaul link $T_DEV ($a) not present: $b not carried"; return 1; }
	case " $S_BH " in *" $s:"*) made=${S_BH#*" $s:"}; made=${made%% *} ;; *)
		if [ -e "$SYSNET/$s" ]; then
			vlan_is "$s" "$T_DEV" "$BHV" || { err "$s exists and is not VLAN $BHV of $T_DEV"; return 1; }
			made=0
		else
			ip link add link "$T_DEV" name "$s" type vlan id "$BHV" || { err "cannot create $s"; return 1; }
		fi
		S_BH="$S_BH $s:$made"; st_write "$b" ;;
	esac
	ipv6_off "$s"
	ip link set dev "$s" up || { err "$s: up failed"; return 1; }
	[ "$(master_of "$s")" = "$b" ] || ip link set dev "$s" master "$b" ||
		{ err "$s: enslave into $b failed"; return 1; }
	bridge link set dev "$s" isolated off 2>/dev/null
	return 0
}
# every downlink trunk carries bridge $1 (state loaded); rc 1 when one could not
bh_attach_all() {
	local f r=0
	for f in "$TR"/bh[0-7]; do
		[ -f "$f" ] || continue
		bh_attach "$1" "${f##*/}" || r=1
	done
	return $r
}
cmd_trunk_add() {
	local d=$1 p=${2:-} a= k f b r=0
	valid_link "$d" || { err "backhaul link '$d' refused"; return 1; }
	[ -e "$SYSNET/$d" ] || { err "backhaul link $d not present"; return 1; }
	p=$(echo "$p" | tr 'A-F' 'a-f')
	[ -z "$p" ] || valid_mac "$p" || { err "backhaul link $d: peer '$p' refused"; return 1; }
	mkdir -p "$TR" || return 1
	for f in "$TR"/bh[0-7]; do
		tr_read "${f##*/}" && [ "$T_DEV" = "$d" ] && { a=${f##*/}; break; }
	done
	if [ -z "$a" ]; then
		for k in 0 1 2 3 4 5 6 7; do [ -f "$TR/bh$k" ] || { a=bh$k; break; }; done
		[ -n "$a" ] || { err "backhaul link $d refused: 8 links already (bh0..bh7)"; return 1; }
	fi
	printf 'dev %s\nrole down\npeer %s\n' "$d" "${p:--}" > "$TR/$a.new" && mv -f "$TR/$a.new" "$TR/$a" || return 1
	for f in "$L2"/brwifi*; do
		[ -f "$f" ] || continue
		b=${f##*/}; case "$b" in *.new) continue ;; esac
		st_read "$b" || continue
		bh_attach "$b" "$a" || r=1
	done
	echo "$a"
	return $r
}
cmd_trunk_del() {
	local d=$1 a= f b
	valid_link "$d" || { err "backhaul link '$d' refused"; return 1; }
	for f in "$TR"/bh[0-7]; do
		tr_read "${f##*/}" && [ "$T_DEV" = "$d" ] && { a=${f##*/}; break; }
	done
	[ -n "$a" ] || return 0
	for f in "$L2"/brwifi*; do
		[ -f "$f" ] || continue
		b=${f##*/}; case "$b" in *.new) continue ;; esac
		st_read "$b" || continue
		bh_prune "$b" "$a"
	done
	rm -f "$TR/$a"
	echo "$a"
}
cmd_uplink() {
	local d=$1 old= f b r=0
	tr_read bhs && old=$T_DEV
	if [ "$d" = - ]; then rm -f "$TR/bhs"; return 0; fi
	valid_link "$d" || { err "uplink '$d' refused"; return 1; }
	mkdir -p "$TR" || return 1
	printf 'dev %s\nrole up\npeer -\n' "$d" > "$TR/bhs.new" && mv -f "$TR/bhs.new" "$TR/bhs" || return 1
	[ -n "$old" ] && [ "$old" != "$d" ] || return 0
	# the station moved: every bridge on bhs gets its bhs.<vid> on the new one
	for f in "$L2"/brwifi*; do
		[ -f "$f" ] || continue
		b=${f##*/}; case "$b" in *.new) continue ;; esac
		st_read "$b" || continue
		[ "$S_TRUNK" = bhs ] || continue
		sub_drop "$b" || { err "$b: bhs.$S_VID (on $old) not removed"; r=1; continue; }
		S_MV=0; st_write "$b"
		sub_up "$b" || r=1
	done
	return $r
}
cmd_trunks() {
	local f
	for f in "$TR"/bhs "$TR"/bh[0-7]; do
		[ -f "$f" ] || continue
		tr_read "${f##*/}" && echo "${f##*/} $T_DEV $T_ROLE $T_PEER"
	done
}

cmd_up() {
	local u=$1 b=$2 t=$3 v=$4 s=$3.$4 w=${5:-} ws= f o p x made
	valid_user "$u" || { err "user '$u' refused"; return 1; }
	valid_bridge "$b" || { err "bridge '$b' refused (brwifiN only)"; return 1; }
	valid_trunk "$t" || { err "trunk '$t' refused (rnr0..rnr3, bhs)"; return 1; }
	valid_vid "$v" || { err "VLAN '$v' refused (1-4094)"; return 1; }
	if [ -n "$w" ]; then
		valid_wired "$w" || { err "wired port '$w' refused (rnr1..rnr3)"; return 1; }
		[ "$w" != "$t" ] || { err "wired port $w is the trunk: refused"; return 1; }
		ws=$w.$v
	fi
	x=$(trunk_dev "$t")
	[ -n "$x" ] && [ -e "$SYSNET/$x" ] || { err "trunk $t not present: $b not bridged"; return 1; }
	[ -z "$w" ] || [ -e "$SYSNET/$w" ] || { err "wired port $w not present: $b not bridged"; return 1; }
	# one bridge per VLAN of a trunk (a lan-only bridge of a network
	# without an SSID yields to the Wi-Fi's: header)
	for f in "$L2"/brwifi*; do
		[ -f "$f" ] || continue
		o=${f##*/}; case "$o" in *.new) continue ;; esac
		[ "$o" = "$b" ] && continue
		st_read "$o"
		[ "$S_UPLINK.$S_VID" = "$s" ] || continue
		if [ "$u" = wifi ] && wired_only_net "$o" && [ "$S_USERS" = " lan" ]; then
			yield_bridge "$o" || { err "$s: $o could not be let go: $b refused"; return 1; }
			err "$s moves from $o (a network without an SSID, lan only) to $b (its SSID's bridge): gt-be98-lan's reload re-attaches the jacks"
			continue
		fi
		err "$s is bridged in $o already: $b refused"; return 1
	done
	vid_mode "$v" "$b"
	if [ "$MODE" = vlan ]; then
		o=$(master_of "$s")
		[ -z "$o" ] || [ "$o" = "$b" ] || { err "$s is a port of $o: $b refused"; return 1; }
	fi
	if [ -n "$ws" ]; then
		o=$(master_of "$ws")
		[ -z "$o" ] || [ "$o" = "$b" ] || { err "$ws is a port of $o: $b refused"; return 1; }
	fi
	st_read "$b" || { S_TRUNK=$t S_UPLINK=$t S_VID=$v; S_MB=0 S_MV=0 S_USERS= S_WIRED=; }
	# the bridge's VLAN changed: the old one goes first
	if [ "$S_UPLINK.$S_VID" != "$s" ]; then
		sub_drop "$b" || { err "$b: the old VLAN $S_TRUNK.$S_VID could not be removed"; return 1; }
		S_MV=0
		# every user's wired members are of the old VLAN too
		wired_prune "$b" "" ""
		[ -z "$S_WIRED" ] || { err "$b: a wired member of the old VLAN could not be removed"; return 1; }
		# and the backhaul downlinks carried the old VLAN's backhaul VID
		bh_prune "$b" ""
		[ -z "$S_BH" ] || { err "$b: a backhaul VLAN of the old VLAN could not be removed"; return 1; }
		# the wired members joined the OLD VLAN: evicted (never carried
		# into another VLAN), and their users must come back with `up`
		if [ -d "$SYSNET/$b/brif" ]; then
			for p in "$SYSNET/$b/brif"/rnr*; do
				[ -e "$p" ] || [ -L "$p" ] || continue
				p=${p##*/}
				case "$p" in *.*) continue ;; esac
				ip link set dev "$p" nomaster && err "$p evicted from $b: its VLAN moved to $s"
			done
		fi
		S_USERS=
	elif [ "$MODE" = gateway ] && [ "$S_TRUNK" != - ]; then
		# the same VLAN turned into a gateway network: only the trunk
		# sub-interface leaves (the wired members and users stay)
		sub_drop "$b" || { err "$b: $S_TRUNK.$S_VID could not be removed (gateway network)"; return 1; }
		S_MV=0
		err "$b: VLAN $v is a gateway network: $S_TRUNK.$S_VID removed, the bridge is not carried upstream"
	fi
	S_UPLINK=$t S_VID=$v S_TRUNK=$t
	[ "$MODE" = gateway ] && S_TRUNK=-
	if [ -e "$SYSNET/$b" ]; then
		[ -d "$SYSNET/$b/bridge" ] || { err "$b exists and is not a bridge"; return 1; }
	else
		ip link add name "$b" type bridge stp_state 0 forward_delay 0 || { err "cannot create $b"; return 1; }
		S_MB=1
	fi
	# recorded at once: a failure below still lets `down` undo what exists
	case " $S_USERS " in *" $u "*) ;; *) S_USERS="$S_USERS $u" ;; esac
	st_write "$b"
	# IPv6 off on the bridge, except while gt-be98-gw holds it: the gateway
	# network's IPv6 (its /64 of the delegated prefix) is gt-be98-gw's, which
	# turns IPv6 on and off itself; writing disable_ipv6=1 here at every
	# `up` (each lan/wifi reload) would flush its address under it
	[ -e "$GW_HOLD/$b" ] || ipv6_off "$b"
	ip link set dev "$b" type bridge stp_state 0 forward_delay 0 && ip link set dev "$b" up ||
		{ err "$b: setup failed"; return 1; }
	# a gateway network: no trunk sub-interface (header)
	if [ "$MODE" = vlan ]; then sub_up "$b" || return 1; fi
	# the mesh root's downlink trunks (bh<k>): their backhaul VLAN of this
	# bridge (none on a leaf's bridge); a failure is logged, the bridge runs
	bh_attach_all "$b"
	# the user's wired member: what it named, and nothing else of its own
	wired_prune "$b" "$u" "$ws"; st_write "$b"
	[ -n "$ws" ] || return 0
	made=
	for x in $S_WIRED; do
		o=${x#*:}
		[ "${o%%:*}" = "$ws" ] || continue
		[ "${x%%:*}" = "$u" ] || { err "$ws is the wired member of user ${x%%:*}: refused for $u"; return 1; }
		made=${o#*:}
	done
	if [ $(( $(cat "$SYSNET/$w/flags" 2>/dev/null || echo 0) & 1 )) = 0 ]; then
		ip link set dev "$w" up || { err "wired port $w: up failed"; return 1; }
	fi
	if [ -e "$SYSNET/$ws" ]; then
		vlan_is "$ws" "$w" "$v" || { err "$ws exists and is not VLAN $v of $w"; return 1; }
		made=${made:-0}
	else
		ip link add link "$w" name "$ws" type vlan id "$v" || { err "cannot create $ws"; return 1; }
		made=1
	fi
	o=
	for x in $S_WIRED; do [ "$x" = "$u:$ws:${x##*:}" ] || o="$o $x"; done
	S_WIRED="$o $u:$ws:$made"; st_write "$b"
	ipv6_off "$ws"
	ip link set dev "$ws" up || { err "$ws: up failed"; return 1; }
	[ "$(master_of "$ws")" = "$b" ] || ip link set dev "$ws" master "$b" ||
		{ err "$ws: enslave into $b failed"; return 1; }
	bridge link set dev "$ws" isolated off 2>/dev/null
	return 0
}

cmd_down() {
	local u=$1 b=$2 n x p
	valid_user "$u" && valid_bridge "$b" || { err "down '$u' '$b' refused"; return 1; }
	st_read "$b" || return 0
	n=
	for x in $S_USERS; do [ "$x" = "$u" ] || n="$n $x"; done
	S_USERS=$n
	wired_prune "$b" "$u" ""
	if [ -n "$S_USERS" ]; then st_write "$b"; return 0; fi
	# the last user: the backhaul VLANs of the bridge go with it
	bh_prune "$b" ""
	if [ "$S_MB" = 1 ] && [ -d "$SYSNET/$b/brif" ]; then
		for p in "$SYSNET/$b/brif"/*; do
			[ -e "$p" ] || [ -L "$p" ] || continue
			p=${p##*/}
			case "$p" in bcawl*|"$S_UPLINK.$S_VID") ;; *)
				err "$b has port $p: left in place (its owner removes it)"
				S_MB=0 ;;
			esac
		done
	fi
	sub_drop "$b" || err "$b: $S_TRUNK.$S_VID not removed"
	[ "$S_MB" = 1 ] && [ -e "$SYSNET/$b" ] && { ip link del dev "$b" || err "$b: not deleted"; }
	rm -f "$L2/$b"
	return 0
}

# every bridge's trunk sub-interface follows its mode (header); rc 1 when one
# could not
cmd_sync() {
	local f b r=0 x
	for f in "$L2"/brwifi*; do
		[ -f "$f" ] || continue
		b=${f##*/}; case "$b" in *.new) continue ;; esac
		st_read "$b" || continue
		[ -n "$S_VID" ] && valid_trunk "$S_UPLINK" || continue
		# the backhaul VLANs follow the backhaul VID (bhvid= may have moved)
		bh_attach_all "$b" || r=1
		vid_mode "$S_VID" "$b"
		if [ "$MODE" = gateway ] && [ "$S_TRUNK" != - ]; then
			if sub_drop "$b"; then
				S_TRUNK=- S_MV=0; st_write "$b"
				err "$b: VLAN $S_VID is a gateway network: $S_UPLINK.$S_VID removed (sync)"
			else
				err "$b: $S_UPLINK.$S_VID could not be removed (gateway network)"; r=1
			fi
		elif [ "$MODE" = vlan ] && [ "$S_TRUNK" = - ]; then
			x=$(trunk_dev "$S_UPLINK")
			[ -n "$x" ] && [ -e "$SYSNET/$x" ] || { err "$b: trunk $S_UPLINK not present: VLAN $S_VID not carried"; r=1; continue; }
			S_TRUNK=$S_UPLINK S_MV=0; st_write "$b"
			if sub_up "$b"; then
				err "$b: VLAN $S_VID is VLAN only again: $S_UPLINK.$S_VID carried (sync)"
			else
				# nothing half-made: back to "-" (sub_drop deletes what was made)
				sub_drop "$b"; S_TRUNK=- S_MV=0; st_write "$b"; r=1
			fi
		fi
	done
	return $r
}

cmd_list() {
	local f b
	for f in "$L2"/brwifi*; do
		[ -f "$f" ] || continue
		b=${f##*/}; case "$b" in *.new) continue ;; esac
		st_read "$b"; echo "$b $S_TRUNK $S_VID$S_USERS"
	done
}

c=${1:-}; [ $# -gt 0 ] && shift
case "$c" in
up)	[ $# = 4 ] || [ $# = 5 ] || { err "usage: up <user> <bridge> <trunk> <vid> [<wired>]"; exit 2; }
	# a failed up leaves nothing of this user (what it created is undone)
	lock || exit 1; cmd_up "$@"; r=$?; [ $r = 0 ] || cmd_down "$1" "$2"; unlock; exit $r ;;
down)	[ $# = 2 ] || { err "usage: down <user> <bridge>"; exit 2; }
	lock || exit 1; cmd_down "$@"; r=$?; unlock; exit $r ;;
vid)	[ $# = 1 ] && valid_bridge "$1" && st_read "$1" && [ -n "$S_VID" ] || exit 1
	echo "$S_VID" ;;
list)	cmd_list ;;
mode)	[ $# = 1 ] || [ $# = 2 ] || { err "usage: mode <vid> [<bridge>]"; exit 2; }
	valid_vid "$1" || exit 2
	vid_mode "$1" "${2:-}"; echo "$MODE" ;;
sync)	lock || exit 1; cmd_sync; r=$?; unlock; exit $r ;;
trunk-add) [ $# = 1 ] || [ $# = 2 ] || { err "usage: trunk-add <dev> [<peer MAC>]"; exit 2; }
	lock || exit 1; cmd_trunk_add "$@"; r=$?; unlock; exit $r ;;
trunk-del) [ $# = 1 ] || { err "usage: trunk-del <dev>"; exit 2; }
	lock || exit 1; cmd_trunk_del "$@"; r=$?; unlock; exit $r ;;
uplink)	[ $# = 1 ] || { err "usage: uplink <dev>|-"; exit 2; }
	lock || exit 1; cmd_uplink "$@"; r=$?; unlock; exit $r ;;
trunks)	cmd_trunks ;;
*)	err "usage: up|down|vid|list|mode|sync|trunk-add|trunk-del|uplink|trunks"; exit 2 ;;
esac
