#!/bin/sh
# shellcheck shell=busybox
# SPDX-License-Identifier: GPL-2.0
# gt-be98-wps: Wi-Fi Protected Setup on the network that runs it (network
# wps=1 in the network list, see /usr/sbin/gt-be98-wifi-gen; off unless the
# admin sets it, one network at most).
#
#   gt-be98-wps pbc         press the push button: a client that presses its
#                           own WPS button within 2 minutes gets the network
#                           (hostapd wps_pbc; two clients pressing in that
#                           time are an overlap and both are refused)
#   gt-be98-wps pin PIN     admit the client showing this PIN (4 or 8 digits,
#                           an 8-digit PIN must carry its checksum digit) for
#                           2 minutes (hostapd wps_pin any PIN 120). The box
#                           has no PIN of its own: nothing to brute-force
#   gt-be98-wps cancel      end a running push-button or PIN session
#   gt-be98-wps status      hostapd's WPS state (PBC Status, Last WPS result)
#
# The WPS BSSes are the ones whose generated config has wps_state= (the plan
# of gt-be98-wifi, $STATE/gen/plan). All of them run in ONE hostapd, whose
# WPS commands reach every WPS BSS of the process: the command is sent to the
# first one only, and the network's 2.4 and 5 GHz BSSes share the session.
# Exit: 0 done, 1 refused (WPS off, or hostapd answered FAIL), 2 usage.
set -u
# (GT_BE98_*: the offline test harness only)
RUNDIR=${GT_BE98_RUN:-/run}
HOSTAPD_CLI=${GT_BE98_HOSTAPD_CLI:-hostapd_cli}
STATE=$RUNDIR/gt-be98-wifi
PLAN=$STATE/gen/plan

usage() { sed -n '/^#   gt-be98-wps pbc/,/^#   gt-be98-wps status/p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2; }
log() {
	if command -v logger > /dev/null 2>&1; then logger -t gt-be98-wps -- "$*"; fi
	echo "gt-be98-wps: $*" >&2
}

# the first WPS BSS of the plan: "<ctrl dir> <ifname>", nothing when WPS is off
# (plan: bss <dev> <ifname> <slot> <net> <index> <bssid> <bridge> <conf> <sum>)
wps_bss() {
	[ -f "$PLAN" ] || return 0
	while read -r t _ ifn _ _ _ _ _ conf _; do
		[ "$t" = bss ] && [ -f "$conf" ] || continue
		grep -q '^wps_state=[12]$' "$conf" || continue
		c=$(sed -n 's/^ctrl_interface=//p' "$conf" | head -n 1)
		echo "${c:-/run/hostapd} $ifn"
		return 0
	done < "$PLAN"
}

# a WPS PIN: 4 digits, or 8 whose last is the checksum of the first 7
pin_ok() {
	case $1 in
	[0-9][0-9][0-9][0-9]) return 0 ;;
	[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]) ;;
	*) return 1 ;;
	esac
	p=$1 s=0 i=0
	while [ $i -lt 8 ]; do
		d=${p%"${p#?}"}; p=${p#?}
		if [ $((i % 2)) = 0 ]; then s=$((s + 3 * d)); else s=$((s + d)); fi
		i=$((i + 1))
	done
	[ $((s % 10)) = 0 ]
}

[ $# -ge 1 ] || usage
cmd=$1; shift
case $cmd in
pbc|cancel|status) [ $# = 0 ] || usage ;;
pin) [ $# = 1 ] || usage
	pin_ok "$1" || { log "pin refused: 4 digits, or 8 digits with a valid checksum"; exit 1; } ;;
*) usage ;;
esac

b=$(wps_bss)
if [ -z "$b" ]; then
	log "$cmd refused: WPS is off (no network has wps=1, or the Wi-Fi service is not running)"
	exit 1
fi
ctrl=${b% *} ifn=${b#* }
case $cmd in
pbc) a=$("$HOSTAPD_CLI" -p "$ctrl" -i "$ifn" wps_pbc 2>&1) ;;
pin) a=$("$HOSTAPD_CLI" -p "$ctrl" -i "$ifn" wps_pin any "$1" 120 2>&1) ;;
cancel) a=$("$HOSTAPD_CLI" -p "$ctrl" -i "$ifn" wps_cancel 2>&1) ;;
status) "$HOSTAPD_CLI" -p "$ctrl" -i "$ifn" wps_get_status; exit $? ;;
esac
if [ "$a" = OK ]; then
	if [ "$cmd" = cancel ]; then log "cancel: done on $ifn (and every WPS BSS of the network)"
	else log "$cmd: started on $ifn (and every WPS BSS of the network), 2 minutes"; fi
	exit 0
fi
log "$cmd: hostapd answered: $a"
exit 1
