config BR2_PACKAGE_GT_BE98_WEBUI
	bool "gt-be98-webui (prebuilt webui-go, mainline-os port)"
	select BR2_PACKAGE_GT_BE98_OS
	help
	  Installs the prebuilt gt-be98-webui-go delivery (branch
	  mainline-os, built separately on the build host) from a local
	  directory:
	    webui                 -> /usr/sbin/webui
	    www/                  -> /usr/share/webui/www/
	    openrc/webui          -> /etc/init.d/webui
	    openrc/webui.confd    -> /etc/conf.d/webui
	    platform.conf.example -> /etc/webui/platform.conf (if absent)
	  The service is installed but NOT enabled (rc-update add webui
	  default). Empty directory: only /etc/webui and a placeholder
	  service are installed.

if BR2_PACKAGE_GT_BE98_WEBUI

config BR2_PACKAGE_GT_BE98_WEBUI_DIR
	string "webui delivery directory (build host)"
	default ""
	help
	  Absolute path of the webui-go build output (the directory with
	  webui, www/, openrc/, platform.conf.example). Set from WEBUI_DIR
	  in the local configuration by board/gt-be98-mainline/build.sh.

endif
