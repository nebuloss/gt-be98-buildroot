config BR2_PACKAGE_GT_BE98_WEBUI
	bool "gt-be98-webui (prebuilt webui-go binary)"
	select BR2_PACKAGE_GT_BE98_OS
	help
	  Installs a prebuilt static arm64 gt-be98-webui-go binary (branch
	  mainline-os, built separately on the build host) as
	  /usr/sbin/webui, with /etc/webui/ for its configuration and the
	  OpenRC service "webui" (installed, NOT enabled: rc-update add
	  webui default). Leave the path empty to install only /etc/webui/
	  and the service script.

if BR2_PACKAGE_GT_BE98_WEBUI

config BR2_PACKAGE_GT_BE98_WEBUI_BINARY
	string "path to the prebuilt webui binary"
	default ""
	help
	  Absolute path on the build host. Empty: no binary installed.

config BR2_PACKAGE_GT_BE98_WEBUI_EXTRA_DIR
	string "optional directory copied into the rootfs"
	default ""
	help
	  Absolute path of a directory whose contents are copied as-is
	  over the rootfs (e.g. etc/init.d/webui, etc/conf.d/webui,
	  etc/webui/*, usr/share/webui/www/...) as delivered with the
	  binary. Files from it replace the defaults of this package.

endif
