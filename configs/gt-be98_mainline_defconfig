# GT-BE98 (BCM4916) mainline development OS.
# Linux 7.2.9 + the open-ethernet patch series, OpenRC, glibc, upstream tools.
# Build: board/gt-be98-mainline/build.sh (sets the local configuration file).
# Design, image layout, sizes: board/gt-be98-mainline/README.md.

# --- target ---------------------------------------------------------------------
BR2_aarch64=y
BR2_cortex_a53=y

# --- toolchain: Buildroot internal, glibc, default (stable) GCC -----------------
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y
BR2_KERNEL_HEADERS_AS_KERNEL=y
BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_7_1=y
BR2_SHARED_STATIC_LIBS=y
BR2_GLOBAL_PATCH_DIR="$(BR2_EXTERNAL_GT_BE98_PATH)/board/gt-be98-mainline/patches"
BR2_ENABLE_LOCALE_PURGE=y
BR2_ENABLE_LOCALE_WHITELIST="C en_US"
BR2_OPTIMIZE_2=y
BR2_STRIP_strip=y

# --- system ---------------------------------------------------------------------
BR2_TARGET_GENERIC_HOSTNAME="gt-be98"
BR2_TARGET_GENERIC_ISSUE="GT-BE98 mainline development OS"
BR2_INIT_OPENRC=y
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_DEVTMPFS=y
BR2_SYSTEM_BIN_SH_BASH=y
BR2_TARGET_GENERIC_GETTY_PORT="ttyAMA0"
BR2_TARGET_GENERIC_GETTY_BAUDRATE_115200=y
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_GT_BE98_PATH)/board/gt-be98-mainline/post-image.sh"

# --- kernel: 7.2.9 + kernel-patches/mainline (gt-be98-open-ethernet) -----------
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="7.2.9"
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="$(BR2_EXTERNAL_GT_BE98_PATH)/board/gt-be98-mainline/linux/linux.config"
BR2_LINUX_KERNEL_IMAGE=y
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y

# --- GT-BE98 packages -----------------------------------------------------------
BR2_PACKAGE_GT_BE98_OS=y
BR2_PACKAGE_GT_BE98_OPEN_ETHERNET=y
BR2_PACKAGE_GT_BE98_OPEN_WIFI=y
BR2_PACKAGE_GT_BE98_VENDOR_FIRMWARE=y
BR2_PACKAGE_GT_BE98_RESCUE_BUSYBOX=y
BR2_PACKAGE_GT_BE98_WEBUI=y

# --- base userland (no BusyBox in the rootfs) -------------------------------------
# BR2_PACKAGE_BUSYBOX is not set
BR2_PACKAGE_BASH=y
BR2_PACKAGE_COREUTILS=y
BR2_PACKAGE_FINDUTILS=y
BR2_PACKAGE_GREP=y
BR2_PACKAGE_SED=y
BR2_PACKAGE_GAWK=y
BR2_PACKAGE_DIFFUTILS=y
BR2_PACKAGE_WHICH=y
BR2_PACKAGE_LESS=y
BR2_PACKAGE_NANO=y
BR2_PACKAGE_TAR=y
BR2_PACKAGE_GZIP=y
BR2_PACKAGE_XZ=y
BR2_PACKAGE_PROCPS_NG=y
BR2_PACKAGE_PSMISC=y
BR2_PACKAGE_HTOP=y
BR2_PACKAGE_LSOF=y
BR2_PACKAGE_KMOD=y
BR2_PACKAGE_KMOD_TOOLS=y
BR2_PACKAGE_UTIL_LINUX=y
BR2_PACKAGE_UTIL_LINUX_BINARIES=y
BR2_PACKAGE_UTIL_LINUX_AGETTY=y
BR2_PACKAGE_UTIL_LINUX_KILL=y
BR2_PACKAGE_UTIL_LINUX_LOGGER=y
BR2_PACKAGE_UTIL_LINUX_LOSETUP=y
BR2_PACKAGE_UTIL_LINUX_MORE=y
BR2_PACKAGE_UTIL_LINUX_MOUNT=y
BR2_PACKAGE_UTIL_LINUX_MOUNTPOINT=y
BR2_PACKAGE_UTIL_LINUX_NSENTER=y
BR2_PACKAGE_UTIL_LINUX_UNSHARE=y
BR2_PACKAGE_UTIL_LINUX_IRQTOP=y
BR2_PACKAGE_UTIL_LINUX_LSFD=y
BR2_PACKAGE_UTIL_LINUX_LSMEM=y

# --- networking -----------------------------------------------------------------
BR2_PACKAGE_IPROUTE2=y
BR2_PACKAGE_IPUTILS=y
BR2_PACKAGE_ETHTOOL=y
BR2_PACKAGE_DHCPCD=y
BR2_PACKAGE_OPENSSH=y
BR2_PACKAGE_CHRONY=y
BR2_PACKAGE_NFTABLES=y
BR2_PACKAGE_CONNTRACK_TOOLS=y
BR2_PACKAGE_TCPDUMP=y
BR2_PACKAGE_IPERF3=y
BR2_PACKAGE_SOCAT=y
BR2_PACKAGE_NETCAT_OPENBSD=y
BR2_PACKAGE_RSYNC=y
BR2_PACKAGE_LIBCURL=y
BR2_PACKAGE_LIBCURL_CURL=y
BR2_PACKAGE_CA_CERTIFICATES=y
BR2_PACKAGE_LIBOPENSSL=y
BR2_PACKAGE_DNSMASQ=y

# --- Wi-Fi userland ---------------------------------------------------------------
BR2_PACKAGE_IW=y
BR2_PACKAGE_WIRELESS_REGDB=y
BR2_PACKAGE_HOSTAPD=y
BR2_PACKAGE_HOSTAPD_DRIVER_NL80211=y
BR2_PACKAGE_HOSTAPD_WPA3=y
BR2_PACKAGE_HOSTAPD_ACS=y
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_WPA_SUPPLICANT_NL80211=y
BR2_PACKAGE_WPA_SUPPLICANT_CLI=y
BR2_PACKAGE_WPA_SUPPLICANT_WPA3=y

# --- logging ----------------------------------------------------------------------
BR2_PACKAGE_SYSKLOGD=y

# --- debugging / driver development -------------------------------------------------
BR2_PACKAGE_STRACE=y
BR2_PACKAGE_GDB=y
BR2_PACKAGE_GDB_SERVER=y
BR2_PACKAGE_LINUX_TOOLS_PERF=y
BR2_PACKAGE_ELFUTILS=y
BR2_PACKAGE_TRACE_CMD=y
BR2_PACKAGE_MEMTOOL=y
BR2_PACKAGE_PCIUTILS=y

# --- root filesystem: squashfs (xz), packed into the kernel's initramfs ------------
BR2_TARGET_ROOTFS_SQUASHFS=y
BR2_TARGET_ROOTFS_SQUASHFS4_XZ=y
BR2_TARGET_ROOTFS_SQUASHFS_BS_1024K=y
BR2_TARGET_ROOTFS_SQUASHFS_EXTREME_COMP=y
# BR2_TARGET_ROOTFS_TAR is not set

# --- host tools for the FIT ---------------------------------------------------------
BR2_PACKAGE_HOST_UBOOT_TOOLS=y
BR2_PACKAGE_HOST_UBOOT_TOOLS_FIT_SUPPORT=y
BR2_PACKAGE_HOST_DTC=y
