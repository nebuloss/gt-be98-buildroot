# GT-BE98 mainline OS - local configuration (build host only, NEVER commit
# the filled-in copy). board/gt-be98-mainline/build.sh reads it from
# $GT_BE98_LOCAL_CONF (default ~/.config/gt-be98-os/local.conf) and records
# its path in the Buildroot .config (BR2_PACKAGE_GT_BE98_OS_LOCAL_CONF).
# Shell syntax: KEY=VALUE, absolute paths.

# --- build.sh ------------------------------------------------------------------
# Buildroot source tree (release tarball, signature checked)
BR2_SRC=$HOME/os-build/buildroot-2026.08
# Buildroot output directory (about 15 GB)
OUT=$HOME/os-build/out-mainline
# shared download directory
BR2_DL_DIR=$HOME/be98/buildroot/dl

# --- FIT -----------------------------------------------------------------------
# the stock bootfs FIT (dumpimage -p 0 of a stock .pkgtb): ATF, U-Boot and
# the vendor DTBs are reused unchanged
STOCK_BOOTFS=

# --- vendor firmware (gt-be98-vendor-firmware; sha256-checked) -------------------
# bcm4916-runner-microcode.bin, merlin16-shortfin.bin
FW_RUNNER_DIR=
# stock /rom/etc/fw (xphy_firmware.bin, blackfin_b0_firmware.bin)
FW_PHY_DIR=
# stock /rom/etc/wlan (dhd/6726b0, dhd/6717a0, nvram/GT-BE98.nvm)
FW_WIFI_DIR=

# --- access ----------------------------------------------------------------------
# public keys allowed to log in as root over ssh
SSH_AUTHORIZED_KEYS=
# stable ssh host keys (build.sh generates them here if missing)
SSH_HOSTKEY_DIR=$HOME/.config/gt-be98-os/ssh-host-keys
# auto (enabled only when there is no SSH key) | yes | no
TELNET_LIFELINE=auto

# --- network (optional) -------------------------------------------------------------
# static address dhcpcd falls back to when no DHCP server answers (A.B.C.D/NN)
RNR0_FALLBACK=
USB_FALLBACK=
# remote syslog target host[:port] (UDP)
SYSLOG_REMOTE=

# --- boot ----------------------------------------------------------------------------
# netroot (default): small FIT (kernel + DTB + rescue initramfs); /init
#   boots a GTBE98-ROOT USB partition, else fetches ROOTFS_URL.
# initrd: the rootfs inside the FIT (only for a boot chain that loads ~46 MB)
IMAGE=netroot
# http:// URL of rootfs.squashfs (rootfs.squashfs.sha256 must sit next to
# it). @DHCP_SERVER@ / @DHCP_ROUTER@ are replaced at boot by the lifeline's
# DHCP lease values. Changing it only needs build.sh (post-image).
ROOTFS_URL=
# NAND access (PHASE 1): off (default: no NAND node in the DT) or ro
# (read-only: UBI attached read-only, the stock /jffs mounted read-only and
# /jffs/mainline-os applied; NAND.md). There is no write mode.
NAND=off
# the size probe ml-bootfs-pad<N>.itb is padded to this many MiB
PAD_TOTAL_MB=30
# 1: always boot the rescue lifeline (the rootfs is still in the image)
RESCUE=0
# rescue: seconds of watchdog petting (extendable to 3600)
WDT_MAX=600

# --- web UI (gt-be98-webui; optional) -------------------------------------------------
# webui-go mainline-os build output (webui, www/, openrc/, platform.conf.example);
# the service is installed disabled. Empty: not installed.
WEBUI_DIR=
# Web UI admin password. Set either of these to ENABLE the webui service at
# boot; with neither, the webui stays disabled (it never runs its first-run
# open setup on the LAN). WEBUI_PASSWORD: >= 6 characters, stored in the image
# only as /etc/webui/auth.conf (SALT + sha256(SALT || password)).
# WEBUI_PASSWORD_HASH: "SALT:HASH" in that same format.
WEBUI_PASSWORD=
WEBUI_PASSWORD_HASH=
