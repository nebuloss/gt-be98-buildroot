# GT-BE98 mainline development OS - kernel config fragment.
#
# Merged by gen-linux-config.sh AFTER the open-ethernet fragments
# (tools/mainline-boot/gt-be98-mlboot.config, -s2, -pcie, -pcie-all), on top
# of "make allnoconfig". Everything here is what a full OpenRC userland and
# driver development need beyond the diagnostic initramfs image. Size matters:
# the whole Image (with the built-in initramfs that carries the rootfs
# squashfs) must stay below 30 MB (board/gt-be98-mainline/README.md, "Size").
# Prefer =m for anything not needed to reach the rootfs.

# --- rootfs: squashfs image file in the initramfs, loop-mounted, overlayfs ----
CONFIG_BLK_DEV=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_BLK_DEV_LOOP_MIN_COUNT=2
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_OVERLAY_FS=y
CONFIG_TMPFS_XATTR=y
CONFIG_TMPFS_POSIX_ACL=y

# --- size: pack the relocations of the relocatable kernel (allnoconfig
# leaves RELR off; ~2 MB less Image, the bootfs must stay small)
CONFIG_RELR=y

# --- CMA: the four radios' DMA memory --------------------------------------
# Overrides the 168 MB of gt-be98-mlboot-pcie-all.config (stock's cma=168M):
# with all four radios on the live BHM pool plus the copy-path flowring
# buffers (2 MB coherent per client/TID ring), 168 MB runs out. CMA pages
# stay usable for movable allocations. Separate from the Runner's 64 MB
# reusable pool and the 256 MB no-map MPM pool (DT reserved-memory, kept).
# All of DRAM (2 GB) is inside the PCIe inbound window.
CONFIG_CMA_SIZE_MBYTES=256

# --- userland: OpenRC, OpenSSH (seccomp sandbox), glibc tools -------------------
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_INOTIFY_USER=y
CONFIG_FANOTIFY=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_PIDS=y
CONFIG_MEMCG=y
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_SYSFS_SYSCALL=y
CONFIG_MODULE_FORCE_UNLOAD=y
CONFIG_PROC_PAGE_MONITOR=y
CONFIG_PROC_CHILDREN=y
CONFIG_TASKSTATS=y
CONFIG_TASK_DELAY_ACCT=y

# --- debugging / tracing / profiling for driver work ------------------------------
# The bootfs must stay small (a 46 MB one did not boot, the 14.7 MB ones
# do), so the tracing set is tracepoints + kprobes + perf counters. The
# function tracer (+1.7 MB), BPF and KALLSYMS_ALL cost too much Image.
CONFIG_PERF_EVENTS=y
CONFIG_ARM_PMU=y
CONFIG_ARM_PMUV3=y
CONFIG_HW_PERF_EVENTS=y
CONFIG_FTRACE=y
# CONFIG_FUNCTION_TRACER is not set
CONFIG_KPROBES=y
CONFIG_KPROBE_EVENTS=y
CONFIG_DEBUG_FS=y

# --- networking extras (modules) ------------------------------------------------
CONFIG_NET_SCHED=y
CONFIG_NET_SCH_FQ_CODEL=y
CONFIG_NET_SCH_HTB=m
CONFIG_NET_SCH_NETEM=m
CONFIG_NET_SCH_INGRESS=m
CONFIG_NET_CLS_ACT=y
CONFIG_NET_CLS_U32=m
CONFIG_NET_CLS_FLOWER=m
CONFIG_NET_ACT_MIRRED=m
CONFIG_NET_ACT_GACT=m
CONFIG_INET_DIAG=y
CONFIG_PACKET_DIAG=m
CONFIG_UNIX_DIAG=m
CONFIG_IP_MULTIPLE_TABLES=y
CONFIG_IPV6_MULTIPLE_TABLES=y
CONFIG_TUN=m
CONFIG_VETH=m
CONFIG_DUMMY=m
CONFIG_MACVLAN=m
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NETFILTER_NETLINK_LOG=m
CONFIG_NF_CT_NETLINK=m
CONFIG_NF_CONNTRACK_EVENTS=y
CONFIG_NF_TABLES_NETDEV=y
# Wi-Fi router mode: table bridge gt_be98_router_iso (client isolation on
# the brwifiN bridges, "meta ibrname")
CONFIG_NF_TABLES_BRIDGE=y
CONFIG_NFT_BRIDGE_META=y
CONFIG_NFT_LOG=m
CONFIG_NFT_LIMIT=m
CONFIG_NFT_REJECT=m
CONFIG_NFT_REDIR=m
CONFIG_NFT_QUOTA=m
CONFIG_NFT_CONNLIMIT=m
CONFIG_NFT_FIB_INET=m
CONFIG_NFT_FIB_IPV4=m
CONFIG_NFT_FIB_IPV6=m
CONFIG_NF_LOG_SYSLOG=m

# --- USB mass storage: built in, so the initramfs can boot a root from a
# USB stick (label GTBE98-ROOT) and the OS can keep logs on one (GTBE98-DATA).
# Never NAND.
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_USB_STORAGE=y
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_FAT_DEFAULT_UTF8=y
CONFIG_NLS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y

# --- NAND, read-only (DT node only with NAND=ro; NAND.md) -----------------------
CONFIG_MTD=y
CONFIG_MTD_OF_PARTS=y
CONFIG_MTD_RAW_NAND=y
CONFIG_MTD_NAND_BRCMNAND=y
CONFIG_MTD_NAND_BRCMNAND_BCMBCA=y
CONFIG_MTD_UBI=y
# CONFIG_MTD_UBI_FASTMAP is not set
# CONFIG_MTD_UBI_GLUEBI is not set
CONFIG_UBIFS_FS=y
CONFIG_UBIFS_FS_LZO=y
CONFIG_UBIFS_FS_ZLIB=y
CONFIG_UBIFS_FS_ZSTD=y
# CONFIG_MTD_OOPS is not set

# --- crash capture: netconsole + a 5 s panic timeout ---------------------------
# DRAM does not survive any reset: the loader's DDR init re-keys the DDR
# scrambler from the hardware RNG every time (open-ethernet
# docs/mainline-noUART-bringup.md, section 2a), so pstore/ramoops reads back
# noise and no ramoops region is reserved (PSTORE_RAM stays compiled with no
# region, as the open-ethernet fragment has it). The log has to leave the box
# before the reset: netconsole, a module, loaded by the gt-be98-netconsole
# service only when /etc/conf.d/gt-be98-netconsole names a target (the
# command line is forced, so netconsole= cannot be passed there). DYNAMIC:
# targets can be added/changed at runtime under configfs.
CONFIG_NETCONSOLE=m
CONFIG_NETCONSOLE_DYNAMIC=y
CONFIG_CONFIGFS_FS=y
# reboot 5 s after a panic instead of 1 s: netpoll returns once a frame is
# queued to the driver, not once it is on the wire, so the last lines of the
# panic report need time to leave before the reset. gen-linux-config.sh
# writes panic=5 into the forced command line too (it wins over this).
# oops=panic and softlockup_panic=1 are unchanged; no new panic trigger.
CONFIG_PANIC_TIMEOUT=5

# --- cfg80211: the regulatory database is loaded at boot, no CRDA ------------
# cfg80211 is built in and asks for regulatory.db at late_initcall, while the
# root is still the built-in initramfs. post-image.sh puts regulatory.db and
# regulatory.db.p7s (wireless-regdb, signed with a key the kernel carries:
# CFG80211_USE_KERNEL_REGDB_KEYS) into the initramfs, so that load succeeds.
# Without it cfg80211 remembered the failure and sent every later hint
# (iw reg set, hostapd country_code) to CRDA, which this OS does not ship: a
# uevent nobody answers, a silent ~3 s timeout each, all hints ignored after
# ten. CRDA support off, so a missing database fails at once instead.
# CFG80211_CRDA_SUPPORT is only offered with EXPERT, which only unhides
# menu entries: gen-linux-config.sh starts from allnoconfig and every other
# symbol keeps its value (checked by a full .config diff, 2026-10-26).
CONFIG_EXPERT=y
# CONFIG_CFG80211_CRDA_SUPPORT is not set

# --- LEDs: the LED class and its triggers (gt-be98-leds) ---------------------
# Nothing registers a LED yet: the board DT declares none (stock's SoC GPIO
# LEDs: power 50, LAN 1, 10G 47, WAN white 17 / red 43, AFC 48, all active
# low) and the Wi-Fi LEDs are GPIO 12 of each radio chip, driven by the radio
# firmware (stock: `wl ledbh 12 7`), so they need a LED class device from the
# Wi-Fi driver. Built in so that a DT node (LEDS_GPIO) or the driver (it
# depends on LEDS_CLASS, and may offload the netdev trigger to the firmware)
# is all that is missing; gt-be98-leds sets the netdev trigger per radio.
CONFIG_NEW_LEDS=y
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_GPIO=y
CONFIG_LEDS_TRIGGERS=y
CONFIG_LEDS_TRIGGER_NETDEV=y
CONFIG_LEDS_TRIGGER_TIMER=y
CONFIG_LEDS_TRIGGER_DEFAULT_ON=y
CONFIG_LEDS_TRIGGER_HEARTBEAT=y
