#!/bin/sh
# SPDX-License-Identifier: GPL-2.0
# GT-BE98 NAND phase-2 rehearsal (G5 restore + G6 fence), runs as /init in
# QEMU on the patched kernel with nandsim shaped like the box's NAND
# (Macronix MX30LF2G28AD: 256 MiB, 128 KiB blocks, 2 KiB pages; nandsim OOB
# 64 B with software BCH-8 instead of the box's 108-B controller layout;
# nandsim allows sub-page writes, so UBI is attached with the box's VID
# header offset, -O 2048),
# partitions loader (16 blocks) / image (2024) / rest (8, the BBT area).
# The image partition is loaded with the page data of the box's corrected
# backup. Every check prints "GATE <name> PASS|FAIL"; the run ends with
# "RH-DONE".
export PATH=/tools:/bin:/sbin
/bin/busybox --install -s /bin
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
mount -t tmpfs -o size=90% tmpfs /tmp
mount -t debugfs debugfs /sys/kernel/debug

say() { echo "RH: $*"; }
pass=0; fail=0
gate() {
	if eval "$2" >/tmp/gate.out 2>&1; then
		echo "GATE $1 PASS"; pass=$((pass + 1))
	else
		echo "GATE $1 FAIL ($2)"; sed 's/^/    /' /tmp/gate.out | tail -n 5; fail=$((fail + 1))
	fi
}
FW=/sys/module/nandsim/parameters/fence_writes
UF=/sys/module/ubi/parameters/fence
DBG=/sys/kernel/debug/ubi
EB=131072; WS=2048; OOB=$(cat /sys/class/mtd/mtd1/oobsize)
STOCK_BOOTFS2=74efd23e3c466ab10f486faab8cda97c8b2054c6627ec3f17d72306a50746f53
STOCK_META=51aa0cb2f0d76748d99f08a491da7d3cf99c1f5bc7c6df3899cf4e23286bd4df
D=/data

say "kernel $(uname -r)"
cat /proc/mtd
gate geometry "[ \$(cat /sys/class/mtd/mtd1/size) = 265289728 ] && [ \$(cat /sys/class/mtd/mtd1/erasesize) = $EB ] && [ \$(cat /sys/class/mtd/mtd1/writesize) = $WS ]"

# ---- L: load the box's data (fence off on the simulated chip) -------------------
echo 0 > $FW
echo "" > $UF
say "loading loader + image page data"
nandwrite -q /dev/mtd0 $D/loader.data
nandwrite -q /dev/mtd1 $D/image.data
nanddump -q --bb=dumpbad -f /tmp/load.data /dev/mtd1
gate load_identical "cmp -s /tmp/load.data $D/image.data"
rm -f /tmp/load.data
gt-be98-nandtool pebmap /dev/mtd1 > /tmp/pebmap.txt
say "pebmap: $(grep -c ' vol 13 ' /tmp/pebmap.txt) jffs2, $(grep -c ' free$' /tmp/pebmap.txt) free, $(grep -c ' vol ' /tmp/pebmap.txt) used"

# >=6-bit flip in a slot PEB (bootfs2 LEB 5, page 3): re-program the page
# raw with 6 more 0 bits; the ECC still corrects it, reads report 6 flips
P=$(sed -n 's/^PEB \([0-9]*\) vol 5 lnum 5$/\1/p' /tmp/pebmap.txt)
OFF=$((P * EB + 3 * WS))
say "injecting 6 bitflips in bootfs2 LEB 5 = PEB $P page 3"
nanddump -q -n --oob -s $OFF -l $WS -f /tmp/pg.raw /dev/mtd1
gt-be98-nandtool flipzero /tmp/pg.raw /tmp/pg.inj $WS $OOB 6
nandwrite -q -n -o -s $OFF /dev/mtd1 /tmp/pg.inj
nanddump -s $OFF -l $WS -f /tmp/pg.ecc /dev/mtd1 2>/tmp/pg.log
dd if=$D/image.data of=/tmp/pg.orig bs=$WS skip=$((OFF / WS)) count=1 2>/dev/null
gate injected_still_correctable "cmp -s /tmp/pg.ecc /tmp/pg.orig && grep -q 'corrected' /tmp/pg.log"
cat /tmp/pg.log

# the reference for the restore test: raw data + OOB of the whole partition
nanddump -q -n --oob --bb=dumpbad -f /tmp/backup.raw /dev/mtd1
say "raw backup $(wc -c < /tmp/backup.raw) bytes"

# ---- N: the chip is fenced, nothing registered: no write path at all ------------
echo 1 > $FW
FREEPEB=$(sed -n 's/^PEB \([0-9]*\) free$/\1/p' /tmp/pebmap.txt | head -n1)
dd if=/dev/zero of=/tmp/zero.page bs=$WS count=1 2>/dev/null
# (flash_erase exits 0 even when an erase fails: check the flash itself)
peb_unchanged() {	# $1 PEB of mtd1: corrected data == the loaded image
	nanddump -q -s $(($1 * EB)) -l $EB -f /tmp/peb.now /dev/mtd1 2>/dev/null
	dd if=$D/image.data of=/tmp/peb.orig bs=$EB skip=$1 count=1 2>/dev/null
	cmp -s /tmp/peb.now /tmp/peb.orig
}
flash_erase -q /dev/mtd1 $((FREEPEB * EB)) 1
gate mtd_erase_refused "peb_unchanged $FREEPEB && dmesg | grep -q 'write fence refused erase'"
gate mtd_write_refused "! nandwrite -q -s $((FREEPEB * EB)) /dev/mtd1 /tmp/zero.page && peb_unchanged $FREEPEB"
gate mtd_markbad_refused "! gt-be98-ubileb markbad /dev/mtd1 $((FREEPEB * EB))"
say "unfenced UBI attach (must not be able to write)"
ubiattach -m 1 -d 0 -O 2048
sleep 10
ubinfo -a > /tmp/ubinfo.before
say "unfenced ubi0 ro_mode=$(cat /sys/class/ubi/ubi0/ro_mode)"
gate unfenced_ubi_cannot_create "! ubimkvol /dev/ubi0 -N evil -s 1MiB"
# the backup's static volumes (reference for the stock-side comparisons)
for v in /sys/class/ubi/ubi0_*; do
	[ "$(cat $v/type)" = static ] || continue
	say "backup static ${v##*/} $(cat $v/name) $(cat $v/data_bytes) B sha256 $(sha256sum /dev/${v##*/} | cut -d' ' -f1)"
done
ubidetach -d 0

# ---- F: fenced session on jffs2 ---------------------------------------------------
echo jffs2 > $UF
ubiattach -m 1 -d 0 -O 2048
cat $DBG/ubi0/fence
gate fence_active "grep -q 'state active' $DBG/ubi0/fence && grep -q 'jffs2:13' $DBG/ubi0/fence"
gate fenced_rw_mode "[ \$(cat /sys/class/ubi/ubi0/ro_mode) = 0 ]"
gate vtbl_change_refused "! ubimkvol /dev/ubi0 -N evil -s 1MiB"
gate vol_remove_refused "! ubirmvol /dev/ubi0 -n 4"
echo hello > /tmp/small
gate other_volume_write_refused "! gt-be98-ubileb write /dev/ubi0_6 /tmp/small"
gate raw_write_refused_while_fenced "! nandwrite -q -s $((FREEPEB * EB)) /dev/mtd1 /tmp/zero.page && peb_unchanged $FREEPEB"
gate restore_refused_while_attached "! sh -c 'echo add 1 $FREEPEB 1 > $DBG/fence_restore'"
gate bootfs2_reads_stock_hash "[ \$(sha256sum /dev/ubi0_5 | cut -d' ' -f1) = $STOCK_BOOTFS2 ]"
gate scrub_refused "grep -qE 'scrub_refused [1-9]' $DBG/ubi0/fence"

mkdir -p /mnt
mount -t ubifs ubi0:jffs2 /mnt
df -k /mnt
mkdir -p /mnt/mainline-os && echo "rehearsal marker" > /mnt/mainline-os/marker && sync
N=${RH_LOOPS:-300}
say "write loop: $N x 1 MiB write+sync+delete"
i=0
while [ $i -lt $N ]; do
	dd if=/dev/urandom of=/mnt/churn bs=64k count=16 2>/dev/null
	sync
	rm -f /mnt/churn
	sync
	i=$((i + 1))
	[ $((i % 50)) = 0 ] && say "loop $i: $(grep -E 'writes|erases' $DBG/ubi0/fence | tr '\n' ' ')"
done
gate marker_kept "grep -q 'rehearsal marker' /mnt/mainline-os/marker"
umount /mnt
cat $DBG/ubi0/fence
gate fenced_writes_happened "grep -qE '^writes [1-9]' $DBG/ubi0/fence && grep -qE 'erases [1-9]' $DBG/ubi0/fence"
dmesg | grep -iE 'fence|ubi0' | grep -viE 'fence: (write|erase) PEB' | tail -n 30
dmesg | grep -cE 'fence: (write|erase) PEB' | sed 's/^/RH: logged fence write\/erase lines: /'
ubidetach -d 0

# ---- P: power cuts during fenced writes (UBI's power-cut emulation: after a
# random number of EC/VID/data writes UBI stops writing, as after a power
# loss), then fenced re-attach + UBIFS mount (journal replay) ------------------
c=1
while [ $c -le ${RH_CUTS:-5} ]; do
	ubiattach -m 1 -d 0 -O 2048 >/dev/null
	mount -t ubifs ubi0:jffs2 /mnt
	echo 7 > $DBG/ubi0/tst_emulate_power_cut
	echo 20 > $DBG/ubi0/tst_emulate_power_cut_min
	echo 300 > $DBG/ubi0/tst_emulate_power_cut_max
	i=0
	while [ $i -lt 200 ] && [ "$(cat /sys/class/ubi/ubi0/ro_mode)" = 0 ]; do
		dd if=/dev/urandom of=/mnt/cut.$i bs=64k count=4 2>/dev/null
		sync 2>/dev/null
		[ $((i % 3)) = 2 ] && rm -f /mnt/cut.$((i - 2))
		i=$((i + 1))
	done
	say "power cut $c after $i writes (ro_mode=$(cat /sys/class/ubi/ubi0/ro_mode))"
	umount /mnt 2>/dev/null || umount -l /mnt
	ubidetach -d 0
	ubiattach -m 1 -d 0 -O 2048 >/dev/null
	gate "power_cut_${c}_reattach_fenced" "grep -q 'state active' $DBG/ubi0/fence"
	gate "power_cut_${c}_ubifs_mounts" "mount -t ubifs ubi0:jffs2 /mnt && grep -q 'rehearsal marker' /mnt/mainline-os/marker"
	rm -f /mnt/cut.* 2>/dev/null; sync
	umount /mnt 2>/dev/null
	ubidetach -d 0
	c=$((c + 1))
done

# ---- V: verification ---------------------------------------------------------------
echo "" > $UF
nanddump -q --bb=dumpbad -f /tmp/final.data /dev/mtd1
gt-be98-nandtool pebdiff $D/image.data /tmp/final.data $EB /tmp/pebmap.txt > /tmp/diff.txt
tail -n 1 /tmp/diff.txt
grep '^changed' /tmp/diff.txt | head -n 20
gate only_jffs2_and_free_changed "grep -q 'other 0' /tmp/diff.txt && ! grep '^changed' /tmp/diff.txt | grep -vqE '\\((free|vol 13 lnum [0-9]+)\\)'"
rm -f /tmp/final.data
nanddump -q --bb=dumpbad -f /tmp/loader.final /dev/mtd0
gate loader_unchanged "cmp -s /tmp/loader.final $D/loader.data"
gate injected_peb_untouched "nanddump -q -n --oob -s $OFF -l $WS -f /tmp/pg.now /dev/mtd1 && cmp -s /tmp/pg.now /tmp/pg.inj"
say "re-attach without a fence (writes impossible), stock-style reads"
ubiattach -m 1 -d 0 -O 2048
ubinfo -a > /tmp/ubinfo.after
gate volume_table_unchanged "diff /tmp/ubinfo.before /tmp/ubinfo.after"
gate bootfs2_still_verifies "[ \$(sha256sum /dev/ubi0_5 | cut -d' ' -f1) = $STOCK_BOOTFS2 ]"
gate metadata_unchanged "[ \$(sha256sum /dev/ubi0_1 | cut -d' ' -f1) = $STOCK_META ] && [ \$(sha256sum /dev/ubi0_2 | cut -d' ' -f1) = $STOCK_META ]"
mount -t ubifs -o ro ubi0:jffs2 /mnt && gate jffs2_mounts_with_marker "grep -q 'rehearsal marker' /mnt/mainline-os/marker" && umount /mnt
ubidetach -d 0

# ---- U: the image after the fenced sessions and power cuts, attached by an
# unmodified UBI (gate off, no fence: writes allowed, as stock): attach, erase
# whatever the fence left alone, mount UBIFS read-write (G6 second half) -----
say "unmodified UBI (no gate, no fence) on the post-session image"
echo 0 > $FW
dmesg -c > /dev/null
ubiattach -m 1 -d 0 -O 2048 > /dev/null
gate unmodified_ubi_attaches "[ -e /dev/ubi0_13 ] && [ \"\$(cat /sys/class/ubi/ubi0/ro_mode)\" = 0 ]"
dmesg | grep -E 'corrupted PEBs|bad PEBs' | sed 's/^/RH: /'
gate unmodified_ubi_0_corrupted "dmesg | grep -q 'corrupted PEBs: 0'"
gate unmodified_ubifs_mounts_rw "mount -t ubifs ubi0:jffs2 /mnt && grep -q 'rehearsal marker' /mnt/mainline-os/marker && echo stock > /mnt/stock-side && sync && umount /mnt"
gate unmodified_ubifs_no_errors "! dmesg | grep -qE 'UBIFS error|ubi0 error'"
ubidetach -d 0
echo 1 > $FW

# ---- R: restore the raw backup (G5 restore half) ---------------------------------
gt-be98-nandrestore --dry-run /tmp/backup.raw /dev/mtd1 | tail -n 3
gt-be98-nandrestore /tmp/backup.raw /dev/mtd1 > /tmp/restore.txt; rc=$?
tail -n 3 /tmp/restore.txt
gate restore_ran "[ $rc = 0 ]"
nanddump -q -n --oob --bb=dumpbad -f /tmp/after.raw /dev/mtd1
gate restore_bit_exact "cmp -s /tmp/after.raw /tmp/backup.raw"
rm -f /tmp/after.raw
gate restore_entries_cleared "[ -z \"\$(cat $DBG/fence_restore)\" ]"

# ---- G7 rehearsal with the kit scripts, in the box sequence (phase2/G7.md):
# "stock" = an unfenced attach with the gate off; "mainline" = phase-1 attach,
# then the write fence on mltest only ---------------------------------------------
say "G7: the kit scripts in the box sequence"
K=/kit
export G7_REHEARSAL=1 G7_MTD=/dev/mtd1
gate g7_kit_sha256 "cd $K && sha256sum -c -s SHA256SUMS"
# step 1, stock
echo 0 > $FW; echo "" > $UF
ubiattach -m 1 -d 0 -O 2048 >/dev/null
gate g7_s1_create "$K/stock-mltest.sh create"
gate g7_s1_write_a "$K/stock-mltest.sh write-a"
gate g7_s1_verify_a "$K/stock-mltest.sh verify-a"
gate g7_s1_flips "$K/stock-mltest.sh flips"
ubidetach -d 0
# step 3, mainline: phase-1 attach (gate on, no fence), snapshot, fence on mltest
echo 1 > $FW
ubiattach -m 1 -d 0 -O 2048 >/dev/null
gate g7_s3_before "W=/tmp/g7 $K/mltest-mainline.sh before"
ubidetach -d 0
echo mltest > $UF
ubiattach -m 1 -d 0 -O 2048 >/dev/null
gate g7_s3_fence_mltest_only "grep -qx 'volumes mltest:[0-9]*' $DBG/ubi0/fence && grep -q '^state active' $DBG/ubi0/fence"
mount -t ubifs -o ro ubi0:jffs2 /mnt
gate g7_s3_jffs_ro "grep -q ' /mnt ubifs ro' /proc/mounts"
umount /mnt 2>/dev/null || umount -l /mnt
gate g7_s3_verify_a "$K/mltest-mainline.sh verify-a"
gate g7_s3_write_b "$K/mltest-mainline.sh write-b"
gate g7_s3_flips "$K/mltest-mainline.sh flips"
$K/mltest-mainline.sh status | grep -E '^(state|volumes|pebs|writes|mtd_gate)' | sed 's/^/RH: /'
gate g7_s3_jffs2_refused "! gt-be98-ubileb write /dev/ubi0_13 /tmp/small"
mount -t ubifs -o ro ubi0:jffs2 /mnt
# what if someone remounts jffs2 read-write under fence=mltest? (the
# service never does): UBI refuses every jffs2 write; the result is shown,
# step 4 checks that nothing reached the flash
dmesg -c >/dev/null
if mount -o remount,rw /mnt 2>/dev/null; then
	echo x > /mnt/g7-must-fail 2>/dev/null; sync 2>/dev/null
	say "jffs2 rw remount under fence=mltest: remount accepted; then: $(dmesg | grep -cE 'UBIFS error|refused') UBIFS errors/refusals, mount now: $(grep ' /mnt ' /proc/mounts | cut -d' ' -f4 | cut -d, -f1)"
else
	say "jffs2 rw remount under fence=mltest: refused"
fi
dmesg | grep -E 'UBIFS|fence' | head -n 5 | sed 's/^/RH:   /'
umount /mnt 2>/dev/null || umount -l /mnt
ubidetach -d 0; echo "" > $UF
gate g7_s3_pebdiff "W=/tmp/g7 $K/mltest-mainline.sh after"
tail -n 1 /tmp/g7/pebdiff.txt | sed 's/^/RH: /'
rm -f /tmp/g7/*.data
# step 4, stock
echo 0 > $FW
ubiattach -m 1 -d 0 -O 2048 >/dev/null
gate g7_s4_verify_b "$K/stock-mltest.sh verify-b"
gate g7_s4_flips "$K/stock-mltest.sh flips"
gate g7_s4_jffs2_mounts_no_mainline_write "mount -t ubifs ubi0:jffs2 /mnt && ! [ -e /mnt/g7-must-fail ] && umount /mnt"
gate g7_s4_remove "$K/stock-mltest.sh remove && ! ubinfo -d 0 -N mltest >/dev/null 2>&1"
ubidetach -d 0
echo 1 > $FW

# ---- G8 rehearsal with the kit scripts, in the box sequence (phase2/G8.md) ----
say "G8: the kit scripts in the box sequence"
export G8_REHEARSAL=1 G8_JFFS=/jffs G8_MTD=/dev/mtd1
mkdir -p /jffs
# mainline, phase 1
echo 1 > $FW; echo "" > $UF
ubiattach -m 1 -d 0 -O 2048 >/dev/null
mount -t ubifs -o ro ubi0:jffs2 /jffs
gate g8_before "W=/tmp/g8 $K/jffs-mainline.sh before"
umount /jffs; ubidetach -d 0
# mainline, fence on jffs2, /jffs rw (what gt-be98-jffs does)
echo jffs2 > $UF
ubiattach -m 1 -d 0 -O 2048 >/dev/null
mount -t ubifs -o ro ubi0:jffs2 /jffs && mount -o remount,rw /jffs
gate g8_check "$K/jffs-mainline.sh check"
gate g8_test "$K/jffs-mainline.sh test"
# stands for gt-be98-save --local (no rootfs here): the same files
mkdir -p /jffs/mainline-os
tar -czf /jffs/mainline-os/state.tgz -C / init
(cd /jffs/mainline-os && echo "$(sha256sum state.tgz | cut -d' ' -f1)  state.tgz" > state.tgz.sha256)
sync
gate g8_loop "$K/jffs-mainline.sh loop 20"
gate g8_verify "W=/tmp/g8 $K/jffs-mainline.sh verify"
$K/jffs-mainline.sh status | grep -E '^(state|volumes|pebs|writes|mtd_gate)' | sed 's/^/RH: /'
gate g8_rootfs2_refused "! gt-be98-ubileb write /dev/ubi0_6 /tmp/small"
cd /; umount /jffs; ubidetach -d 0; echo "" > $UF
gate g8_pebdiff "W=/tmp/g8 $K/jffs-mainline.sh after"
tail -n 1 /tmp/g8/pebdiff.txt | sed 's/^/RH: /'
rm -f /tmp/g8/*.data
# stock (a fresh boot: fresh kernel log)
dmesg -c > /dev/null
echo 0 > $FW
ubiattach -m 1 -d 0 -O 2048 >/dev/null
mount -t ubifs ubi0:jffs2 /jffs
gate g8_stock_read "$K/stock-jffs-check.sh read"
gate g8_stock_write "$K/stock-jffs-check.sh write"
gate g8_stock_clean "$K/stock-jffs-check.sh clean"
umount /jffs; ubidetach -d 0
echo 1 > $FW

echo "RH-SUMMARY pass $pass fail $fail"
echo "RH-DONE"
sync
poweroff -f
sleep 30
