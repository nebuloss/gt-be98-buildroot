diff --git a/drivers/mtd/ubi/eba.c b/drivers/mtd/ubi/eba.c
index f0c549e62..dc144e2a1 100644
--- a/drivers/mtd/ubi/eba.c
+++ b/drivers/mtd/ubi/eba.c
@@ -448,6 +448,10 @@ int ubi_eba_unmap_leb(struct ubi_device *ubi, struct ubi_volume *vol,
 {
 	int err, pnum, vol_id = vol->vol_id;
 
+	err = ubi_fence_check_vol(ubi, vol->vol_id, "LEB unmap");
+	if (err)
+		return err;
+
 	if (ubi->ro_mode)
 		return -EROFS;
 
@@ -1016,6 +1020,10 @@ int ubi_eba_write_leb(struct ubi_device *ubi, struct ubi_volume *vol, int lnum,
 	struct ubi_vid_io_buf *vidb;
 	struct ubi_vid_hdr *vid_hdr;
 
+	err = ubi_fence_check_vol(ubi, vol->vol_id, "LEB write");
+	if (err)
+		return err;
+
 	if (ubi->ro_mode)
 		return -EROFS;
 
@@ -1120,6 +1128,10 @@ int ubi_eba_write_leb_st(struct ubi_device *ubi, struct ubi_volume *vol,
 	struct ubi_vid_hdr *vid_hdr;
 	uint32_t crc;
 
+	err = ubi_fence_check_vol(ubi, vol->vol_id, "static LEB write");
+	if (err)
+		return err;
+
 	if (ubi->ro_mode)
 		return -EROFS;
 
@@ -1198,6 +1210,10 @@ int ubi_eba_atomic_leb_change(struct ubi_device *ubi, struct ubi_volume *vol,
 	struct ubi_vid_hdr *vid_hdr;
 	uint32_t crc;
 
+	err = ubi_fence_check_vol(ubi, vol->vol_id, "atomic LEB change");
+	if (err)
+		return err;
+
 	if (ubi->ro_mode)
 		return -EROFS;
 
diff --git a/drivers/mtd/ubi/fence.c b/drivers/mtd/ubi/fence.c
new file mode 100644
index 000000000..9b7ce0fe0
--- /dev/null
+++ b/drivers/mtd/ubi/fence.c
@@ -0,0 +1,534 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * UBI write fence (GT-BE98 mainline development OS, DEBUG, not for upstream).
+ *
+ * The UBI device on the GT-BE98 NAND holds the stock firmware slots, the
+ * boot metadata and the stock data volumes next to the one volume the
+ * mainline OS may write (jffs2). A plain read-write attach may move or
+ * rewrite any of them (wear-leveling, scrubbing, attach repairs, volume
+ * table updates). With the fence, UBI may only write or erase PEBs that are
+ * free or belong to a fenced volume:
+ *
+ *   ubi.fence=<name>[,<name>...]   (runtime: /sys/module/ubi/parameters/fence,
+ *                                   applies to devices attached afterwards)
+ *
+ *  - PEBs of other volumes, and attach "erase" candidates that do not belong
+ *    to a fenced volume, are kept in the fence_off tree: never moved,
+ *    scrubbed or erased (reads are unaffected);
+ *  - only fenced volumes accept LEB writes, unmaps and atomic changes, so the
+ *    volume table (layout volume) cannot change: no volume create, remove,
+ *    resize, rename or update marker;
+ *  - bad-block marking is refused (no BBT write); fastmap must be disabled;
+ *  - until the fence is set up (attach scan, volume table checks) every write
+ *    is refused.
+ *
+ * Below UBI, the MTD write fence (mtd_fence_check(), the NAND core gate for
+ * chips with fence_writes set, i.e. brcmnand and nandsim) lets a program or
+ * erase through only if this code registered it as in flight for the
+ * calling task and range: UBI I/O of a fenced device, or an explicit
+ * restore entry (debugfs ubi/fence_restore) for a detached MTD. Nothing
+ * else can write such a chip.
+ *
+ * Every allowed write/erase is logged (rate-limited) with PEB and owner
+ * volume; counters are in debugfs ubi/ubiN/fence.
+ */
+
+#include <linux/capability.h>
+#include <linux/debugfs.h>
+#include <linux/module.h>
+#include <linux/moduleparam.h>
+#include <linux/pid.h>
+#include <linux/ratelimit.h>
+#include <linux/sched.h>
+#include <linux/sched/signal.h>
+#include <linux/seq_file.h>
+#include <linux/slab.h>
+#include <linux/string.h>
+#include <linux/uaccess.h>
+#include "ubi.h"
+
+static char ubi_fence_param[128];
+module_param_string(fence, ubi_fence_param, sizeof(ubi_fence_param), 0644);
+MODULE_PARM_DESC(fence, "comma-separated UBI volume names the only writable volumes of devices attached from now on (empty: no fence, and no writes on fenced MTD chips)");
+
+static DEFINE_RATELIMIT_STATE(fence_rs, 5 * HZ, 20);
+
+/* ---- in-flight UBI I/O and restore entries, checked by the MTD gate ------ */
+
+#define FENCE_INFLIGHT	32
+#define FENCE_RESTORE	64
+
+struct fence_range {
+	struct mtd_info *master;
+	u64 start, end;
+};
+
+static struct {
+	struct task_struct *task;
+	struct fence_range r;
+} fence_inflight[FENCE_INFLIGHT];
+
+static struct {
+	struct pid *tgid;
+	int mtd_num;
+	struct fence_range r;
+} fence_restore[FENCE_RESTORE];
+
+static DEFINE_SPINLOCK(fence_lock);
+static atomic_long_t fence_gate_allowed, fence_gate_refused, fence_restore_allowed;
+
+static bool range_in(const struct fence_range *r, struct mtd_info *master,
+		     u64 ofs, u64 len)
+{
+	return r->master == master && ofs >= r->start && ofs + len <= r->end;
+}
+
+/* MTD write fence callback: called by mtd_fence_check() under its lock */
+static int ubi_fence_mtd_check(struct mtd_info *master, u64 ofs, u64 len,
+			       enum mtd_fence_op op)
+{
+	int i, ret = -EROFS;
+
+	if (op == MTD_FENCE_MARKBAD)
+		goto out;	/* never: no BBT/bad-block-marker writes */
+
+	spin_lock(&fence_lock);
+	for (i = 0; i < FENCE_INFLIGHT; i++) {
+		if (fence_inflight[i].task == current &&
+		    range_in(&fence_inflight[i].r, master, ofs, len)) {
+			ret = 0;
+			atomic_long_inc(&fence_gate_allowed);
+			goto unlock;
+		}
+	}
+	for (i = 0; i < FENCE_RESTORE; i++) {
+		if (fence_restore[i].tgid &&
+		    fence_restore[i].tgid == task_tgid(current) &&
+		    range_in(&fence_restore[i].r, master, ofs, len)) {
+			ret = 0;
+			atomic_long_inc(&fence_restore_allowed);
+			if (__ratelimit(&fence_rs))
+				pr_info("ubi fence: restore %s 0x%llx+0x%llx on %s (pid %d)\n",
+					op == MTD_FENCE_ERASE ? "erase" : "write",
+					ofs, len, master->name, task_tgid_nr(current));
+			goto unlock;
+		}
+	}
+unlock:
+	spin_unlock(&fence_lock);
+out:
+	if (ret)
+		atomic_long_inc(&fence_gate_refused);
+	return ret;
+}
+
+/* @addr is an offset in @ubi->mtd (the partition); returns a slot or -EROFS */
+int ubi_fence_inflight_begin(const struct ubi_device *ubi, loff_t addr, u64 len)
+{
+	struct mtd_info *master = mtd_get_master(ubi->mtd);
+	u64 ofs = mtd_get_master_ofs(ubi->mtd, addr);
+	int i;
+
+	if (ubi->fence_state != UBI_FENCE_STATE_ACTIVE)
+		return INT_MAX;		/* not fenced: no registration */
+
+	spin_lock(&fence_lock);
+	for (i = 0; i < FENCE_INFLIGHT; i++) {
+		if (!fence_inflight[i].task) {
+			fence_inflight[i].task = current;
+			fence_inflight[i].r.master = master;
+			fence_inflight[i].r.start = ofs;
+			fence_inflight[i].r.end = ofs + len;
+			spin_unlock(&fence_lock);
+			return i;
+		}
+	}
+	spin_unlock(&fence_lock);
+	ubi_err(ubi, "fence: no in-flight slot, refusing I/O");
+	return -EROFS;
+}
+
+void ubi_fence_inflight_end(int slot)
+{
+	if (slot < 0 || slot >= FENCE_INFLIGHT)
+		return;
+	spin_lock(&fence_lock);
+	fence_inflight[slot].task = NULL;
+	spin_unlock(&fence_lock);
+}
+
+/* ---- per-device fence ------------------------------------------------------- */
+
+static const char *owner_str(int owner, char *buf, size_t n)
+{
+	if (owner == UBI_FENCE_FREE)
+		return "free";
+	if (owner == UBI_FENCE_OFF)
+		return "fenced-off";
+	snprintf(buf, n, "vol %d", owner);
+	return buf;
+}
+
+int ubi_fence_attach_begin(struct ubi_device *ubi)
+{
+	char buf[sizeof(ubi_fence_param)], *p, *s;
+
+	ubi->fence_state = UBI_FENCE_STATE_OFF;
+	ubi->fence_nvols = 0;
+	strscpy(buf, ubi_fence_param, sizeof(buf));
+	strim(buf);
+	if (!buf[0])
+		return 0;
+
+#ifdef CONFIG_MTD_UBI_FASTMAP
+	ubi_err(ubi, "fence: needs CONFIG_MTD_UBI_FASTMAP disabled");
+	return -EINVAL;
+#endif
+	p = buf;
+	while ((s = strsep(&p, ",")) != NULL) {
+		s = strim(s);
+		if (!*s)
+			continue;
+		if (ubi->fence_nvols == UBI_FENCE_MAX_VOLS ||
+		    strlen(s) > UBI_VOL_NAME_MAX) {
+			ubi_err(ubi, "fence: bad volume list \"%s\"", ubi_fence_param);
+			return -EINVAL;
+		}
+		strscpy(ubi->fence_names[ubi->fence_nvols], s, UBI_VOL_NAME_MAX + 1);
+		ubi->fence_vol_ids[ubi->fence_nvols] = -1;
+		ubi->fence_nvols++;
+	}
+	if (!ubi->fence_nvols)
+		return 0;
+	ubi->fence_state = UBI_FENCE_STATE_PENDING;
+	ubi_msg(ubi, "fence: pending for \"%s\" (all writes refused until set up)",
+		ubi_fence_param);
+	return 0;
+}
+
+/* resolve the fenced volume names (after the volume table was read) */
+int ubi_fence_init(struct ubi_device *ubi)
+{
+	int i, j;
+
+	if (ubi->fence_state == UBI_FENCE_STATE_OFF)
+		return 0;
+
+	for (i = 0; i < ubi->fence_nvols; i++) {
+		for (j = 0; j < ubi->vtbl_slots; j++) {
+			struct ubi_volume *vol = ubi->volumes[j];
+
+			if (vol && !strcmp(vol->name, ubi->fence_names[i]))
+				ubi->fence_vol_ids[i] = vol->vol_id;
+		}
+		if (ubi->fence_vol_ids[i] < 0) {
+			ubi_err(ubi, "fence: no volume \"%s\"", ubi->fence_names[i]);
+			return -ENODEV;
+		}
+	}
+	ubi->fence_owner = kmalloc_array(ubi->peb_count, sizeof(int), GFP_KERNEL);
+	if (!ubi->fence_owner)
+		return -ENOMEM;
+	for (i = 0; i < ubi->peb_count; i++)
+		ubi->fence_owner[i] = UBI_FENCE_OFF;
+	return 0;
+}
+
+void ubi_fence_activate(struct ubi_device *ubi)
+{
+	int i, nfree = 0, nfenced = 0, noff = 0;
+
+	if (ubi->fence_state != UBI_FENCE_STATE_PENDING)
+		return;
+	for (i = 0; i < ubi->peb_count; i++) {
+		if (ubi->fence_owner[i] == UBI_FENCE_FREE)
+			nfree++;
+		else if (ubi->fence_owner[i] == UBI_FENCE_OFF)
+			noff++;
+		else
+			nfenced++;
+	}
+	ubi->fence_state = UBI_FENCE_STATE_ACTIVE;
+	ubi_msg(ubi, "fence: ACTIVE for \"%s\": %d fenced, %d free, %d fenced-off PEBs",
+		ubi_fence_param, nfenced, nfree, noff);
+}
+
+void ubi_fence_close(struct ubi_device *ubi)
+{
+	kfree(ubi->fence_owner);
+	ubi->fence_owner = NULL;
+	ubi->fence_state = UBI_FENCE_STATE_OFF;
+}
+
+bool ubi_fence_vol_fenced(const struct ubi_device *ubi, int vol_id)
+{
+	int i;
+
+	for (i = 0; i < ubi->fence_nvols; i++)
+		if (ubi->fence_vol_ids[i] == vol_id)
+			return true;
+	return false;
+}
+
+/* may this volume be written (LEB write/unmap/change)? */
+int ubi_fence_check_vol(struct ubi_device *ubi, int vol_id, const char *what)
+{
+	if (ubi->fence_state == UBI_FENCE_STATE_OFF)
+		return 0;
+	if (ubi->fence_state == UBI_FENCE_STATE_ACTIVE &&
+	    ubi_fence_vol_fenced(ubi, vol_id))
+		return 0;
+	atomic_long_inc(&ubi->fence_refused);
+	if (__ratelimit(&fence_rs))
+		ubi_warn(ubi, "fence: refused %s of volume %d", what, vol_id);
+	return -EROFS;
+}
+
+void ubi_fence_set_owner(struct ubi_device *ubi, int pnum, int owner)
+{
+	if (ubi->fence_owner && pnum >= 0 && pnum < ubi->peb_count)
+		ubi->fence_owner[pnum] = owner;
+}
+
+bool ubi_fence_is_off(const struct ubi_device *ubi, int pnum)
+{
+	return ubi->fence_state != UBI_FENCE_STATE_OFF && ubi->fence_owner &&
+	       ubi->fence_owner[pnum] == UBI_FENCE_OFF;
+}
+
+/* low-level check for a write (@vol_id < 0: EC header/data) or an erase */
+int ubi_fence_check_io(struct ubi_device *ubi, int pnum, int op, int vol_id,
+		       int offset, int len)
+{
+	char b[24];
+	int owner;
+
+	if (ubi->fence_state == UBI_FENCE_STATE_OFF)
+		return 0;
+	if (ubi->fence_state != UBI_FENCE_STATE_ACTIVE)
+		goto refuse;
+	owner = ubi->fence_owner[pnum];
+	if (owner == UBI_FENCE_OFF)
+		goto refuse;
+	if (op == UBI_FENCE_OP_VID) {
+		if (!ubi_fence_vol_fenced(ubi, vol_id))
+			goto refuse;
+		ubi->fence_owner[pnum] = vol_id;
+		owner = vol_id;
+	}
+	if (op == UBI_FENCE_OP_ERASE) {
+		atomic_long_inc(&ubi->fence_erases);
+		if (__ratelimit(&fence_rs))
+			ubi_msg(ubi, "fence: erase PEB %d (%s)", pnum,
+				owner_str(owner, b, sizeof(b)));
+	} else {
+		atomic_long_inc(&ubi->fence_writes);
+		if (__ratelimit(&fence_rs))
+			ubi_msg(ubi, "fence: write PEB %d:%d+%d (%s)", pnum,
+				offset, len, owner_str(owner, b, sizeof(b)));
+	}
+	return 0;
+
+refuse:
+	atomic_long_inc(&ubi->fence_refused);
+	if (__ratelimit(&fence_rs))
+		ubi_warn(ubi, "fence: refused %s of PEB %d (%s%s)",
+			 op == UBI_FENCE_OP_ERASE ? "erase" : "write", pnum,
+			 ubi->fence_state == UBI_FENCE_STATE_ACTIVE ?
+				owner_str(ubi->fence_owner[pnum], b, sizeof(b)) :
+				"fence not set up yet",
+			 op == UBI_FENCE_OP_VID ? ", VID header" : "");
+	return -EROFS;
+}
+
+void ubi_fence_erased(struct ubi_device *ubi, int pnum)
+{
+	if (ubi->fence_state == UBI_FENCE_STATE_ACTIVE)
+		ubi->fence_owner[pnum] = UBI_FENCE_FREE;
+}
+
+void ubi_fence_refused_scrub(struct ubi_device *ubi, int pnum)
+{
+	atomic_long_inc(&ubi->fence_scrub_refused);
+	if (__ratelimit(&fence_rs))
+		ubi_warn(ubi, "fence: refused scrubbing of fenced-off PEB %d (data stays readable)",
+			 pnum);
+}
+
+/* ---- debugfs ----------------------------------------------------------------- */
+
+static int fence_dev_show(struct seq_file *s, void *data)
+{
+	struct ubi_device *ubi = ubi_get_device((long)s->private);
+	int i, nfree = 0, noff = 0, nfenced = 0;
+
+	if (!ubi)
+		return -ENODEV;
+	seq_printf(s, "state %s\n",
+		   ubi->fence_state == UBI_FENCE_STATE_ACTIVE ? "active" :
+		   ubi->fence_state == UBI_FENCE_STATE_PENDING ? "pending" : "off");
+	seq_puts(s, "volumes");
+	for (i = 0; i < ubi->fence_nvols; i++)
+		seq_printf(s, " %s:%d", ubi->fence_names[i], ubi->fence_vol_ids[i]);
+	seq_puts(s, "\n");
+	if (ubi->fence_owner) {
+		for (i = 0; i < ubi->peb_count; i++) {
+			if (ubi->fence_owner[i] == UBI_FENCE_FREE)
+				nfree++;
+			else if (ubi->fence_owner[i] == UBI_FENCE_OFF)
+				noff++;
+			else
+				nfenced++;
+		}
+	}
+	seq_printf(s, "pebs fenced %d free %d fenced_off %d\n", nfenced, nfree, noff);
+	seq_printf(s, "writes %ld erases %ld refused %ld scrub_refused %ld\n",
+		   atomic_long_read(&ubi->fence_writes),
+		   atomic_long_read(&ubi->fence_erases),
+		   atomic_long_read(&ubi->fence_refused),
+		   atomic_long_read(&ubi->fence_scrub_refused));
+	seq_printf(s, "mtd_gate allowed %ld refused %ld restore_allowed %ld\n",
+		   atomic_long_read(&fence_gate_allowed),
+		   atomic_long_read(&fence_gate_refused),
+		   atomic_long_read(&fence_restore_allowed));
+	ubi_put_device(ubi);
+	return 0;
+}
+
+static int fence_dev_open(struct inode *inode, struct file *file)
+{
+	return single_open(file, fence_dev_show, inode->i_private);
+}
+
+static const struct file_operations fence_dev_fops = {
+	.owner = THIS_MODULE,
+	.open = fence_dev_open,
+	.read = seq_read,
+	.llseek = seq_lseek,
+	.release = single_release,
+};
+
+void ubi_fence_debugfs_dev(struct ubi_device *ubi, struct dentry *dir)
