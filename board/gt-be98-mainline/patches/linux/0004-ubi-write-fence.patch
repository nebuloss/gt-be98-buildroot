+			    &fence_dev_fops);
+}
+
+/*
+ * ubi/fence_restore (root only): allow the calling process to rewrite whole
+ * PEBs of an MTD device no UBI device is attached to (restore of a raw
+ * backup). "add <mtd number> <first PEB> [<count>]" or "clear". Entries are
+ * tied to the writer's thread group and dropped by "clear".
+ */
+static ssize_t fence_restore_write(struct file *file, const char __user *ubuf,
+				   size_t count, loff_t *ppos)
+{
+	char buf[64];
+	unsigned int mtdn, peb, n = 1;
+	struct mtd_info *mtd;
+	int i, ret;
+
+	if (!capable(CAP_SYS_ADMIN))
+		return -EPERM;
+	if (count >= sizeof(buf))
+		return -EINVAL;
+	if (copy_from_user(buf, ubuf, count))
+		return -EFAULT;
+	buf[count] = '\0';
+
+	if (!strncmp(buf, "clear", 5)) {
+		spin_lock(&fence_lock);
+		for (i = 0; i < FENCE_RESTORE; i++) {
+			if (fence_restore[i].tgid == task_tgid(current)) {
+				put_pid(fence_restore[i].tgid);
+				fence_restore[i].tgid = NULL;
+			}
+		}
+		spin_unlock(&fence_lock);
+		return count;
+	}
+	if (sscanf(buf, "add %u %u %u", &mtdn, &peb, &n) < 2 || !n)
+		return -EINVAL;
+
+	mtd = get_mtd_device(NULL, mtdn);
+	if (IS_ERR(mtd))
+		return PTR_ERR(mtd);
+	/* never on a chip any UBI device is attached to (any partition) */
+	for (i = 0; i < UBI_MAX_DEVICES; i++) {
+		struct ubi_device *ubi = ubi_get_device(i);
+
+		if (!ubi)
+			continue;
+		if (mtd_get_master(ubi->mtd) == mtd_get_master(mtd)) {
+			pr_err("ubi fence: restore refused: ubi%d is attached to mtd%d on the same chip\n",
+			       i, ubi->mtd->index);
+			ubi_put_device(ubi);
+			put_mtd_device(mtd);
+			return -EBUSY;
+		}
+		ubi_put_device(ubi);
+	}
+	ret = -ENOSPC;
+	spin_lock(&fence_lock);
+	for (i = 0; i < FENCE_RESTORE; i++) {
+		if (fence_restore[i].tgid)
+			continue;
+		fence_restore[i].tgid = get_pid(task_tgid(current));
+		fence_restore[i].mtd_num = mtdn;
+		fence_restore[i].r.master = mtd_get_master(mtd);
+		fence_restore[i].r.start = mtd_get_master_ofs(mtd, (u64)peb * mtd->erasesize);
+		fence_restore[i].r.end = fence_restore[i].r.start + (u64)n * mtd->erasesize;
+		ret = 0;
+		break;
+	}
+	spin_unlock(&fence_lock);
+	if (!ret)
+		pr_warn("ubi fence: restore allowed for pid %d: mtd%u (%s) PEB %u..%u\n",
+			task_tgid_nr(current), mtdn, mtd->name, peb, peb + n - 1);
+	put_mtd_device(mtd);
+	return ret ? ret : count;
+}
+
+static int fence_restore_show(struct seq_file *s, void *data)
+{
+	int i;
+
+	spin_lock(&fence_lock);
+	for (i = 0; i < FENCE_RESTORE; i++)
+		if (fence_restore[i].tgid)
+			seq_printf(s, "pid %d mtd%d master 0x%llx..0x%llx\n",
+				   pid_nr(fence_restore[i].tgid),
+				   fence_restore[i].mtd_num,
+				   fence_restore[i].r.start, fence_restore[i].r.end);
+	spin_unlock(&fence_lock);
+	return 0;
+}
+
+static int fence_restore_open(struct inode *inode, struct file *file)
+{
+	return single_open(file, fence_restore_show, NULL);
+}
+
+static const struct file_operations fence_restore_fops = {
+	.owner = THIS_MODULE,
+	.open = fence_restore_open,
+	.read = seq_read,
+	.write = fence_restore_write,
+	.llseek = seq_lseek,
+	.release = single_release,
+};
+
+void ubi_fence_debugfs_root(struct dentry *root)
+{
+	debugfs_create_file("fence_restore", 0600, root, NULL, &fence_restore_fops);
+}
+
+int ubi_fence_register(void)
+{
+	return mtd_fence_register(ubi_fence_mtd_check);
+}
+
+void ubi_fence_unregister(void)
+{
+	mtd_fence_unregister(ubi_fence_mtd_check);
+}
