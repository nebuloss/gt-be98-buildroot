+/* gt-be98 0005: the widths a background chain may take, widest first */
+#define DFS_NO_WIDTH 0xff
+
+static u8 dfs_chwidth_step_down(u8 w)
+{
+	switch (w) {
+	case CONF_OPER_CHWIDTH_320MHZ:
+		return CONF_OPER_CHWIDTH_160MHZ;
+	case CONF_OPER_CHWIDTH_160MHZ:
+	case CONF_OPER_CHWIDTH_80P80MHZ:
+		return CONF_OPER_CHWIDTH_80MHZ;
+	case CONF_OPER_CHWIDTH_80MHZ:
+		return CONF_OPER_CHWIDTH_USE_HT;
+	default:
+		return DFS_NO_WIDTH;
+	}
+}
+
+
+static int dfs_chwidth_mhz(u8 w, int sec)
+{
+	switch (w) {
+	case CONF_OPER_CHWIDTH_USE_HT:
+		return sec ? 40 : 20;
+	case CONF_OPER_CHWIDTH_80MHZ:
+	case CONF_OPER_CHWIDTH_80P80MHZ:
+		return 80;
+	case CONF_OPER_CHWIDTH_160MHZ:
+		return 160;
+	case CONF_OPER_CHWIDTH_320MHZ:
+		return 320;
+	default:
+		return 20;
+	}
+}
+
+
+/* the MHz range [lo, hi) a 5 GHz block occupies (its primary freq, its
+ * HT40 secondary offset, its width, its VHT centre index) */
+static void dfs_block_range(int freq, int sec, u8 w, u8 seg0, int *lo, int *hi)
+{
+	int mhz = dfs_chwidth_mhz(w, sec), c;
+
+	if (w == CONF_OPER_CHWIDTH_USE_HT)
+		c = freq + sec * 10;
+	else
+		c = seg0 ? 5000 + 5 * seg0 : freq;
+	*lo = c - mhz / 2;
+	*hi = c + mhz / 2;
+}
+
+
+/*
+ * Every 20 MHz piece of [lo, hi) exists in the mode and is enabled. nl80211
+ * refuses a CAC over a disabled channel, and hostapd's own DFS_NO_CAC_YET
+ * range check (dfs_channel_available()) does not test the disabled flag: on
+ * 5 GHz-high in ETSI it offered 132/80, whose last channel 144 is disabled
+ * (silicon run q343).
+ */
+static int dfs_block_enabled(struct hostapd_iface *iface, int lo, int hi)
+{
+	struct hostapd_hw_modes *mode = iface->current_mode;
+	int f, i, ok;
+
+	for (f = lo + 10; f < hi; f += 20) {
+		ok = 0;
+		for (i = 0; i < mode->num_channels; i++) {
+			if (mode->channels[i].freq == f) {
+				ok = !(mode->channels[i].flag &
+				       HOSTAPD_CHAN_DISABLED);
+				break;
+			}
+		}
+		if (!ok)
+			return 0;
+	}
+	return 1;
+}
+
+
+/* a (channel, width) the driver refused in this update: not offered again */
+#define DFS_BG_MAX_TRIES 8
+struct dfs_bg_excl {
+	int n;
+	int chan[DFS_BG_MAX_TRIES];
+	u8 w[DFS_BG_MAX_TRIES];
+};
+
+
+static int dfs_bg_excluded(const struct dfs_bg_excl *x, int chan, u8 w)
+{
+	int i;
+
+	for (i = 0; x && i < x->n; i++)
+		if (x->chan[i] == chan && x->w[i] == w)
+			return 1;
+	return 0;
+}
+
+
+static void dfs_note_cfg_chwidth(struct hostapd_iface *iface)
+{
+	if (!iface->radar_background.cfg_chwidth_set) {
+		iface->radar_background.cfg_chwidth =
+			hostapd_get_oper_chwidth(iface->conf);
+		iface->radar_background.cfg_chwidth_set = 1;
+	}
+}
+
+
+/*
+ * A block for the background chain at width w and of type type that does
+ * not overlap the main chain's block and is not the chain's last channel;
+ * NULL if none. The configured width is changed only for the search and
+ * restored before returning (the chain must never rewrite the width of the
+ * running AP: the next beacon would advertise it).
+ */
+static struct hostapd_channel_data *
+dfs_background_pick(struct hostapd_iface *iface, u8 w,
+		    enum dfs_channel_type type, const struct dfs_bg_excl *x,
+		    int *sec, u8 *seg0, u8 *seg1)
+{
+	struct hostapd_channel_data *chan = NULL, *c;
+	u8 saved_w = hostapd_get_oper_chwidth(iface->conf);
+	int hlo, hhi, lo, hi, n, i;
+	u32 r = 0;
+
+	dfs_block_range(iface->freq, iface->conf->secondary_channel, saved_w,
+			hostapd_get_oper_centr_freq_seg0_idx(iface->conf),
+			&hlo, &hhi);
+	hostapd_set_oper_chwidth(iface->conf, w);
+	n = dfs_find_channel(iface, NULL, 0, type);
+	if (n > 0 && os_get_random((u8 *) &r, sizeof(r)) < 0)
+		r = 0;
+	for (i = 0; i < n && !chan; i++) {
+		c = NULL;
+		dfs_find_channel(iface, &c, (r + i) % n, type);
+		if (!c || c->chan == iface->radar_background.channel ||
+		    dfs_bg_excluded(x, c->chan, w))
+			continue;
+		*sec = iface->conf->secondary_channel ? 1 : 0;
+		*seg0 = *seg1 = 0;
+		dfs_adjust_center_freq(iface, c, *sec, -1, seg0, seg1);
+		dfs_block_range(c->freq, *sec, w, *seg0, &lo, &hi);
+		if (lo < hhi && hlo < hi)
+			continue; /* overlaps the main chain's block */
+		if (!dfs_block_enabled(iface, lo, hi))
+			continue; /* holds a disabled channel */
+		chan = c;
+	}
+	hostapd_set_oper_chwidth(iface->conf, saved_w);
+	return chan;
+}
+
+
 static void hostapd_dfs_update_background_chain(struct hostapd_iface *iface)
 {
 	int sec = 0;
-	enum dfs_channel_type channel_type = DFS_NO_CAC_YET;
-	struct hostapd_channel_data *channel;
+	struct hostapd_channel_data *channel = NULL;
 	u8 oper_centr_freq_seg0_idx = 0;
 	u8 oper_centr_freq_seg1_idx = 0;
+	u8 cur = hostapd_get_oper_chwidth(iface->conf);
+	u8 w = cur;
+	bool ready = false, upgrade = false;
+	struct dfs_bg_excl x;
+
+	dfs_note_cfg_chwidth(iface);
+	iface->radar_background.upgrade = 0;
+	x.n = 0;
 
 	/*
-	 * Allow selection of DFS channel in ETSI to comply with
-	 * uniform spreading.
+	 * A (channel, width) the driver refuses is excluded and the selection
