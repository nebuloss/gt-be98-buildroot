+			channel = dfs_background_pick(
+				iface, w, DFS_NO_CAC_YET, &x, &sec,
+				&oper_centr_freq_seg0_idx,
+				&oper_centr_freq_seg1_idx);
+			if (!channel) {
+				channel = dfs_background_pick(
+					iface, w, DFS_AVAILABLE, &x, &sec,
+					&oper_centr_freq_seg0_idx,
+					&oper_centr_freq_seg1_idx);
+				ready = channel != NULL;
+			}
+			if (channel)
+				break;
+		}
 
-	channel = dfs_get_valid_channel(iface, &sec, &oper_centr_freq_seg0_idx,
-					&oper_centr_freq_seg1_idx,
-					channel_type);
-	if (!channel ||
-	    channel->chan == iface->conf->channel ||
-	    channel->chan == iface->radar_background.channel)
-		channel = dfs_downgrade_bandwidth(iface, &sec,
-						  &oper_centr_freq_seg0_idx,
-						  &oper_centr_freq_seg1_idx,
-						  &channel_type);
-	if (!channel ||
-	    hostapd_start_dfs_cac(iface, iface->conf->hw_mode,
-				  channel->freq, channel->chan,
-				  iface->conf->ieee80211n,
-				  iface->conf->ieee80211ac,
-				  iface->conf->ieee80211ax,
-				  iface->conf->ieee80211be,
-				  sec, hostapd_get_oper_chwidth(iface->conf),
-				  oper_centr_freq_seg0_idx,
-				  oper_centr_freq_seg1_idx, true)) {
+		if (!channel || ready)
+			break;
+		if (!hostapd_start_dfs_cac(iface, iface->conf->hw_mode,
+					   channel->freq, channel->chan,
+					   iface->conf->ieee80211n,
+					   iface->conf->ieee80211ac,
+					   iface->conf->ieee80211ax,
+					   iface->conf->ieee80211be,
+					   sec, w,
+					   oper_centr_freq_seg0_idx,
+					   oper_centr_freq_seg1_idx, true))
+			break;
+		wpa_printf(MSG_INFO,
+			   "DFS: background CAC refused on chan %d width %d MHz: trying another",
+			   channel->chan, dfs_chwidth_mhz(w, sec));
+		if (x.n >= DFS_BG_MAX_TRIES) {
+			channel = NULL;
+			break;
+		}
+		x.chan[x.n] = channel->chan;
+		x.w[x.n++] = w;
+	}
+
+	if (!channel) {
 		wpa_printf(MSG_ERROR, "DFS failed to start CAC offchannel");
 		iface->radar_background.channel = -1;
 		return;
@@ -1150,10 +1365,19 @@
 	iface->radar_background.secondary_channel = sec;
 	iface->radar_background.centr_freq_seg0_idx = oper_centr_freq_seg0_idx;
 	iface->radar_background.centr_freq_seg1_idx = oper_centr_freq_seg1_idx;
+	iface->radar_background.oper_chwidth = w;
+	iface->radar_background.upgrade = upgrade;
+	if (ready)
+		iface->radar_background.cac_started = 0;
 
 	wpa_printf(MSG_DEBUG,
 		   "%s: setting background chain to chan %d (%d MHz)",
 		   __func__, channel->chan, channel->freq);
+	wpa_printf(MSG_INFO,
+		   "DFS: background chain chan %d (%d MHz) width %d MHz%s%s",
+		   channel->chan, channel->freq, dfs_chwidth_mhz(w, sec),
+		   ready ? " (already available: ready, no CAC)" : "",
+		   upgrade ? " (the configured width: switch back after its CAC)" : "");
 }
 
 
@@ -1198,6 +1422,14 @@
 		iface->conf, iface->radar_background.centr_freq_seg0_idx);
 	hostapd_set_oper_centr_freq_seg1_idx(
 		iface->conf, iface->radar_background.centr_freq_seg1_idx);
+	/*
+	 * gt-be98 0005: the chain's own width (a narrower standby, or the
