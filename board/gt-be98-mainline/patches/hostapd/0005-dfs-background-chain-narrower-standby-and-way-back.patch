 	 */
-	if (iface->dfs_domain == HOSTAPD_DFS_REGION_ETSI)
-		channel_type = DFS_ANY_CHANNEL;
+	for (;;) {
+		channel = NULL;
+		ready = false;
+		upgrade = false;
+
+		/*
+		 * gt-be98 0005: the main chain runs narrower than configured (a
+		 * radar moved it to a narrower standby): clear the configured-
+		 * width block again (after its non-occupancy period it is
+		 * usable), then switch back to it (hostapd_dfs_complete_cac()).
+		 */
+		if (dfs_chwidth_mhz(cur, 1) <
+		    dfs_chwidth_mhz(iface->radar_background.cfg_chwidth, 1)) {
+			w = iface->radar_background.cfg_chwidth;
+			channel = dfs_background_pick(
+				iface, w, DFS_NO_CAC_YET, &x, &sec,
+				&oper_centr_freq_seg0_idx,
+				&oper_centr_freq_seg1_idx);
+			upgrade = channel != NULL;
+		}
+
+		/*
+		 * A standby at the main chain's width, else narrower (a band
