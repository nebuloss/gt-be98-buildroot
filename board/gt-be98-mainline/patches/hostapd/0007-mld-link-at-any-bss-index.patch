--- a/src/ap/ieee802_11.c
+++ b/src/ap/ieee802_11.c
@@ -6256,6 +6256,18 @@
 	}
 
 	sta = ap_get_sta(hapd, origin_sta->addr);
+	/* gt-be98 0007: a link station that a previous association of this MLD left behind (disassociated or
+	 * deauthenticated, waiting for its removal timer: an AP-initiated deauthentication keeps every link's
+	 * station AP_MAX_INACTIVITY_AFTER_DEAUTH) is not this association's. Refusing the new association for it
+	 * locked a client that rejoins at once out of this link, and the stale copy's later removal took the new
+	 * association's link station out of the driver (open-wifi q472). Free it now, before this association's
+	 * link station is added. A link station that is still associated keeps the refusal. */
+	if (sta && sta != origin_sta && !(sta->flags & WLAN_STA_ASSOC)) {
+		wpa_printf(MSG_DEBUG,
+			   "MLD: link: freeing a stale station of a previous association");
+		ap_free_sta(hapd, sta);
+		sta = NULL;
+	}
 	if (sta || TEST_FAIL()) {
 		wpa_printf(MSG_INFO, "MLD: link: Station already exists");
 		status = WLAN_STATUS_UNSPECIFIED_FAILURE;
