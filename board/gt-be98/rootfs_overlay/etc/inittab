# /etc/inittab — GT-BE98 from-scratch (busybox init)
#
# Trial history (2026-06-25, live RE since there is no serial console):
#  #1 no WD handling   -> 30s BCM watchdog hard-reset, auto-reverted.
#  #2 foreground WD    -> petted (survived) but the foreground `watchdog` sysinit
#                         entry BLOCKED init before rcS.
#  #3 bg WD + /data mount FIRST (before /proc) -> survived, but the fresh
#                         `mount -t ubifs ubi:data` run before /proc HANGS busybox,
#                         stalling init before rcS (empty markers, no auto-revert).
# Fix (this rev): pet the WD first (backgrounded, simple line — proven OK), then
# the STANDARD early mounts (/proc, /sys via mount -a) BEFORE touching /data, then
# arm the dead-man from a real script (/etc/init.d/arm-deadman) so a later stall
# still auto-reverts. All ubifs mounts now happen with /proc+/sys present.
#
# Format: <id>:<runlevels>:<action>:<process>

# ★ pet the HW watchdog FIRST, backgrounded so it cannot block init ★
::sysinit:/bin/sh -c '/sbin/watchdog -t 5 /dev/watchdog &'

# standard early mounts (proc + sys/devpts/tmpfs via fstab) BEFORE any ubifs mount
::sysinit:/bin/mount -t proc proc /proc
::sysinit:/bin/mount -o remount,rw /
::sysinit:/bin/mkdir -p /dev/pts /dev/shm
::sysinit:/bin/mount -a

# now /proc+/sys exist: mount /data+/jffs and arm the dead-man (real script)
::sysinit:/etc/init.d/arm-deadman

::sysinit:/bin/mkdir -p /run/lock/subsys
::sysinit:/sbin/swapon -a
null::sysinit:/bin/ln -sf /proc/self/fd /dev/fd
null::sysinit:/bin/ln -sf /proc/self/fd/0 /dev/stdin
null::sysinit:/bin/ln -sf /proc/self/fd/1 /dev/stdout
null::sysinit:/bin/ln -sf /proc/self/fd/2 /dev/stderr
::sysinit:/bin/hostname -F /etc/hostname
# now run any rc scripts (S10 mounts data/jffs idempotently, S15 datapath, S40 lan, S50 ssh)
::sysinit:/etc/init.d/rcS

# Put a getty on the serial port
console::respawn:/sbin/getty -L  console 0 vt100 # GENERIC_SERIAL

# Stuff to do before rebooting
::shutdown:/etc/init.d/rcK
::shutdown:/sbin/swapoff -a
::shutdown:/bin/umount -a -r
