# /etc/inittab — GT-BE98 from-scratch (busybox init)
#
# Overrides Buildroot's generated inittab to add ONE critical first action: pet
# the BCM hardware watchdog. The bootloader/kernel arm a ~30s "BCM96xxx Watchdog
# timer" (CONFIG_BCM96XXX_WDT); the merlin OS services it with /bin/wdtctl (the
# asus rc starts it). A from-scratch rootfs has no wdtctl, so without this the box
# HARD-RESETS ~30s into boot (the 2026-06-25 trial: slot1 never reached an init
# script, empty /data breadcrumb, ~2-min auto-revert). busybox's watchdog applet
# services /dev/watchdog the same way. It MUST run before rcS in case the kernel
# boot eats most of the 30s budget — so it is the first sysinit entry.
#
# Format: <id>:<runlevels>:<action>:<process>

# ★ pet the HW watchdog FIRST (busybox watchdog daemonizes; -T HW timeout, -t kick) ★
::sysinit:/sbin/watchdog -t 5 /dev/watchdog

# Startup the system
::sysinit:/bin/mount -t proc proc /proc
::sysinit:/bin/mount -o remount,rw /
::sysinit:/bin/mkdir -p /dev/pts /dev/shm
::sysinit:/bin/mount -a
::sysinit:/bin/mkdir -p /run/lock/subsys
::sysinit:/sbin/swapon -a
null::sysinit:/bin/ln -sf /proc/self/fd /dev/fd
null::sysinit:/bin/ln -sf /proc/self/fd/0 /dev/stdin
null::sysinit:/bin/ln -sf /proc/self/fd/1 /dev/stdout
null::sysinit:/bin/ln -sf /proc/self/fd/2 /dev/stderr
::sysinit:/bin/hostname -F /etc/hostname
# now run any rc scripts
::sysinit:/etc/init.d/rcS

# Put a getty on the serial port
console::respawn:/sbin/getty -L  console 0 vt100 # GENERIC_SERIAL

# Stuff to do before rebooting
::shutdown:/etc/init.d/rcK
::shutdown:/sbin/swapoff -a
::shutdown:/bin/umount -a -r
