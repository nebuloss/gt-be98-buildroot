# /etc/inittab — GT-BE98 from-scratch :: STAGE-TIMING DIAG
#
# The early-boot hang holds a ubi lock that blocks every ubifs write, there is no
# serial and no pstore, so NO persistent marker channel works. Instead each step
# drops /dev/.sN (devtmpfs = RAM, no mount needed) and diag-deadman encodes the
# highest N reached into its revert delay -> host decodes the wedged step from the
# dark time.  Stage map:
#   s1  init+sh alive (pre-mount)         s7  /etc/init.d/S10bcm-knvram (data+knvram)
#   s2  /proc mounted                     s8  /etc/init.d/S15bcm-platform (datapath)
#   s3  /sys mounted                      s9  /etc/init.d/S40lan (br0 + IP) -> reachable
#   s4  remount-rw + mount -a             s10 /etc/init.d/S50dropbear (ssh) + disarm
#   s5  mount ubi:data /data
#   s6  mount ubi:jffs2 /jffs
# Reaching s10 touches /tmp/diag-ok (cancels revert) so a HEALTHY boot stays up and
# is reachable on 10.0.0.8 (fallback) or 10.0.0.95 (nvram). Triple safety unchanged.
#
# Format: <id>:<runlevels>:<action>:<process>

::sysinit:/bin/sh -c '/bin/sh /usr/sbin/diag-deadman &'
::sysinit:/bin/sh -c '/sbin/watchdog -t 5 /dev/watchdog &'
::sysinit:/bin/sh -c ': > /dev/.s1'
::sysinit:/bin/mount -t proc proc /proc
::sysinit:/bin/sh -c ': > /dev/.s2'
::sysinit:/bin/mount -t sysfs sysfs /sys
::sysinit:/bin/sh -c ': > /dev/.s3'
::sysinit:/bin/sh -c 'mount -o remount,rw / 2>/dev/null; mkdir -p /dev/pts /dev/shm; mount -a; : > /dev/.s4'
::sysinit:/bin/sh -c 'mount -t ubifs ubi:data /data 2>/dev/null || mount -t ubifs /dev/ubi0_10 /data 2>/dev/null; : > /dev/.s5'
::sysinit:/bin/sh -c 'mount -t ubifs ubi:jffs2 /jffs 2>/dev/null || mount -t ubifs /dev/ubi0_13 /jffs 2>/dev/null; : > /dev/.s6'
::sysinit:/bin/sh -c '/etc/init.d/S10bcm-knvram start; : > /dev/.s7'
::sysinit:/bin/sh -c '/etc/init.d/S15bcm-platform start; : > /dev/.s8'
::sysinit:/bin/sh -c '/etc/init.d/S40lan start; : > /dev/.s9'
::sysinit:/bin/sh -c '/etc/init.d/S50dropbear start; : > /dev/.s10; touch /tmp/diag-ok'

console::respawn:/sbin/getty -L  console 0 vt100 # GENERIC_SERIAL
::shutdown:/bin/umount -a -r
