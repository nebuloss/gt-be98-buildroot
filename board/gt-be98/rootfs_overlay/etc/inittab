# /etc/inittab — GT-BE98 from-scratch (busybox init)
#
# Trial #2 (2026-06-25) proved: petting the BCM HW watchdog from sysinit kept the
# box alive past the 30s reset, BUT init then blocked before rcS (empty /data
# breadcrumb, no deadman) — the foreground `watchdog` line stalled init. This
# revision (a) BACKGROUNDS the watchdog so init proceeds, and (b) is SELF-
# DIAGNOSING: it mounts /data early and writes an Mn marker after each sysinit
# step, so the next trial pinpoints exactly where (if anywhere) boot stalls —
# no serial console needed. Read /data/fromscratch-boot.log on the good slot
# after the trial: last marker present = last step that completed.
#
# Format: <id>:<runlevels>:<action>:<process>

# ★ pet the HW watchdog, BACKGROUNDED so it cannot block init ★
::sysinit:/bin/sh -c '/sbin/watchdog -t 5 /dev/watchdog &'
# mount /data + /jffs EARLY so markers persist and the dead-man can be armed
::sysinit:/bin/sh -c 'mkdir -p /data /jffs; mount -t ubifs ubi:data /data 2>/dev/null; mount -t ubifs ubi:jffs2 /jffs 2>/dev/null; echo "=== boot $(cat /proc/uptime) ===" >> /data/fromscratch-boot.log 2>/dev/null; echo "M1 wd+data+jffs" >> /data/fromscratch-boot.log 2>/dev/null'
# ★ arm the trial dead-man BEFORE rcS so a later init block still auto-reverts ★
::sysinit:/bin/sh -c 'if [ -f /data/.trial-armed ] && [ -x /jffs/scripts/trial-deadman ]; then /jffs/scripts/trial-deadman & echo "M1b deadman-armed" >> /data/fromscratch-boot.log 2>/dev/null; fi'

::sysinit:/bin/mount -t proc proc /proc
::sysinit:/bin/sh -c 'echo "M2 proc" >> /data/fromscratch-boot.log 2>/dev/null'
::sysinit:/bin/mount -o remount,rw /
::sysinit:/bin/mkdir -p /dev/pts /dev/shm
::sysinit:/bin/mount -a
::sysinit:/bin/sh -c 'echo "M3 mount-a" >> /data/fromscratch-boot.log 2>/dev/null'
::sysinit:/bin/mkdir -p /run/lock/subsys
::sysinit:/sbin/swapon -a
null::sysinit:/bin/ln -sf /proc/self/fd /dev/fd
null::sysinit:/bin/ln -sf /proc/self/fd/0 /dev/stdin
null::sysinit:/bin/ln -sf /proc/self/fd/1 /dev/stdout
null::sysinit:/bin/ln -sf /proc/self/fd/2 /dev/stderr
::sysinit:/bin/hostname -F /etc/hostname
::sysinit:/bin/sh -c 'echo "M4 pre-rcS" >> /data/fromscratch-boot.log 2>/dev/null'
# now run any rc scripts
::sysinit:/etc/init.d/rcS
::sysinit:/bin/sh -c 'echo "M5 post-rcS" >> /data/fromscratch-boot.log 2>/dev/null'

# Put a getty on the serial port
console::respawn:/sbin/getty -L  console 0 vt100 # GENERIC_SERIAL

# Stuff to do before rebooting
::shutdown:/etc/init.d/rcK
::shutdown:/sbin/swapoff -a
::shutdown:/bin/umount -a -r
