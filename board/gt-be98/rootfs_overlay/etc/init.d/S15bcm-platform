#!/bin/sh
# S15bcm-platform — Broadcom platform bring-up. Runs the closed bcm_boot_launcher
# VERBATIM, which executes /rom/etc/rc3.d/S25..S50 in numeric order (exactly what
# the ASUS rc sysinit() invokes). That sequence does:
#   S25mount-fs       mount -a, reset_reason, mdev coldplug, make_static_devnodes
#   S40hndnvram       nvram kernelset /data/.kernel_nvram.setting
#   S45bcm-base-drivers  the CLOSED HW-datapath .ko load ORDER (bdmf, rdpa_gpl,
#                     bcm_mpm, bcm_bpm, bcmvlan, rdpa, pktflow, cmdlist, bcm_enet,
#                     pktrunner, bcmmcast, wfd, ...)
#   S45bcm-wlan-drivers  wl.ko/dhd.ko + radio firmware
#
# Busybox-init port of the proven OpenRC `bcm-platform` service. This single
# script replicates ~90% of the ASUS rc graft early-init. SELF-CONTAINED: we
# INVOKE bcm_boot_launcher, never reimplement it.
#
# GRAFT-DEPENDENT: bcm_boot_launcher (ELF) + the rc3.d tree + the closed .ko
# come from the userspace blob + the kernel build.

LAUNCHER=/bin/bcm_boot_launcher

start() {
	if [ -x "$LAUNCHER" ]; then
		echo "S15bcm-platform: bcm_boot_launcher start (rc3.d S25-S50: datapath + wl)"
		"$LAUNCHER" start
		echo "S15 launcher_exit=$? modules=$(grep -c '' /proc/modules) enet=$(grep -c '^bcm_enet ' /proc/modules) rdpa=$(grep -c '^rdpa ' /proc/modules) wl=$(grep -c '^wl ' /proc/modules)" >> /data/fromscratch-boot.log 2>/dev/null
	else
		echo "S15bcm-platform: WARN $LAUNCHER absent — closed datapath NOT loaded."
		echo "S15bcm-platform:      (a fully-generated rootfs needs the userspace"
		echo "S15bcm-platform:       blob that ships bcm_boot_launcher + /rom/etc/rc3.d)"
	fi
}

case "$1" in
	start) start ;;
	stop)  [ -x "$LAUNCHER" ] && "$LAUNCHER" stop ;;
	*) echo "usage: $0 {start|stop}" >&2; exit 1 ;;
esac
